# IMPORTANT: this MUST be changed to `Production` for a real deploy.
# In `Development` the Api applies pending EF Core migrations automatically on
# startup; in `Production` it never does (Técnico R0009) - migrations are an
# explicit deploy step, so you must run `make migrate` yourself after `make deploy`.
# Swagger is also only exposed in `Development`.
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_USER=ruinarpg
POSTGRES_PASSWORD=change-me
JWT_SIGNING_KEY=change-me-to-a-long-random-string
JWT_ISSUER=RuinaRPG
JWT_AUDIENCE=RuinaRPG
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost
IMG_MAX_SIZE_MB=10
