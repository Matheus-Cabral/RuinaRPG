@using RuinaRPG.Client.Shared.Fields
@using MudBlazor

@* As Runas da ficha (só nos tipos com Runas, TipoDeFichaCliente.TemRunas): adicionar do zero ou do Banco, a tabela, remover. *@

<Section Title="Runas">
    <EditForm Model="Estado.FormularioDeRuna" OnValidSubmit="Estado.AdicionarRunaAsync">
        <RuneOrigemFields Model="Estado.FormularioDeRuna" BankEntries="Estado.BancoDeRunas" AvailableImages="Estado.MinhasImagens"
                          CampaignId="@(Estado.IsGmCaller ? null : Estado.CampaignId)" OnError="@Estado.MostrarErro" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Runa</MudButton>
    </EditForm>
    <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
        <thead><tr><th></th><th>Nome</th><th>Descrição</th><th>Grau</th><th>Tipo</th><th>Disciplina</th><th></th></tr></thead>
        <tbody>
            @foreach (var rune in Estado.Runas)
            {
                <tr>
                    <td>@if (rune.ImageUrl is not null) { <ClickableImage Src="@rune.ImageUrl" Width="60" /> }</td>
                    <td>@rune.Nome <DesabilitadoChip Condicao="@rune.DesabilitadoPor" /></td>
                    <td>@rune.Descricao</td>
                    <td>@rune.Grau</td>
                    <td>@RuneTipoRotulo.De(rune.Tipo)</td>
                    <td>@RuneDisciplinaRotulo.De(rune.Disciplina)</td>
                    <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => Estado.RemoverRunaAsync(rune.Id))">Remover</MudButton></td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</Section>

@code {
    [CascadingParameter] public FichaEstado Estado { get; set; } = default!;
}
