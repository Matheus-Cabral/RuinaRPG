@using MudBlazor
@using RuinaRPG.Contracts.Fichas

@* As Afinidades por elemento (Ficha de Personagem 2.c e R0007; Personagem e NPC): no topo, "Distribuídos gasto/máximo"
   (vermelho acima do máximo), a mensagem de validação e a Afinidade Adicional (do formulário auto-salvo da página,
   AoMudar); depois, um elemento por linha com o nome (e a dica de um bloqueado), − valor +, a barra de segmentos e a
   Experiência. Cada − / + / Experiência grava o elemento na hora (FichaEstado.AtualizarAfinidadeAsync); gasto, máximo,
   bloqueios e o que aparece vêm do servidor. Quem as regras não recusam (o GM do NPC: AfinidadesLivresParaOGm) vê a
   dica mas não perde o +. Seção oculta (marcial sem Afinidade Adicional nem coração de mana): só a Afinidade
   Adicional fica, que é como ela volta. *@

<Section Title="Afinidades">
    @if (Afinidades is { SecaoVisivel: true } afinidades)
    {
        <div class="d-flex align-center flex-wrap mb-2" style="gap:16px">
            <div>
                <MudText Typo="Typo.subtitle1" Color="@(afinidades.Gasto > afinidades.Maximo ? Color.Error : Color.Default)">Distribuídos @afinidades.Gasto/@afinidades.Maximo</MudText>
                <MudText Typo="Typo.caption" Color="@(afinidades.Gasto > afinidades.Maximo ? Color.Error : Color.Secondary)">@MensagemDeValidacao(afinidades)</MudText>
            </div>
            @CampoDaAfinidadeAdicional
        </div>
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>Elemento</th><th>Pontos</th><th>Experiência</th></tr></thead>
            <tbody>
                @foreach (var elemento in afinidades.Elementos)
                {
                    <tr @key="elemento.Id">
                        <td>
                            <MudText Typo="Typo.body2">@elemento.Nome</MudText>
                            @if (elemento.Motivo is { } motivo)
                            {
                                <div class="d-flex align-center" style="gap:4px">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@motivo</MudText>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-center flex-wrap" style="gap:4px">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Variant="Variant.Outlined"
                                               aria-label="@($"Tirar 1 ponto de {elemento.Nome}")" title="Tirar 1 ponto"
                                               Disabled="@(Estado.SalvandoAfinidade || elemento.Pontos == 0)"
                                               OnClick="@(() => Estado.AtualizarAfinidadeAsync(elemento.Id, elemento.Pontos - 1, elemento.Experiencia))" />
                                <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="min-width:2rem">@elemento.Pontos</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               aria-label="@($"Pôr 1 ponto em {elemento.Nome}")" title="Pôr 1 ponto"
                                               Disabled="@(Estado.SalvandoAfinidade || !PodeSubir(afinidades, elemento))"
                                               OnClick="@(() => Estado.AtualizarAfinidadeAsync(elemento.Id, elemento.Pontos + 1, elemento.Experiencia))" />
                                @{ var segmentos = Segmentos(afinidades, elemento); }
                                <div class="d-flex flex-wrap ml-2" style="gap:2px" role="img" aria-label="@($"{elemento.Pontos} de {segmentos} pontos")">
                                    @for (var i = 0; i < segmentos; i++)
                                    {
                                        <span class="@(i < elemento.Pontos ? "mud-theme-primary" : "border border-solid mud-border-lines-default") rounded-sm" style="width:10px;height:16px"></span>
                                    }
                                </div>
                                @if (elemento.PontosComCondicoes != elemento.Pontos)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning" Style="white-space:nowrap">com Condições: @elemento.PontosComCondicoes</MudText>
                                }
                            </div>
                        </td>
                        <td>
                            <MudNumericField T="int?" Value="@elemento.Experiencia" Min="0" Margin="Margin.Dense" Style="max-width:6rem"
                                             ValueChanged="@(v => Estado.AtualizarAfinidadeAsync(elemento.Id, elemento.Pontos, v))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else if (Afinidades is not null)
    {
        @CampoDaAfinidadeAdicional
    }
</Section>

@code {
    [CascadingParameter] public FichaEstado Estado { get; set; } = default!;

    /// <summary>O formulário auto-salvo da página: a Afinidade Adicional.</summary>
    [Parameter, EditorRequired] public FormularioDaFicha Formulario { get; set; } = default!;

    /// <summary>A página auto-salva a ficha (a Afinidade Adicional); o salvamento relê as abas e, com elas, o máximo.</summary>
    [Parameter] public EventCallback AoMudar { get; set; }

    private AfinidadesDaFichaResponse? Afinidades => Estado.Afinidades;

    private RenderFragment CampoDaAfinidadeAdicional => @<MudNumericField T="int" @bind-Value="Formulario.AfinidadeAdicional" @bind-Value:after="MudouAsync"
                                                                          Label="Afinidade Adicional" Min="0" Margin="Margin.Dense" Style="max-width:10rem" />;

    // As regras de 2.c valem para todos, menos para o GM onde o tipo o deixa livre (Ficha de NPCs R0010).
    private bool AplicaRegras => !(Estado.Tipo.AfinidadesLivresParaOGm && Estado.IsGmCaller);

    // O servidor decide; o + só não oferece o que ele recusaria: elemento bloqueado, no teto ou sem pontos livres.
    private bool PodeSubir(AfinidadesDaFichaResponse afinidades, ElementoDaFichaResponse elemento) =>
        !AplicaRegras
        || (!elemento.Bloqueado && (elemento.Teto is not { } teto || elemento.Pontos < teto) && afinidades.Gasto < afinidades.Maximo);

    // Um segmento por ponto possível: até o teto do elemento ou, sem teto, até o máximo da ficha — nunca menos que os pontos.
    private static int Segmentos(AfinidadesDaFichaResponse afinidades, ElementoDaFichaResponse elemento) =>
        Math.Max(elemento.Teto ?? afinidades.Maximo, elemento.Pontos);

    private static string MensagemDeValidacao(AfinidadesDaFichaResponse a) =>
        a.Gasto > a.Maximo ? $"Acima do máximo em {a.Gasto - a.Maximo}: só é possível tirar pontos."
        : a.Gasto == a.Maximo ? "Todos os pontos distribuídos."
        : $"Restam {a.Maximo - a.Gasto} ponto(s) para distribuir.";

    private Task MudouAsync() => AoMudar.InvokeAsync();
}
