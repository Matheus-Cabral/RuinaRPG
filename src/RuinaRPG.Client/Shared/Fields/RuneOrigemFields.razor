@using MudBlazor
@using RuinaRPG.Contracts.Images
@using RuinaRPG.Contracts.Runes

@* Campos do formulário de adicionar Runa em 4.d, compartilhados por FichaDePersonagem e FichaDeNpc:
   Origem (do zero / do Banco de Runas) e, conforme ela, os 3 campos da Runa ou o seletor de entrada
   do banco. O GM passa o banco inteiro dele; o jogador, só as entradas públicas da campanha. *@

<MudSelect T="string" @bind-Value="Model.Origem" Label="Origem">
    <MudSelectItem Value="@("Zero")">Montar do zero</MudSelectItem>
    <MudSelectItem Value="@("Banco")">Escolher do Banco de Runas</MudSelectItem>
</MudSelect>

@if (Model.DoBanco)
{
    <MudSelect T="string" @bind-Value="Model.SourceBankEntryId" Label="Entrada do Banco">
        <MudSelectItem Value="@("")">Escolha uma entrada</MudSelectItem>
        @foreach (var entry in BankEntries)
        {
            <MudSelectItem Value="@entry.Id">@EntryLabel(entry)</MudSelectItem>
        }
    </MudSelect>
    var picked = BankEntries.FirstOrDefault(e => e.Id == Model.SourceBankEntryId);
    if (picked?.ImageUrl is not null)
    {
        <div class="mt-2"><ClickableImage Src="@picked.ImageUrl" Width="60" /></div>
    }
}
else
{
    <MudTextField T="string" @bind-Value="Model.Nome" Label="Nome" />
    <MudTextField T="string" @bind-Value="Model.Descricao" Label="Descrição" Lines="3" />
    <MudNumericField T="int" @bind-Value="Model.Grau" Label="Grau" />
    <DisciplinaDeRunaSelect @bind-Value="Model.Disciplina" />
    <div class="d-flex align-center">
        <MudSelect T="string" @bind-Value="Model.Tipo" Label="Tipo">
            <MudSelectItem Value="@("")">Sem tipo</MudSelectItem>
            <MudSelectItem Value="@("Arcana")">Runa Arcana</MudSelectItem>
            <MudSelectItem Value="@("Negra")">Runa Negra</MudSelectItem>
        </MudSelect>
        <InfoPopup Title="Tipo da Runa">
            <MudText>Classifica a Runa como Arcana ou Negra. É só uma classificação exibida no Banco de Runas e nas fichas; não muda nenhum cálculo. Runas antigas ficam sem tipo até serem editadas no Banco.</MudText>
        </InfoPopup>
    </div>
    <ImageAttachmentField AvailableImages="AvailableImages" SelectedIds="SelectedImageIds"
                          SelectedIdsChanged="@(ids => Model.ImageId = ids.FirstOrDefault() ?? "")"
                          OnError="OnError" CampaignId="CampaignId" Multiple="false" />
}

@code {
    [Parameter, EditorRequired] public RuneOrigemModel Model { get; set; } = new();
    [Parameter] public IReadOnlyList<RuneBankEntryResponse> BankEntries { get; set; } = [];
    [Parameter] public List<ImageSummaryResponse> AvailableImages { get; set; } = new();
    [Parameter] public string? CampaignId { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    // "Runa do Fogo (Grau 1, Emissão, Runa Arcana)"; Disciplina e Tipo só aparecem quando existem.
    private static string EntryLabel(RuneBankEntryResponse entry)
    {
        var partes = new List<string> { $"Grau {entry.Grau}" };
        if (!string.IsNullOrEmpty(entry.Disciplina))
            partes.Add(RuneDisciplinaRotulo.De(entry.Disciplina));
        if (!string.IsNullOrEmpty(entry.Tipo))
            partes.Add(RuneTipoRotulo.De(entry.Tipo));
        return $"{entry.Nome} ({string.Join(", ", partes)})";
    }

    private List<string> SelectedImageIds => string.IsNullOrEmpty(Model.ImageId) ? new() : new() { Model.ImageId };
}
