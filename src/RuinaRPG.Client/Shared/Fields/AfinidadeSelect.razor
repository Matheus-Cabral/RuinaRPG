@using MudBlazor
@using RuinaRPG.Client.Services
@inject CatalogoDeElementos Catalogo

@* O campo Afinidade (Ficha de Personagem 1.a/2.b, Criatura 1.a, requisito de Passiva): as opções são os elementos do
   catálogo do Auditor que não são Caminho; o valor é o id do elemento. *@
<MudSelect T="int?" Label="Afinidade" Value="Value" ValueChanged="OnValueChangedAsync" Placeholder="Escolha uma Afinidade">
    @foreach (var (valor, rotulo) in Opcoes)
    {
        <MudSelectItem T="int?" Value="@valor">@rotulo</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }

    protected override async Task OnInitializedAsync() => await Catalogo.CarregarAsync();

    // Um Caminho (ou elemento fora da lista) já salvo continua aparecendo, para o select não ficar em branco,
    // mas não é oferecido para uma escolha nova.
    private IReadOnlyList<(int? Valor, string Rotulo)> Opcoes
    {
        get
        {
            var lista = Catalogo.Afinidades.Select(e => ((int?)e.Id, e.Nome)).ToList();
            if (Value is { } atual && lista.All(o => o.Item1 != atual))
                lista.Add((atual, Catalogo.Nome(atual)));
            return lista;
        }
    }

    private async Task OnValueChangedAsync(int? novoValor)
    {
        Value = novoValor;
        await ValueChanged.InvokeAsync(Value);
    }
}
