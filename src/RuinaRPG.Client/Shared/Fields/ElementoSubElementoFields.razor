@using MudBlazor

<MudSelect T="string" Value="Elemento" ValueChanged="OnElementoChangedAsync" Placeholder="Elemento" Margin="Margin.Dense">
    @foreach (var (valor, rotulo) in Elementos)
    {
        <MudSelectItem Value="@valor">@rotulo</MudSelectItem>
    }
</MudSelect>

<MudSelect T="string" Value="SubElemento" ValueChanged="OnSubElementoChangedAsync" Placeholder="Sub-Elemento" Margin="Margin.Dense">
    @foreach (var (valor, rotulo) in SubElementos)
    {
        <MudSelectItem Value="@valor">@rotulo</MudSelectItem>
    }
</MudSelect>

@code {
    // R0001 2.c descreve Sub-Elemento como um dropdown em cascata (filtrado pelo Elemento
    // escolhido). Na prática isso deixava o campo de Sub-Elemento sumindo da tabela até um
    // Elemento ser escolhido — o backend já valida a combinação (ElementoSubElementoValidator),
    // então aqui os dois ficam sempre visíveis e independentes, sem filtro nem limpeza automática.
    [Parameter] public string? Elemento { get; set; }
    [Parameter] public EventCallback<string?> ElementoChanged { get; set; }
    [Parameter] public string? SubElemento { get; set; }
    [Parameter] public EventCallback<string?> SubElementoChanged { get; set; }

    // Os 4 Elementos da Matriz Elemental ("Mundano", presente na matriz apenas como referência,
    // não é uma opção válida aqui).
    public static readonly (string Valor, string Rotulo)[] Elementos =
    [
        ("Ar", "Ar"), ("Agua", "Água"), ("Fogo", "Fogo"), ("Terra", "Terra"),
    ];

    // Os 14 Sub-Elementos da Matriz Elemental, mesmos rótulos usados em AfinidadeSelect.
    public static readonly (string Valor, string Rotulo)[] SubElementos =
    [
        ("Gelo", "Gelo"), ("Flora", "Flora"), ("Ferro", "Ferro"), ("Raio", "Raio"), ("Prever", "Prever"), ("Alma", "Alma"),
        ("Purificar", "Purificar"), ("Ecomancia", "Ecomancia"), ("Hemomancia", "Hemomancia"), ("Curar", "Curar"),
        ("Vida", "Vida"), ("Aprimorar", "Aprimorar"), ("Necromancia", "Necromancia"), ("Invocacao", "Invocação"),
    ];

    internal Task SetElementoForTests(string? elemento) => OnElementoChangedAsync(elemento);
    internal Task SetSubElementoForTests(string? subElemento) => OnSubElementoChangedAsync(subElemento);

    private Task OnElementoChangedAsync(string? novoElemento)
    {
        Elemento = novoElemento;
        return ElementoChanged.InvokeAsync(Elemento);
    }

    private Task OnSubElementoChangedAsync(string? novoSubElemento)
    {
        SubElemento = novoSubElemento;
        return SubElementoChanged.InvokeAsync(SubElemento);
    }
}
