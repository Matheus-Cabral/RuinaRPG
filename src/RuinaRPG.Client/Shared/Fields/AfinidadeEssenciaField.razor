@using MudBlazor
@using RuinaRPG.Domain.CharacterSheets

@* One "Essência" cell of the Afinidades table: a name dropdown (Essência Básica 1 or 2)
   paired with its own numeric value, matching the PDF sheet's "- AFINIDADES -" table
   (Essências Básicas | Sub-Elementos | Cam. e Exp., each column a name+number pair). Used
   twice per row — once for each Essência Básica — so the pairing doesn't get re-typed on
   both Ficha de Personagem and Ficha de NPC. *@

<div class="d-flex align-center" style="gap:4px">
    <MudSelect T="string" Value="Nome" ValueChanged="OnNomeChangedAsync" Placeholder="@Label" Margin="Margin.Dense" Style="min-width:7rem" Disabled="Disabled">
        @foreach (var (valor, rotulo) in Opcoes)
        {
            <MudSelectItem Value="@valor">@rotulo</MudSelectItem>
        }
    </MudSelect>
    <MudNumericField T="int?" Value="Valor" ValueChanged="OnValorChangedAsync" Margin="Margin.Dense" Style="max-width:4.5rem" />
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public (string Valor, string Rotulo)[] Opcoes { get; set; } = [];
    [Parameter] public string? Nome { get; set; }
    [Parameter] public EventCallback<string?> NomeChanged { get; set; }
    [Parameter] public int? Valor { get; set; }
    [Parameter] public EventCallback<int?> ValorChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    // Os 4 Elementos da Matriz Elemental ("Mundano", presente na matriz apenas como referência,
    // não é uma opção válida aqui).
    public static readonly (string Valor, string Rotulo)[] Elementos =
    [
        ("Ar", "Ar"), ("Agua", "Água"), ("Fogo", "Fogo"), ("Terra", "Terra"),
    ];

    public static readonly (string Valor, string Rotulo)[] EssenciasBasicas =
    [
        ("Ar", "Ar"), ("Agua", "Água"), ("Fogo", "Fogo"), ("Terra", "Terra"), ("Alma", "Alma"), ("Vida", "Vida"), ("Mundano", "Mundano"),
    ];

    // Essência 2 de uma linha de Afinidade: só o que cruza com a Essência 1 na Matriz Elemental. O valor
    // já salvo (atual) fica na lista pro select não aparecer em branco.
    public static (string Valor, string Rotulo)[] OpcoesSegundaEssencia(string? elemento, string? atual)
    {
        if (!Enum.TryParse<Elemento>(elemento, out var e1))
            return [];
        var validas = MatrizElemental.OpcoesSegundaEssencia(e1).Select(e => e.ToString()).ToHashSet();
        return EssenciasBasicas.Where(o => validas.Contains(o.Valor) || o.Valor == atual).ToArray();
    }

    public static string RotuloSubElemento(string? subElemento) => subElemento switch
    {
        null or "" => "—",
        "Invocacao" => "Invocação",
        _ => subElemento,
    };

    internal Task SetNomeForTests(string? nome) => OnNomeChangedAsync(nome);
    internal Task SetValorForTests(int? valor) => OnValorChangedAsync(valor);

    private Task OnNomeChangedAsync(string? novoNome)
    {
        Nome = novoNome;
        return NomeChanged.InvokeAsync(Nome);
    }

    private Task OnValorChangedAsync(int? novoValor)
    {
        Valor = novoValor;
        return ValorChanged.InvokeAsync(Valor);
    }
}
