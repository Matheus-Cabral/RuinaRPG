@using MudBlazor

@* One "Essência" cell of the Afinidades table: a name dropdown (Elemento or Sub-Elemento,
   depending on which static option list the caller passes) paired with its own numeric value,
   matching the PDF sheet's "- AFINIDADES -" table (Essências Básicas | Sub-Elementos | Cam. e
   Exp., each column a name+number pair). Used twice per row — once for Elemento, once for
   Sub-Elemento — so the pairing doesn't get re-typed on both Ficha de Personagem and Ficha de NPC. *@

<div class="d-flex align-center" style="gap:4px">
    <MudSelect T="string" Value="Nome" ValueChanged="OnNomeChangedAsync" Placeholder="@Label" Margin="Margin.Dense" Style="min-width:7rem">
        @foreach (var (valor, rotulo) in Opcoes)
        {
            <MudSelectItem Value="@valor">@rotulo</MudSelectItem>
        }
    </MudSelect>
    <MudNumericField T="int?" Value="Valor" ValueChanged="OnValorChangedAsync" Margin="Margin.Dense" Style="max-width:4.5rem" />
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public (string Valor, string Rotulo)[] Opcoes { get; set; } = [];
    [Parameter] public string? Nome { get; set; }
    [Parameter] public EventCallback<string?> NomeChanged { get; set; }
    [Parameter] public int? Valor { get; set; }
    [Parameter] public EventCallback<int?> ValorChanged { get; set; }

    // Os 4 Elementos da Matriz Elemental ("Mundano", presente na matriz apenas como referência,
    // não é uma opção válida aqui).
    public static readonly (string Valor, string Rotulo)[] Elementos =
    [
        ("Ar", "Ar"), ("Agua", "Água"), ("Fogo", "Fogo"), ("Terra", "Terra"),
    ];

    // Os 14 Sub-Elementos da Matriz Elemental, mesmos rótulos usados em AfinidadeSelect.
    public static readonly (string Valor, string Rotulo)[] SubElementos =
    [
        ("Gelo", "Gelo"), ("Flora", "Flora"), ("Ferro", "Ferro"), ("Raio", "Raio"), ("Prever", "Prever"), ("Alma", "Alma"),
        ("Purificar", "Purificar"), ("Ecomancia", "Ecomancia"), ("Hemomancia", "Hemomancia"), ("Curar", "Curar"),
        ("Vida", "Vida"), ("Aprimorar", "Aprimorar"), ("Necromancia", "Necromancia"), ("Invocacao", "Invocação"),
    ];

    internal Task SetNomeForTests(string? nome) => OnNomeChangedAsync(nome);
    internal Task SetValorForTests(int? valor) => OnValorChangedAsync(valor);

    private Task OnNomeChangedAsync(string? novoNome)
    {
        Nome = novoNome;
        return NomeChanged.InvokeAsync(Nome);
    }

    private Task OnValorChangedAsync(int? novoValor)
    {
        Valor = novoValor;
        return ValorChanged.InvokeAsync(Valor);
    }
}
