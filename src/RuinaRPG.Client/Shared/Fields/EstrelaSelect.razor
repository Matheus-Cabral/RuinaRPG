@using MudBlazor
@using RuinaRPG.Contracts.Rules
@inject HttpClient Http

@* R0001 1.a — dropdown das 10 Estrelas Alkerianas + ícone de descrição, para não poluir a ficha com
   o texto completo. Os rótulos do dropdown são os títulos dos cartões da aba As Estrelas do Livro de
   Regras (GET api/rulebook/estrelas-alkerianas), e o popup mostra o cartão daquela Estrela, buscado a
   cada abertura — assim uma edição do Auditor de Regras aparece aqui. *@
<div class="d-flex align-center" style="gap:4px">
    <MudSelect T="string" Label="Estrela" Value="Value" ValueChanged="OnValueChangedAsync" Placeholder="Escolha uma Estrela"
               ToStringFunc="Rotulo">
        @foreach (var nome in Estrelas)
        {
            <MudSelectItem Value="@nome">@Rotulo(nome)</MudSelectItem>
        }
    </MudSelect>
    @if (Value is not null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" OnClick="OpenAsync" title="Descrição da Estrela" />
    }
</div>

<MudDialog @bind-Visible="_open" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>@(_card?.Titulo ?? Value)</TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else if (_card is not null)
        {
            <div class="rulebook-content">@((MarkupString)_card.Html)</div>
        }
        else
        {
            <MudText>Descrição não encontrada no Livro de Regras.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _open = false)">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private bool _open;
    private bool _loading;
    private RulebookSectionResponse? _card;
    private List<RulebookSectionResponse> _cartoes = new();

    // Só o Nome (o valor salvo na ficha) fica fixo aqui — o rótulo e a descrição vêm do Livro de
    // Regras (ver OnInitializedAsync e OpenAsync).
    public static readonly string[] Estrelas =
        ["Aeurer", "Liora", "Vaelen", "Theron", "Maetus", "Almora", "Elvani", "Sareli", "Gaelion", "Sadir"];

    protected override async Task OnInitializedAsync() =>
        _cartoes = (await BuscarCartoesAsync()) ?? new();

    // Sem o cartão (Livro de Regras fora do ar ou cartão removido), o rótulo cai para o próprio Nome.
    private string Rotulo(string? nome) =>
        nome is null ? "" : CartaoDe(_cartoes, nome)?.Titulo ?? nome;

    // Cada cartão tem como título o nome da Estrela em caixa alta (ex: "🌿 I — AEURER").
    private static RulebookSectionResponse? CartaoDe(IEnumerable<RulebookSectionResponse> cartoes, string nome) =>
        cartoes.FirstOrDefault(s => s.Titulo.Contains(nome, StringComparison.OrdinalIgnoreCase));

    private async Task<List<RulebookSectionResponse>?> BuscarCartoesAsync()
    {
        try
        {
            var documento = await Http.GetFromJsonAsync<RulebookDocumentResponse>("rulebook/estrelas-alkerianas");
            return documento?.Sections;
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private async Task OpenAsync()
    {
        _card = null;
        _loading = true;
        _open = true;
        var cartoes = await BuscarCartoesAsync();
        if (cartoes is not null)
            _cartoes = cartoes;
        _card = cartoes is null ? null : CartaoDe(cartoes, Value!);
        _loading = false;
    }

    private async Task OnValueChangedAsync(string? novoValor)
    {
        Value = novoValor;
        await ValueChanged.InvokeAsync(Value);
    }
}
