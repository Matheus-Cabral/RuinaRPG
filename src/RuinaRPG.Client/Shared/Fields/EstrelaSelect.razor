@using MudBlazor
@using RuinaRPG.Contracts.Rules
@inject HttpClient Http

@* R0001 1.a — dropdown das 10 Estrelas Alkerianas + ícone de descrição, para não poluir a ficha com
   o texto completo. O popup mostra o cartão daquela Estrela na aba As Estrelas do Livro de Regras
   (GET api/rulebook/estrelas-alkerianas), buscado a cada abertura — assim uma edição do Auditor de
   Regras aparece aqui sem recarregar a ficha. *@
<div class="d-flex align-center" style="gap:4px">
    <MudSelect T="string" Label="Estrela" Value="Value" ValueChanged="OnValueChangedAsync" Placeholder="Escolha uma Estrela">
        @foreach (var estrela in Estrelas)
        {
            <MudSelectItem Value="@estrela.Nome">@estrela.Rotulo</MudSelectItem>
        }
    </MudSelect>
    @if (Value is not null)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" OnClick="OpenAsync" title="Descrição da Estrela" />
    }
</div>

<MudDialog @bind-Visible="_open" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>@(_card?.Titulo ?? Value)</TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else if (_card is not null)
        {
            <div class="rulebook-content">@((MarkupString)_card.Html)</div>
        }
        else
        {
            <MudText>Descrição não encontrada no Livro de Regras.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _open = false)">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private bool _open;
    private bool _loading;
    private RulebookSectionResponse? _card;

    // Só Nome (o valor salvo na ficha) e o rótulo do dropdown ficam fixos aqui — a descrição vem do
    // Livro de Regras (ver OpenAsync).
    public static readonly (string Nome, string Rotulo)[] Estrelas =
    [
        ("Aeurer", "Aeurer — Estrela da Curiosidade"),
        ("Liora", "Liora — Estrela da Introspecção"),
        ("Vaelen", "Vaelen — Estrela da Proteção"),
        ("Theron", "Theron — Estrela da Impulsividade"),
        ("Maetus", "Maetus — Estrela da Ambição"),
        ("Almora", "Almora — Estrela da Generosidade"),
        ("Elvani", "Elvani — Estrela da Prudência"),
        ("Sareli", "Sareli — Estrela da Vingança"),
        ("Gaelion", "Gaelion — Estrela da Lealdade"),
        ("Sadir", "Sadir — Estrela do Egoísmo"),
    ];

    private async Task OpenAsync()
    {
        _card = null;
        _loading = true;
        _open = true;
        try
        {
            var documento = await Http.GetFromJsonAsync<RulebookDocumentResponse>("rulebook/estrelas-alkerianas");
            // Cada cartão tem como título o nome da Estrela em caixa alta (ex: "🌿 I — AEURER").
            _card = documento?.Sections.FirstOrDefault(s => s.Titulo.Contains(Value!, StringComparison.OrdinalIgnoreCase));
        }
        catch (HttpRequestException)
        {
            _card = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnValueChangedAsync(string? novoValor)
    {
        Value = novoValor;
        await ValueChanged.InvokeAsync(Value);
    }
}
