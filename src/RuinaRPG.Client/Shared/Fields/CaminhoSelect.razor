@using MudBlazor

@* Caminho de uma linha de Afinidade (2.c): Alma, Vida ou Mundano. Um valor antigo em texto livre
   (de antes do Caminho virar dropdown) continua listado pra poder ser exibido, mas não é uma das
   opções novas — o servidor só o aceita enquanto não for alterado. *@

<MudSelect T="string" Value="Value" ValueChanged="OnValueChangedAsync" Placeholder="Caminho" Margin="Margin.Dense" Clearable="true" Style="min-width:7rem">
    @foreach (var opcao in Opcoes)
    {
        <MudSelectItem Value="@opcao">@opcao</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    public static readonly string[] Caminhos = ["Alma", "Vida", "Mundano"];

    private string[] Opcoes =>
        string.IsNullOrEmpty(Value) || Caminhos.Contains(Value) ? Caminhos : [.. Caminhos, Value];

    internal Task SetValueForTests(string? valor) => OnValueChangedAsync(valor);

    private Task OnValueChangedAsync(string? novoValor)
    {
        Value = novoValor;
        return ValueChanged.InvokeAsync(Value);
    }
}
