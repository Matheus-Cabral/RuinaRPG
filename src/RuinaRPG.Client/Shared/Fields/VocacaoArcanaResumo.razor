@using MudBlazor

@* Cabeçalho da seção Afinidades (Ficha de Personagem 2.c): pontos de Vocação Arcana gastos
   sobre o máximo, mais a Afinidade Adicional que aumenta esse máximo. Compartilhado entre
   Ficha de Personagem e Ficha de NPC — só o servidor da Ficha de Personagem bloqueia o excesso. *@

<div class="d-flex align-center flex-wrap mb-2" style="gap:16px">
    <MudText Typo="Typo.subtitle1" Color="@(Gasto > Maxima ? Color.Error : Color.Default)">Vocação Arcana: @Gasto / @Maxima</MudText>
    <MudNumericField T="int" Value="AfinidadeAdicional" ValueChanged="AfinidadeAdicionalChanged" Label="Afinidade Adicional" Min="0" Margin="Margin.Dense" Style="max-width:10rem" />
</div>

@code {
    [Parameter, EditorRequired] public int Gasto { get; set; }
    [Parameter, EditorRequired] public int Maxima { get; set; }
    [Parameter] public int AfinidadeAdicional { get; set; }
    [Parameter] public EventCallback<int> AfinidadeAdicionalChanged { get; set; }

    // As linhas já carregadas na página, para o contador acompanhar cada edição sem recarregar a ficha: cada
    // Essência conta uma vez, pelo maior valor (como 1 ou 2), e os Sub-Elementos somam. A Api conta pontos por
    // elemento desde a 2.2.0; esta conta só vive enquanto a seção de linhas existe.
    public static int CalcularGasto(IEnumerable<(string? Elemento, int? ElementoValor, string? SegundaEssencia, int? SegundaEssenciaValor, int? SubElementoValor)> linhas)
    {
        var maiorPorEssencia = new Dictionary<string, int>();
        var subElementos = 0;
        foreach (var l in linhas)
        {
            if (l.Elemento is { } e)
                maiorPorEssencia[e] = Math.Max(maiorPorEssencia.GetValueOrDefault(e), l.ElementoValor ?? 0);
            if (l.SegundaEssencia is { } s)
                maiorPorEssencia[s] = Math.Max(maiorPorEssencia.GetValueOrDefault(s), l.SegundaEssenciaValor ?? 0);
            subElementos += l.SubElementoValor ?? 0;
        }
        return maiorPorEssencia.Values.Sum() + subElementos;
    }
}
