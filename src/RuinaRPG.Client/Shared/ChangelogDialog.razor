@using MudBlazor

<MudDialog @bind-Visible="_visible" @bind-Visible:after="OnVisibilityChangedAsync" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
    <DialogContent>
        <MudText Typo="Typo.h6">Novidades da Versão @Version</MudText>
        @* Texto da versão 1.3.1 (AppVersionInfo.Current) — atualize esta lista junto com a constante ao lançar uma nova versão. *@
        <ul class="mt-2">
            <li><b>Aba História:</b> nova aba nas fichas de Personagem e NPC (antes do Diário no Personagem), que reúne a Estrela, o Histórico e um campo para escrever a história do personagem, com editor de texto completo: títulos, fontes, cores, listas, alinhamento, citações, links e tabelas. Salva automaticamente.</li>
            <li><b>Afinidades:</b> cada linha agora tem duas Essências Básicas. A segunda aceita Elementos e os Caminhos Alma, Vida e Mundano, e o Sub-Elemento é calculado automaticamente pela interseção das duas na Matriz Elemental. As afinidades não dependem mais da Vocação.</li>
            <li><b>Estrelas:</b> o popup da Estrela nas fichas mostra o texto do Livro de Regras, acompanhando qualquer atualização.</li>
            <li><b>Livro de Regras:</b> abre na aba Sistema Básico, a aba "As Estrelas Alkerianas" passou a se chamar "As Estrelas", e há um botão para voltar ao topo.</li>
            <li><b>Ficha de Criatura:</b> os Pontos de Atributo iniciais dependem do Rank (F 6, E 7, D 8, C 9, B 10, A 12, S 14), e os níveis seguintes somam pela Tabela de Níveis.</li>
        </ul>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CloseAsync">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string Version { get; set; } = "";
    [Parameter] public EventCallback OnDismissed { get; set; }

    private bool _visible = true;

    // Escape / backdrop click close the dialog through MudDialog's own Visible round-trip, which
    // raises this callback via @bind-Visible:after. A direct "_visible = false" assignment from our
    // own code (as the "Fechar" button used to do) does NOT trigger it: MudBlazor's internal
    // ParameterState already observes Visible=false via the normal parameter channel by the time its
    // own close logic tries to echo the change back, so the echo is a no-op and VisibleChanged never
    // fires — silently dropping the dismissal. CloseAsync below invokes OnDismissed explicitly so the
    // button path is not dependent on that echo.
    private async Task OnVisibilityChangedAsync()
    {
        if (!_visible)
            await OnDismissed.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        _visible = false;
        await OnDismissed.InvokeAsync();
    }
}
