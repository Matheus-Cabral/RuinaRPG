@using MudBlazor

<MudDialog @bind-Visible="_visible" @bind-Visible:after="OnVisibilityChangedAsync" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
    <DialogContent>
        <MudText Typo="Typo.h6">Novidades da Versão @Version</MudText>
        @* Texto da versão 1.3.0 (AppVersionInfo.Current) — atualize esta lista junto com a constante ao lançar uma nova versão. *@
        <ul class="mt-2">
            <li><b>Históricos:</b> novo campo Histórico nas fichas de Personagem e NPC, com um popup que descreve o Histórico escolhido. O bônus de +6/+3 conta como pontos gastos na Perícia (+2/+1 no Modificador), que aparece em negrito na ficha. Há também uma nova aba Históricos no Livro de Regras.</li>
            <li><b>Estrelas Alkerianas:</b> nova aba no Livro de Regras, campo Estrela e Pontos de Sina nas fichas.</li>
            <li><b>Equipagem inicial:</b> botão "Escolher Equipamento Inicial" na aba Posses (Personagem e NPC), com 12 kits. Os itens escolhidos entram na ficha automaticamente, incluindo Armadura no slot certo. Há uma nova aba Equipagem no Livro de Regras, e o Tônico de Vida/Foco simples entrou no catálogo padrão.</li>
            <li><b>Construtor de Subcategoria:</b> checkbox "Item Inicial" no cadastro de itens (Arma, Armadura, Escudo e Artefato) para montar a Subcategoria a partir de listas padronizadas.</li>
            <li><b>Banco de Runas:</b> um banco de Runas do GM. As Runas das fichas podem partir dele, e as Runas podem ser anexadas à campanha e ter imagem.</li>
            <li><b>Afinidades:</b> o Caminho virou um dropdown antes do Sub-Elemento, e os Sub-Elementos agora dependem do Elemento e do Caminho. Alma e Vida passaram a ser Caminhos.</li>
            <li><b>Alóra:</b> nova variante solar nas Habilidades Raciais e nas fichas.</li>
            <li><b>Fichas de NPC e Criatura:</b> contador de Pontos de Atributo.</li>
            <li><b>Interface:</b>
                <ul>
                    <li>Sidebar com ícones, que no desktop fica recolhida e expande quando o cursor passa por cima.</li>
                    <li>Conteúdo com largura máxima no desktop.</li>
                    <li>Novo ícone ⓘ de ajuda no formulário do Banco de Magias.</li>
                </ul>
            </li>
            <li><b>Correções:</b> o Banco de Magias passa a ser visível só para o GM, e as regras de cópia de entradas do banco foram ajustadas.</li>
        </ul>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CloseAsync">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string Version { get; set; } = "";
    [Parameter] public EventCallback OnDismissed { get; set; }

    private bool _visible = true;

    // Escape / backdrop click close the dialog through MudDialog's own Visible round-trip, which
    // raises this callback via @bind-Visible:after. A direct "_visible = false" assignment from our
    // own code (as the "Fechar" button used to do) does NOT trigger it: MudBlazor's internal
    // ParameterState already observes Visible=false via the normal parameter channel by the time its
    // own close logic tries to echo the change back, so the echo is a no-op and VisibleChanged never
    // fires — silently dropping the dismissal. CloseAsync below invokes OnDismissed explicitly so the
    // button path is not dependent on that echo.
    private async Task OnVisibilityChangedAsync()
    {
        if (!_visible)
            await OnDismissed.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        _visible = false;
        await OnDismissed.InvokeAsync();
    }
}
