@using MudBlazor

<MudDialog @bind-Visible="_visible" @bind-Visible:after="OnVisibilityChangedAsync" Options="@(new DialogOptions { CloseOnEscapeKey = true })">
    <DialogContent>
        <MudText Typo="Typo.h6">Novidades da Versão @Version</MudText>
        @* Texto da versão 1.4.4 (AppVersionInfo.Current) — atualize esta lista junto com a constante ao lançar uma nova versão. *@
        <ul class="mt-2">
            <li><b>Afinidade Elemental:</b> Eficiência Elemental e Dano Elemental agora vêm da Tabela de Afinidades, conforme o valor da essência ou elemento da Afinidade escolhida (os valores das fichas podem mudar).</li>
            <li><b>Sub-Atributos:</b> organizados em blocos, com a Defesa em coluna à direita e a Afinidade Elemental no fim; o estado da Cobertura ganhou uma cor de maior contraste.</li>
            <li><b>Maestrias:</b> a seção de Maestrias das fichas saiu da aba Magias &amp; Habilidades e agora fica na aba Combate, abaixo de Armas.</li>
            <li><b>Características:</b> o limite de Características Negativas passa a ser o dobro do de Positivas.</li>
            <li><b>Anexos da campanha:</b> agrupados por tipo, com galeria de imagens e filtros por grupo; a busca não lista mais o que já está anexado.</li>
            <li><b>Catálogo de Itens:</b> os campos de Subcategoria sugerem as subcategorias já existentes; Requisitos e Penalidade do equipamento aparecem no popup do item, e não mais na lista.</li>
            <li><b>Banco de Magias e Habilidades:</b> filtros de Categoria, Vocação e Classe nas Passivas.</li>
        </ul>
        @if (IsRulesAuditor)
        {
            @* Bloco só para o Auditor de Regras: o que mudou nas páginas de Auditoria nesta versão. Preencha-o
               sempre que uma versão mexer numa página de Auditoria; apague o bloco inteiro quando não mexer. *@
            <MudText Typo="Typo.subtitle1" Class="mt-3"><b>Para Auditores</b></MudText>
            <ul class="mt-1">
                <li><b>Tabela de Afinidades:</b> nova página de Auditoria para criar, editar e excluir as linhas que definem Eficiência e Dano Elemental por valor de Afinidade; acima da maior linha valem os valores dela.</li>
            </ul>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CloseAsync">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string Version { get; set; } = "";
    [Parameter] public EventCallback OnDismissed { get; set; }
    /// <summary>Mostra o bloco "Para Auditores" — novidades das páginas de Auditoria.</summary>
    [Parameter] public bool IsRulesAuditor { get; set; }

    private bool _visible = true;

    // Escape / backdrop click close the dialog through MudDialog's own Visible round-trip, which
    // raises this callback via @bind-Visible:after. A direct "_visible = false" assignment from our
    // own code (as the "Fechar" button used to do) does NOT trigger it: MudBlazor's internal
    // ParameterState already observes Visible=false via the normal parameter channel by the time its
    // own close logic tries to echo the change back, so the echo is a no-op and VisibleChanged never
    // fires — silently dropping the dismissal. CloseAsync below invokes OnDismissed explicitly so the
    // button path is not dependent on that echo.
    private async Task OnVisibilityChangedAsync()
    {
        if (!_visible)
            await OnDismissed.InvokeAsync();
    }

    private async Task CloseAsync()
    {
        _visible = false;
        await OnDismissed.InvokeAsync();
    }
}
