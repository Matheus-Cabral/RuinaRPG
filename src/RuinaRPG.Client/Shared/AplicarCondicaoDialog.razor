@inject HttpClient Http
@inject PericiaCatalogo Pericias
@using System.Net.Http.Json
@using MudBlazor
@using RuinaRPG.Client.Services
@using RuinaRPG.Contracts.Condicoes
@using RuinaRPG.Contracts.Encounters
@*
    Gerenciador de Encontros: aplica uma Condição do catálogo a um participante. Escolha da Condição, Duração
    (começa na padrão do catálogo, pode ser limpa), o valor de cada linha (editável só para este participante) e,
    por categoria que a Condição desabilita, "toda a categoria" ou linhas específicas da ficha dele, e, por linha de
    Maestria, "todas as Maestrias" ou Maestrias específicas da ficha dele (as da Perícia da linha, se ela tiver uma).
    Fecha com sucesso depois do POST; um erro da API (ex.: condição repetida) fica no diálogo.
*@
<MudDialog>
    <DialogContent>
        <DismissibleAlert @bind-Message="_errorMessage" Class="mb-3" />
        <MudAutocomplete T="CondicaoResponse" Label="Condição" SearchFunc="BuscarAsync" ToStringFunc="@(c => c?.Nome ?? string.Empty)"
                         Value="_condicao" ValueChanged="EscolherAsync" ResetValueOnEmptyText="true" CoerceText="false" Clearable="true" MaxItems="null" />
        @if (_condicao is not null)
        {
            @if (!string.IsNullOrWhiteSpace(_condicao.Descricao))
            {
                <MudText Typo="Typo.body2" Class="mt-2">@_condicao.Descricao</MudText>
            }
            <div class="d-flex align-center mt-3" style="gap:12px">
                <MudNumericField T="int?" Label="Duração (turnos)" @bind-Value="_duracao" Min="1" Clearable="true" Disabled="_semDuracao"
                                 HelperText="Vazio usa a duração padrão da Condição." />
                <MudCheckBox T="bool" Label="Sem duração" Value="_semDuracao" ValueChanged="@(v => { _semDuracao = v; if (v) _duracao = null; })" />
            </div>

            @for (var i = 0; i < _condicao.Modificadores.Count; i++)
            {
                var indice = i;
                var linha = _condicao.Modificadores[indice];
                <div class="d-flex align-center mt-2" style="gap:12px">
                    <MudText Typo="Typo.body2" Style="flex:1">@CondicaoResumo.Linha(linha, _valores[indice], Pericias.Label)</MudText>
                    <MudNumericField T="int" Label="Valor" Value="_valores[indice]" ValueChanged="@(v => _valores[indice] = v)"
                                     Style="max-width:8rem" aria-label="@($"Valor da linha {indice + 1}")" />
                </div>
                @if (linha.Alvo == "Maestria" && _itensCarregados)
                {
                    var maestrias = MaestriasDa(linha);
                    <div class="ml-4">
                        @if (maestrias.Count == 0)
                        {
                            <MudText Typo="Typo.caption">A ficha não tem Maestrias para esta linha.</MudText>
                        }
                        else
                        {
                            <MudSwitch T="bool" Label="@($"Todas as Maestrias (linha {indice + 1})")" Value="!_maestriasEscolhidas.ContainsKey(indice)"
                                       ValueChanged="@(v => { if (v) _maestriasEscolhidas.Remove(indice); else _maestriasEscolhidas[indice] = new(); })" Color="Color.Primary" />
                            @if (_maestriasEscolhidas.TryGetValue(indice, out var escolhidas))
                            {
                                <MudSelect T="string" Label="@($"Maestrias da linha {indice + 1}")" MultiSelection="true"
                                           SelectedValues="@escolhidas" SelectedValuesChanged="@(v => _maestriasEscolhidas[indice] = v.ToHashSet())"
                                           MultiSelectionTextFunc="@(ids => string.Join(", ", maestrias.Where(m => ids.Contains(m.Id)).Select(m => m.Nome)))">
                                    @foreach (var maestria in maestrias)
                                    {
                                        <MudSelectItem T="string" Value="@maestria.Id">@maestria.Nome</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        }
                    </div>
                }
            }

            @foreach (var categoria in _condicao.Desabilitacoes)
            {
                var rotulo = CondicaoAlvos.Categorias.FirstOrDefault(o => o.Valor == categoria)?.Rotulo ?? categoria;
                var linhas = ItensDa(categoria);
                <div class="mt-3">
                    @if (!_itensCarregados)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error">Não foi possível carregar os itens da ficha deste participante.</MudText>
                    }
                    else if (linhas.Count == 0)
                    {
                        <MudText Typo="Typo.body2">Desabilita @rotulo: a ficha não tem itens nesta categoria.</MudText>
                    }
                    else
                    {
                        <MudSwitch T="bool" Label="Toda a categoria" Value="_categoriaInteira[categoria]" ValueChanged="@(v => _categoriaInteira[categoria] = v)"
                                   Color="Color.Primary" />
                        <MudText Typo="Typo.caption">Desabilita @rotulo.</MudText>
                        @if (!_categoriaInteira[categoria])
                        {
                            <MudSelect T="string" Label="@($"Itens desabilitados: {rotulo}")" MultiSelection="true"
                                       SelectedValues="@_itensEscolhidos[categoria]" SelectedValuesChanged="@(v => _itensEscolhidos[categoria] = v.ToHashSet())"
                                       MultiSelectionTextFunc="@(escolhidos => string.Join(", ", linhas.Where(l => escolhidos.Contains(l.Id)).Select(l => l.Nome)))">
                                @foreach (var item in linhas)
                                {
                                    <MudSelectItem T="string" Value="@item.Id">@item.Nome</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    }
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_condicao is null || _aplicando || (!_itensCarregados && _condicao.Desabilitacoes.Count > 0))" OnClick="AplicarAsync">Aplicar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public string EncounterId { get; set; } = "";
    [Parameter, EditorRequired] public string ParticipantId { get; set; } = "";

    private List<CondicaoResponse> _catalogo = new();
    private Dictionary<string, List<ItemDesabilitavelDto>> _itens = new();
    private List<MaestriaDaFichaDto> _maestrias = new();
    // Por linha de Maestria (índice) restrita a Maestrias específicas; uma linha fora daqui vale em todas.
    private Dictionary<int, HashSet<string>> _maestriasEscolhidas = new();
    private CondicaoResponse? _condicao;
    private int? _duracao;
    private int[] _valores = [];
    private Dictionary<string, bool> _categoriaInteira = new();
    private Dictionary<string, HashSet<string>> _itensEscolhidos = new();
    private string? _errorMessage;
    private bool _aplicando;
    private bool _semDuracao;
    private bool _itensCarregados;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(Pericias.CarregarAsync(), CarregarCatalogoAsync(), CarregarItensAsync());
    }

    private async Task CarregarCatalogoAsync()
    {
        var response = await Http.GetAsync("condicoes");
        if (response.IsSuccessStatusCode)
            _catalogo = await response.Content.ReadFromJsonAsync<List<CondicaoResponse>>() ?? new();
        else
            _errorMessage = "Não foi possível carregar o catálogo de Condições.";
    }

    private async Task CarregarItensAsync()
    {
        var response = await Http.GetAsync($"encounters/{EncounterId}/participants/{ParticipantId}/itens-desabilitaveis");
        if (!response.IsSuccessStatusCode)
            return; // _itensCarregados fica falso: o diálogo avisa e não deixa aplicar uma Condição que desabilita itens

        var corpo = await response.Content.ReadFromJsonAsync<ItensDesabilitaveisResponse>();
        _itens = corpo?.Categorias ?? new();
        _maestrias = corpo?.Maestrias ?? new();
        _itensCarregados = true;
    }

    private Task<IEnumerable<CondicaoResponse>> BuscarAsync(string? texto, CancellationToken token) =>
        Task.FromResult(_catalogo.Where(c => string.IsNullOrWhiteSpace(texto) || c.Nome.Contains(texto, StringComparison.OrdinalIgnoreCase)));

    private List<ItemDesabilitavelDto> ItensDa(string categoria) => _itens.GetValueOrDefault(categoria) ?? new();

    // As Maestrias da ficha a que a linha pode ser restrita: as da Perícia dela, ou todas se a linha vale em qualquer Perícia.
    private List<MaestriaDaFichaDto> MaestriasDa(CondicaoModificadorDto linha) =>
        _maestrias.Where(m => linha.AlvoEspecifico is null || string.Equals(m.Pericia, linha.AlvoEspecifico, StringComparison.OrdinalIgnoreCase)).ToList();

    private void Escolher(CondicaoResponse? condicao)
    {
        _condicao = condicao;
        _duracao = condicao?.DuracaoPadraoTurnos;
        _semDuracao = false;
        _valores = condicao?.Modificadores.Select(m => m.Valor).ToArray() ?? [];
        _categoriaInteira = condicao?.Desabilitacoes.ToDictionary(c => c, _ => true) ?? new();
        _itensEscolhidos = condicao?.Desabilitacoes.ToDictionary(c => c, _ => new HashSet<string>()) ?? new();
        _maestriasEscolhidas = new();
        _errorMessage = null;
    }

    private Task EscolherAsync(CondicaoResponse? condicao)
    {
        Escolher(condicao);
        return Task.CompletedTask;
    }

    private async Task AplicarAsync()
    {
        if (_condicao is null || _aplicando)
            return;

        // Só viajam os valores que o GM mudou; o resto fica com o do catálogo. Cada um leva a linha como o GM a viu,
        // para o servidor recusar se a entrada mudou no catálogo enquanto isso.
        var ajustados = new List<ValorAjustadoDto>();
        for (var i = 0; i < _valores.Length; i++)
        {
            var linha = _condicao.Modificadores[i];
            if (_valores[i] != linha.Valor)
                ajustados.Add(new ValorAjustadoDto(i, linha.Alvo, linha.AlvoEspecifico, _valores[i]));
        }

        var itens = new Dictionary<string, List<string>>();
        foreach (var categoria in _condicao.Desabilitacoes)
        {
            if (ItensDa(categoria).Count == 0 || _categoriaInteira[categoria])
                continue;
            if (_itensEscolhidos[categoria].Count == 0)
            {
                var rotulo = CondicaoAlvos.Categorias.FirstOrDefault(o => o.Valor == categoria)?.Rotulo ?? categoria;
                _errorMessage = $"Escolha ao menos um item de {rotulo} ou desabilite a categoria inteira.";
                return;
            }
            itens[categoria] = _itensEscolhidos[categoria].ToList();
        }

        var maestrias = new Dictionary<int, List<string>>();
        foreach (var (indice, escolhidas) in _maestriasEscolhidas.OrderBy(m => m.Key))
        {
            if (escolhidas.Count == 0)
            {
                _errorMessage = $"Escolha ao menos uma Maestria na linha {indice + 1} ou deixe-a valer em todas.";
                return;
            }
            maestrias[indice] = escolhidas.ToList();
        }

        _aplicando = true;
        try
        {
            var request = new AplicarCondicaoRequest(_condicao.Id, _semDuracao ? null : _duracao, ajustados.Count > 0 ? ajustados : null, itens.Count > 0 ? itens : null, _semDuracao,
                maestrias.Count > 0 ? maestrias : null);
            var response = await Http.PostAsJsonAsync($"encounters/{EncounterId}/participants/{ParticipantId}/condicoes", request);
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível aplicar a condição.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _aplicando = false;
        }
    }
}
