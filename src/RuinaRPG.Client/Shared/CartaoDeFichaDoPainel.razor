@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Client.Shared.Ficha
@using MudBlazor

@* O cartão de uma ficha do Jogador no Painel: as vivas e as do cemitério (estas com os motivos) usam o mesmo. *@
<MudCard>
    <MudCardHeader>
        <CardHeaderAvatar>
            @if (Sheet.ImageUrl is not null)
            {
                <ClickableAvatarImage Src="@Sheet.ImageUrl" Size="Size.Large" />
            }
            else
            {
                <MudAvatar Size="Size.Large" />
            }
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@(Sheet.Nome ?? "(sem nome)")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nível @Sheet.Nivel — @Sheet.CampanhaNome</MudText>
            @foreach (var motivo in Sheet.MotivosDoCemiterio)
            {
                <MudChip T="string" Size="Size.Small">@FichaEstado.RotuloDoMotivo(motivo)</MudChip>
            }
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardActions>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"fichas/{Sheet.Id}")">Abrir</MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public MyCharacterSheetSummaryResponse Sheet { get; set; } = default!;
}
