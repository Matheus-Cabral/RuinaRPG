@inject HttpClient Http
@using System.Net.Http.Json
@using MudBlazor
@using RuinaRPG.Contracts.Campaigns
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Domain.SpellsAndAbilities

@* Livro de Regras R0010: as Passivas ao alcance de quem está logado — o GM vê o próprio banco; o
   Jogador, as públicas da campanha escolhida (seletor só com mais de uma campanha). Filtros combináveis
   (busca por nome, Categoria, Vocação, Classe); as Passivas sempre nos grupos Livres, Vocacionais e de Classe,
   em ordem alfabética, cada uma num painel recolhível. *@
<DismissibleAlert @bind-Message="_errorMessage" Class="mb-3" />

@if (!IsGm && _campanhas.Count > 1)
{
    <MudSelect T="string" Value="_campanhaId" ValueChanged="OnCampanhaChangedAsync" Label="Campanha" Class="mb-4">
        @foreach (var campanha in _campanhas)
        {
            <MudSelectItem Value="@campanha.Id">@campanha.Nome</MudSelectItem>
        }
    </MudSelect>
}

@if (_carregado && !_falhou)
{
    @if (!IsGm && _campanhas.Count == 0)
    {
        <MudText>Você ainda não participa de nenhuma campanha.</MudText>
    }
    else if (_passivas.Count == 0)
    {
        <MudText>Nenhuma Habilidade Passiva disponível.</MudText>
    }
    else
    {
        <div class="d-flex flex-wrap mb-4" style="gap:8px">
            <MudTextField T="string" @bind-Value="_nome" Label="Buscar passiva..." Immediate="true" Style="min-width:220px" />
            <MudSelect T="string" @bind-Value="_categoria" Label="Categoria" Style="min-width:200px">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                @foreach (var categoria in Enum.GetValues<CategoriaDePassiva>())
                {
                    <MudSelectItem Value="@categoria.ToString()">@RequisitoLabels.Categoria(categoria)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_vocacao" Label="Vocação" Style="min-width:180px">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                @foreach (var vocacao in PassivasDoLivroOrganizador.Vocacoes(_passivas))
                {
                    <MudSelectItem Value="@vocacao">@vocacao</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_classe" Label="Classe" Style="min-width:180px">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                @foreach (var classe in PassivasDoLivroOrganizador.Classes(_passivas))
                {
                    <MudSelectItem Value="@classe">@classe</MudSelectItem>
                }
            </MudSelect>
        </div>

        var grupos = PassivasDoLivroOrganizador.Agrupar(_passivas, new FiltroDePassivas(_nome, _categoria, _vocacao, _classe));
        @if (grupos.Count == 0)
        {
            <MudText>Nenhuma Habilidade Passiva corresponde aos filtros.</MudText>
        }
        @foreach (var grupo in grupos)
        {
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">@grupo.Titulo (@grupo.Passivas.Count)</MudText>
            <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
                @foreach (var passiva in grupo.Passivas)
                {
                    var requisitos = passiva.Requisitos.Count > 0 ? string.Join(", ", passiva.Requisitos) : "Sem requisitos";
                    <MudExpansionPanel @key="passiva.Id">
                        <TitleContent>
                            <MudText Typo="Typo.subtitle1"><b>@passiva.Nome</b></MudText>
                            <MudText Typo="Typo.body2">@requisitos</MudText>
                        </TitleContent>
                        <ChildContent>
                            <MudText Style="white-space: pre-wrap">@passiva.Descricao</MudText>
                            <MudText Typo="Typo.body2" Class="mt-2"><b>Requisitos:</b> @requisitos</MudText>
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        }
    }
}

@code {
    [Parameter] public bool IsGm { get; set; }

    private List<CampaignResponse> _campanhas = new();
    private List<PassivaDoLivroResponse> _passivas = new();
    private string? _campanhaId;
    private string _nome = "";
    private string _categoria = "";
    private string _vocacao = "";
    private string _classe = "";
    private string? _errorMessage;
    private bool _carregado;
    // O DismissibleAlert zera _errorMessage ao ser dispensado; o estado de falha não pode depender dele.
    private bool _falhou;

    protected override async Task OnInitializedAsync()
    {
        await TentarCarregarAsync(async () =>
        {
            if (!IsGm)
            {
                _campanhas = await Http.GetFromJsonAsync<List<CampaignResponse>>("campaigns/mine") ?? new();
                _campanhaId = _campanhas.FirstOrDefault()?.Id;
            }
            await CarregarPassivasAsync();
        });
        _carregado = true;
    }

    private async Task OnCampanhaChangedAsync(string? campanhaId)
    {
        _campanhaId = campanhaId;
        await TentarCarregarAsync(CarregarPassivasAsync);
    }

    private async Task TentarCarregarAsync(Func<Task> carregar)
    {
        _falhou = false;
        _errorMessage = null;
        try
        {
            await carregar();
        }
        catch (Exception)
        {
            _falhou = true;
            _passivas = new();
            _errorMessage = "Não foi possível carregar as Habilidades Passivas.";
        }
    }

    private async Task CarregarPassivasAsync()
    {
        // Jogador sem campanha: não há o que pedir (o endpoint exige campaignId).
        if (!IsGm && _campanhaId is null)
        {
            _passivas = new();
            return;
        }
        var url = IsGm ? "rulebook/passivas" : $"rulebook/passivas?campaignId={_campanhaId}";
        _passivas = await Http.GetFromJsonAsync<List<PassivaDoLivroResponse>>(url) ?? new();
        // Vocação/Classe que não existem na lista carregada (troca de campanha) deixam de filtrar.
        if (!PassivasDoLivroOrganizador.Vocacoes(_passivas).Contains(_vocacao)) _vocacao = "";
        if (!PassivasDoLivroOrganizador.Classes(_passivas).Contains(_classe)) _classe = "";
    }
}
