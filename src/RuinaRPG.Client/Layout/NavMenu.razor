@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject TokenAuthenticationStateProvider AuthProvider

@*
    MudNavLink prioritises Href over OnClick: when both are set it renders a non-anchor
    <div tabindex="0"> and never invokes OnClick. So links with an Href carry no click handler —
    MainLayout closes the drawer on NavigationManager.LocationChanged instead, which covers every
    navigation (including browser back/forward). Only "Sair", which has no Href, keeps an OnClick.
*@
<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All">Início</MudNavLink>

    <AuthorizeView>
        <NotAuthorized>
            <MudNavLink Href="login">Entrar</MudNavLink>
            <MudNavLink Href="cadastro">Cadastrar</MudNavLink>
        </NotAuthorized>
        <Authorized>
            <AuthorizeView Roles="GM" Context="gmContext">
                <Authorized>
                    <MudNavLink Href="painel/convites">Convidar Jogador</MudNavLink>
                    <MudNavLink Href="painel/jogadores">Jogadores</MudNavLink>
                    <MudNavLink Href="catalogo">Catálogo de Itens</MudNavLink>
                    <MudNavLink Href="npcs">NPCs do GM</MudNavLink>
                    <MudNavLink Href="bestiario">Bestiário do GM</MudNavLink>
                    <MudNavLink Href="banco-de-magias">Banco de Magias e Habilidades</MudNavLink>
                    <MudNavLink Href="campanhas">Campanhas</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Jogador" Context="jogadorContext">
                <Authorized>
                    <MudNavLink Href="minhas-campanhas">Minhas Campanhas</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <MudNavLink Href="livro-de-regras">Livro de Regras</MudNavLink>
            <MudNavLink OnClick="LogoutAsync">Sair</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Parameter] public EventCallback OnLinkClicked { get; set; }

    private Task NotifyLinkClicked() => OnLinkClicked.InvokeAsync();

    private async Task LogoutAsync()
    {
        var refreshToken = await AuthState.GetRefreshTokenAsync();
        if (refreshToken is not null)
            await Http.PostAsJsonAsync("auth/logout", new RuinaRPG.Contracts.Auth.RefreshRequest(refreshToken));

        await AuthState.ClearAsync();
        AuthProvider.NotifyUserChanged();
        Navigation.NavigateTo("/");
        await NotifyLinkClicked();
    }
}
