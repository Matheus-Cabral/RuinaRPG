@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject TokenAuthenticationStateProvider AuthProvider

@*
    MudNavLink prioritises Href over OnClick: when both are set it renders a non-anchor
    <div tabindex="0"> and never invokes OnClick. So links with an Href carry no click handler —
    MainLayout closes the drawer on NavigationManager.LocationChanged instead, which covers every
    navigation (including browser back/forward). Only "Sair", which has no Href, keeps an OnClick.
*@
<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All"><span aria-hidden="true">🏠</span> Início</MudNavLink>

    <AuthorizeView>
        <NotAuthorized>
            <MudNavLink Href="login"><span aria-hidden="true">🔑</span> Entrar</MudNavLink>
            <MudNavLink Href="cadastro"><span aria-hidden="true">✒️</span> Cadastrar</MudNavLink>
        </NotAuthorized>
        <Authorized>
            <AuthorizeView Roles="GM" Context="gmContext">
                <Authorized>
                    <MudNavLink Href="painel/convites"><span aria-hidden="true">✉️</span> Convidar Jogador</MudNavLink>
                    <MudNavLink Href="painel/jogadores"><span aria-hidden="true">👥</span> Jogadores</MudNavLink>
                    <MudNavLink Href="catalogo"><span aria-hidden="true">🎒</span> Catálogo de Itens</MudNavLink>
                    <MudNavLink Href="npcs"><span aria-hidden="true">🎭</span> NPCs do GM</MudNavLink>
                    <MudNavLink Href="bestiario"><span aria-hidden="true">🐺</span> Bestiário do GM</MudNavLink>
                    <MudNavLink Href="banco-de-magias"><span aria-hidden="true">📜</span> Banco de Magias e Habilidades</MudNavLink>
                    <MudNavLink Href="campanhas"><span aria-hidden="true">🗺️</span> Campanhas</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Jogador" Context="jogadorContext">
                <Authorized>
                    <MudNavLink Href="minhas-campanhas"><span aria-hidden="true">🗺️</span> Minhas Campanhas</MudNavLink>
                </Authorized>
            </AuthorizeView>
            <MudNavLink Href="compendio"><span aria-hidden="true">📖</span> Compêndio de Regras</MudNavLink>
            <MudNavLink OnClick="LogoutAsync"><span aria-hidden="true">🚪</span> Sair</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [Parameter] public EventCallback OnLinkClicked { get; set; }

    private Task NotifyLinkClicked() => OnLinkClicked.InvokeAsync();

    private async Task LogoutAsync()
    {
        var refreshToken = await AuthState.GetRefreshTokenAsync();
        if (refreshToken is not null)
            await Http.PostAsJsonAsync("auth/logout", new RuinaRPG.Contracts.Auth.RefreshRequest(refreshToken));

        await AuthState.ClearAsync();
        AuthProvider.NotifyUserChanged();
        Navigation.NavigateTo("/");
        await NotifyLinkClicked();
    }
}
