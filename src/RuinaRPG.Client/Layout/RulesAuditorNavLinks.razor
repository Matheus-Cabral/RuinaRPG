@using MudBlazor
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Auth

@if (_isRulesAuditor)
{
    <MudNavGroup Title="Auditoria" @bind-Expanded="_expanded" Icon="@Icons.Material.Filled.FactCheck" IconColor="Color.Primary">
        <MudNavLink Href="auditoria/livro-de-regras" Icon="@Icons.Material.Filled.MenuBook" IconColor="Color.Primary">Livro de Regras</MudNavLink>
        <MudNavLink Href="auditoria/caracteristicas" Icon="@Icons.Material.Filled.Psychology" IconColor="Color.Primary">Características</MudNavLink>
        <MudNavLink Href="auditoria/caracteristicas-de-criatura" Icon="@Icons.Material.Filled.Pets" IconColor="Color.Primary">Características de Criatura</MudNavLink>
        <MudNavLink Href="auditoria/efeitos" Icon="@Icons.Material.Filled.Bolt" IconColor="Color.Primary">Efeitos</MudNavLink>
        <MudNavLink Href="auditoria/historicos" Icon="@Icons.Material.Filled.History" IconColor="Color.Primary">Históricos</MudNavLink>
        <MudNavLink Href="auditoria/equipagem" Icon="@Icons.Material.Filled.Shield" IconColor="Color.Primary">Equipagem</MudNavLink>
    </MudNavGroup>
}

@code {
    private bool _isRulesAuditor;
    private bool _expanded;

    protected override async Task OnInitializedAsync()
    {
        _expanded = IsUnderAuditoria(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;

        var response = await Http.GetAsync("auth/me");
        if (!response.IsSuccessStatusCode)
            return;

        var me = await response.Content.ReadFromJsonAsync<MeResponse>();
        _isRulesAuditor = me?.IsRulesAuditor ?? false;
    }

    // RulesAuditorNavLinks is rendered unconditionally inside NavMenu, which lives in
    // MainLayout's drawer for the whole authenticated session — it never gets torn down and
    // re-created between page navigations, so the auto-expand state has to be kept in sync here
    // rather than computed once in OnInitializedAsync.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _expanded = IsUnderAuditoria(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private static bool IsUnderAuditoria(string uri) =>
        new Uri(uri).AbsolutePath.TrimStart('/').StartsWith("auditoria/", StringComparison.Ordinal);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
