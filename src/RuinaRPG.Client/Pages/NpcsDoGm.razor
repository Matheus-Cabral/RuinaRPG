@page "/npcs"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.NpcSheets
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">NPCs do GM</MudText>

<Section Title="Filtros">
    <MudGrid Class="mt-3">
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_nomeFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Nome" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_linhagemFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Linhagem" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_varianteFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Variante" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_vocacaoFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Vocação" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_subVocacaoFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Classe" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudNumericField T="int?" @bind-Value="_nivelFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Nível" />
        </MudItem>
    </MudGrid>
</Section>

<Section Title="NPC's">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="CreateAsync">Novo NPC</MudButton>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
    }

    <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Linhagem</th>
                <th>Vocação</th>
                <th>Classe</th>
                <th>Nível</th>
                <th>Dono</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var npc in _npcs)
            {
                <tr>
                    <td>
                        @if (npc.ImageUrl is not null)
                        {
                            <ClickableAvatarImage Src="@npc.ImageUrl" Size="Size.Small" Class="mr-2" />
                        }
                        <MudLink Href="@($"npcs/{npc.Id}")">@npc.Nome</MudLink>
                    </td>
                    <td>@npc.Linhagem</td>
                    <td>@npc.Vocacao</td>
                    <td>@(npc.SubVocacao ?? "—")</td>
                    <td>@npc.Nivel</td>
                    <td>@(npc.OwnerNickname ?? "—")</td>
                    <td>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/npcs/{npc.Id}"))">Editar</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAsync(npc.Id))">Excluir</MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</Section>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("NPCs do GM"),
    };

    private string _nomeFiltro = "";
    private string _linhagemFiltro = "";
    private string _varianteFiltro = "";
    private string _vocacaoFiltro = "";
    private string _subVocacaoFiltro = "";
    private int? _nivelFiltro;
    private List<NpcSheetSummaryResponse> _npcs = new();
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedLoadAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(_nomeFiltro))
            query.Add($"nome={Uri.EscapeDataString(_nomeFiltro)}");
        if (!string.IsNullOrWhiteSpace(_linhagemFiltro))
            query.Add($"linhagem={Uri.EscapeDataString(_linhagemFiltro)}");
        if (!string.IsNullOrWhiteSpace(_varianteFiltro))
            query.Add($"variante={Uri.EscapeDataString(_varianteFiltro)}");
        if (!string.IsNullOrWhiteSpace(_vocacaoFiltro))
            query.Add($"vocacao={Uri.EscapeDataString(_vocacaoFiltro)}");
        if (!string.IsNullOrWhiteSpace(_subVocacaoFiltro))
            query.Add($"subVocacao={Uri.EscapeDataString(_subVocacaoFiltro)}");
        if (_nivelFiltro is not null)
            query.Add($"nivel={_nivelFiltro}");

        var queryString = query.Count > 0 ? $"?{string.Join("&", query)}" : "";
        var response = await Http.GetAsync($"npc-sheets{queryString}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar os NPCs.";
            return;
        }

        _npcs = await response.Content.ReadFromJsonAsync<List<NpcSheetSummaryResponse>>() ?? new();
        _errorMessage = null;
    }

    private async Task CreateAsync()
    {
        var response = await Http.PostAsync("npc-sheets", null);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível criar o NPC.";
            return;
        }

        var npc = await response.Content.ReadFromJsonAsync<NpcSheetResponse>();
        Navigation.NavigateTo($"/npcs/{npc!.Id}");
    }

    private async Task DeleteAsync(string id)
    {
        var response = await Http.DeleteAsync($"npc-sheets/{id}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir o NPC.";
            return;
        }

        await LoadAsync();
    }
}
