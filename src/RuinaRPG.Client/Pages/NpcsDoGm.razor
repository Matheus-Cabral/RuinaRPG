@page "/npcs"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.NpcSheets

<Breadcrumbs Items="@Crumbs" />

<h1>NPCs do GM</h1>

<button @onclick="CreateAsync">Novo NPC</button>

<div>
    <label>Nome <input @bind="_nomeFiltro" @bind:event="oninput" @bind:after="DebouncedLoadAsync" /></label>
    <label>Linhagem <input @bind="_linhagemFiltro" @bind:event="oninput" @bind:after="DebouncedLoadAsync" /></label>
    <label>Variante <input @bind="_varianteFiltro" @bind:event="oninput" @bind:after="DebouncedLoadAsync" /></label>
    <label>Vocação <input @bind="_vocacaoFiltro" @bind:event="oninput" @bind:after="DebouncedLoadAsync" /></label>
    <label>Sub-Vocação <input @bind="_subVocacaoFiltro" @bind:event="oninput" @bind:after="DebouncedLoadAsync" /></label>
    <label>Nível <input type="number" @bind="_nivelFiltro" @bind:event="oninput" @bind:after="DebouncedLoadAsync" /></label>
</div>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<table>
    <thead>
        <tr>
            <th>Nome</th>
            <th>Linhagem</th>
            <th>Vocação</th>
            <th>Sub-Vocação</th>
            <th>Nível</th>
            <th>Dono</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var npc in _npcs)
        {
            <tr>
                <td><a href="@($"npcs/{npc.Id}")">@npc.Nome</a></td>
                <td>@npc.Linhagem</td>
                <td>@npc.Vocacao</td>
                <td>@(npc.SubVocacao ?? "—")</td>
                <td>@npc.Nivel</td>
                <td>@(npc.OwnerNickname ?? "—")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("NPCs do GM"),
    };

    private string _nomeFiltro = "";
    private string _linhagemFiltro = "";
    private string _varianteFiltro = "";
    private string _vocacaoFiltro = "";
    private string _subVocacaoFiltro = "";
    private int? _nivelFiltro;
    private List<NpcSheetSummaryResponse> _npcs = new();
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedLoadAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(_nomeFiltro))
            query.Add($"nome={Uri.EscapeDataString(_nomeFiltro)}");
        if (!string.IsNullOrWhiteSpace(_linhagemFiltro))
            query.Add($"linhagem={Uri.EscapeDataString(_linhagemFiltro)}");
        if (!string.IsNullOrWhiteSpace(_varianteFiltro))
            query.Add($"variante={Uri.EscapeDataString(_varianteFiltro)}");
        if (!string.IsNullOrWhiteSpace(_vocacaoFiltro))
            query.Add($"vocacao={Uri.EscapeDataString(_vocacaoFiltro)}");
        if (!string.IsNullOrWhiteSpace(_subVocacaoFiltro))
            query.Add($"subVocacao={Uri.EscapeDataString(_subVocacaoFiltro)}");
        if (_nivelFiltro is not null)
            query.Add($"nivel={_nivelFiltro}");

        var queryString = query.Count > 0 ? $"?{string.Join("&", query)}" : "";
        var response = await Http.GetAsync($"npc-sheets{queryString}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar os NPCs.";
            return;
        }

        _npcs = await response.Content.ReadFromJsonAsync<List<NpcSheetSummaryResponse>>() ?? new();
        _errorMessage = null;
    }

    private async Task CreateAsync()
    {
        var response = await Http.PostAsync("npc-sheets", null);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível criar o NPC.";
            return;
        }

        var npc = await response.Content.ReadFromJsonAsync<NpcSheetResponse>();
        Navigation.NavigateTo($"/npcs/{npc!.Id}");
    }
}
