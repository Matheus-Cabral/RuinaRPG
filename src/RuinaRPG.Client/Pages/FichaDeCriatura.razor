    private async Task<List<PickerOption>> SearchItemsByTipoAsync(string query, string tipo)
    {
        var response = await Http.GetAsync($"items?nome={Uri.EscapeDataString(query)}&tipo={tipo}");
        if (!response.IsSuccessStatusCode) return new();
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        return items.Select(i => new PickerOption(i.Id, i.Nome)).ToList();
    }

    // Espólios has no Tipo restriction server-side (AddSpoil accepts any catalog Item) — unlike
    // Inventário/Weapon/Armor/Artefato, which are each scoped to a single Tipo.
    private async Task<List<PickerOption>> SearchAllItemsAsync(string query)
    {
        var response = await Http.GetAsync($"items?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        return items.Select(i => new PickerOption(i.Id, i.Nome)).ToList();
    }

    private async Task<List<PickerOption>> SearchTraitsAsync(string query)
    {
        var response = await Http.GetAsync($"traits?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var traits = await response.Content.ReadFromJsonAsync<List<TraitResponse>>() ?? new();
        return traits.Select(t => new PickerOption(t.Id, $"{t.Nome} ({t.Custo}, {t.Polaridade})")).ToList();
    }

    protected override Task OnInitializedAsync() => Task.WhenAll(
        LoadSheetAsync(), LoadTabs2And3Async(),
        LoadSpellAbilitiesAsync(), LoadMasteriesAsync(),
        LoadSpoilsAsync(), LoadArtifactsAsync(), LoadAffectionsAsync(), LoadTraitsAsync());

    private async Task LoadSheetAsync()
    {
        var response = await Http.GetAsync($"creature-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar a ficha.";
            return;
        }

        var sheet = await response.Content.ReadFromJsonAsync<CreatureSheetResponse>();
        _form.Nome = sheet!.Nome;
        _form.Raca = sheet.Raca;
        _form.Arquetipo = sheet.Arquetipo;
        _form.SubArquetipo = sheet.SubArquetipo;
        _form.Afinidade = sheet.Afinidade;
        _form.Rank = sheet.Rank;
        _form.Nivel = sheet.Nivel;
        _form.ExperienciaAtual = sheet.ExperienciaAtual;
        _form.Kill = sheet.Kill;
        _form.Assistencia = sheet.Assistencia;
        _form.PontosDeIgnicao = sheet.PontosDeIgnicao;
        _form.VitalidadeAtual = sheet.VitalidadeAtual;
        _form.FocoAtual = sheet.FocoAtual;
        _form.AdrenalinaAtual = sheet.AdrenalinaAtual;
        _form.Cobertura = sheet.Cobertura;
        _form.VitalidadeMaximo = sheet.VitalidadeMaximo;
        _form.FocoMaximo = sheet.FocoMaximo;
        _form.AdrenalinaMaximo = sheet.AdrenalinaMaximo;
        _errorMessage = null;
    }

    private async Task SaveAsync()
    {
        if (_form.Nivel is null || _form.ExperienciaAtual is null || _form.PontosDeIgnicao is null
            || _form.VitalidadeAtual is null || _form.FocoAtual is null || _form.AdrenalinaAtual is null)
        {
            _errorMessage = "Preencha todos os campos obrigatórios da aba Informações Básicas antes de salvar.";
            return;
        }

        var request = new UpdateCreatureSheetRequest(null, _form.Nome, _form.Raca, _form.Arquetipo, _form.SubArquetipo,
            _form.Afinidade, _form.Rank, _form.Nivel!.Value, _form.ExperienciaAtual!.Value, _form.PontosDeIgnicao!.Value,
            _form.VitalidadeAtual!.Value, _form.FocoAtual!.Value, _form.AdrenalinaAtual!.Value, _form.Cobertura);

        var response = await Http.PutAsJsonAsync($"creature-sheets/{SheetId}", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar a ficha.";
            return;
        }

        await LoadSheetAsync();
    }

    private async Task UpdateCoberturaAsync(string? value)
    {
        _form.Cobertura = value ?? "Nenhuma";
        await SaveAsync();
        await LoadTabs2And3Async(); // Cobertura feeds Defesa Natural, loaded here, not by LoadSheetAsync.
    }

    private async Task LoadTabs2And3Async()
    {
        _attributes = await Http.GetFromJsonAsync<List<CreatureAttributeResponse>>($"creature-sheets/{SheetId}/attributes") ?? new();
        _skills = await Http.GetFromJsonAsync<List<CreatureSkillResponse>>($"creature-sheets/{SheetId}/skills") ?? new();
        _weapons = await Http.GetFromJsonAsync<List<CreatureWeaponResponse>>($"creature-sheets/{SheetId}/weapons") ?? new();
        _armorSlots = await Http.GetFromJsonAsync<List<CreatureArmorSlotResponse>>($"creature-sheets/{SheetId}/armor-slots") ?? new();
        _shields = await Http.GetFromJsonAsync<List<CreatureShieldResponse>>($"creature-sheets/{SheetId}/shields") ?? new();
        _subAttributes = await Http.GetFromJsonAsync<SubAttributesResponse>($"creature-sheets/{SheetId}/sub-attributes");
    }

    private async Task UpdateAttributeAsync(string atributo, string field, object? value)
    {
        var current = _attributes.Single(a => a.Atributo == atributo);
        var gasto = field == "Gasto" ? (int.TryParse(value?.ToString(), out var g) ? g : current.Gasto) : current.Gasto;
        var bonus = field == "Bonus" ? (int.TryParse(value?.ToString(), out var b) ? b : current.Bonus) : current.Bonus;
        var temMaestria = field == "TemMaestria" ? (bool)(value ?? false) : current.TemMaestria;

        await Http.PutAsJsonAsync($"creature-sheets/{SheetId}/attributes/{atributo}", new UpdateCreatureAttributeRequest(gasto, bonus, temMaestria));
        await LoadTabs2And3Async();
    }

    private async Task UpdateSkillGastoAsync(string pericia, object? value)
    {
        var current = _skills.Single(s => s.Pericia == pericia);
        var gasto = int.TryParse(value?.ToString(), out var g) ? g : current.Gasto;
        await Http.PutAsJsonAsync($"creature-sheets/{SheetId}/skills/{pericia}", new UpdateCreatureSkillRequest(gasto, current.AtributoEscolhido));
        await LoadTabs2And3Async();
    }

    private async Task UpdateSkillAtributoAsync(string pericia, object? value)
    {
        var current = _skills.Single(s => s.Pericia == pericia);
        var atributoEscolhido = value?.ToString();
        await Http.PutAsJsonAsync($"creature-sheets/{SheetId}/skills/{pericia}", new UpdateCreatureSkillRequest(current.Gasto, string.IsNullOrEmpty(atributoEscolhido) ? null : atributoEscolhido));
        await LoadTabs2And3Async();
    }

    private async Task AddWeaponAsync()
    {
        var request = _weaponForm.Origem == "Catalogo"
            ? new AddCreatureWeaponRequest(_weaponForm.ItemId, null, null, null, null)
            : new AddCreatureWeaponRequest(null, _weaponForm.ManualNome, _weaponForm.ManualTipoDeDano, _weaponForm.ManualDados, _weaponForm.ManualDano);

        var response = await Http.PostAsJsonAsync($"creature-sheets/{SheetId}/weapons", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a arma.";
            return;
        }

        _weaponForm.ItemId = "";
        _weaponForm.ManualNome = "";
        _weaponForm.ManualTipoDeDano = "";
        _weaponForm.ManualDados = "";
        _weaponForm.ManualDano = 0;
        await LoadTabs2And3Async();
    }

