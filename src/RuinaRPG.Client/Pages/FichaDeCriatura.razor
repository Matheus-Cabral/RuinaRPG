    private void AddSpellAbilityEffect() => _spellAbilityForm.Efeitos.Add(new SpellAbilityEffectFormModel());

    private async Task AddSpellAbilityAsync()
    {
        var request = _spellAbilityForm.Origem == "Banco"
            ? new AddCreatureSpellAbilityRequest(_spellAbilityForm.SourceBankEntryId, null, null, null, null, null)
            : new AddCreatureSpellAbilityRequest(null, _spellAbilityForm.Nome, _spellAbilityForm.Tipo, _spellAbilityForm.Grau, _spellAbilityForm.Descricao,
                _spellAbilityForm.Efeitos.Select(e => new SpellAbilityEffectRequest(e.EfeitoNome, e.Quantidade, e.CustoPI)).ToList());

        var response = await Http.PostAsJsonAsync($"creature-sheets/{SheetId}/spell-abilities", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a magia/habilidade.";
            return;
        }

        _spellAbilityForm.SourceBankEntryId = "";
        _spellAbilityForm.Nome = "";
        _spellAbilityForm.Tipo = "Magia";
        _spellAbilityForm.Grau = 0;
        _spellAbilityForm.Descricao = "";
        _spellAbilityForm.Efeitos.Clear();
        await LoadSpellAbilitiesAsync();
    }

