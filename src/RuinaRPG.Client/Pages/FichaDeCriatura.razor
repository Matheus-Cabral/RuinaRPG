@page "/criaturas/{SheetId}"
@inherits PaginaDeFicha<CreatureSheetResponse>
@using RuinaRPG.Contracts.CreatureSheets
@using RuinaRPG.Client.Shared.Ficha
@using MudBlazor

<MolduraDaFicha Estado="Estado" Recarga="Recarga" Trilha="@Trilha" Concedida="Concedida">
<MudTabs>
    <MudTabPanel Text="Informações Básicas">
        <AbaInformacoesBasicas Formulario="_form" AutoSave="AutoSave" AoMudar="NotifySavedAsync" AoMudarNivel="NotifyNivelChangedAsync"
                               AoMudarExperiencia="NotifyExperienciaAtualChangedAsync" AoMudarPontosDeIgnicao="NotifyPontosDeIgnicaoChangedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Atributos & Perícias">
        <AbaAtributosEPericias Formulario="_form" />
    </MudTabPanel>

    <MudTabPanel Text="Combate">
        <AbaCombate Formulario="_form" AutoSave="AutoSave" AoMudar="NotifySavedAsync" SalvarERecarregar="SalvarERecarregarAbasAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Magias & Habilidades">
        <AbaMagiasEHabilidades />
    </MudTabPanel>

    <MudTabPanel Text="Posses">
        <AbaPosses />
    </MudTabPanel>
</MudTabs>
</MolduraDaFicha>

@code {
    // A Criatura sempre tem Abate e Assistência (0 antes da carga, como sempre mostrou).
    private readonly FormularioDaFicha _form = new(TipoDeFichaCliente.Criatura) { Abate = 0, Assistencia = 0 };
    protected override FormularioDaFicha Formulario => _form;

    protected override (string? CampaignId, string? CampaignName, string? OwnerId) OrigemDa(CreatureSheetResponse sheet) =>
        (sheet.CampaignId, sheet.CampaignName, sheet.OwnerId);

    protected override int PontosDeIgnicaoDa(CreatureSheetResponse sheet) => sheet.PontosDeIgnicao;

    protected override void PreencherFormulario(CreatureSheetResponse sheet)
    {
        _form.ImageUrl = sheet.ImageUrl;
        _form.ImageId = sheet.ImageId;
        _form.Nome = sheet.Nome;
        _form.Raca = sheet.Raca;
        _form.Arquetipo = sheet.Arquetipo;
        _form.SubArquetipo = sheet.SubArquetipo;
        _form.Afinidade = sheet.Afinidade;
        _form.Rank = sheet.Rank;
        _form.Nivel = sheet.Nivel;
        _form.ExperienciaAtual = sheet.ExperienciaAtual;
        _form.Abate = sheet.Abate;
        _form.Assistencia = sheet.Assistencia;
        _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicao;
        _form.VitalidadeAtual = sheet.VitalidadeAtual;
        _form.FocoAtual = sheet.FocoAtual;
        _form.AdrenalinaAtual = sheet.AdrenalinaAtual;
        _form.GuardarAtuaisCarregados();
        _form.Cobertura = sheet.Cobertura;
        _form.VitalidadeMaximo = sheet.VitalidadeMaximo;
        _form.FocoMaximo = sheet.FocoMaximo;
        _form.AdrenalinaMaximo = sheet.AdrenalinaMaximo;
    }

    protected override async Task<bool> SaveIfValidAsync()
    {
        if (_form.Nivel is null || _form.ExperienciaAtual is null || _form.PontosDeIgnicaoAtual is null
            || _form.VitalidadeAtual is null || _form.FocoAtual is null || _form.AdrenalinaAtual is null)
        {
            Estado.Erro = "Preencha todos os campos obrigatórios da aba Informações Básicas antes de salvar.";
            return false;
        }

        var request = new UpdateCreatureSheetRequest(_form.ImageId, _form.Nome, _form.Raca, _form.Arquetipo, _form.SubArquetipo,
            _form.Afinidade, _form.Rank, _form.Nivel!.Value, _form.ExperienciaAtual!.Value, _form.PontosDeIgnicaoAtual!.Value,
            _form.VitalidadeAtual!.Value, _form.FocoAtual!.Value, _form.AdrenalinaAtual!.Value, _form.Cobertura,
            _form.VitalidadeAtualCarregada, _form.FocoAtualCarregado, _form.AdrenalinaAtualCarregada);


        return await SalvarFichaAsync(request);
    }
}
