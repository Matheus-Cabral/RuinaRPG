@page "/criaturas/{SheetId}"
@inject HttpClient Http
@using RuinaRPG.Contracts.CreatureSheets
@using RuinaRPG.Contracts.SpellsAndAbilities
@using RuinaRPG.Contracts.CharacterSheets

<Breadcrumbs Items="@Crumbs" />

<h1>Ficha de Criatura</h1>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<TabControl>
    <TabPage Title="Informações Básicas">
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Nome</label>
                    <InputText class="form-control" @bind-Value="_form.Nome" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Raça</label>
                    <InputText class="form-control" @bind-Value="_form.Raca" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Arquétipo</label>
                    <select class="form-select" @bind="_form.Arquetipo">
                        <option value="">Escolha um Arquétipo</option>
                        <option value="Fisico">Físico</option>
                        <option value="Arcano">Arcano</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sub Arquétipo</label>
                    <InputText class="form-control" @bind-Value="_form.SubArquetipo" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Afinidade</label>
                    <select class="form-select" @bind="_form.Afinidade">
                        <option value="">Escolha uma Afinidade</option>
                        <option value="Terra">Terra</option>
                        <option value="Agua">Água</option>
                        <option value="Fogo">Fogo</option>
                        <option value="Ar">Ar</option>
                        <option value="Gelo">Gelo</option>
                        <option value="Flora">Flora</option>
                        <option value="Ferro">Ferro</option>
                        <option value="Raio">Raio</option>
                        <option value="Prever">Prever</option>
                        <option value="Alma">Alma</option>
                        <option value="Purificar">Purificar</option>
                        <option value="Ecomancia">Ecomancia</option>
                        <option value="Hemomancia">Hemomancia</option>
                        <option value="Curar">Curar</option>
                        <option value="Vida">Vida</option>
                        <option value="Aprimorar">Aprimorar</option>
                        <option value="Necromancia">Necromancia</option>
                        <option value="Invocacao">Invocação</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Rank</label>
                    <select class="form-select" @bind="_form.Rank">
                        <option value="">Escolha um Rank</option>
                        <option value="F">F</option>
                        <option value="E">E</option>
                        <option value="D">D</option>
                        <option value="C">C</option>
                        <option value="B">B</option>
                        <option value="A">A</option>
                        <option value="S">S</option>
                    </select>
                </div>
            </div>

            <h3>Nível e Progressão</h3>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Nível</label>
                    <InputNumber class="form-control" @bind-Value="_form.Nivel" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Experiência Atual</label>
                    <InputNumber class="form-control" @bind-Value="_form.ExperienciaAtual" />
                </div>
                <div class="col-md-2 pt-4">
                    <p class="mb-0">Kill: @_form.Kill</p>
                </div>
                <div class="col-md-2 pt-4">
                    <p class="mb-0">Assistência: @_form.Assistencia</p>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Pontos de Ignição</label>
                    <InputNumber class="form-control" @bind-Value="_form.PontosDeIgnicao" />
                </div>
            </div>

            <h3>Recursos</h3>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Adrenalina (PA)</label>
                    <div class="input-group">
                        <InputNumber class="form-control" @bind-Value="_form.AdrenalinaAtual" />
                        <span class="input-group-text">/ @_form.AdrenalinaMaximo</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Arcana (PF)</label>
                    <div class="input-group">
                        <InputNumber class="form-control" @bind-Value="_form.FocoAtual" />
                        <span class="input-group-text">/ @_form.FocoMaximo</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Vitalidade</label>
                    <div class="input-group">
                        <InputNumber class="form-control" @bind-Value="_form.VitalidadeAtual" />
                        <span class="input-group-text">/ @_form.VitalidadeMaximo</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary mt-3">Salvar</button>
        </EditForm>
    </TabPage>

    <TabPage Title="Atributos & Perícias">
        <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Atributo</th><th>Gasto</th><th>Bônus</th><th>Maestria</th><th>Total</th></tr></thead>
            <tbody>
                @foreach (var attr in _attributes)
                {
                    <tr>
                        <td>@attr.Atributo</td>
                        <td><input type="number" value="@attr.Gasto" @onchange="@(e => UpdateAttributeAsync(attr.Atributo, "Gasto", e.Value))" /></td>
                        <td><input type="number" value="@attr.Bonus" @onchange="@(e => UpdateAttributeAsync(attr.Atributo, "Bonus", e.Value))" /></td>
                        <td><input type="checkbox" checked="@attr.TemMaestria" @onchange="@(e => UpdateAttributeAsync(attr.Atributo, "TemMaestria", e.Value))" /></td>
                        <td>@attr.Total</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Perícia</th><th>Gasto</th><th>Modificador</th></tr></thead>
            <tbody>
                @foreach (var skill in _skills)
                {
                    <tr>
                        <td>@skill.Pericia</td>
                        <td><input type="number" value="@skill.Gasto" @onchange="@(e => UpdateSkillAsync(skill.Pericia, e.Value))" /></td>
                        <td>@skill.Modificador</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </TabPage>

    <TabPage Title="Combate">
        <h3>Armas</h3>
        <EditForm Model="_weaponForm" OnValidSubmit="AddWeaponAsync">
            <div class="mb-3">
                <label class="form-label">Origem</label>
                <select class="form-select" @bind="_weaponForm.Origem">
                    <option value="Catalogo">Vincular ao Catálogo</option>
                    <option value="Manual">Preencher manualmente (ataque natural)</option>
                </select>
            </div>

            @if (_weaponForm.Origem == "Catalogo")
            {
                <div class="mb-3">
                    <label class="form-label">Arma (Id do Catálogo)</label>
                    <InputText class="form-control" @bind-Value="_weaponForm.ItemId" />
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <InputText class="form-control" @bind-Value="_weaponForm.ManualNome" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Tipo de Dano</label>
                    <select class="form-select" @bind="_weaponForm.ManualTipoDeDano">
                        <option value="">Escolha um Tipo de Dano</option>
                        <option value="Cortante">Cortante</option>
                        <option value="Perfurante">Perfurante</option>
                        <option value="Contundente">Contundente</option>
                        <option value="Magico">Mágico</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Dados</label>
                    <InputText class="form-control" @bind-Value="_weaponForm.ManualDados" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Dano</label>
                    <InputNumber class="form-control" @bind-Value="_weaponForm.ManualDano" />
                </div>
            }

            <button type="submit" class="btn btn-primary">Adicionar Arma</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var weapon in _weapons)
            {
                <li>
                    @weapon.Nome@(weapon.TipoDeDano is not null ? $" ({weapon.TipoDeDano})" : "")
                    —
                    @if (weapon.ItemId is not null)
                    {
                        <text>Durabilidade <input type="number" value="@weapon.DurabilidadeAtual" @onchange="@(e => UpdateWeaponDurabilidadeAsync(weapon.Id, e.Value))" style="width:4em" />/@weapon.DurabilidadeMaximo</text>
                    }
                    else
                    {
                        <text>Ataque natural</text>
                    }
                    — @(weapon.IsEquipped ? "Equipada" : "")
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => EquipWeaponAsync(weapon.Id, !weapon.IsEquipped))">@(weapon.IsEquipped ? "Desequipar" : "Equipar")</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteWeaponAsync(weapon.Id))">Remover</button>
                </li>
            }
        </ul>

        <h3>Armaduras</h3>
        <ul class="list-unstyled">
            @foreach (var slot in _armorSlots)
            {
                <li>
                    @slot.Slot: @(slot.Nome ?? "—") @(slot.DurabilidadeAtual is not null ? $"({slot.DurabilidadeAtual}/{slot.DurabilidadeMaximo})" : "")
                    @if (slot.ItemId is not null)
                    {
                        <input type="number" value="@slot.DurabilidadeAtual" @onchange="@(e => UpdateArmorSlotDurabilidadeAsync(slot.Slot, e.Value))" style="width:4em" />
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => AssignArmorSlotAsync(slot.Slot, null))">Remover</button>
                    }
                    else
                    {
                        <input type="text" placeholder="Id do Catálogo" @bind="_armorSlotForm[slot.Slot]" style="width:14em" />
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => AssignArmorSlotAsync(slot.Slot, _armorSlotForm.GetValueOrDefault(slot.Slot)))">Atribuir</button>
                    }
                </li>
            }
        </ul>

        <h3>Escudos</h3>
        <EditForm Model="_shieldForm" OnValidSubmit="AddShieldAsync">
            <div class="mb-3">
                <label class="form-label">Escudo (Id do Catálogo)</label>
                <InputText class="form-control" @bind-Value="_shieldForm.ItemId" />
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Escudo</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var shield in _shields)
            {
                <li>@shield.Nome —
                    Durabilidade <input type="number" value="@shield.DurabilidadeAtual" @onchange="@(e => UpdateShieldDurabilidadeAsync(shield.Id, e.Value))" style="width:4em" />/@shield.DurabilidadeMaxima
                    — @(shield.IsEquipped ? "Equipado" : "")
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => EquipShieldAsync(shield.Id, !shield.IsEquipped))">@(shield.IsEquipped ? "Desequipar" : "Equipar")</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteShieldAsync(shield.Id))">Remover</button>
                </li>
            }
        </ul>

        @if (_subAttributes is not null)
        {
            <h3>Sub-Atributos</h3>
            <p>Iniciativa: @_subAttributes.Iniciativa</p>
            <p>Movimentação: @_subAttributes.Movimentacao</p>
            <p>Esquiva Natural: @_subAttributes.EsquivaNatural</p>
            <p>Defesa Natural: @_subAttributes.DefesaNatural</p>
            <p>Redução Física: @_subAttributes.ReducaoFisica</p>
            <p>Redução Mágica: @_subAttributes.ReducaoMagica</p>
        }
    </TabPage>

    <TabPage Title="Magias & Habilidades">
        <Section Title="Magias e Habilidades">
        <EditForm Model="_spellAbilityForm" OnValidSubmit="AddSpellAbilityAsync">
            <div class="mb-3">
                <label class="form-label">Origem</label>
                <select class="form-select" @bind="_spellAbilityForm.Origem">
                    <option value="Zero">Montar do zero</option>
                    <option value="Banco">Escolher do Banco de Magias</option>
                </select>
            </div>

            @if (_spellAbilityForm.Origem == "Banco")
            {
                <div class="mb-3">
                    <label class="form-label">Entrada do Banco</label>
                    <select class="form-select" @bind="_spellAbilityForm.SourceBankEntryId">
                        <option value="">Escolha uma entrada</option>
                        @foreach (var entry in _bankEntries)
                        {
                            <option value="@entry.Id">@entry.Nome (@entry.Tipo, Grau @entry.Grau)</option>
                        }
                    </select>
                </div>
            }
            else
            {
            <div class="mb-3">
                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="_spellAbilityForm.Nome" />
            </div>
            <div class="mb-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" @bind="_spellAbilityForm.Tipo">
                    <option value="Magia">Magia</option>
                    <option value="Habilidade">Habilidade</option>
                    <option value="Racial">Racial</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Grau</label>
                <InputNumber class="form-control" @bind-Value="_spellAbilityForm.Grau" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descrição</label>
                <InputTextArea class="form-control" @bind-Value="_spellAbilityForm.Descricao" />
            </div>

            <h4>Efeitos</h4>
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddSpellAbilityEffect">Adicionar Efeito</button>
            @for (var i = 0; i < _spellAbilityForm.Efeitos.Count; i++)
            {
                var index = i; // capture for the closures below
                <div class="row g-3 align-items-end mb-3 mt-1">
                    <div class="col-md-4">
                        <label class="form-label">Nome do Efeito</label>
                        <InputText class="form-control" @bind-Value="_spellAbilityForm.Efeitos[index].EfeitoNome" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Quantidade</label>
                        <InputNumber class="form-control" @bind-Value="_spellAbilityForm.Efeitos[index].Quantidade" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Custo em PI</label>
                        <InputNumber class="form-control" @bind-Value="_spellAbilityForm.Efeitos[index].CustoPI" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => _spellAbilityForm.Efeitos.RemoveAt(index))">Remover</button>
                    </div>
                </div>
            }
            }

            <button type="submit" class="btn btn-primary mt-3">Adicionar Magia/Habilidade</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var spellAbility in _spellAbilities)
            {
                <li>
                    @spellAbility.Nome (@spellAbility.Tipo, Grau @spellAbility.Grau) — Gasto em PI @spellAbility.GastoEmPI, Custo @spellAbility.Custo — @spellAbility.Descricao
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteSpellAbilityAsync(spellAbility.Id))">Remover</button>
                </li>
            }
        </ul>
        </Section>

        <Section Title="Maestrias">
        <EditForm Model="_masteryForm" OnValidSubmit="AddMasteryAsync">
            <div class="mb-3">
                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="_masteryForm.Nome" />
            </div>
            <div class="mb-3">
                <label class="form-label">Perícia</label>
                <select class="form-select" @bind="_masteryForm.Pericia">
                    <option value="">Escolha uma Perícia</option>
                    @foreach (var skill in _skills)
                    {
                        <option value="@skill.Pericia">@skill.Pericia</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Atributo</label>
                <select class="form-select" @bind="_masteryForm.Atributo">
                    <option value="">Escolha um Atributo</option>
                    @foreach (var attr in _attributes)
                    {
                        <option value="@attr.Atributo">@attr.Atributo</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Gasto Maestria</label>
                <InputNumber class="form-control" @bind-Value="_masteryForm.GastoMaestria" />
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Maestria</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var mastery in _masteries)
            {
                <li>@mastery.Nome — @mastery.Pericia / @mastery.Atributo — Gasto @mastery.GastoMaestria — Total @mastery.Total <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteMasteryAsync(mastery.Id))">Remover</button></li>
            }
        </ul>
        </Section>
    </TabPage>

    <TabPage Title="Posses">
        <Section Title="Espólios">
        <EditForm Model="_spoilForm" OnValidSubmit="AddSpoilAsync">
            <div class="mb-3">
                <label class="form-label">Item (Id do Catálogo)</label>
                <InputText class="form-control" @bind-Value="_spoilForm.ItemId" />
            </div>
            <div class="mb-3">
                <label class="form-label">Quantidade</label>
                <InputNumber class="form-control" @bind-Value="_spoilForm.Qtd" />
            </div>
            <div class="mb-3">
                <label class="form-label">DT</label>
                <InputNumber class="form-control" @bind-Value="_spoilForm.DT" />
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Espólio</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var spoil in _spoils)
            {
                <li>@spoil.Nome — Custo @spoil.Custo — Qtd @spoil.Qtd — Total @spoil.CustoTotal — DT @spoil.DT <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteSpoilAsync(spoil.Id))">Remover</button></li>
            }
        </ul>
        </Section>

        <Section Title="Artefatos">
        <EditForm Model="_artifactForm" OnValidSubmit="AddArtifactAsync">
            <div class="mb-3">
                <label class="form-label">Artefato (Id do Catálogo)</label>
                <InputText class="form-control" @bind-Value="_artifactForm.ArtifactItemId" />
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Artefato</button>
        </EditForm>
        @foreach (var group in _artifacts.GroupBy(a => a.TipoDeAlvo))
        {
            <h4>@group.Key</h4>
            <ul class="list-unstyled">
                @foreach (var artifact in group)
                {
                    <li>@artifact.Nome — Alvo @artifact.Alvo — Valor @artifact.Valor <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteArtifactAsync(artifact.Id))">Remover</button></li>
                }
            </ul>
        }
        </Section>

        <Section Title="Afeições">
        <EditForm Model="_affectionForm" OnValidSubmit="AddAffectionAsync">
            <div class="mb-3">
                <label class="form-label">Nome</label>
                <InputText class="form-control" @bind-Value="_affectionForm.Nome" />
            </div>
            <div class="mb-3">
                <label class="form-label">Favorabilidade</label>
                <InputNumber class="form-control" @bind-Value="_affectionForm.Favorabilidade" />
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Afeição</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var affection in _affections)
            {
                <li>@affection.Nome — Favorabilidade @affection.Favorabilidade <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteAffectionAsync(affection.Id))">Remover</button></li>
            }
        </ul>
        </Section>

        <Section Title="Características">
        <EditForm Model="_traitForm" OnValidSubmit="AddTraitAsync">
            <div class="mb-3">
                <label class="form-label">Característica (Id)</label>
                <InputText class="form-control" @bind-Value="_traitForm.TraitId" />
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Característica</button>
        </EditForm>
        <h4>Positivas (Total: @(_traits?.TotalPositivas ?? 0))</h4>
        <ul class="list-unstyled">
            @foreach (var trait in _traits?.Positivas ?? new())
            {
                <li>@trait.Nome (@trait.Custo) — @trait.Descricao <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteTraitAsync(trait.Id))">Remover</button></li>
            }
        </ul>
        <h4>Negativas (Total: @(_traits?.TotalNegativas ?? 0))</h4>
        <ul class="list-unstyled">
            @foreach (var trait in _traits?.Negativas ?? new())
            {
                <li>@trait.Nome (@trait.Custo) — @trait.Descricao <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteTraitAsync(trait.Id))">Remover</button></li>
            }
        </ul>
        </Section>
    </TabPage>
</TabControl>

@code {
    [Parameter] public string SheetId { get; set; } = "";

    private List<BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Bestiário do GM", "bestiario"),
        new(string.IsNullOrWhiteSpace(_form.Nome) ? "Ficha de Criatura" : _form.Nome),
    };

    private readonly SheetFormModel _form = new();
    private string? _errorMessage;
    private List<CreatureAttributeResponse> _attributes = new();
    private List<CreatureSkillResponse> _skills = new();
    private List<CreatureWeaponResponse> _weapons = new();
    private readonly WeaponFormModel _weaponForm = new();
    private List<CreatureArmorSlotResponse> _armorSlots = new();
    private List<CreatureShieldResponse> _shields = new();
    private readonly ShieldFormModel _shieldForm = new();
    // Pre-seeded with the 3 fixed ArmorSlotType values so @bind's getter never sees a missing key.
    private readonly Dictionary<string, string> _armorSlotForm = new() { ["Capacete"] = "", ["Superior"] = "", ["Inferior"] = "" };
    private SubAttributesResponse? _subAttributes;
    private List<CreatureSpellAbilityResponse> _spellAbilities = new();
    private List<SpellAbilityEntryResponse> _bankEntries = new();
    private readonly SpellAbilityFormModel _spellAbilityForm = new();
    private List<CreatureMasteryResponse> _masteries = new();
    private readonly MasteryFormModel _masteryForm = new();
    private List<CreatureSpoilResponse> _spoils = new();
    private readonly SpoilFormModel _spoilForm = new();
    private List<CreatureArtifactResponse> _artifacts = new();
    private readonly ArtifactFormModel _artifactForm = new();
    private List<CreatureAffectionResponse> _affections = new();
    private readonly AffectionFormModel _affectionForm = new();
    private CreatureTraitsListResponse? _traits;
    private readonly TraitFormModel _traitForm = new();

    protected override Task OnInitializedAsync() => Task.WhenAll(
        LoadSheetAsync(), LoadTabs2And3Async(),
        LoadSpellAbilitiesAsync(), LoadMasteriesAsync(),
        LoadSpoilsAsync(), LoadArtifactsAsync(), LoadAffectionsAsync(), LoadTraitsAsync());

    private async Task LoadSheetAsync()
    {
        var response = await Http.GetAsync($"creature-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar a ficha.";
            return;
        }

        var sheet = await response.Content.ReadFromJsonAsync<CreatureSheetResponse>();
        _form.Nome = sheet!.Nome;
        _form.Raca = sheet.Raca;
        _form.Arquetipo = sheet.Arquetipo;
