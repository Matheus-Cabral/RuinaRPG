        _skills = await Http.GetFromJsonAsync<List<CreatureSkillResponse>>($"creature-sheets/{SheetId}/skills") ?? new();
        _weapons = await Http.GetFromJsonAsync<List<CreatureWeaponResponse>>($"creature-sheets/{SheetId}/weapons") ?? new();
        _armorSlots = await Http.GetFromJsonAsync<List<CreatureArmorSlotResponse>>($"creature-sheets/{SheetId}/armor-slots") ?? new();
        _shields = await Http.GetFromJsonAsync<List<CreatureShieldResponse>>($"creature-sheets/{SheetId}/shields") ?? new();
        _subAttributes = await Http.GetFromJsonAsync<SubAttributesResponse>($"creature-sheets/{SheetId}/sub-attributes");
    }

    private async Task UpdateAttributeAsync(string atributo, string field, object? value)
    {
        var current = _attributes.Single(a => a.Atributo == atributo);
        var gasto = field == "Gasto" ? (int.TryParse(value?.ToString(), out var g) ? g : current.Gasto) : current.Gasto;
        var bonus = field == "Bonus" ? (int.TryParse(value?.ToString(), out var b) ? b : current.Bonus) : current.Bonus;
        var temMaestria = field == "TemMaestria" ? (bool)(value ?? false) : current.TemMaestria;

        await Http.PutAsJsonAsync($"creature-sheets/{SheetId}/attributes/{atributo}", new UpdateCreatureAttributeRequest(gasto, bonus, temMaestria));
        await LoadTabs2And3Async();
    }

    private async Task UpdateSkillAsync(string pericia, object? value)
    {
        var current = _skills.Single(s => s.Pericia == pericia);
        var gasto = int.TryParse(value?.ToString(), out var g) ? g : current.Gasto;
        await Http.PutAsJsonAsync($"creature-sheets/{SheetId}/skills/{pericia}", new UpdateCreatureSkillRequest(gasto, null));
        await LoadTabs2And3Async();
    }

