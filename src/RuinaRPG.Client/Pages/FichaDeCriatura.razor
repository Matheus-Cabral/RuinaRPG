    /// <summary>
    /// A API mexe no saldo de PI ao adicionar, editar e remover uma Magia/Habilidade (4.b), e é ela quem
    /// guarda o valor: o formulário só o exibe. Relê o saldo depois de cada operação que o altera. Se a
    /// releitura falhar, o campo fica como está — a operação em si já deu certo.
    /// </summary>
    private async Task RecarregarPontosDeIgnicaoAsync()
    {
        var response = await Http.GetAsync($"creature-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
            return;

        var sheet = await response.Content.ReadFromJsonAsync<CreatureSheetResponse>();
        if (sheet is not null)
            _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicao;
    }

    private async Task LoadMasteriesAsync()
    {
        _masteries = await Http.GetFromJsonAsync<List<MasteryResponse>>($"creature-sheets/{SheetId}/masteries") ?? new();
    }

    private async Task AddMasteryAsync()
    {
        var request = new AddMasteryRequest(_masteryForm.Nome, _masteryForm.Pericia, _masteryForm.Atributo, _masteryForm.GastoMaestria);
        var response = await Http.PostAsJsonAsync($"creature-sheets/{SheetId}/masteries", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a maestria.";
            return;
        }

        _masteryForm.Nome = "";
        _masteryForm.GastoMaestria = 0;
        await LoadMasteriesAsync();
    }

    private async Task DeleteMasteryAsync(string id)
    {
        await Http.DeleteAsync($"creature-sheets/{SheetId}/masteries/{id}");
        await LoadMasteriesAsync();
    }

