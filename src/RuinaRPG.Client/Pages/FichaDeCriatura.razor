    {
        await Http.PutAsJsonAsync($"creature-sheets/{SheetId}/armor-slots/{slot}", new UpdateArmorSlotRequest(string.IsNullOrWhiteSpace(itemId) ? null : itemId));
        _armorSlotForm[slot] = "";
        await _estado.CarregarAtributosECombateAsync();
