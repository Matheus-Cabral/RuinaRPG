@page "/auditoria/equipagem"
@inject HttpClient Http
@inject IDialogService Dialogs
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Domain.Items
@using MudBlazor
@using RuinaRPG.Client.Shared

<Breadcrumbs Items="@Crumbs" />
<MudText Typo="Typo.h3">Auditoria: Equipagem</MudText>

<DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

@if (_forbidden)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-3">Você não é o Auditor de Regras designado — sem permissão para editar.</MudAlert>
}
else
{
    <Section Title="Construtor de Subcategoria">
        <TitleInfo>
            <InfoPopup Title="Como funciona o Construtor">
                Aqui você mantém, para cada Tipo (Arma, Armadura, Escudo, Artefato), as listas de <b>Categorias</b> e <b>Famílias</b>. No Catálogo de Itens, quando o GM marca "Item Inicial", ele escolhe uma Categoria e uma Família dessas listas. A Subcategoria do item vira então <code>Equipamento inicial - {Tipo} - {Categoria} - {Família}</code>. Os slots de escolha dos kits usam as <b>Famílias</b> para decidir quais itens o jogador pode escolher. Os valores não podem conter " - " nem vírgula. Remover um valor não altera os itens que já o usam.
            </InfoPopup>
        </TitleInfo>
        <ChildContent>
        <MudSelect T="string" @bind-Value="_subcatTipo" Label="Tipo" @bind-Value:after="LoadSubcategoriaOptionsAsync">
            <MudSelectItem Value="@("Arma")">Arma</MudSelectItem>
            <MudSelectItem Value="@("Armadura")">Armadura</MudSelectItem>
            <MudSelectItem Value="@("Escudo")">Escudo</MudSelectItem>
            <MudSelectItem Value="@("Artefato")">Artefato</MudSelectItem>
        </MudSelect>

        <MudText Typo="Typo.h6" Class="mt-3">Categorias</MudText>
        <MudSimpleTable Dense="true">
            <tbody>
                @foreach (var opt in _categoriaOptions)
                {
                    <tr><td>@opt.Valor</td><td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteSubcategoriaOptionAsync(opt))" /></td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <div class="d-flex" style="gap:8px">
            <MudTextField T="string" @bind-Value="_newCategoriaValor" Label="Nova Categoria" />
            <MudButton Variant="Variant.Outlined" OnClick="@(() => AddSubcategoriaOptionAsync("Categoria", _newCategoriaValor))">Adicionar</MudButton>
        </div>

        <MudText Typo="Typo.h6" Class="mt-3">Famílias</MudText>
        <MudSimpleTable Dense="true">
            <tbody>
                @foreach (var opt in _familiaOptions)
                {
                    <tr><td>@opt.Valor</td><td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteSubcategoriaOptionAsync(opt))" /></td></tr>
                }
            </tbody>
        </MudSimpleTable>
        <div class="d-flex" style="gap:8px">
            <MudTextField T="string" @bind-Value="_newFamiliaValor" Label="Nova Família" />
            <MudButton Variant="Variant.Outlined" OnClick="@(() => AddSubcategoriaOptionAsync("Familia", _newFamiliaValor))">Adicionar</MudButton>
        </div>
        </ChildContent>
    </Section>

    <Section Title="Adicionar Kit">
        <MudTextField T="string" @bind-Value="_newForm.Nome" Label="Nome" />
        <MudTextField T="string" @bind-Value="_newForm.Descricao" Label="Descrição" Lines="3" />
        <MudNumericField T="int" @bind-Value="_newForm.Ciclos" Label="Ciclos" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AddAsync">Adicionar</MudButton>
    </Section>

    <Section Title="Kits">
        <TitleInfo>
            <InfoPopup Title="Como montar um Kit">
                <MudText>
                    Um kit é o equipamento inicial que o jogador escolhe uma única vez na aba Posses da ficha. Os <b>Ciclos</b> são somados ao dinheiro da ficha.
                </MudText>
                <ul class="mt-1">
                    <li><b>Itens fixos:</b> todo mundo que escolhe o kit recebe esses itens. Eles vêm da base de itens fixos, igual para todas as campanhas: pesquise pelo nome ou cadastre um novo. Ao aplicar o kit, o item que o GM ainda não tem é copiado completo para o catálogo dele.</li>
                    <li><b>Slots de escolha:</b> o jogador escolhe um item. Defina o Tipo e as Famílias permitidas; vazio significa qualquer uma. Para Arma, defina também o Rank. Para Armadura, defina em qual posição (Capacete, Superior ou Inferior) ela será equipada, substituindo o que estiver lá.</li>
                </ul>
                <MudText Class="mt-2">
                    Excluir um kit já escolhido em alguma ficha é bloqueado.
                </MudText>
            </InfoPopup>
        </TitleInfo>
        <ChildContent>
        @foreach (var kit in _kits)
        {
            <MudExpansionPanel Text="@kit.Nome">
                <MudTextField T="string" Value="@kit.Nome" ValueChanged="@(v => UpdateAsync(kit, nome: v))" Label="Nome" />
                <MudTextField T="string" Value="@kit.Descricao" ValueChanged="@(v => UpdateAsync(kit, descricao: v))" Label="Descrição" Lines="3" />
                <MudNumericField T="int" Value="@kit.Ciclos" ValueChanged="@(v => UpdateAsync(kit, ciclos: v))" Label="Ciclos" />

                <MudText Typo="Typo.h6" Class="mt-3">Itens fixos</MudText>
                <MudSimpleTable Dense="true">
                    <thead><tr><th>Nome</th><th>Tipo</th><th>Qtd</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in kit.Items)
                        {
                            <tr>
                                <td>
                                    @item.Nome
                                    @if (item.DetalhesIncompletos)
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">Detalhes incompletos</MudChip>
                                    }
                                </td>
                                <td>@item.Tipo@(item.ArmorSlot is null ? "" : $" ({item.ArmorSlot})")</td>
                                <td>
                                    <MudNumericField T="int" Value="@item.Qtd" ValueChanged="@(v => UpdateItemAsync(kit, item, v))" Label="Qtd do item" Min="1" Style="max-width:90px" />
                                </td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Editar item fixo" OnClick="@(() => EditarLinhaAsync(kit, item))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Remover item do kit" OnClick="@(() => RemoveItemAsync(kit, item))" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <div class="d-flex" style="gap:8px; align-items:flex-start">
                    <FixedItemPicker TiposPermitidos="@TodosOsTipos" @bind-Tipo="_itemForm[kit.Id].Tipo" @bind-Value="_itemForm[kit.Id].Escolhido" />
                    <MudNumericField T="int" @bind-Value="_itemForm[kit.Id].Qtd" Label="Quantidade do item" Min="1" Style="max-width:120px" />
                    @if (_itemForm[kit.Id].Escolhido?.Tipo == "Armadura")
                    {
                        <MudSelect T="string" @bind-Value="_itemForm[kit.Id].ArmorSlot" Label="Slot de Armadura" Style="max-width:180px">
                            <MudSelectItem Value="@("Capacete")">Capacete</MudSelectItem>
                            <MudSelectItem Value="@("Superior")">Superior</MudSelectItem>
                            <MudSelectItem Value="@("Inferior")">Inferior</MudSelectItem>
                        </MudSelect>
                    }
                    <MudButton Variant="Variant.Outlined" Class="mt-3" Disabled="@(!PodeAdicionarItem(kit.Id))" OnClick="@(() => AddItemAsync(kit))">Adicionar item</MudButton>
                </div>

                <MudText Typo="Typo.h6" Class="mt-3">Slots de escolha</MudText>
                <MudSimpleTable Dense="true">
                    <thead><tr><th>Label</th><th>Tipo</th><th>Subcategorias</th><th>Rank</th><th>Qtd</th><th>Bônus</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var slot in kit.ChoiceSlots)
                        {
                            <tr>
                                <td>@slot.Label</td><td>@slot.Tipo@(slot.ArmorSlot is null ? "" : $" ({slot.ArmorSlot})")</td><td>@(slot.Subcategorias is null ? "qualquer" : string.Join(", ", slot.Subcategorias))</td><td>@(slot.Rank ?? "qualquer")</td><td>@slot.Qtd</td><td>@(slot.BonusNome is null ? "" : $"{slot.BonusQtd}x {slot.BonusNome} ({slot.BonusSubcategoria})")</td>
                                <td><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => RemoveSlotAsync(kit, slot))" /></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <div class="d-flex" style="gap:8px">
                    <MudTextField T="string" @bind-Value="_slotForm[kit.Id].Label" Label="Label" />
                    <MudSelect T="string" @bind-Value="_slotForm[kit.Id].Tipo" Label="Tipo" @bind-Value:after="@(() => OnSlotTipoChangedAsync(kit.Id))">
                        <MudSelectItem Value="@("Arma")">Arma</MudSelectItem>
                        <MudSelectItem Value="@("Armadura")">Armadura</MudSelectItem>
                        <MudSelectItem Value="@("Escudo")">Escudo</MudSelectItem>
                        <MudSelectItem Value="@("Artefato")">Artefato</MudSelectItem>
                    </MudSelect>
                    @if (_slotForm[kit.Id].Tipo == "Armadura")
                    {
                        <MudSelect T="string" @bind-Value="_slotForm[kit.Id].ArmorSlot" Label="Slot de Armadura">
                            <MudSelectItem Value="@("Capacete")">Capacete</MudSelectItem>
                            <MudSelectItem Value="@("Superior")">Superior</MudSelectItem>
                            <MudSelectItem Value="@("Inferior")">Inferior</MudSelectItem>
                        </MudSelect>
                    }
                    <MudSelect T="string" MultiSelection="true" Label="Famílias (vazio = qualquer)"
                               SelectedValues="_slotForm[kit.Id].SubcategoriasSelected"
                               SelectedValuesChanged="@(v => _slotForm[kit.Id].SubcategoriasSelected = v.ToList())">
                        @foreach (var opt in GetSlotFamiliaOptions(kit.Id))
                        {
                            <MudSelectItem T="string" Value="@opt.Valor">@opt.Valor</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_slotForm[kit.Id].Tipo == "Arma")
                    {
                        <MudSelect T="string" @bind-Value="_slotForm[kit.Id].Rank" Label="Rank (vazio = qualquer)">
                            <MudSelectItem Value="@("")">Qualquer</MudSelectItem>
                            @foreach (var rank in RankOptions)
                            {
                                <MudSelectItem Value="@rank">@rank</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudNumericField T="int" @bind-Value="_slotForm[kit.Id].Qtd" Label="Qtd" />
                    <FixedItemPicker TiposPermitidos="@SoItemGeral" Tipo="ItemGeral" @bind-Value="_slotForm[kit.Id].BonusItem" RotuloTipo="Tipo do bônus" RotuloItem="Item do bônus" />
                    <MudTextField T="string" @bind-Value="_slotForm[kit.Id].BonusSubcategoria" Label="Subcategoria do bônus" />
                    <MudNumericField T="int" @bind-Value="_slotForm[kit.Id].BonusQtd" Label="Qtd do bônus" Min="1" />
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => AddSlotAsync(kit))">Adicionar slot</MudButton>
                </div>

                <MudButton Variant="Variant.Outlined" Color="Color.Error" Class="mt-3" OnClick="@(() => DeleteAsync(kit.Id))">Excluir Kit</MudButton>
            </MudExpansionPanel>
        }
        </ChildContent>
    </Section>

    <Section Title="Itens fixos">
        <MudText Typo="Typo.body2">A base de itens fixos é a mesma para todas as campanhas. Editar um item vale para todos os kits que o usam.</MudText>
        <div class="d-flex" style="gap:8px; align-items:flex-start">
            <MudSelect T="string" Value="@_baseTipo" ValueChanged="OnBaseTipoChangedAsync" Label="Filtrar por Tipo" Style="max-width:200px">
                <MudSelectItem Value="@("")">Todos</MudSelectItem>
                <MudSelectItem Value="@("ItemGeral")">Item Geral</MudSelectItem>
                <MudSelectItem Value="@("Arma")">Arma</MudSelectItem>
                <MudSelectItem Value="@("Armadura")">Armadura</MudSelectItem>
                <MudSelectItem Value="@("Escudo")">Escudo</MudSelectItem>
                <MudSelectItem Value="@("Artefato")">Artefato</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" Value="@_baseBusca" ValueChanged="OnBaseBuscaChangedAsync" Label="Buscar por nome" Immediate="true" DebounceInterval="300" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" StartIcon="@Icons.Material.Filled.Add" OnClick="NovoItemFixoAsync">Novo item fixo</MudButton>
        </div>
        <MudSimpleTable Dense="true" Class="mt-2">
            <thead><tr><th>Nome</th><th>Tipo</th><th>Kits</th><th></th></tr></thead>
            <tbody>
                @foreach (var fixo in _base)
                {
                    <tr>
                        <td>
                            @fixo.Nome
                            @if (fixo.DetalhesIncompletos)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">Detalhes incompletos</MudChip>
                            }
                        </td>
                        <td>@fixo.Tipo</td>
                        <td>@(fixo.Kits.Count == 0 ? "-" : string.Join(", ", fixo.Kits))</td>
                        <td>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Editar item da base" OnClick="@(() => EditarItemFixoAsync(fixo))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Excluir item fixo" OnClick="@(() => ExcluirItemFixoAsync(fixo))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </Section>
}

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Auditoria: Equipagem"),
    };

    private List<EquipmentKitResponse> _kits = new();
    private string? _errorMessage;
    private bool _forbidden;
    private readonly NewKitFormModel _newForm = new();
    private readonly Dictionary<string, NewSlotFormModel> _slotForm = new();
    private readonly Dictionary<string, NewItemFormModel> _itemForm = new();
    private static readonly string[] TodosOsTipos = ["ItemGeral", "Arma", "Armadura", "Escudo", "Artefato"];
    private static readonly string[] SoItemGeral = ["ItemGeral"];
    private List<EquipmentKitFixedItemResponse> _base = new();
    private string _baseTipo = "";
    private string _baseBusca = "";
    private readonly Dictionary<string, List<SubcategoriaOptionResponse>> _slotFamiliaOptions = new();

    private string _subcatTipo = "Arma";
    private List<SubcategoriaOptionResponse> _categoriaOptions = new();
    private List<SubcategoriaOptionResponse> _familiaOptions = new();
    private string _newCategoriaValor = "";
    private string _newFamiliaValor = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadSubcategoriaOptionsAsync();
        await LoadBaseAsync();
    }

    private async Task LoadAsync()
    {
        var response = await Http.GetAsync("equipment-kits");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar os kits de Equipagem.";
            return;
        }

        _kits = await response.Content.ReadFromJsonAsync<List<EquipmentKitResponse>>() ?? new();
        foreach (var kit in _kits)
        {
            _itemForm.TryAdd(kit.Id, new NewItemFormModel());
            if (_slotForm.TryAdd(kit.Id, new NewSlotFormModel()))
                await LoadSlotFamiliaOptionsAsync(kit.Id, _slotForm[kit.Id].Tipo);
        }
    }

    private async Task LoadSubcategoriaOptionsAsync()
    {
        var categoriaResponse = await Http.GetAsync($"subcategoria-options?tipo={_subcatTipo}&facet=Categoria");
        if (categoriaResponse.IsSuccessStatusCode)
            _categoriaOptions = await categoriaResponse.Content.ReadFromJsonAsync<List<SubcategoriaOptionResponse>>() ?? new();

        var familiaResponse = await Http.GetAsync($"subcategoria-options?tipo={_subcatTipo}&facet=Familia");
        if (familiaResponse.IsSuccessStatusCode)
            _familiaOptions = await familiaResponse.Content.ReadFromJsonAsync<List<SubcategoriaOptionResponse>>() ?? new();
    }

    private async Task AddSubcategoriaOptionAsync(string facet, string valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return;

        var response = await Http.PostAsJsonAsync("subcategoria-options", new CreateSubcategoriaOptionRequest(_subcatTipo, facet, valor));
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();
            _errorMessage = string.IsNullOrWhiteSpace(detail) ? "Não foi possível adicionar o valor." : detail;
            return;
        }

        _newCategoriaValor = "";
        _newFamiliaValor = "";
        await LoadSubcategoriaOptionsAsync();
    }

    private async Task DeleteSubcategoriaOptionAsync(SubcategoriaOptionResponse option)
    {
        var response = await Http.DeleteAsync($"subcategoria-options/{option.Id}");
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível remover o valor.";
            return;
        }

        await LoadSubcategoriaOptionsAsync();
    }

    private async Task LoadSlotFamiliaOptionsAsync(string kitId, string tipo)
    {
        var response = await Http.GetAsync($"subcategoria-options?tipo={tipo}&facet=Familia");
        if (response.IsSuccessStatusCode)
            _slotFamiliaOptions[kitId] = await response.Content.ReadFromJsonAsync<List<SubcategoriaOptionResponse>>() ?? new();
    }

    private async Task OnSlotTipoChangedAsync(string kitId)
    {
        _slotForm[kitId].SubcategoriasSelected = new List<string>();
        await LoadSlotFamiliaOptionsAsync(kitId, _slotForm[kitId].Tipo);
    }

    private List<SubcategoriaOptionResponse> GetSlotFamiliaOptions(string kitId) =>
        _slotFamiliaOptions.TryGetValue(kitId, out var options) ? options : new();

    private async Task AddAsync()
    {
        var response = await Http.PostAsJsonAsync("equipment-kits", new CreateEquipmentKitRequest(_newForm.Nome, _newForm.Descricao, _newForm.Ciclos, new(), new()));
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();
            _errorMessage = string.IsNullOrWhiteSpace(detail) ? "Não foi possível adicionar o kit." : detail;
            return;
        }

        _newForm.Nome = "";
        _newForm.Descricao = "";
        _newForm.Ciclos = 0;
        await LoadAsync();
    }

    private static EquipmentKitItemInput ParaInput(EquipmentKitItemResponse i) => new(i.FixedItemId, i.Qtd, i.ArmorSlot);

    private static EquipmentKitChoiceSlotInput ParaInput(EquipmentKitChoiceSlotResponse s) =>
        new(s.Label, s.Tipo, s.Subcategorias, s.Rank, s.Qtd, s.BonusSubcategoria, s.BonusFixedItemId, s.BonusQtd, s.ArmorSlot);

    /// <summary>
    /// Único ponto de escrita de um kit: o PUT substitui o kit inteiro (não há endpoint por linha).
    /// Mostra a mensagem do servidor quando há; um kit que ainda tem uma linha legada (sem item fixo)
    /// é recusado com um 400 que explica o motivo, e essa mensagem é mais útil que a genérica.
    /// </summary>
    private async Task<bool> SalvarKitAsync(EquipmentKitResponse kit, string nome, string descricao, int ciclos,
        List<EquipmentKitItemInput> itens, List<EquipmentKitChoiceSlotInput> slots, string mensagemPadrao)
    {
        var response = await Http.PutAsJsonAsync($"equipment-kits/{kit.Id}", new UpdateEquipmentKitRequest(nome, descricao, ciclos, itens, slots));
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return false;
        }
        if (!response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();
            _errorMessage = string.IsNullOrWhiteSpace(detail) ? mensagemPadrao : detail;
            return false;
        }

        await LoadAsync();
        return true;
    }

    private Task SalvarItensAsync(EquipmentKitResponse kit, List<EquipmentKitItemInput> itens) =>
        SalvarKitAsync(kit, kit.Nome, kit.Descricao, kit.Ciclos, itens, kit.ChoiceSlots.Select(ParaInput).ToList(), "Não foi possível salvar a alteração.");

    private Task UpdateAsync(EquipmentKitResponse current, string? nome = null, string? descricao = null, int? ciclos = null) =>
        SalvarKitAsync(current, nome ?? current.Nome, descricao ?? current.Descricao, ciclos ?? current.Ciclos,
            current.Items.Select(ParaInput).ToList(), current.ChoiceSlots.Select(ParaInput).ToList(), "Não foi possível salvar a alteração.");

    private bool PodeAdicionarItem(string kitId) =>
        _itemForm.TryGetValue(kitId, out var f) && f.Escolhido is not null && f.Qtd >= 1
        && (f.Escolhido.Tipo != "Armadura" || !string.IsNullOrEmpty(f.ArmorSlot));

    private async Task AddItemAsync(EquipmentKitResponse kit)
    {
        var form = _itemForm[kit.Id];
        var itens = kit.Items.Select(ParaInput)
            .Append(new EquipmentKitItemInput(form.Escolhido!.Id, form.Qtd, form.Escolhido.Tipo == "Armadura" ? form.ArmorSlot : null)).ToList();
        if (await SalvarKitAsync(kit, kit.Nome, kit.Descricao, kit.Ciclos, itens, kit.ChoiceSlots.Select(ParaInput).ToList(), "Não foi possível adicionar o item."))
            _itemForm[kit.Id] = new NewItemFormModel();
    }

    private Task UpdateItemAsync(EquipmentKitResponse kit, EquipmentKitItemResponse item, int qtd) =>
        SalvarItensAsync(kit, kit.Items.Select(i => i.Id == item.Id ? new EquipmentKitItemInput(i.FixedItemId, qtd, i.ArmorSlot) : ParaInput(i)).ToList());

    private Task RemoveItemAsync(EquipmentKitResponse kit, EquipmentKitItemResponse item) =>
        SalvarItensAsync(kit, kit.Items.Where(i => i.Id != item.Id).Select(ParaInput).ToList());

    private async Task EditarLinhaAsync(EquipmentKitResponse kit, EquipmentKitItemResponse item)
    {
        var dialog = await Dialogs.ShowAsync<EditarItemFixoDoKitDialog>("Editar item fixo",
            new DialogParameters<EditarItemFixoDoKitDialog> { { x => x.Linha, item } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is not { Canceled: false, Data: ItemFixoEditado editado })
            return;

        if (editado.DetalhesAlterados)
        {
            await LoadAsync();
            await LoadBaseAsync();
            return;
        }

        await SalvarItensAsync(kit, kit.Items.Select(i => i.Id == item.Id ? new EquipmentKitItemInput(editado.FixedItemId, i.Qtd, editado.ArmorSlot) : ParaInput(i)).ToList());
        await LoadBaseAsync();
    }

    private async Task AddSlotAsync(EquipmentKitResponse kit)
    {
        var form = _slotForm[kit.Id];
        var subcategorias = form.SubcategoriasSelected.Count == 0 ? null : form.SubcategoriasSelected.ToList();
        var temBonus = form.BonusItem is not null;
        var slots = kit.ChoiceSlots.Select(ParaInput)
            .Append(new EquipmentKitChoiceSlotInput(form.Label, form.Tipo, subcategorias,
                form.Tipo == "Arma" && !string.IsNullOrWhiteSpace(form.Rank) ? form.Rank : null, form.Qtd,
                temBonus ? form.BonusSubcategoria : null, temBonus ? form.BonusItem!.Id : null, temBonus ? form.BonusQtd : null,
                form.Tipo == "Armadura" ? form.ArmorSlot : null)).ToList();

        if (!await SalvarKitAsync(kit, kit.Nome, kit.Descricao, kit.Ciclos, kit.Items.Select(ParaInput).ToList(), slots, "Não foi possível adicionar o slot de escolha."))
            return;

        _slotForm[kit.Id] = new NewSlotFormModel();
        await LoadSlotFamiliaOptionsAsync(kit.Id, _slotForm[kit.Id].Tipo);
    }

    private Task RemoveSlotAsync(EquipmentKitResponse kit, EquipmentKitChoiceSlotResponse slot) =>
        SalvarKitAsync(kit, kit.Nome, kit.Descricao, kit.Ciclos, kit.Items.Select(ParaInput).ToList(),
            kit.ChoiceSlots.Where(s => s.Id != slot.Id).Select(ParaInput).ToList(), "Não foi possível remover o slot de escolha.");

    private async Task LoadBaseAsync()
    {
        var response = await Http.GetAsync($"equipment-kit-fixed-items?tipo={_baseTipo}&q={Uri.EscapeDataString(_baseBusca)}");
        if (!response.IsSuccessStatusCode)
        {
            _base = new();
            return;
        }

        _base = await response.Content.ReadFromJsonAsync<List<EquipmentKitFixedItemResponse>>() ?? new();
    }

    private async Task OnBaseTipoChangedAsync(string tipo)
    {
        _baseTipo = tipo;
        await LoadBaseAsync();
    }

    private async Task OnBaseBuscaChangedAsync(string? busca)
    {
        _baseBusca = busca ?? "";
        await LoadBaseAsync();
    }

    private async Task NovoItemFixoAsync()
    {
        var dialog = await Dialogs.ShowAsync<FixedItemDialog>("Novo item fixo",
            new DialogParameters<FixedItemDialog> { { x => x.Tipo, string.IsNullOrEmpty(_baseTipo) ? "ItemGeral" : _baseTipo }, { x => x.NomeInicial, "" } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false })
            await LoadBaseAsync();
    }

    private async Task EditarItemFixoAsync(EquipmentKitFixedItemResponse fixo)
    {
        var dialog = await Dialogs.ShowAsync<FixedItemDialog>("Editar item fixo",
            new DialogParameters<FixedItemDialog> { { x => x.Tipo, fixo.Tipo }, { x => x.Existente, fixo } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await dialog.Result) is { Canceled: false })
        {
            await LoadBaseAsync();
            await LoadAsync();
        }
    }

    private async Task ExcluirItemFixoAsync(EquipmentKitFixedItemResponse fixo)
    {
        var response = await Http.DeleteAsync($"equipment-kit-fixed-items/{fixo.Id}");
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            var detail = await response.Content.ReadAsStringAsync();
            _errorMessage = string.IsNullOrWhiteSpace(detail) ? "Não foi possível excluir o item fixo." : detail;
            return;
        }

        await LoadBaseAsync();
    }

    private async Task DeleteAsync(string id)
    {
        var response = await Http.DeleteAsync($"equipment-kits/{id}");
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return;
        }
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir — este kit pode estar em uso em alguma ficha.";
            return;
        }

        await LoadAsync();
    }

