    private async Task AddSpellAbilityAsync()
    {
        var efeitos = _spellAbilityForm.Efeitos.Select(e => new SpellAbilityEffectRequest(e.EfeitoNome, e.Quantidade, e.CustoPI)).ToList();
        var request = new AddCharacterSpellAbilityRequest(null, _spellAbilityForm.Nome, _spellAbilityForm.Tipo, _spellAbilityForm.Grau, _spellAbilityForm.Descricao, efeitos);
        var response = await Http.PostAsJsonAsync($"character-sheets/{SheetId}/spell-abilities", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a magia/habilidade.";
            return;
        }

        _spellAbilityForm.Nome = "";
        _spellAbilityForm.Tipo = "Magia";
        _spellAbilityForm.Grau = 0;
        _spellAbilityForm.Descricao = "";
        _spellAbilityForm.Efeitos.Clear();
        await LoadSpellAbilitiesAsync();
    }

