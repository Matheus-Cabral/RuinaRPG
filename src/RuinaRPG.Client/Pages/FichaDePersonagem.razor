    {
        _weapons = await Http.GetFromJsonAsync<List<WeaponResponse>>($"character-sheets/{SheetId}/weapons") ?? new();
        _armorSlots = await Http.GetFromJsonAsync<List<ArmorSlotResponse>>($"character-sheets/{SheetId}/armor-slots") ?? new();
        _shields = await Http.GetFromJsonAsync<List<ShieldResponse>>($"character-sheets/{SheetId}/shields") ?? new();
        _subAttributes = await Http.GetFromJsonAsync<SubAttributesResponse>($"character-sheets/{SheetId}/sub-attributes");
        _modificadorDeDano = await Http.GetFromJsonAsync<ModificadorDeDanoResponse>($"character-sheets/{SheetId}/modificador-de-dano");
    }

