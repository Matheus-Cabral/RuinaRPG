    {
        var request = new AddMasteryRequest(_masteryForm.Nome, _masteryForm.Pericia, _masteryForm.Atributo, _masteryForm.GastoMaestria);
        var response = await Http.PostAsJsonAsync($"character-sheets/{SheetId}/masteries", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a maestria.";
