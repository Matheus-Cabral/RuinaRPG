@page "/fichas/{SheetId}"
@inherits PaginaDeFicha<CharacterSheetResponse>
@using RuinaRPG.Contracts.Campaigns
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Client.Shared.Ficha
@using MudBlazor

<MolduraDaFicha Estado="Estado" Recarga="Recarga" Trilha="@Trilha">
<MudTabs>
    <MudTabPanel Text="Informações Básicas">
        <AbaInformacoesBasicas Formulario="_form" AutoSave="AutoSave" AoMudar="NotifySavedAsync" AoMudarExperiencia="NotifySavedAsync"
                               AoMudarPontosDeIgnicao="NotifyPontosDeIgnicaoChangedAsync" SalvarAgora="SaveIgnoringResultAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Atributos & Perícias">
        <AbaAtributosEPericias Formulario="_form" AoMudar="NotifySavedAsync" SalvarERecarregar="SalvarERecarregarAbasAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Combate">
        <AbaCombate Formulario="_form" AutoSave="AutoSave" AoMudar="NotifySavedAsync" SalvarAgora="SaveIgnoringResultAsync" SalvarERecarregar="SalvarERecarregarAbasAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Magias & Habilidades">
        <HabilidadeRacialSection Formulario="_form" SalvarAgora="SaveIgnoringResultAsync" />
        <AbaMagiasEHabilidades />
    </MudTabPanel>

    <MudTabPanel Text="Posses">
        <AbaPosses Formulario="_form" SalvarAgora="SaveIgnoringResultAsync" EquipagemEscolhida="OnEquipagemChosenAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Antecedentes">
        <AbaAntecedentes Formulario="_form" AoMudar="NotifySavedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Diário">
        <DiarioDaFicha />
    </MudTabPanel>
</MudTabs>
</MolduraDaFicha>

@code {
    // Antes da carga o VIS do Personagem mostra 0 (no NPC fica em branco), como sempre mostrou.
    private readonly FormularioDaFicha _form = new(TipoDeFichaCliente.Personagem) { EAPAtual = 0 };
    protected override FormularioDaFicha Formulario => _form;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Notifier.FichaNoCemiterioAlterada += OnFichaNoCemiterioAlterada;
        Estado.EntrouNoCemiterio += AgendarRecargaDoFormulario;
    }

    public override void Dispose()
    {
        Notifier.FichaNoCemiterioAlterada -= OnFichaNoCemiterioAlterada;
        Estado.EntrouNoCemiterio -= AgendarRecargaDoFormulario;
        _descartada = true;
        base.Dispose();
    }

    private bool _recargaDoFormularioAgendada;
    private bool _descartada;

    // A ficha entrou no cemitério, ou um salvamento foi recusado por isso: assim que o auto-save terminar (os salvamentos
    // pendentes também recebem a recusa), o formulário volta ao que o servidor tem. A mensagem do alerta fica.
    private void AgendarRecargaDoFormulario()
    {
        if (_recargaDoFormularioAgendada)
            return;
        _recargaDoFormularioAgendada = true;
        _ = RecarregarFormularioQuandoOciosoAsync();
    }

    private async Task RecarregarFormularioQuandoOciosoAsync()
    {
        try
        {
            while (AutoSave.Ocupado && !_descartada)
                await Task.Delay(50);
            if (_descartada)
                return;
            await InvokeAsync(async () =>
            {
                _recargaDoFormularioAgendada = false;
                var erro = Estado.Erro;
                // Já esperou o auto-save ficar ocioso; o que estiver em edição agora será recusado pelo cemitério.
                AplicarFicha(await LerFichaAsync());
                if (erro is not null)
                    Estado.Erro = erro;
                StateHasChanged();
            });
        }
        catch (Exception)
        {
            // Ninguém espera esta tarefa: se a página saiu ou a releitura falhou, o formulário fica como está.
        }
    }

    // O GM marcou ou desmarcou "Morto": a ficha aberta entra ou sai do modo leitura sem recarregar a página. Só o estado
    // do cemitério é relido: o alerta de erro (ex.: a recusa 409 de um auto-save pendente) continua à vista.
    private void OnFichaNoCemiterioAlterada(string sheetId)
    {
        if (sheetId != SheetId)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Estado.RecarregarCemiterioAsync();
            }
            catch (Exception)
            {
                Estado.Erro = "Não foi possível atualizar a ficha.";
            }
            StateHasChanged();
        });
    }

    protected override bool LimpaOErroAntesDeSalvar => true;

    /// <summary>
    /// A falha de um salvamento, para lançar. A recusa do cemitério (409: o GM marcou "Morto" com um salvamento pendente)
    /// também vai ao alerta da página, para não sumir em silêncio.
    /// </summary>
    protected override async Task<InvalidOperationException> FalhaAoSalvarAsync(HttpResponseMessage response)
    {
        var falha = await base.FalhaAoSalvarAsync(response);
        if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            Estado.Erro = falha.Message;
            AgendarRecargaDoFormulario();
        }
        return falha;
    }

    // O nome da campanha não vem com a ficha do Personagem. O jogador não lê a lista do GM: as campanhas dele vêm de
    // campaigns/mine.
    protected override async Task CarregarOQueEDaPaginaAsync()
    {
        if (Estado.CampaignId is null) return;
        var response = await Http.GetAsync(Estado.IsGmCaller ? "campaigns" : "campaigns/mine");
        if (!response.IsSuccessStatusCode) return;
        var campaigns = await response.Content.ReadFromJsonAsync<List<CampaignResponse>>() ?? new();
        Estado.CampaignName = campaigns.FirstOrDefault(c => c.Id == Estado.CampaignId)?.Nome;
    }

    protected override int PontosDeIgnicaoDa(CharacterSheetResponse sheet) => sheet.PontosDeIgnicaoAtual;

    protected override void PreencherFormulario(CharacterSheetResponse sheet)
    {
        Estado.CampaignId = sheet.CampaignId;
        Estado.DefinirCemiterio(sheet.NoCemiterio, sheet.MotivosDoCemiterio);
        _form.ImageUrl = sheet.ImageUrl;
        _form.ImageId = sheet.ImageId;
        _form.Nome = sheet.Nome;
        _form.Linhagem = sheet.Linhagem;
        _form.Variante = sheet.Variante;
        _form.Vocacao = sheet.Vocacao;
        _form.SubVocacao = sheet.SubVocacao;
        _form.Afinidade = sheet.Afinidade;
        _form.Propriedade = sheet.Propriedade;
        _form.Estrela = sheet.Estrela;
        _form.SinaAtual = sheet.SinaAtual;
        _form.HistoricoId = sheet.HistoricoId;
        if (!Estado.HistoriaCarregada)
        {
            _form.Historia = sheet.Historia;
            Estado.HistoriaCarregada = true;
        }
        _form.EquipmentKitId = sheet.EquipmentKitId;
        _form.Nivel = sheet.Nivel;
        _form.Graduacao = sheet.Graduacao;
        _form.GraduacaoLabel = sheet.GraduacaoLabel;
        _form.PossuiCoracaoDeMana = sheet.PossuiCoracaoDeMana;
        _form.AfinidadeAdicional = sheet.AfinidadeAdicional;
        _form.VocacaoArcanaMaxima = sheet.VocacaoArcanaMaxima;
        _form.ExperienciaAtual = sheet.ExperienciaAtual;
        _form.XpParaProximoNivel = sheet.XpParaProximoNivel;
        _form.EAPAtual = sheet.EAPAtual;
        _form.NucleosRankF = sheet.NucleosRankF;
        _form.NucleosRankE = sheet.NucleosRankE;
        _form.NucleosRankD = sheet.NucleosRankD;
        _form.NucleosRankC = sheet.NucleosRankC;
        _form.NucleosRankB = sheet.NucleosRankB;
        _form.NucleosRankA = sheet.NucleosRankA;
        _form.NucleosRankS = sheet.NucleosRankS;
        _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicaoAtual;
        _form.PontosDeIgnicaoBonusManual = sheet.PontosDeIgnicaoBonusManual;
        _form.PontosDePericiaBonusCritico = sheet.PontosDePericiaBonusCritico;
        _form.VitalidadeAtual = sheet.VitalidadeAtual;
        _form.FocoAtual = sheet.FocoAtual;
        _form.AdrenalinaAtual = sheet.AdrenalinaAtual;
        _form.EstresseAtual = sheet.EstresseAtual;
        _form.GuardarAtuaisCarregados();
        _form.Cobertura = sheet.Cobertura;
        _form.Ciclos = sheet.Ciclos;
        _form.ArcaRolada = sheet.ArcaRolada;
        _form.VitalidadeMaximo = sheet.VitalidadeMaximo;
        _form.FocoMaximo = sheet.FocoMaximo;
        _form.AdrenalinaMaximo = sheet.AdrenalinaMaximo;
        _form.EstresseMaximo = sheet.EstresseMaximo;
    }

    protected override async Task<bool> SaveIfValidAsync()
    {
        if (_form.ExperienciaAtual is null
            || _form.NucleosRankF is null || _form.NucleosRankE is null || _form.NucleosRankD is null
            || _form.NucleosRankC is null || _form.NucleosRankB is null || _form.NucleosRankA is null || _form.NucleosRankS is null
            || _form.PontosDeIgnicaoAtual is null
            || _form.VitalidadeAtual is null || _form.FocoAtual is null || _form.AdrenalinaAtual is null || _form.EstresseAtual is null)
        {
            Estado.Erro = "Preencha todos os campos obrigatórios da aba Informações Básicas antes de salvar.";
            return false;
        }

        var request = new UpdateCharacterSheetRequest(_form.ImageId, _form.Nome, _form.Linhagem, _form.Variante, _form.Vocacao, _form.SubVocacao,
            _form.Afinidade, _form.Propriedade, _form.PossuiCoracaoDeMana, _form.ExperienciaAtual!.Value, _form.EAPAtual ?? 0,
            _form.NucleosRankF!.Value, _form.NucleosRankE!.Value, _form.NucleosRankD!.Value, _form.NucleosRankC!.Value, _form.NucleosRankB!.Value, _form.NucleosRankA!.Value, _form.NucleosRankS!.Value,
            _form.PontosDeIgnicaoAtual!.Value, _form.PontosDeIgnicaoBonusManual, _form.VitalidadeAtual!.Value, _form.FocoAtual!.Value, _form.AdrenalinaAtual!.Value, _form.EstresseAtual!.Value,
            _form.Cobertura, _form.Ciclos, _form.PontosDePericiaBonusCritico, _form.ArcaRolada, _form.Estrela, _form.SinaAtual, _form.HistoricoId, null, _form.AfinidadeAdicional,
            _form.VitalidadeAtualCarregada, _form.FocoAtualCarregado, _form.AdrenalinaAtualCarregada, _form.EstresseAtualCarregado);


        return await SalvarFichaAsync(request);
    }
}
