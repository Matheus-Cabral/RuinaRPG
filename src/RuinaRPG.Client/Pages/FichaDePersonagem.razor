    protected override void OnInitialized()
    {
        _estado = new FichaEstado(Http, TipoDeFichaCliente.Personagem, SheetId);
        _estado.RecarregarPontosDeIgnicao = RecarregarPontosDeIgnicaoAsync;
        _estado.CarregarCombate = CarregarCombateAsync;
        _estado.Alterado += OnEstadoAlterado;
        _autoSave.StateChanged += StateHasChangedFromAutoSave;
        // Condições mudam no servidor (ação do GM no encontro): a ficha se recarrega sem salvar nada e sem
        // trocar o campo que está sendo editado (RecargaAdiada).
        _recarga = new RecargaAdiada(RecarregarPorCondicoesAsync, () => JS.InvokeAsync<bool>("ruinaFoco.campoEmEdicao").AsTask(), () => _autoSave.Ocupado,
            aoFalhar: falha => _ = AvisarFalhaDaRecargaAsync());
        Notifier.CondicoesAlteradas += OnCondicoesAlteradas;
    }

    // Erro de uma recarga adiada (RecargaAdiada nunca chama isto depois do Dispose). Ninguém espera esta tarefa, então
    // ela não pode falhar: se a página sair no meio-tempo, não há onde mostrar o erro.
    private async Task AvisarFalhaDaRecargaAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _errorMessage = "Não foi possível atualizar a ficha com as Condições.";
                StateHasChanged();
            });
        }
        catch (Exception)
        {
        }
    }

    private RecargaAdiada _recarga = null!;

    private void OnCondicoesAlteradas(CondicoesAlteradasNotification notificacao)
    {
        if (notificacao.Kind != "character" || notificacao.SheetId != SheetId)
            return;

        _ = InvokeAsync(async () =>
        {
            // O aviso e a lista de Passivas mudam já; a recarga da ficha espera se há um campo em edição.
            _condicoesVersao++;
            StateHasChanged();
            try
            {
                await _recarga.SolicitarAsync();
            }
            catch (Exception)
            {
                _errorMessage = "Não foi possível atualizar a ficha com as Condições.";
            }
            StateHasChanged();
        });
    }

    // Relê os números e as listas que as Condições mexem. Não passa por _autoSave: nada é gravado.
    private Task RecarregarPorCondicoesAsync() => InvokeAsync(async () =>
    {
        await LoadSheetAsync(); await _estado.CarregarAtributosECombateAsync(); await _estado.CarregarMagiasAsync(); await _estado.CarregarRunasAsync(); await _estado.CarregarArtefatosAsync();
        _penalidadesVersao++;
        StateHasChanged();
    });

    private void StateHasChangedFromAutoSave() => InvokeAsync(StateHasChanged);

    // Uma aba filha mudou o estado fora de um evento da página (ex.: Erro depois de um POST recusado).
    private void OnEstadoAlterado() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _estado.Alterado -= OnEstadoAlterado;
        _autoSave.StateChanged -= StateHasChangedFromAutoSave;
        Notifier.CondicoesAlteradas -= OnCondicoesAlteradas;
        _recarga.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await Pericias.CarregarAsync();
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _isGmCaller = authState.User.IsInRole("GM");

        // LoadSheetAsync sets _campaignId, which LoadImagesAsync now needs (a Jogador's image
        // list is scoped to that campaign). LoadSheetAsync also sets _form.ImageId directly from
        // the sheet's own ImageId, so it no longer needs to be resolved by matching _myImages.
        await LoadSheetAsync();
        await LoadImagesAsync();

        await Task.WhenAll(LoadLevelUpNoticeAsync(), _estado.CarregarAtributosECombateAsync(),
            _estado.CarregarHabilidadeRacialAsync(), _estado.CarregarVariantesLiberadasAsync(), _estado.CarregarMagiasAsync(), _estado.CarregarRunasAsync(), LoadMasteriesAsync(),
            _estado.CarregarInventarioAsync(), _estado.CarregarArtefatosAsync(), _estado.CarregarAfeicoesAsync(), _estado.CarregarCaracteristicasAsync(), LoadDiaryAsync(),
            LoadCampaignNameAsync(), LoadPendingRacialChoiceAsync());
    }

    private async Task LoadImagesAsync()
    {
        var url = _isGmCaller ? "images/mine" : $"campaigns/{_campaignId}/available-images";
        var response = await Http.GetAsync(url);
        if (response.IsSuccessStatusCode)
            _myImages = await response.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();
    }

