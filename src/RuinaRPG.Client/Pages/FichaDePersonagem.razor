        await LoadMasteriesAsync();
    }

    private async Task UpdateMasteryAsync(string id, string field, object? value)
    {
        var current = _masteries.Single(m => m.Id == id);
        var nome = field == "Nome" ? value?.ToString() ?? current.Nome : current.Nome;
        var pericia = field == "Pericia" ? value?.ToString() ?? current.Pericia : current.Pericia;
        var atributo = field == "Atributo" ? value?.ToString() ?? current.Atributo : current.Atributo;
        var gastoMaestria = field == "GastoMaestria" ? (int.TryParse(value?.ToString(), out var g) ? g : current.GastoMaestria) : current.GastoMaestria;

        var response = await Http.PutAsJsonAsync($"character-sheets/{SheetId}/masteries/{id}", new UpdateCharacterMasteryRequest(nome, pericia, atributo, gastoMaestria));
        _errorMessage = response.IsSuccessStatusCode ? null : await response.Content.ReadErrorMessageAsync();
        await LoadMasteriesAsync();
    }

    private async Task OnEquipagemChosenAsync()
    {
        await LoadSheetAsync();
        await Task.WhenAll(_estado.CarregarAtributosECombateAsync(), _estado.CarregarInventarioAsync(), _estado.CarregarArtefatosAsync());
        _penalidadesVersao++;
    }

    // Ruína RPG - Sistema Básico §7: every Variante grants a Característica Gratuita (a real
    // choice) and, for some, a Característica Obrigatória (0, 1 fixed, or a real choice too) — see
    // RacialTraitLookup/RacialTraitChoiceResolver. This dialog opens whenever the sheet's current
    // Variante still has that unresolved; closing without choosing just reopens next page load.
    private async Task LoadPendingRacialChoiceAsync()
    {
        _pendingRacialChoice = await Http.GetFromJsonAsync<PendingRacialTraitChoiceResponse>($"character-sheets/{SheetId}/racial-traits/pending");
        _racialChoiceDialogOpen = _pendingRacialChoice?.Pending == true;
        _racialGratuitaChoice = null;
        _racialObrigatoriaChoice = null;
        _racialGratuitaEspecificacao = null;
        _racialObrigatoriaEspecificacao = null;
    }

    private async Task ConfirmRacialChoiceAsync()
    {
        if (_racialGratuitaChoice is null)
            return;

        var response = await Http.PostAsJsonAsync($"character-sheets/{SheetId}/racial-traits/resolve",
            new ResolveRacialTraitChoiceRequest(_racialGratuitaChoice, _racialObrigatoriaChoice, _racialGratuitaEspecificacao, _racialObrigatoriaEspecificacao));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível registrar a Característica Racial escolhida.";
            return;
        }

        _racialChoiceDialogOpen = false;
        await LoadPendingRacialChoiceAsync();
        await _estado.CarregarCaracteristicasAsync();
    }

    private async Task LoadDiaryAsync()
    {
        _diaryEntries = await Http.GetFromJsonAsync<List<DiaryEntryResponse>>($"character-sheets/{SheetId}/diary") ?? new();
    }

    private async Task AddDiaryEntryAsync()
    {
        var response = await Http.PostAsJsonAsync($"character-sheets/{SheetId}/diary", new CreateDiaryEntryRequest(_diaryForm.Texto, _diaryImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a entrada.";
            return;
        }

        _diaryForm.Texto = "";
        _diaryImageIds.Clear();
        await LoadDiaryAsync();
    }

    private void StartEditDiaryEntry(DiaryEntryResponse entry)
    {
        _editingDiaryEntryId = entry.Id;
        _editDiaryText = entry.Texto;
        _editDiaryImageIds.Clear();
        foreach (var url in entry.ImageUrls)
        {
            var image = _myImages.FirstOrDefault(i => i.Url == url);
            if (image is not null)
                _editDiaryImageIds.Add(image.Id);
        }
    }

    private void CancelEditDiaryEntry()
    {
        _editingDiaryEntryId = null;
        _editDiaryText = "";
        _editDiaryImageIds.Clear();
    }

    private async Task SaveDiaryEntryAsync(string entryId)
    {
        var response = await Http.PutAsJsonAsync($"character-sheets/{SheetId}/diary/{entryId}", new UpdateDiaryEntryRequest(_editDiaryText, _editDiaryImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar a entrada.";
            return;
        }

        _editingDiaryEntryId = null;
        _editDiaryText = "";
        _editDiaryImageIds.Clear();
        await LoadDiaryAsync();
    }

    private async Task DeleteDiaryEntryAsync(string entryId)
    {
        await Http.DeleteAsync($"character-sheets/{SheetId}/diary/{entryId}");
        await LoadDiaryAsync();
    }

