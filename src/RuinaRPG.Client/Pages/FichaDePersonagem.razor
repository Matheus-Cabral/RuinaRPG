    {
        _form.Cobertura = value ?? "Nenhuma";
        await SaveIgnoringResultAsync();
        await _estado.CarregarAtributosECombateAsync(); // Cobertura feeds Defesa Natural (2.b), loaded here, not by LoadSheetAsync.
    }

