    /// O "Aplicar" do Acerto Crítico (na aba): salva na hora e relê as abas 2 e 3 (o orçamento de Perícias vem com
    /// elas; o salvamento só relê a ficha), num evento só da página.
    /// </summary>
    private async Task SalvarERecarregarAbasAsync()
    {
