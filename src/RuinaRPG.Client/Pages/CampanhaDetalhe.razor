    private void StartEditSecretNote(SecretNoteResponse note)
    {
        _editingNoteId = note.Id;
        _editNoteText = note.Texto;
        _editNoteRecipients.Clear();
        foreach (var recipientId in note.RecipientUserIds)
            _editNoteRecipients.Add(recipientId);
        _editNoteImageIds.Clear();
        foreach (var url in note.ImageUrls)
        {
            var image = _myImages.FirstOrDefault(i => i.Url == url);
            if (image is not null)
                _editNoteImageIds.Add(image.Id);
        }
    }

    private void CancelEditSecretNote()
    {
        _editingNoteId = null;
        _editNoteText = "";
        _editNoteRecipients.Clear();
        _editNoteImageIds.Clear();
    }

    private async Task SaveSecretNoteAsync(string noteId)
    {
        var response = await Http.PutAsJsonAsync($"campaigns/{CampaignId}/secret-notes/{noteId}", new UpdateSecretNoteRequest(_editNoteText, _editNoteRecipients.ToList(), _editNoteImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar a nota secreta.";
            return;
        }

        _editingNoteId = null;
        _editNoteText = "";
        _editNoteRecipients.Clear();
        _editNoteImageIds.Clear();
        await LoadSecretNotesAsync();
    }

