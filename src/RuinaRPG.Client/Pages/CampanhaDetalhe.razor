@page "/campanhas/{CampaignId}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Campaigns
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Contracts.Diary
@using RuinaRPG.Contracts.Encounters
@using RuinaRPG.Contracts.Images
@using RuinaRPG.Contracts.Players

<Breadcrumbs Items="@Crumbs" />
<h1>@(_campaignName ?? "Campanha")</h1>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<TabControl>
    <TabPage Title="Membros">
        <div class="mb-3">
            <label class="form-label">Buscar jogador para adicionar</label>
            <input class="form-control" @bind="_memberSearch" @bind:event="oninput" @bind:after="DebouncedSearchPlayersAsync" placeholder="Buscar jogador para adicionar" />
        </div>
        <ul class="list-unstyled mt-3">
            @foreach (var player in _searchResults)
            {
                <li>@player.Nickname (@player.Email) <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => AddMemberAsync(player.Id))">Adicionar</button></li>
            }
        </ul>
        <ul class="list-unstyled">
            @foreach (var member in _members)
            {
                <li>
                    @member.Nickname (@member.Email)
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => CreateSheetForAsync(member.UserId))">Criar Ficha de Personagem</button>
                    <ul class="list-unstyled">
                        @foreach (var sheet in _sheets.Where(s => s.OwnerId == member.UserId))
                        {
                            <li>
                                <a href="@($"fichas/{sheet.Id}")">@(sheet.Nome ?? "(sem nome)")</a>
                                <span class="text-muted">— Nível @sheet.Nivel, @(sheet.Vocacao ?? "sem vocação") (@(sheet.Linhagem ?? "sem linhagem"))</span>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ul>
    </TabPage>

    <TabPage Title="Diário">
        <EditForm Model="_diaryForm" OnValidSubmit="AddDiaryEntryAsync">
            <div class="mb-3">
                <label class="form-label">Texto</label>
                <InputTextArea class="form-control" @bind-Value="_diaryForm.Texto" />
            </div>
            <div class="mb-3">
                <label class="form-label">Enviar nova imagem <InputFile OnChange="@(e => UploadImageAsync(e, _diaryImageIds))" /></label>
                <ul class="list-unstyled">
                    @foreach (var image in _myImages)
                    {
                        <li>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" checked="@_diaryImageIds.Contains(image.Id)" @onchange="@(e => ToggleImage(_diaryImageIds, image.Id, (bool)e.Value!))" />
                                <label class="form-check-label">@image.Url</label>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Entrada</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var entry in _diaryEntries)
            {
                <li>
                    @if (_editingEntryId == entry.Id)
                    {
                        <textarea class="form-control" @bind="_editText"></textarea>
                        <ul class="list-unstyled">
                            @foreach (var image in _myImages)
                            {
                                <li>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked="@_editDiaryImageIds.Contains(image.Id)" @onchange="@(e => ToggleImage(_editDiaryImageIds, image.Id, (bool)e.Value!))" />
                                        <label class="form-check-label">@image.Url</label>
                                    </div>
                                </li>
                            }
                        </ul>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => SaveDiaryEntryAsync(entry.Id))">Salvar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEditDiaryEntry">Cancelar</button>
                    }
                    else
                    {
                        <span>@entry.CreatedAt.ToString("g") — @entry.Texto</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => StartEditDiaryEntry(entry))">Editar</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteDiaryEntryAsync(entry.Id))">Excluir</button>
                        @if (entry.ImageUrls.Count > 0)
                        {
                            <div class="mt-1">
                                @foreach (var url in entry.ImageUrls)
                                {
                                    <img src="@url" alt="" style="max-width: 100px; margin-right: 4px;" />
                                }
                            </div>
                        }
                    }
                </li>
            }
        </ul>
    </TabPage>

    <TabPage Title="Encontros">
        <button type="button" class="btn btn-primary" @onclick="CreateEncounterAsync">Novo Encontro</button>
        <ul class="list-unstyled mt-3">
            @foreach (var encounter in _encounters)
            {
                <li><a href="@($"campanhas/{CampaignId}/encontros/{encounter.Id}")">@(encounter.Nome ?? "(sem nome)")</a></li>
            }
        </ul>
    </TabPage>

    <TabPage Title="Anexos">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Item (id)</label>
                <div class="input-group">
                    <input class="form-control" @bind="_attachItemId" />
                    <button type="button" class="btn btn-primary" @onclick="AttachItemAsync">Anexar Item</button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Entrada do Banco de Magias (id)</label>
                <div class="input-group">
                    <input class="form-control" @bind="_attachBankEntryId" />
                    <button type="button" class="btn btn-primary" @onclick="AttachBankEntryAsync">Anexar Magia/Habilidade</button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Imagem (id)</label>
                <div class="input-group">
                    <input class="form-control" @bind="_attachImageId" />
                    <button type="button" class="btn btn-primary" @onclick="AttachImageAsync">Anexar Imagem</button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ficha de NPC (id)</label>
                <div class="input-group">
                    <input class="form-control" @bind="_attachNpcSheetId" />
                    <button type="button" class="btn btn-primary" @onclick="AttachNpcSheetAsync">Anexar NPC</button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Ficha de Criatura (id)</label>
                <div class="input-group">
                    <input class="form-control" @bind="_attachCreatureSheetId" />
                    <button type="button" class="btn btn-primary" @onclick="AttachCreatureSheetAsync">Anexar Criatura</button>
                </div>
            </div>
        </div>
        <ul class="list-unstyled">
            @foreach (var attachment in _attachments)
            {
                <li>
                    [@attachment.Tipo] @attachment.Nome
                    @if (attachment.Tipo == "NpcSheet")
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@attachment.NpcNomePublico" @onchange="@(e => ToggleNpcVisibilityAsync(attachment, (bool)e.Value!, attachment.NpcImagemPublica ?? false))" />
                            <label class="form-check-label">Nome público</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@attachment.NpcImagemPublica" @onchange="@(e => ToggleNpcVisibilityAsync(attachment, attachment.NpcNomePublico ?? false, (bool)e.Value!))" />
                            <label class="form-check-label">Imagem pública</label>
                        </div>
                    }
                    else if (attachment.Tipo == "CreatureSheet")
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@attachment.CreatureNomePublico" @onchange="@(e => ToggleCreatureVisibilityAsync(attachment, (bool)e.Value!, attachment.CreatureImagemPublica ?? false))" />
                            <label class="form-check-label">Nome público</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@attachment.CreatureImagemPublica" @onchange="@(e => ToggleCreatureVisibilityAsync(attachment, attachment.CreatureNomePublico ?? false, (bool)e.Value!))" />
                            <label class="form-check-label">Imagem pública</label>
                        </div>
                    }
                    else
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@attachment.IsPublic" @onchange="@(e => ToggleVisibilityAsync(attachment, (bool)e.Value!))" />
                            <label class="form-check-label">Público</label>
                        </div>
                    }
                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => RemoveAttachmentAsync(attachment.Id))">Remover</button>
                </li>
            }
        </ul>
    </TabPage>

    <TabPage Title="Conceder Ficha">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Jogador</label>
                <select class="form-select" @bind="_grantPlayerId">
                    <option value="">(selecione)</option>
                    @foreach (var member in _members)
                    {
                        <option value="@member.UserId">@member.Nickname</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" @bind="_grantTipo">
                    <option value="Npc">NPC</option>
                    <option value="Creature">Criatura</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Ficha de origem (id, opcional — em branco cria uma ficha nova)</label>
                <input class="form-control" @bind="_grantSourceSheetId" />
            </div>
        </div>
        <button type="button" class="btn btn-primary mt-3" @onclick="GrantSheetAsync">Conceder</button>
    </TabPage>

    <TabPage Title="Notas Secretas">
        <EditForm Model="_noteForm" OnValidSubmit="AddSecretNoteAsync">
            <div class="mb-3">
                <label class="form-label">Texto</label>
                <InputTextArea class="form-control" @bind-Value="_noteForm.Texto" />
            </div>
            <p>Destinatários:</p>
            <ul class="list-unstyled">
                @foreach (var member in _members)
                {
                    <li>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" checked="@_noteRecipients.Contains(member.UserId)" @onchange="@(e => ToggleNoteRecipient(member.UserId, (bool)e.Value!))" />
                            <label class="form-check-label">@member.Nickname</label>
                        </div>
                    </li>
                }
            </ul>
            <div class="mb-3">
                <label class="form-label">Enviar nova imagem <InputFile OnChange="@(e => UploadImageAsync(e, _noteImageIds))" /></label>
                <ul class="list-unstyled">
                    @foreach (var image in _myImages)
                    {
                        <li>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" checked="@_noteImageIds.Contains(image.Id)" @onchange="@(e => ToggleImage(_noteImageIds, image.Id, (bool)e.Value!))" />
                                <label class="form-check-label">@image.Url</label>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <button type="submit" class="btn btn-primary">Adicionar Nota Secreta</button>
        </EditForm>
        <ul class="list-unstyled mt-3">
            @foreach (var note in _secretNotes)
            {
                <li>
                    @if (_editingNoteId == note.Id)
                    {
                        <textarea class="form-control" @bind="_editNoteText"></textarea>
                        <ul class="list-unstyled">
                            @foreach (var member in _members)
                            {
                                <li>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked="@_editNoteRecipients.Contains(member.UserId)" @onchange="@(e => ToggleEditNoteRecipient(member.UserId, (bool)e.Value!))" />
                                        <label class="form-check-label">@member.Nickname</label>
                                    </div>
                                </li>
                            }
                        </ul>
                        <ul class="list-unstyled">
                            @foreach (var image in _myImages)
                            {
                                <li>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked="@_editNoteImageIds.Contains(image.Id)" @onchange="@(e => ToggleImage(_editNoteImageIds, image.Id, (bool)e.Value!))" />
                                        <label class="form-check-label">@image.Url</label>
                                    </div>
                                </li>
                            }
                        </ul>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => SaveSecretNoteAsync(note.Id))">Salvar</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEditSecretNote">Cancelar</button>
                    }
                    else
                    {
                        <span>@note.CreatedAt.ToString("g") — @note.Texto (destinatários: @note.RecipientUserIds.Count)</span>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => StartEditSecretNote(note))">Editar</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteSecretNoteAsync(note.Id))">Excluir</button>
                        @if (note.ImageUrls.Count > 0)
                        {
                            <div class="mt-1">
                                @foreach (var url in note.ImageUrls)
                                {
                                    <img src="@url" alt="" style="max-width: 100px; margin-right: 4px;" />
                                }
                            </div>
                        }
                    }
                </li>
            }
        </ul>
    </TabPage>
</TabControl>

@code {
    [Parameter] public string CampaignId { get; set; } = "";

    private string? _campaignName;

    private List<BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Campanhas", "campanhas"),
        new(_campaignName ?? "Campanha"),
    };

    private List<CampaignMemberResponse> _members = new();
    private List<CharacterSheetResponse> _sheets = new();
    private List<DiaryEntryResponse> _diaryEntries = new();
    private List<EncounterResponse> _encounters = new();
    private List<PlayerSearchResultResponse> _searchResults = new();
    private List<CampaignAttachmentResponse> _attachments = new();
    private List<SecretNoteResponse> _secretNotes = new();
    private List<ImageSummaryResponse> _myImages = new();
    private string _memberSearch = "";
    private readonly DiaryFormModel _diaryForm = new();
    private readonly DiaryFormModel _noteForm = new();
    private readonly HashSet<string> _noteRecipients = new();
    private readonly HashSet<string> _editNoteRecipients = new();
    private readonly HashSet<string> _diaryImageIds = new();
    private readonly HashSet<string> _editDiaryImageIds = new();
    private readonly HashSet<string> _noteImageIds = new();
    private readonly HashSet<string> _editNoteImageIds = new();
    private string? _errorMessage;
    private string? _editingEntryId;
    private string _editText = "";
    private string? _editingNoteId;
    private string _editNoteText = "";

    private string _attachItemId = "";
    private string _attachBankEntryId = "";
    private string _attachImageId = "";
    private string _attachNpcSheetId = "";
    private string _attachCreatureSheetId = "";

    private string _grantPlayerId = "";
    private string _grantTipo = "Npc";
    private string _grantSourceSheetId = "";

    protected override Task OnInitializedAsync() => Task.WhenAll(LoadMembersAsync(), LoadSheetsAsync(), LoadDiaryAsync(), LoadEncountersAsync(), LoadAttachmentsAsync(), LoadSecretNotesAsync(), LoadCampaignNameAsync(), SearchPlayersAsync(), LoadImagesAsync());

    private async Task LoadImagesAsync()
    {
        var response = await Http.GetAsync("images/mine");
        if (response.IsSuccessStatusCode)
            _myImages = await response.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();
    }

    private async Task UploadImageAsync(InputFileChangeEventArgs e, HashSet<string> targetSelection)
    {
        using var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(e.File.OpenReadStream(maxAllowedSize: 20_000_000));
        content.Add(fileContent, "file", e.File.Name);

        var response = await Http.PostAsync("images", content);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível enviar a imagem.";
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<ImageUploadResponse>();
        _myImages.Insert(0, new ImageSummaryResponse(body!.Id, body.Url, DateTime.UtcNow));
        targetSelection.Add(body.Id);
    }

    private static void ToggleImage(HashSet<string> selection, string imageId, bool selected)
    {
        if (selected)
            selection.Add(imageId);
        else
            selection.Remove(imageId);
    }

    private async Task LoadCampaignNameAsync()
    {
        var response = await Http.GetAsync("campaigns");
        if (!response.IsSuccessStatusCode) return;
        var campaigns = await response.Content.ReadFromJsonAsync<List<CampaignResponse>>() ?? new();
        _campaignName = campaigns.FirstOrDefault(c => c.Id == CampaignId)?.Nome;
    }

    private async Task LoadMembersAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/members");
        if (response.IsSuccessStatusCode)
            _members = await response.Content.ReadFromJsonAsync<List<CampaignMemberResponse>>() ?? new();
    }

    private async Task LoadSheetsAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/character-sheets");
        if (response.IsSuccessStatusCode)
            _sheets = await response.Content.ReadFromJsonAsync<List<CharacterSheetResponse>>() ?? new();
    }

    private async Task LoadDiaryAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/diary");
        if (response.IsSuccessStatusCode)
            _diaryEntries = await response.Content.ReadFromJsonAsync<List<DiaryEntryResponse>>() ?? new();
    }

    private async Task LoadEncountersAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/encounters");
        if (response.IsSuccessStatusCode)
            _encounters = await response.Content.ReadFromJsonAsync<List<EncounterResponse>>() ?? new();
    }

    private async Task CreateEncounterAsync()
    {
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/encounters", new CreateEncounterRequest(null));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível criar o encontro.";
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<EncounterResponse>();
        Navigation.NavigateTo($"campanhas/{CampaignId}/encontros/{body!.Id}");
    }

    private async Task LoadAttachmentsAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/attachments");
        if (response.IsSuccessStatusCode)
            _attachments = await response.Content.ReadFromJsonAsync<List<CampaignAttachmentResponse>>() ?? new();
    }

    private async Task LoadSecretNotesAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/secret-notes");
        if (response.IsSuccessStatusCode)
            _secretNotes = await response.Content.ReadFromJsonAsync<List<SecretNoteResponse>>() ?? new();
    }

    private CancellationTokenSource? _memberSearchDebounceCts;

    private async Task DebouncedSearchPlayersAsync()
    {
        _memberSearchDebounceCts?.Cancel();
        _memberSearchDebounceCts = new CancellationTokenSource();
        var token = _memberSearchDebounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SearchPlayersAsync();
    }

    private async Task SearchPlayersAsync()
    {
        var response = await Http.GetAsync($"players?q={Uri.EscapeDataString(_memberSearch)}");
        if (response.IsSuccessStatusCode)
            _searchResults = await response.Content.ReadFromJsonAsync<List<PlayerSearchResultResponse>>() ?? new();
    }

    private async Task AddMemberAsync(string playerId)
    {
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/members", new AddCampaignMemberRequest(playerId));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar o membro.";
            return;
        }

        await LoadMembersAsync();
    }

    private async Task AddDiaryEntryAsync()
    {
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/diary", new CreateDiaryEntryRequest(_diaryForm.Texto, _diaryImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a entrada.";
            return;
        }

        _diaryForm.Texto = "";
        _diaryImageIds.Clear();
        await LoadDiaryAsync();
    }

    private void StartEditDiaryEntry(DiaryEntryResponse entry)
    {
        _editingEntryId = entry.Id;
        _editText = entry.Texto;
        _editDiaryImageIds.Clear();
        foreach (var url in entry.ImageUrls)
        {
            var image = _myImages.FirstOrDefault(i => i.Url == url);
            if (image is not null)
                _editDiaryImageIds.Add(image.Id);
        }
    }

    private void CancelEditDiaryEntry()
    {
        _editingEntryId = null;
        _editText = "";
        _editDiaryImageIds.Clear();
    }

    private async Task SaveDiaryEntryAsync(string entryId)
    {
        var response = await Http.PutAsJsonAsync($"campaigns/{CampaignId}/diary/{entryId}", new UpdateDiaryEntryRequest(_editText, _editDiaryImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar a entrada.";
            return;
        }

        _editingEntryId = null;
        _editText = "";
        _editDiaryImageIds.Clear();
        await LoadDiaryAsync();
    }

    private async Task DeleteDiaryEntryAsync(string entryId)
    {
        var response = await Http.DeleteAsync($"campaigns/{CampaignId}/diary/{entryId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir a entrada.";
            return;
        }

        await LoadDiaryAsync();
    }

    private async Task CreateSheetForAsync(string ownerId)
    {
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/character-sheets", new CreateCharacterSheetRequest(ownerId));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível criar a ficha.";
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<CharacterSheetResponse>();
        Navigation.NavigateTo($"fichas/{body!.Id}");
    }

    private async Task AttachAsync(AttachToCampaignRequest request)
    {
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/attachments", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível anexar.";
            return;
        }

        await LoadAttachmentsAsync();
    }

    private Task AttachItemAsync()
    {
        var id = _attachItemId;
        _attachItemId = "";
        return AttachAsync(new AttachToCampaignRequest(id, null, null, null, null));
    }

    private Task AttachBankEntryAsync()
    {
        var id = _attachBankEntryId;
        _attachBankEntryId = "";
        return AttachAsync(new AttachToCampaignRequest(null, null, null, id, null));
    }

    private Task AttachImageAsync()
    {
        var id = _attachImageId;
        _attachImageId = "";
        return AttachAsync(new AttachToCampaignRequest(null, null, null, null, id));
    }

    private Task AttachNpcSheetAsync()
    {
        var id = _attachNpcSheetId;
        _attachNpcSheetId = "";
        return AttachAsync(new AttachToCampaignRequest(null, id, null, null, null));
    }

    private Task AttachCreatureSheetAsync()
    {
        var id = _attachCreatureSheetId;
        _attachCreatureSheetId = "";
        return AttachAsync(new AttachToCampaignRequest(null, null, id, null, null));
    }

    private async Task ToggleVisibilityAsync(CampaignAttachmentResponse attachment, bool isPublic)
    {
        var response = await Http.PutAsJsonAsync($"campaigns/{CampaignId}/attachments/{attachment.Id}/visibility", isPublic);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível alterar a visibilidade.";
            return;
        }

        await LoadAttachmentsAsync();
    }

    private async Task ToggleNpcVisibilityAsync(CampaignAttachmentResponse attachment, bool nomePublico, bool imagemPublica)
    {
        var response = await Http.PutAsJsonAsync($"campaigns/{CampaignId}/attachments/{attachment.Id}/npc-visibility", new NpcVisibilityBody(nomePublico, imagemPublica));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível alterar a visibilidade.";
            return;
        }

        await LoadAttachmentsAsync();
    }

    private async Task ToggleCreatureVisibilityAsync(CampaignAttachmentResponse attachment, bool nomePublico, bool imagemPublica)
    {
        var response = await Http.PutAsJsonAsync($"campaigns/{CampaignId}/attachments/{attachment.Id}/creature-visibility", new CreatureVisibilityBody(nomePublico, imagemPublica));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível alterar a visibilidade.";
            return;
        }

        await LoadAttachmentsAsync();
    }

    private async Task RemoveAttachmentAsync(string attachmentId)
    {
        var response = await Http.DeleteAsync($"campaigns/{CampaignId}/attachments/{attachmentId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível remover o anexo.";
            return;
        }

        await LoadAttachmentsAsync();
    }

    private async Task GrantSheetAsync()
    {
        if (string.IsNullOrWhiteSpace(_grantPlayerId))
        {
            _errorMessage = "Selecione um jogador.";
            return;
        }

        var sourceSheetId = string.IsNullOrWhiteSpace(_grantSourceSheetId) ? null : _grantSourceSheetId;
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/grants", new GrantSheetRequest(_grantPlayerId, _grantTipo, sourceSheetId));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível conceder a ficha.";
            return;
        }

        _grantSourceSheetId = "";
        await LoadAttachmentsAsync();
    }

    private void ToggleNoteRecipient(string userId, bool selected)
    {
        if (selected)
            _noteRecipients.Add(userId);
        else
            _noteRecipients.Remove(userId);
    }

    private void ToggleEditNoteRecipient(string userId, bool selected)
    {
        if (selected)
            _editNoteRecipients.Add(userId);
        else
            _editNoteRecipients.Remove(userId);
    }

    private async Task AddSecretNoteAsync()
    {
        var response = await Http.PostAsJsonAsync($"campaigns/{CampaignId}/secret-notes", new CreateSecretNoteRequest(_noteForm.Texto, _noteRecipients.ToList(), _noteImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a nota secreta.";
            return;
        }

        _noteForm.Texto = "";
        _noteRecipients.Clear();
        _noteImageIds.Clear();
        await LoadSecretNotesAsync();
    }

    private void StartEditSecretNote(SecretNoteResponse note)
    {
        _editingNoteId = note.Id;
        _editNoteText = note.Texto;
        _editNoteRecipients.Clear();
        foreach (var recipientId in note.RecipientUserIds)
            _editNoteRecipients.Add(recipientId);
        _editNoteImageIds.Clear();
        foreach (var url in note.ImageUrls)
        {
            var image = _myImages.FirstOrDefault(i => i.Url == url);
            if (image is not null)
                _editNoteImageIds.Add(image.Id);
        }
    }

    private void CancelEditSecretNote()
    {
        _editingNoteId = null;
        _editNoteText = "";
        _editNoteRecipients.Clear();
        _editNoteImageIds.Clear();
    }

    private async Task SaveSecretNoteAsync(string noteId)
    {
        var response = await Http.PutAsJsonAsync($"campaigns/{CampaignId}/secret-notes/{noteId}", new UpdateSecretNoteRequest(_editNoteText, _editNoteRecipients.ToList(), _editNoteImageIds.ToList()));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar a nota secreta.";
            return;
        }

        _editingNoteId = null;
        _editNoteText = "";
        _editNoteRecipients.Clear();
        _editNoteImageIds.Clear();
        await LoadSecretNotesAsync();
    }

    private async Task DeleteSecretNoteAsync(string noteId)
    {
        var response = await Http.DeleteAsync($"campaigns/{CampaignId}/secret-notes/{noteId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir a nota secreta.";
            return;
        }

        await LoadSecretNotesAsync();
    }

