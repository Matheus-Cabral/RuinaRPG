@page "/campanhas/{CampaignId}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Campaigns
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Contracts.Diary
@using RuinaRPG.Contracts.Encounters
@using RuinaRPG.Contracts.Images
@using RuinaRPG.Contracts.Items
@using RuinaRPG.Contracts.CreatureSheets
@using RuinaRPG.Contracts.NpcSheets
@using RuinaRPG.Contracts.Players
@using RuinaRPG.Contracts.SpellsAndAbilities
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />
<MudText Typo="Typo.h3">@(_campaignName ?? "Campanha")</MudText>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
}

<MudTabs Class="mt-3">
    <MudTabPanel Text="Membros">
        <Section Title="Adicionar Jogador">
            <MudTextField T="string" @bind-Value="_memberSearch" Immediate="true" @bind-Value:after="DebouncedSearchPlayersAsync" Label="Buscar jogador para adicionar" />
            <MudList T="string" Class="mt-3">
                @foreach (var player in _searchResults)
                {
                    <MudListItem T="string">
                        <ChildContent>
                            <MudText>@player.Nickname (@player.Email)</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AddMemberAsync(player.Id))">Adicionar</MudButton>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
        </Section>

        <Section Title="Membros">
            <MudList T="string">
                @foreach (var member in _members)
                {
                    <MudListItem T="string">
                        <ChildContent>
                            <MudText>@member.Nickname</MudText>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => CreateSheetForAsync(member.UserId))">Criar Ficha de Personagem</MudButton>
                            <MudList T="string" Dense="true">
                                @foreach (var sheet in _sheets.Where(s => s.OwnerId == member.UserId))
                                {
                                    <MudListItem T="string">
                                        @if (sheet.ImageUrl is not null)
                                        {
                                            <ClickableAvatarImage Src="@sheet.ImageUrl" Size="Size.Small" Class="mr-2" />
                                        }
                                        <MudLink Href="@($"fichas/{sheet.Id}")">@(sheet.Nome ?? "(sem nome)")</MudLink>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="d-inline ml-2">— Nível @sheet.Nivel, @(sheet.Vocacao ?? "sem vocação") (@(sheet.Linhagem ?? "sem linhagem"))</MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Diário">
        <Section Title="Adicionar entrada">
            <EditForm Model="_diaryForm" OnValidSubmit="AddDiaryEntryAsync">
                <MudTextField T="string" @bind-Value="_diaryForm.Texto" Label="Texto" Lines="3" />
                <MudExpansionPanel Text="Anexar imagens">
                    <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadImageAsync(f, _diaryImageIds))" Class="mt-3">
                        <CustomContent Context="fileUploadContext">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => fileUploadContext.OpenFilePickerAsync())">Enviar nova imagem</MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    <MudList T="string" Dense="true">
                        @foreach (var image in _myImages)
                        {
                            <MudListItem T="string">
                                <MudCheckBox T="bool" Value="@_diaryImageIds.Contains(image.Id)" ValueChanged="@(v => ToggleImage(_diaryImageIds, image.Id, v))" Label="@image.Url" Dense="true" />
                            </MudListItem>
                        }
                    </MudList>
                </MudExpansionPanel>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Entrada</MudButton>
            </EditForm>
        </Section>

        <Section Title="Entradas">
            <MudTimeline Class="mt-3" TimelinePosition="TimelinePosition.Right">
                @foreach (var entry in _diaryEntries)
                {
                    <MudTimelineItem Color="Color.Primary">
                        <ItemContent>
                            <MudCard>
                                <MudCardContent>
                                    @if (_editingEntryId == entry.Id)
                                    {
                                        <MudTextField T="string" @bind-Value="_editText" Lines="3" />
                                        <MudList T="string" Dense="true">
                                            @foreach (var image in _myImages)
                                            {
                                                <MudListItem T="string">
                                                    <MudCheckBox T="bool" Value="@_editDiaryImageIds.Contains(image.Id)" ValueChanged="@(v => ToggleImage(_editDiaryImageIds, image.Id, v))" Label="@image.Url" Dense="true" />
                                                </MudListItem>
                                            }
                                        </MudList>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SaveDiaryEntryAsync(entry.Id))">Salvar</MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="CancelEditDiaryEntry">Cancelar</MudButton>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@entry.CreatedAt.ToString("g")</MudText>
                                        <MudText>@entry.Texto</MudText>
                                        @if (entry.ImageUrls.Count > 0)
                                        {
                                            <div class="mt-1">
                                                @foreach (var url in entry.ImageUrls)
                                                {
                                                    <ClickableImage Src="@url" Width="100" Class="mr-1" />
                                                }
                                            </div>
                                        }
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => StartEditDiaryEntry(entry))">Editar</MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteDiaryEntryAsync(entry.Id))">Excluir</MudButton>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Encontros">
        <Section Title="Criar encontro">
            <MudTextField T="string" @bind-Value="_newEncounterNome" Label="Nome do encontro (opcional)" Style="max-width:24rem" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="CreateEncounterAsync">Novo Encontro</MudButton>
        </Section>

        <Section Title="Encontros">
            <MudList T="string" Class="mt-3">
                @foreach (var encounter in _encounters)
                {
                    <MudListItem T="string" Text="@(encounter.Nome ?? "(sem nome)")" Href="@($"campanhas/{CampaignId}/encontros/{encounter.Id}")" />
                }
            </MudList>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Anexos">
        <MudGrid Class="mt-3 mb-3">
            <MudItem xs="12" md="6">
                <Section Title="Item">
                    <EntityPicker @bind-Value="_attachItemId" SearchItems="SearchItemsAsync" Placeholder="Buscar item..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AttachItemAsync">Anexar Item</MudButton>
                </Section>
            </MudItem>
            <MudItem xs="12" md="6">
                <Section Title="Entrada do Banco de Magias">
                    <EntityPicker @bind-Value="_attachBankEntryId" SearchItems="SearchBankEntriesAsync" Placeholder="Buscar magia/habilidade..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AttachBankEntryAsync">Anexar Magia/Habilidade</MudButton>
                </Section>
            </MudItem>
            <MudItem xs="12" md="6">
                <Section Title="Imagem">
                    <EntityPicker @bind-Value="_attachImageId" SearchItems="SearchImagesAsync" Placeholder="Buscar imagem já enviada..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AttachImageAsync">Anexar Imagem</MudButton>
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadAndAttachImageAsync" Class="mt-2">
                        <CustomContent Context="fileUploadContext">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => fileUploadContext.OpenFilePickerAsync())">Ou enviar uma imagem nova</MudButton>
                        </CustomContent>
                    </MudFileUpload>
                </Section>
            </MudItem>
            <MudItem xs="12" md="6">
                <Section Title="Ficha de NPC">
                    <EntityPicker @bind-Value="_attachNpcSheetId" SearchItems="SearchNpcSheetsAsync" Placeholder="Buscar ficha de NPC..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AttachNpcSheetAsync">Anexar NPC</MudButton>
                </Section>
            </MudItem>
            <MudItem xs="12" md="6">
                <Section Title="Ficha de Criatura">
                    <EntityPicker @bind-Value="_attachCreatureSheetId" SearchItems="SearchCreatureSheetsAsync" Placeholder="Buscar ficha de Criatura..." />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AttachCreatureSheetAsync">Anexar Criatura</MudButton>
                </Section>
            </MudItem>
        </MudGrid>
        <Section Title="Anexos existentes">
            <MudSimpleTable Dense="true" Hover="true">
                <tbody>
                    @foreach (var attachment in _attachments)
                    {
                        <tr>
                            <td>
                                [@attachment.Tipo] @attachment.Nome
                                @if (attachment.Tipo == "NpcSheet")
                                {
                                    <MudCheckBox T="bool" Value="@(attachment.NpcNomePublico ?? false)" ValueChanged="@(v => ToggleNpcVisibilityAsync(attachment, v, attachment.NpcImagemPublica ?? false))" Label="Nome público" Dense="true" Class="d-inline-flex" />
                                    <MudCheckBox T="bool" Value="@(attachment.NpcImagemPublica ?? false)" ValueChanged="@(v => ToggleNpcVisibilityAsync(attachment, attachment.NpcNomePublico ?? false, v))" Label="Imagem pública" Dense="true" Class="d-inline-flex" />
                                }
                                else if (attachment.Tipo == "CreatureSheet")
                                {
                                    <MudCheckBox T="bool" Value="@(attachment.CreatureNomePublico ?? false)" ValueChanged="@(v => ToggleCreatureVisibilityAsync(attachment, v, attachment.CreatureImagemPublica ?? false))" Label="Nome público" Dense="true" Class="d-inline-flex" />
                                    <MudCheckBox T="bool" Value="@(attachment.CreatureImagemPublica ?? false)" ValueChanged="@(v => ToggleCreatureVisibilityAsync(attachment, attachment.CreatureNomePublico ?? false, v))" Label="Imagem pública" Dense="true" Class="d-inline-flex" />
                                }
                                else
                                {
                                    <MudCheckBox T="bool" Value="@(attachment.IsPublic ?? false)" ValueChanged="@(v => ToggleVisibilityAsync(attachment, v))" Label="Público" Dense="true" Class="d-inline-flex" />
                                }
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveAttachmentAsync(attachment.Id))">Remover</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Conceder Ficha">
        <Section Title="Conceder Ficha">
            <MudGrid Class="mt-3">
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_grantPlayerId" Label="Jogador">
                        <MudSelectItem Value="@("")">(selecione)</MudSelectItem>
                        @foreach (var member in _members)
                        {
                            <MudSelectItem Value="@member.UserId">@member.Nickname</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" @bind-Value="_grantTipo" Label="Tipo">
                        <MudSelectItem Value="@("Npc")">NPC</MudSelectItem>
                        <MudSelectItem Value="@("Creature")">Criatura</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="5">
                    <EntityPicker @bind-Value="_grantSourceSheetId" SearchItems="SearchGrantSourceSheetsAsync" Placeholder="Buscar ficha existente (opcional — em branco cria uma ficha nova)..." />
                </MudItem>
            </MudGrid>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="GrantSheetAsync">Conceder</MudButton>
        </Section>

        <Section Title="Concessões existentes">
            <MudSimpleTable Dense="true" Hover="true">
                <tbody>
                    @foreach (var grant in _grants)
                    {
                        <tr>
                            <td>
                                [@grant.Tipo] <MudLink Href="@((grant.Tipo == "Npc" ? "npcs/" : "criaturas/") + grant.SheetId)">@(grant.Nome ?? "(sem nome)")</MudLink>
                                — concedida a @grant.PlayerNickname
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Notas Secretas">
        <Section Title="Enviar nota secreta">
            <EditForm Model="_noteForm" OnValidSubmit="AddSecretNoteAsync">
                <MudTextField T="string" @bind-Value="_noteForm.Texto" Label="Texto" Lines="3" />
                <MudText Typo="Typo.subtitle2" Class="mt-3">Destinatários:</MudText>
                <MudList T="string" Dense="true">
                    @foreach (var member in _members)
                    {
                        <MudListItem T="string">
                            <MudCheckBox T="bool" Value="@_noteRecipients.Contains(member.UserId)" ValueChanged="@(v => ToggleNoteRecipient(member.UserId, v))" Label="@member.Nickname" Dense="true" />
                        </MudListItem>
                    }
                </MudList>
                <MudExpansionPanel Text="Anexar imagens">
                    <MudFileUpload T="IBrowserFile" FilesChanged="@(f => UploadImageAsync(f, _noteImageIds))" Class="mt-3">
                        <CustomContent Context="fileUploadContext">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => fileUploadContext.OpenFilePickerAsync())">Enviar nova imagem</MudButton>
                        </CustomContent>
                    </MudFileUpload>
                    <MudList T="string" Dense="true">
                        @foreach (var image in _myImages)
                        {
                            <MudListItem T="string">
                                <MudCheckBox T="bool" Value="@_noteImageIds.Contains(image.Id)" ValueChanged="@(v => ToggleImage(_noteImageIds, image.Id, v))" Label="@image.Url" Dense="true" />
                            </MudListItem>
                        }
                    </MudList>
                </MudExpansionPanel>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Nota Secreta</MudButton>
            </EditForm>
        </Section>

        <Section Title="Notas secretas enviadas">
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <tbody>
                    @foreach (var note in _secretNotes)
                    {
                        <tr>
                            <td>
                                @if (_editingNoteId == note.Id)
                                {
                                    <MudTextField T="string" @bind-Value="_editNoteText" Lines="3" />
                                    <MudList T="string" Dense="true">
                                        @foreach (var member in _members)
                                        {
                                            <MudListItem T="string">
                                                <MudCheckBox T="bool" Value="@_editNoteRecipients.Contains(member.UserId)" ValueChanged="@(v => ToggleEditNoteRecipient(member.UserId, v))" Label="@member.Nickname" Dense="true" />
                                            </MudListItem>
                                        }
                                    </MudList>
                                    <MudList T="string" Dense="true">
                                        @foreach (var image in _myImages)
                                        {
                                            <MudListItem T="string">
                                                <MudCheckBox T="bool" Value="@_editNoteImageIds.Contains(image.Id)" ValueChanged="@(v => ToggleImage(_editNoteImageIds, image.Id, v))" Label="@image.Url" Dense="true" />
                                            </MudListItem>
                                        }
                                    </MudList>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SaveSecretNoteAsync(note.Id))">Salvar</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="CancelEditSecretNote">Cancelar</MudButton>
                                }
                                else
                                {
                                    <MudText>@note.CreatedAt.ToString("g") — @note.Texto (destinatários: @note.RecipientUserIds.Count)</MudText>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => StartEditSecretNote(note))">Editar</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteSecretNoteAsync(note.Id))">Excluir</MudButton>
                                    @if (note.ImageUrls.Count > 0)
                                    {
                                        <div class="mt-1">
                                            @foreach (var url in note.ImageUrls)
                                            {
                                                <ClickableImage Src="@url" Width="100" Class="mr-1" />
                                            }
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Detalhes">
        <Section Title="Editar Campanha">
            <EditForm Model="_detailsForm" OnValidSubmit="SaveDetailsAsync">
                <MudTextField T="string" @bind-Value="_detailsForm.Nome" Label="Nome" />
                <MudTextField T="string" @bind-Value="_detailsForm.Descricao" Label="Descrição" Lines="3" />

                @if (_campaign?.ImageUrl is not null)
                {
                    <ClickableImage Src="@_campaign.ImageUrl" Width="200" Class="mt-2 mb-2" />
                }

                <MudFileUpload T="IBrowserFile" FilesChanged="UploadDetailsImageAsync" Class="mt-2">
                    <CustomContent Context="fileUploadContext">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => fileUploadContext.OpenFilePickerAsync())">Enviar nova imagem</MudButton>
                    </CustomContent>
                </MudFileUpload>
                <MudSelect T="string" @bind-Value="_detailsForm.ImageId" Label="Ou reutilizar uma imagem já enviada (R0010)">
                    <MudSelectItem Value="@((string?)null)">— nenhuma —</MudSelectItem>
                    @foreach (var image in _myImages)
                    {
                        <MudSelectItem Value="@image.Id">@image.Url (@image.CreatedAt.ToString("g"))</MudSelectItem>
                    }
                </MudSelect>

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Salvar</MudButton>
            </EditForm>
        </Section>

        <Section Title="Excluir Campanha">
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Excluir esta campanha apaga permanentemente todas as fichas de personagem, entradas de diário e notas secretas associadas a ela. Esta ação não pode ser desfeita.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => _deleteDialogOpen = true)">Excluir Campanha</MudButton>
        </Section>
    </MudTabPanel>
</MudTabs>

<MudDialog @bind-Visible="_deleteDialogOpen">
    <TitleContent>Excluir Campanha</TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Esta ação é permanente: todas as fichas de personagem, entradas de diário e notas secretas da campanha "@_campaignName" serão apagadas.
        </MudAlert>
        @if (_deleteErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_deleteErrorMessage</MudAlert>
        }
        <MudTextField T="string" @bind-Value="_deletePassword" Label="Senha" InputType="InputType.Password" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _deleteDialogOpen = false)">Cancelar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmDeleteAsync">Confirmar Exclusão</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string CampaignId { get; set; } = "";

    private string? _campaignName;
    private CampaignResponse? _campaign;
    private readonly CampaignDetailsFormModel _detailsForm = new();
    private bool _deleteDialogOpen;
    private string _deletePassword = "";
    private string? _deleteErrorMessage;

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Campanhas", "campanhas"),
        new(_campaignName ?? "Campanha"),
    };

    private List<CampaignMemberResponse> _members = new();
    private List<CharacterSheetResponse> _sheets = new();
    private List<DiaryEntryResponse> _diaryEntries = new();
    private List<EncounterResponse> _encounters = new();
    private List<PlayerSearchResultResponse> _searchResults = new();
    private List<CampaignAttachmentResponse> _attachments = new();
    private List<SecretNoteResponse> _secretNotes = new();
    private List<ImageSummaryResponse> _myImages = new();
    private List<GrantSummaryResponse> _grants = new();
    private string _memberSearch = "";
    private readonly DiaryFormModel _diaryForm = new();
    private readonly DiaryFormModel _noteForm = new();
    private readonly HashSet<string> _noteRecipients = new();
    private readonly HashSet<string> _editNoteRecipients = new();
    private readonly HashSet<string> _diaryImageIds = new();
    private readonly HashSet<string> _editDiaryImageIds = new();
    private readonly HashSet<string> _noteImageIds = new();
    private readonly HashSet<string> _editNoteImageIds = new();
    private string? _errorMessage;
    private string? _editingEntryId;
    private string _editText = "";
    private string? _editingNoteId;
    private string _editNoteText = "";

    private string _attachItemId = "";
    private string _attachBankEntryId = "";
    private string _attachImageId = "";
    private string _attachNpcSheetId = "";
    private string _attachCreatureSheetId = "";

    private string _newEncounterNome = "";
    private string _grantPlayerId = "";
    private string _grantTipo = "Npc";
    private string _grantSourceSheetId = "";

    protected override async Task OnInitializedAsync()
    {
        // LoadCampaignNameAsync matches the loaded campaign's ImageUrl against _myImages, so
        // images must be loaded first rather than joining the WhenAll below.
        await LoadImagesAsync();
        await Task.WhenAll(LoadMembersAsync(), LoadSheetsAsync(), LoadDiaryAsync(), LoadEncountersAsync(), LoadAttachmentsAsync(), LoadSecretNotesAsync(), LoadCampaignNameAsync(), SearchPlayersAsync(), LoadGrantsAsync());
    }

    private async Task LoadGrantsAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/grants");
        if (response.IsSuccessStatusCode)
            _grants = await response.Content.ReadFromJsonAsync<List<GrantSummaryResponse>>() ?? new();
    }

    private async Task LoadImagesAsync()
    {
        var response = await Http.GetAsync("images/mine");
        if (response.IsSuccessStatusCode)
            _myImages = await response.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();
    }

    private async Task<List<PickerOption>> SearchItemsAsync(string query)
    {
        var response = await Http.GetAsync($"items?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        return items.Select(i => new PickerOption(i.Id, i.Nome)).ToList();
    }

    private async Task<List<PickerOption>> SearchBankEntriesAsync(string query)
    {
        var response = await Http.GetAsync($"spell-ability-bank?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var entries = await response.Content.ReadFromJsonAsync<List<SpellAbilityEntryResponse>>() ?? new();
        return entries.Select(e => new PickerOption(e.Id, $"{e.Nome} ({e.Tipo}, Grau {e.Grau})")).ToList();
    }

    // No new HTTP call needed — _myImages is already loaded for the Diário/Notas Secretas image
    // picker, and images don't have a separate name to search by, just their upload timestamp.
    private Task<List<PickerOption>> SearchImagesAsync(string query) => Task.FromResult(
        _myImages.Where(i => i.Url.Contains(query, StringComparison.OrdinalIgnoreCase))
            .Select(i => new PickerOption(i.Id, $"{i.Url} ({i.CreatedAt:g})"))
            .ToList());

    private async Task<List<PickerOption>> SearchNpcSheetsAsync(string query)
    {
        var response = await Http.GetAsync($"npc-sheets?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var sheets = await response.Content.ReadFromJsonAsync<List<NpcSheetSummaryResponse>>() ?? new();
        return sheets.Select(s => new PickerOption(s.Id, s.Nome)).ToList();
    }

    private async Task<List<PickerOption>> SearchCreatureSheetsAsync(string query)
    {
        var response = await Http.GetAsync($"creature-sheets?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var sheets = await response.Content.ReadFromJsonAsync<List<CreatureSheetSummaryResponse>>() ?? new();
        return sheets.Select(s => new PickerOption(s.Id, s.Nome)).ToList();
    }

