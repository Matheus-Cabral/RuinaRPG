@page "/auditoria/condicoes"
@inject HttpClient Http
@inject PericiaCatalogo Catalogo
@using RuinaRPG.Client.Shared.Fields
@using RuinaRPG.Contracts.Condicoes
@using RuinaRPG.Domain.Condicoes
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />
<div class="d-flex align-center" style="gap:4px">
    <MudText Typo="Typo.h3">Auditoria: Condições</MudText>
    <InfoPopup Title="O que são as Condições">
        <MudText>
            Uma Condição é um estado aplicado a participantes durante um encontro (Envenenado, Lento, Abençoado...). Não são os Efeitos que uma Magia compra com PI: esses ficam em Auditoria: Efeitos. Ela só age enquanto o encontro está em andamento.
        </MudText>
        <MudText Class="mt-2">
            Cada linha de modificador altera um número da ficha, por um valor fixo ou por uma porcentagem. <b>Total</b> de um recurso muda o máximo, e some quando a Condição sai. <b>Valor atual</b> muda o que o participante tem agora, uma vez ao aplicar ou a cada vez do participante, e nunca é devolvido. As categorias desabilitadas fazem equipamentos, Magias, Habilidades, Runas ou Passivas deixarem de valer. O catálogo vale para todo o servidor, e editá-lo ou excluir uma entrada não altera uma Condição já aplicada a um participante.
        </MudText>
    </InfoPopup>
</div>

<DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

@if (_forbidden)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mt-3">Você não é o Auditor de Regras designado — sem permissão para editar.</MudAlert>
}
else
{
    @if (_form is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" StartIcon="@Icons.Material.Filled.Add" OnClick="Nova">Nova condição</MudButton>
    }
    else
    {
        <Section Title="@(_form.Id is null ? "Nova condição" : "Editar condição")">
            <MudTextField T="string" @bind-Value="_form.Nome" Label="Nome" />
            <MudTextField T="string" @bind-Value="_form.Descricao" Label="Descrição" Lines="3" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Ícone</MudText>
            <div class="d-flex flex-wrap">
                @foreach (var chave in CondicaoIcones.Chaves)
                {
                    var escolhido = _form.Icone == chave;
                    <MudIconButton Icon="@CondicaoIcone.Icone(chave)" title="@CondicaoIcone.Nome(chave)" aria-label="@CondicaoIcone.Nome(chave)"
                                   Color="@(escolhido ? Color.Primary : Color.Default)" Variant="@(escolhido ? Variant.Filled : Variant.Text)"
                                   OnClick="@(() => _form.Icone = chave)" />
                }
            </div>
            <MudNumericField T="int?" @bind-Value="_form.DuracaoPadraoTurnos" Label="Duração padrão (Turnos, opcional)" Min="1" HelperText="Vazio = dura até ser removida." />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Modificadores</MudText>
            <CondicaoModificadoresEditor Linhas="_form.Linhas" Pericias="Catalogo.Ativas" />
            <MudSelect T="string" Label="Categorias desabilitadas" Class="mt-3" MultiSelection="true"
                       SelectedValues="@_form.Categorias" SelectedValuesChanged="@(v => _form.Categorias = v.ToList())"
                       MultiSelectionTextFunc="@RotulosDasCategorias">
                @foreach (var o in CondicaoAlvos.Categorias)
                {
                    <MudSelectItem T="string" Value="@o.Valor">@o.Rotulo</MudSelectItem>
                }
            </MudSelect>
            <div class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync">Salvar</MudButton>
                <MudButton Variant="Variant.Text" OnClick="Cancelar">Cancelar</MudButton>
            </div>
        </Section>
    }

    <Section Title="Condições">
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr><th></th><th>Nome</th><th>O que faz</th><th>Duração</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var c in _condicoes)
                {
                    <tr @key="c.Id">
                        <td><MudIcon Icon="@CondicaoIcone.Icone(c.Icone)" title="@CondicaoIcone.Nome(c.Icone)" /></td>
                        <td>@c.Nome</td>
                        <td>@Resumo(c)</td>
                        <td>@(c.DuracaoPadraoTurnos is { } t ? $"{t} {(t == 1 ? "Turno" : "Turnos")}" : "—")</td>
                        <td>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="@($"Editar {c.Nome}")" aria-label="@($"Editar {c.Nome}")" OnClick="@(() => Editar(c))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="@($"Excluir {c.Nome}")" aria-label="@($"Excluir {c.Nome}")" OnClick="@(() => PedirExclusao(c))" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </Section>
}

<MudDialog @bind-Visible="_excluirAberto">
    <TitleContent>Excluir condição</TitleContent>
    <DialogContent>
        Excluir @_pendente?.Nome do catálogo? Isso não altera as condições já aplicadas a participantes.
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _excluirAberto = false)">Cancelar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="ConfirmarExclusaoAsync">Excluir</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Auditoria: Condições"),
    };

    private List<CondicaoResponse> _condicoes = new();
    private CondicaoFormModel? _form;
    private CondicaoResponse? _pendente;
    private bool _excluirAberto;
    private string? _errorMessage;
    private bool _forbidden;

    protected override async Task OnInitializedAsync()
    {
        await Catalogo.CarregarAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var response = await Http.GetAsync("condicoes");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar as condições.";
            return;
        }

        _condicoes = await response.Content.ReadFromJsonAsync<List<CondicaoResponse>>() ?? new();
    }

    private void Nova() => _form = new CondicaoFormModel();

    private void Cancelar() => _form = null;

    private void Editar(CondicaoResponse c) => _form = new CondicaoFormModel
    {
        Id = c.Id,
        Nome = c.Nome,
        Descricao = c.Descricao,
        Icone = c.Icone,
        DuracaoPadraoTurnos = c.DuracaoPadraoTurnos,
        Linhas = c.Modificadores.Select(m => new CondicaoLinhaForm
        {
            Alvo = m.Alvo,
            Especifico = m.AlvoEspecifico ?? "",
            TipoDeValor = m.TipoDeValor,
            Valor = m.Valor,
            Momento = m.Momento
        }).ToList(),
        Categorias = c.Desabilitacoes.ToList()
    };

    private async Task SalvarAsync()
    {
        if (_form is null)
            return;

        var body = new SalvarCondicaoRequest(_form.Nome, _form.Descricao, _form.Icone, _form.DuracaoPadraoTurnos,
            _form.Linhas.Select(l => new CondicaoModificadorDto(l.Alvo, string.IsNullOrEmpty(l.Especifico) ? null : l.Especifico, l.TipoDeValor, l.Valor, l.Momento)).ToList(),
            _form.Categorias.ToList());
        var response = _form.Id is null
            ? await Http.PostAsJsonAsync("condicoes", body)
            : await Http.PutAsJsonAsync($"condicoes/{_form.Id}", body);

        if (!await ChecarAsync(response, "Não foi possível salvar a condição."))
            return;

        _form = null;
        await LoadAsync();
    }

    private void PedirExclusao(CondicaoResponse c)
    {
        _pendente = c;
        _excluirAberto = true;
    }

    private async Task ConfirmarExclusaoAsync()
    {
        _excluirAberto = false;
        if (_pendente is null)
            return;

        var c = _pendente;
        _pendente = null;
        if (!await ChecarAsync(await Http.DeleteAsync($"condicoes/{c.Id}"), "Não foi possível excluir a condição."))
            return;

        await LoadAsync();
    }

    // 403: o usuário não é o Auditor. 400: a API devolve a mensagem em português, mostrada como veio.
    private async Task<bool> ChecarAsync(HttpResponseMessage response, string mensagemPadrao)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _forbidden = true;
            return false;
        }
        if (!response.IsSuccessStatusCode)
        {
            var detalhe = await response.Content.ReadAsStringAsync();
            _errorMessage = response.StatusCode == System.Net.HttpStatusCode.BadRequest && !string.IsNullOrWhiteSpace(detalhe) ? detalhe : mensagemPadrao;
            return false;
        }
        return true;
    }

    private static string RotulosDasCategorias(IReadOnlyList<string> escolhidas) =>
        string.Join(", ", escolhidas.Select(v => CondicaoAlvos.Categorias.FirstOrDefault(o => o.Valor == v)?.Rotulo ?? v));

    // O texto do motor do Domain, numa linha só.
    private string Resumo(CondicaoResponse c)
    {
        var modificadores = new List<ModificadorDeCondicao>();
        foreach (var m in c.Modificadores)
        {
            if (Enum.TryParse<AlvoDeCondicao>(m.Alvo, out var alvo) && Enum.TryParse<TipoDeValorDeCondicao>(m.TipoDeValor, out var tipo))
                modificadores.Add(new ModificadorDeCondicao(alvo, m.AlvoEspecifico, tipo, m.Valor, Enum.TryParse<MomentoDeCondicao>(m.Momento, out var momento) ? momento : null));
        }

        var desabilitacoes = new Dictionary<CategoriaDesabilitavel, IReadOnlySet<Guid>>();
        foreach (var d in c.Desabilitacoes)
        {
            if (Enum.TryParse<CategoriaDesabilitavel>(d, out var categoria))
                desabilitacoes[categoria] = new HashSet<Guid>();
        }

        var ativa = new CondicaoAtiva(Guid.Empty, c.Nome, modificadores, desabilitacoes);
        return string.Join("; ", new EfeitosDeCondicao([ativa]).Explicar(Catalogo.Label)[0].Linhas);
    }
}
