@page "/painel"
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject TokenAuthenticationStateProvider AuthProvider
@using RuinaRPG.Contracts.Auth
@using RuinaRPG.Contracts.CharacterSheets
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">Painel</MudText>

<Section>
    @if (_me is null)
    {
        <MudText Class="mt-3">Carregando...</MudText>
    }
    else
    {
        <MudText Class="mt-3">Bem-vindo(a), @_me.Nickname.</MudText>

        @if (_me.Role == "GM")
        {
            <MudList T="string" Class="mt-3">
                <MudListItem T="string" Text="Convidar Jogador" SecondaryText="Gere e acompanhe códigos de convite." Href="painel/convites" />
                <MudListItem T="string" Text="Bestiário do GM" SecondaryText="Suas fichas de criatura." Href="bestiario" />
                <MudListItem T="string" Text="NPCs do GM" SecondaryText="Suas fichas de NPC." Href="npcs" />
                <MudListItem T="string" Text="Itens e Equipamentos" SecondaryText="Catálogo de itens, armas, armaduras e artefatos." Href="catalogo" />
                <MudListItem T="string" Text="Campanhas" SecondaryText="Conceda fichas, gerencie o diário e os anexos de cada campanha." Href="campanhas" />
            </MudList>
        }
        else
        {
            @if (_errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
            }
            else if (_myCharacters.Count == 0)
            {
                <MudText Color="Color.Secondary" Class="mt-3">Você ainda não tem nenhuma ficha de personagem — peça ao seu GM para criar uma.</MudText>
            }

            <MudList T="string" Class="mt-3">
                @foreach (var sheet in _myCharacters)
                {
                    <MudListItem T="string" Href="@($"fichas/{sheet.Id}")">
                        <ChildContent>
                            @if (sheet.ImageUrl is not null)
                            {
                                <ClickableAvatarImage Src="@sheet.ImageUrl" Class="mr-3" />
                            }
                            <div>
                                <MudText Typo="Typo.subtitle1">@(sheet.Nome ?? "(sem nome)")</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Nível @sheet.Nivel — @sheet.CampanhaNome</MudText>
                            </div>
                        </ChildContent>
                    </MudListItem>
                }
            </MudList>
        }
    }

    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3" OnClick="LogoutAsync">Sair</MudButton>
</Section>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new() { new("Painel") };

    private MeResponse? _me;
    private List<MyCharacterSheetSummaryResponse> _myCharacters = new();
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var meResponse = await Http.GetAsync("auth/me");
        if (!meResponse.IsSuccessStatusCode)
            return;

        _me = await meResponse.Content.ReadFromJsonAsync<MeResponse>();
        if (_me?.Role == "Jogador")
            await LoadMyCharactersAsync();
    }

    private async Task LoadMyCharactersAsync()
    {
        var response = await Http.GetAsync("character-sheets/mine");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar suas fichas.";
            return;
        }

        _myCharacters = await response.Content.ReadFromJsonAsync<List<MyCharacterSheetSummaryResponse>>() ?? new();
        _errorMessage = null;
    }

    private async Task LogoutAsync()
    {
        var refreshToken = await AuthState.GetRefreshTokenAsync();
        if (refreshToken is not null)
            await Http.PostAsJsonAsync("auth/logout", new RefreshRequest(refreshToken));

        await AuthState.ClearAsync();
        AuthProvider.NotifyUserChanged();
        Navigation.NavigateTo("/");
    }
}
