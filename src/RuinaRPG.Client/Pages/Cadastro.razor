@page "/cadastro"
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject TokenAuthenticationStateProvider AuthProvider
@using System.ComponentModel.DataAnnotations
@using RuinaRPG.Contracts.Auth
@using MudBlazor

<div class="rr-auth">
    <div class="rr-auth-card">
        <img src="branding/logo-pequena.png" alt="Ruína RPG" class="rr-auth-logo" />
        <MudText Typo="Typo.h4" Class="rr-auth-title">Cadastro</MudText>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
        }

        <MudTabs>
            <MudTabPanel Text="Gamemaster">
                <EditForm Model="_gmRequest" OnValidSubmit="SubmitGmAsync">
                    <DataAnnotationsValidator />
                    <MudTextField T="string" @bind-Value="_gmRequest.Nickname" Label="Nickname" For="@(() => _gmRequest.Nickname)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_gmRequest.Email" Label="Email" For="@(() => _gmRequest.Email)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_gmRequest.Senha" Label="Senha" InputType="InputType.Password" For="@(() => _gmRequest.Senha)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_gmRequest.ConfirmacaoSenha" Label="Confirmação da Senha" InputType="InputType.Password" For="@(() => _gmRequest.ConfirmacaoSenha)" FullWidth="true" Class="mt-3" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Cadastrar</MudButton>
                </EditForm>
            </MudTabPanel>
            <MudTabPanel Text="Jogador">
                <EditForm Model="_jogadorRequest" OnValidSubmit="SubmitJogadorAsync">
                    <DataAnnotationsValidator />
                    <MudTextField T="string" @bind-Value="_jogadorRequest.Nickname" Label="Nickname" For="@(() => _jogadorRequest.Nickname)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_jogadorRequest.Email" Label="Email" For="@(() => _jogadorRequest.Email)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_jogadorRequest.Senha" Label="Senha" InputType="InputType.Password" For="@(() => _jogadorRequest.Senha)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_jogadorRequest.ConfirmacaoSenha" Label="Confirmação da Senha" InputType="InputType.Password" For="@(() => _jogadorRequest.ConfirmacaoSenha)" FullWidth="true" Class="mt-3" />
                    <MudTextField T="string" @bind-Value="_jogadorRequest.CodigoDeAcesso" Label="Código de acesso" For="@(() => _jogadorRequest.CodigoDeAcesso)" FullWidth="true" Class="mt-3" />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Cadastrar</MudButton>
                </EditForm>
            </MudTabPanel>
        </MudTabs>

        <MudText Typo="Typo.body2" Class="rr-auth-switch">
            Já tem conta? <MudLink Href="/login">Entrar</MudLink>
        </MudText>
    </div>
</div>

@code {
    private readonly GmFormModel _gmRequest = new();
    private readonly JogadorFormModel _jogadorRequest = new();
    private string? _errorMessage;

    private async Task SubmitGmAsync()
    {
        var response = await Http.PostAsJsonAsync("auth/register/gm",
            new RegisterGmRequest(_gmRequest.Nickname, _gmRequest.Email, _gmRequest.Senha, _gmRequest.ConfirmacaoSenha));
        await HandleResponseAsync(response);
    }

    private async Task SubmitJogadorAsync()
    {
        var response = await Http.PostAsJsonAsync("auth/register/jogador",
            new RegisterJogadorRequest(_jogadorRequest.Nickname, _jogadorRequest.Email, _jogadorRequest.Senha,
                _jogadorRequest.ConfirmacaoSenha, _jogadorRequest.CodigoDeAcesso));
        await HandleResponseAsync(response);
    }

    private async Task HandleResponseAsync(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await response.Content.ReadErrorMessageAsync();
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<AuthResponse>();
        await AuthState.SetTokensAsync(body!);
        AuthProvider.NotifyUserChanged();
        Navigation.NavigateTo("/painel");
    }

    private class GmFormModel
    {
        [Required(ErrorMessage = "Informe o Nickname.")]
        public string Nickname { get; set; } = "";

        [Required(ErrorMessage = "Informe o email.")]
        [EmailAddress(ErrorMessage = "Email inválido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Informe a senha.")]
        public string Senha { get; set; } = "";

        [Required(ErrorMessage = "Confirme a senha.")]
        [Compare(nameof(Senha), ErrorMessage = "A confirmação de senha não confere com a senha.")]
        public string ConfirmacaoSenha { get; set; } = "";
    }

    private class JogadorFormModel
    {
        [Required(ErrorMessage = "Informe o Nickname.")]
        public string Nickname { get; set; } = "";

        [Required(ErrorMessage = "Informe o email.")]
        [EmailAddress(ErrorMessage = "Email inválido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Informe a senha.")]
        public string Senha { get; set; } = "";

        [Required(ErrorMessage = "Confirme a senha.")]
        [Compare(nameof(Senha), ErrorMessage = "A confirmação de senha não confere com a senha.")]
        public string ConfirmacaoSenha { get; set; } = "";

        [Required(ErrorMessage = "Informe o código de acesso.")]
        public string CodigoDeAcesso { get; set; } = "";
    }
}
