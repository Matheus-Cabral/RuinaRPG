@page "/banco-de-magias"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.SpellsAndAbilities
@using RuinaRPG.Domain.CharacterSheets
@using RuinaRPG.Domain.SpellsAndAbilities
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">Banco de Magias e Habilidades</MudText>

<Section Title="Filtros">
    <MudGrid Class="mt-3">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" @bind-Value="_nomeFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Nome" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" @bind-Value="_tipoFiltro" @bind-Value:after="LoadAsync" Label="Tipo">
                <MudSelectItem Value="@("")">Todos os Tipos</MudSelectItem>
                <MudSelectItem Value="@("Magia")">Magia</MudSelectItem>
                <MudSelectItem Value="@("Habilidade")">Habilidade</MudSelectItem>
                <MudSelectItem Value="@("Racial")">Racial</MudSelectItem>
                <MudSelectItem Value="@("Passiva")">Passiva</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudNumericField T="int?" @bind-Value="_grauFiltro" Immediate="true" @bind-Value:after="DebouncedLoadAsync" Label="Grau" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" @bind-Value="_criaturaFiltro" @bind-Value:after="LoadAsync" Label="Criatura">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                <MudSelectItem Value="@("true")">Só de Criatura</MudSelectItem>
                <MudSelectItem Value="@("false")">Sem Criatura</MudSelectItem>
            </MudSelect>
        </MudItem>
        @* Filtros de Passiva (R0004): aplicados aqui, sobre a lista já carregada; escolher um deixa só Passivas. *@
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" @bind-Value="_categoriaFiltro" Label="Categoria">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                @foreach (var categoria in Enum.GetValues<CategoriaDePassiva>())
                {
                    <MudSelectItem Value="@categoria.ToString()">@RequisitoLabels.Categoria(categoria)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" @bind-Value="_vocacaoFiltro" Label="Vocação">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                @foreach (var vocacao in Vocacoes())
                {
                    <MudSelectItem Value="@vocacao">@vocacao</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" @bind-Value="_classeFiltro" Label="Classe">
                <MudSelectItem Value="@("")">Todas</MudSelectItem>
                @foreach (var classe in Classes())
                {
                    <MudSelectItem Value="@classe">@classe</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</Section>

<Section Title="Magias e Habilidades">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="@(() => Navigation.NavigateTo("/banco-de-magias/novo"))">Nova Entrada</MudButton>

    <DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

    <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Grau</th>
                <th>Gasto em PI</th>
                <th>Custo</th>
                <th>Efeitos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in EntradasFiltradas())
            {
                <tr>
                    <td>
                        @entry.Nome
                        @if (entry.DeCriatura)
                        {
                            @* Mesmo ícone e cor do Bestiário no menu lateral (NavMenu). *@
                            <MudIcon Icon="@Icons.Material.Filled.Pets" Color="Color.Primary" Size="Size.Small" Title="Magia/Habilidade de Criatura" Class="ml-1" Style="vertical-align:middle" />
                        }
                    </td>
                    <td>@entry.Tipo</td>
                    @if (entry.Tipo == "Passiva")
                    {
                        <td>—</td>
                        <td>—</td>
                        <td>—</td>
                        <td>@(Enum.TryParse<CategoriaDePassiva>(entry.Categoria, out var categoria) ? RequisitoLabels.Categoria(categoria) : "—")</td>
                    }
                    else
                    {
                        <td>@entry.Grau</td>
                        <td>@entry.GastoEmPI</td>
                        <td>@entry.Custo</td>
                        <td>@SpellAbilityEffectSummaryFormatter.Formatar(entry.Grau, entry.Efeitos.Select(e => (e.EfeitoNome, e.Quantidade)))</td>
                    }
                    <td>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/banco-de-magias/{entry.Id}/editar"))">Editar</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAsync(entry.Id))">Excluir</MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</Section>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Banco de Magias e Habilidades"),
    };

    private string _nomeFiltro = "";
    private string _tipoFiltro = "";
    private int? _grauFiltro;
    private string _criaturaFiltro = "";
    private string _categoriaFiltro = "";
    private string _vocacaoFiltro = "";
    private string _classeFiltro = "";
    private List<SpellAbilityEntryResponse> _entries = new();
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    // Rótulo de exibição da Vocação exigida, como na aba Habilidades Passivas do Livro de Regras.
    private static string? VocacaoDe(SpellAbilityEntryResponse entry) =>
        Enum.TryParse<Vocacao>(entry.Requisitos?.Vocacao, out var vocacao) ? RequisitoLabels.Vocacao(vocacao) : null;

    private static string? ClasseDe(SpellAbilityEntryResponse entry) =>
        string.IsNullOrWhiteSpace(entry.Requisitos?.Classe) ? null : entry.Requisitos.Classe.Trim();

    private List<string> Vocacoes() => ValoresPresentes(VocacaoDe);

    private List<string> Classes() => ValoresPresentes(ClasseDe);

    private List<string> ValoresPresentes(Func<SpellAbilityEntryResponse, string?> valor) =>
        _entries.Where(e => e.Tipo == "Passiva").Select(valor).OfType<string>().Distinct().OrderBy(v => v, StringComparer.InvariantCultureIgnoreCase).ToList();

    private IEnumerable<SpellAbilityEntryResponse> EntradasFiltradas() =>
        _categoriaFiltro == "" && _vocacaoFiltro == "" && _classeFiltro == ""
            ? _entries
            : _entries.Where(e => e.Tipo == "Passiva"
                && (_categoriaFiltro == "" || e.Categoria == _categoriaFiltro)
                && (_vocacaoFiltro == "" || VocacaoDe(e) == _vocacaoFiltro)
                && (_classeFiltro == "" || ClasseDe(e) == _classeFiltro));

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedLoadAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = $"?nome={Uri.EscapeDataString(_nomeFiltro)}&tipo={_tipoFiltro}&grau={_grauFiltro}";
        if (_criaturaFiltro != "")
            query += $"&deCriatura={_criaturaFiltro}";
        var response = await Http.GetAsync($"spell-ability-bank{query}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar o banco de magias e habilidades.";
            return;
        }

        _entries = await response.Content.ReadFromJsonAsync<List<SpellAbilityEntryResponse>>() ?? new();
        // Vocação/Classe que não existem na lista recarregada deixam de filtrar.
        if (!Vocacoes().Contains(_vocacaoFiltro)) _vocacaoFiltro = "";
        if (!Classes().Contains(_classeFiltro)) _classeFiltro = "";
        _errorMessage = null;
    }

    private async Task DeleteAsync(string id)
    {
        var response = await Http.DeleteAsync($"spell-ability-bank/{id}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir a entrada.";
            return;
        }

        await LoadAsync();
    }
}
