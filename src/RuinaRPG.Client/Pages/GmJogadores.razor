@page "/painel/jogadores"
@inject HttpClient Http
@using RuinaRPG.Contracts.Players
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">Jogadores</MudText>

<MudTextField T="string" @bind-Value="_query" Immediate="true" @bind-Value:after="DebouncedSearchAsync" Label="Buscar por nickname ou e-mail" Class="mt-3" />

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
}

<MudList T="string" Class="mt-3">
    @foreach (var player in _players)
    {
        <MudListItem T="string">
            <ChildContent>
                <MudText>@player.Nickname (@player.Email)</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => StartReset(player.Id)">Redefinir senha</MudButton>

                @if (_resettingPlayerId == player.Id)
                {
                    <Section Title="@("Redefinir senha de " + player.Nickname)">
                        <EditForm Model="_resetRequest" OnValidSubmit="ConfirmResetAsync">
                            <MudTextField T="string" @bind-Value="_resetRequest.NovaSenha" InputType="InputType.Password" Label="Nova senha" />
                            <MudTextField T="string" @bind-Value="_resetRequest.ConfirmacaoNovaSenha" InputType="InputType.Password" Label="Confirmação da nova senha" />
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Confirmar</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3" OnClick="CancelReset">Cancelar</MudButton>
                        </EditForm>
                    </Section>
                }
            </ChildContent>
        </MudListItem>
    }
</MudList>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Jogadores"),
    };

    private string _query = "";
    private List<PlayerSearchResultResponse> _players = new();
    private string? _errorMessage;
    private string? _resettingPlayerId;
    private readonly ResetFormModel _resetRequest = new();

    protected override Task OnInitializedAsync() => SearchAsync();

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var response = await Http.GetAsync($"players?q={Uri.EscapeDataString(_query)}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível buscar jogadores.";
            return;
        }

        _errorMessage = null;
        _players = await response.Content.ReadFromJsonAsync<List<PlayerSearchResultResponse>>() ?? new();
    }

    private void StartReset(string playerId) => _resettingPlayerId = playerId;

    private void CancelReset()
    {
        _resettingPlayerId = null;
        _resetRequest.NovaSenha = "";
        _resetRequest.ConfirmacaoNovaSenha = "";
    }

    private async Task ConfirmResetAsync()
    {
        var response = await Http.PostAsJsonAsync($"players/{_resettingPlayerId}/reset-password",
            new ResetPlayerPasswordRequest(_resetRequest.NovaSenha, _resetRequest.ConfirmacaoNovaSenha));

        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível redefinir a senha.";
            return;
        }

        _errorMessage = null;
        _resettingPlayerId = null;
        _resetRequest.NovaSenha = "";
        _resetRequest.ConfirmacaoNovaSenha = "";
    }

    private class ResetFormModel
    {
        public string NovaSenha { get; set; } = "";
        public string ConfirmacaoNovaSenha { get; set; } = "";
    }
}
