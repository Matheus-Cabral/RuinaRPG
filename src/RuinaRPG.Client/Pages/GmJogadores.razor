@page "/painel/jogadores"
@inject HttpClient Http
@using RuinaRPG.Contracts.Players

<Breadcrumbs Items="@Crumbs" />

<h1>Jogadores</h1>

<div class="mb-3">
    <label class="form-label">Buscar por nickname ou e-mail</label>
    <input class="form-control" @bind="_query" @bind:event="oninput" @bind:after="DebouncedSearchAsync" placeholder="Buscar por nickname ou e-mail" />
</div>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<ul class="list-unstyled">
    @foreach (var player in _players)
    {
        <li class="mb-2">
            @player.Nickname (@player.Email)
            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => StartReset(player.Id)">Redefinir senha</button>

            @if (_resettingPlayerId == player.Id)
            {
                <Section Title="@("Redefinir senha de " + player.Nickname)">
                    <EditForm Model="_resetRequest" OnValidSubmit="ConfirmResetAsync">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label">Nova senha</label>
                                <InputText type="password" class="form-control" @bind-Value="_resetRequest.NovaSenha" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Confirmação da nova senha</label>
                                <InputText type="password" class="form-control" @bind-Value="_resetRequest.ConfirmacaoNovaSenha" />
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary">Confirmar</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelReset">Cancelar</button>
                            </div>
                        </div>
                    </EditForm>
                </Section>
            }
        </li>
    }
</ul>

@code {
    private List<BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Jogadores"),
    };

    private string _query = "";
    private List<PlayerSearchResultResponse> _players = new();
    private string? _errorMessage;
    private string? _resettingPlayerId;
    private readonly ResetFormModel _resetRequest = new();

    protected override Task OnInitializedAsync() => SearchAsync();

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var response = await Http.GetAsync($"players?q={Uri.EscapeDataString(_query)}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível buscar jogadores.";
            return;
        }

        _errorMessage = null;
        _players = await response.Content.ReadFromJsonAsync<List<PlayerSearchResultResponse>>() ?? new();
    }

    private void StartReset(string playerId) => _resettingPlayerId = playerId;

    private void CancelReset()
    {
        _resettingPlayerId = null;
        _resetRequest.NovaSenha = "";
        _resetRequest.ConfirmacaoNovaSenha = "";
    }

    private async Task ConfirmResetAsync()
    {
        var response = await Http.PostAsJsonAsync($"players/{_resettingPlayerId}/reset-password",
            new ResetPlayerPasswordRequest(_resetRequest.NovaSenha, _resetRequest.ConfirmacaoNovaSenha));

        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível redefinir a senha.";
            return;
        }

        _errorMessage = null;
        _resettingPlayerId = null;
        _resetRequest.NovaSenha = "";
        _resetRequest.ConfirmacaoNovaSenha = "";
    }

    private class ResetFormModel
    {
        public string NovaSenha { get; set; } = "";
        public string ConfirmacaoNovaSenha { get; set; } = "";
    }
}
