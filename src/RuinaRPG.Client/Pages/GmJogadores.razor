@page "/painel/jogadores"
@inject HttpClient Http
@inject IDialogService Dialogs
@using RuinaRPG.Contracts.Players
@using RuinaRPG.Domain.Auth
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">Jogadores</MudText>

<Section Title="Filtros">
    <MudTextField T="string" @bind-Value="_query" Immediate="true" @bind-Value:after="DebouncedSearchAsync" Label="Buscar por nickname ou e-mail" />
</Section>

<Section Title="Jogadores">
    <DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

    <div data-testid="jogadores-ativos">
        @TabelaDeJogadores(Ativos, ativos: true)
    </div>
</Section>

@if (Desativados.Any())
{
    <Section Title="Desativados">
        <div data-testid="jogadores-desativados">
            @TabelaDeJogadores(Desativados, ativos: false)
        </div>
    </Section>
}

@code {
    private RenderFragment TabelaDeJogadores(IEnumerable<PlayerSearchResultResponse> jogadores, bool ativos) => __builder =>
    {
        <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
            <thead>
                <tr>
                    <th>Nickname</th>
                    <th>E-mail</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var player in jogadores)
                {
                    <tr>
                        <td>@player.Nickname</td>
                        <td>@player.Email</td>
                        <td>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => StartReset(player.Id, player.Nickname))">Redefinir senha</MudButton>
                            @if (ativos)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonOff" data-testid="@($"desativar-{player.Id}")" OnClick="@(() => DesativarAsync(player))">Desativar</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" data-testid="@($"reativar-{player.Id}")" OnClick="@(() => ChangeStateAsync(player.Id, "reativar"))">Reativar</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete" data-testid="@($"excluir-{player.Id}")" OnClick="@(() => StartDelete(player))">Excluir</MudButton>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };
}

<MudDialog @bind-Visible="_deleteDialogOpen">
    <TitleContent>Excluir @_deletingPlayer?.Nickname</TitleContent>
    <DialogContent>
        <DismissibleAlert @bind-Message="_deleteErrorMessage" Class="mb-3" />
        <MudText>Esta ação não pode ser desfeita. Digite o apelido do jogador para confirmar.</MudText>
        <MudTextField T="string" @bind-Value="_typedNickname" Immediate="true" Label="Apelido" data-testid="apelido-exclusao" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelDelete">Cancelar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(_typedNickname != _deletingPlayer?.Nickname)" data-testid="confirmar-exclusao" OnClick="ConfirmDeleteAsync">Excluir</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_resetDialogOpen">
    <TitleContent>Redefinir senha de @_resettingPlayerNickname</TitleContent>
    <DialogContent>
        <DismissibleAlert @bind-Message="_resetErrorMessage" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_resetRequest.NovaSenha" InputType="InputType.Password" Label="Nova senha" />
        <MudTextField T="string" @bind-Value="_resetRequest.ConfirmacaoNovaSenha" InputType="InputType.Password" Label="Confirmação da nova senha" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelReset">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmResetAsync">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Jogadores"),
    };

    private const string EstadoDesativada = nameof(EstadoDaConta.Desativada);

    private string _query = "";
    private IEnumerable<PlayerSearchResultResponse> Ativos => _players.Where(p => p.Estado != EstadoDesativada);
    private IEnumerable<PlayerSearchResultResponse> Desativados => _players.Where(p => p.Estado == EstadoDesativada);
    private PlayerSearchResultResponse? _deletingPlayer;
    private bool _deleteDialogOpen;
    private string _typedNickname = "";
    private string? _deleteErrorMessage;
    private List<PlayerSearchResultResponse> _players = new();
    private string? _errorMessage;
    private string? _resettingPlayerId;
    private string? _resettingPlayerNickname;
    private bool _resetDialogOpen;
    private string? _resetErrorMessage;
    private readonly ResetFormModel _resetRequest = new();

    protected override Task OnInitializedAsync() => SearchAsync();

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var response = await Http.GetAsync($"players?q={Uri.EscapeDataString(_query)}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível buscar jogadores.";
            return;
        }

        _errorMessage = null;
        _players = await response.Content.ReadFromJsonAsync<List<PlayerSearchResultResponse>>() ?? new();
    }

    private async Task DesativarAsync(PlayerSearchResultResponse player)
    {
        var confirmou = await Dialogs.ShowMessageBoxAsync(
            $"Desativar {player.Nickname}",
            $"{player.Nickname} sai de todas as suas campanhas: as fichas de personagem dele vão para o cemitério, as fichas de NPC e Criatura concedidas a ele voltam ao GM e ele sai dos Encontros ativos. A conta deixa de entrar no sistema até ser reativada.",
            yesText: "Desativar", cancelText: "Cancelar");
        if (confirmou != true)
            return;

        await ChangeStateAsync(player.Id, "desativar");
    }

    private static async Task<string> ErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        switch (response.StatusCode)
        {
            case System.Net.HttpStatusCode.BadRequest:
                var detail = await response.Content.ReadAsStringAsync();
                return string.IsNullOrWhiteSpace(detail) ? fallback : detail;
            case System.Net.HttpStatusCode.Conflict:
                var conflito = await response.Content.ReadAsStringAsync();
                return string.IsNullOrWhiteSpace(conflito) ? "A conta já está nesse estado." : conflito;
            case System.Net.HttpStatusCode.NotFound:
                return "Jogador não encontrado.";
            default:
                return fallback;
        }
    }

    private async Task ChangeStateAsync(string playerId, string action)
    {
        var response = await Http.PostAsync($"players/{playerId}/{action}", null);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await ErrorMessageAsync(response, "Não foi possível alterar o estado da conta.");
            return;
        }

        _errorMessage = null;

        await SearchAsync();
    }

    private void StartDelete(PlayerSearchResultResponse player)
    {
        _deletingPlayer = player;
        _typedNickname = "";
        _deleteErrorMessage = null;
        _deleteDialogOpen = true;
    }

    private void CancelDelete()
    {
        _deleteDialogOpen = false;
        _deletingPlayer = null;
        _typedNickname = "";
        _deleteErrorMessage = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        var response = await Http.PostAsJsonAsync($"players/{_deletingPlayer!.Id}/excluir", new ExcluirContaRequest(_typedNickname));
        if (!response.IsSuccessStatusCode)
        {
            _deleteErrorMessage = await ErrorMessageAsync(response, "Não foi possível excluir a conta.");
            return;
        }

        CancelDelete();
        await SearchAsync();
    }

    private void StartReset(string playerId, string nickname)
    {
        _resettingPlayerId = playerId;
        _resettingPlayerNickname = nickname;
        _resetDialogOpen = true;
    }

    private void CancelReset()
    {
        _resetDialogOpen = false;
        _resettingPlayerId = null;
        _resettingPlayerNickname = null;
        _resetErrorMessage = null;
        _resetRequest.NovaSenha = "";
        _resetRequest.ConfirmacaoNovaSenha = "";
    }

    private async Task ConfirmResetAsync()
    {
        var response = await Http.PostAsJsonAsync($"players/{_resettingPlayerId}/reset-password",
            new ResetPlayerPasswordRequest(_resetRequest.NovaSenha, _resetRequest.ConfirmacaoNovaSenha));

        if (!response.IsSuccessStatusCode)
        {
            _resetErrorMessage = "Não foi possível redefinir a senha.";
            return;
        }

        CancelReset();
    }

    private class ResetFormModel
    {
        public string NovaSenha { get; set; } = "";
        public string ConfirmacaoNovaSenha { get; set; } = "";
    }
}
