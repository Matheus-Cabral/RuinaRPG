@page "/compendio"
@inject HttpClient Http
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Domain.Rules

<Breadcrumbs Items="@Crumbs" />

<h1>Compêndio de Regras</h1>

<div>
    <input @bind="_query" @bind:event="oninput" @bind:after="DebouncedSearchAsync" placeholder="Buscar..." />
    @foreach (var categoria in _categorias)
    {
        <label>
            <input type="checkbox" checked="@_selectedCategorias.Contains(categoria)"
                   @onchange="@(e => ToggleCategoriaAsync(categoria, (bool)e.Value!))" />
            @categoria
        </label>
    }
</div>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

@foreach (var group in _results.GroupBy(r => r.Categoria))
{
    <h2>@CategoriaLabel(group.Key) (@group.Count())</h2>
    <ul>
        @foreach (var result in group)
        {
            var snippet = CompendioSnippetBuilder.Build(result.Conteudo, string.IsNullOrWhiteSpace(_query) ? null : _query);
            <li>
                <strong>@result.Titulo</strong> — <em>@result.Origem</em>
                <p>
                    @snippet.Before
                    @if (snippet.Match is not null)
                    {
                        <mark>@snippet.Match</mark>
                    }
                    @snippet.After
                </p>
            </li>
        }
    </ul>
}

@code {
    private List<BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Compêndio de Regras"),
    };

    private readonly string[] _categorias = ["Caracteristica", "Efeito", "Tabela", "Regra"];
    private readonly HashSet<string> _selectedCategorias = [];
    private string _query = "";
    private List<CompendioSearchResultResponse> _results = new();
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => SearchAsync();

    private CancellationTokenSource? _debounceCts;

    private async Task DebouncedSearchAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await SearchAsync();
    }

    private async Task ToggleCategoriaAsync(string categoria, bool isSelected)
    {
        if (isSelected)
            _selectedCategorias.Add(categoria);
        else
            _selectedCategorias.Remove(categoria);

        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var queryString = $"q={Uri.EscapeDataString(_query)}";
        foreach (var categoria in _selectedCategorias)
            queryString += $"&categorias={categoria}";

        var response = await Http.GetAsync($"compendio/search?{queryString}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível buscar no Compêndio.";
            return;
        }

        _results = await response.Content.ReadFromJsonAsync<List<CompendioSearchResultResponse>>() ?? new();
        _errorMessage = null;
    }

    private static string CategoriaLabel(string categoria) => categoria switch
    {
        "Caracteristica" => "Características",
        "Efeito" => "Efeitos",
        "Tabela" => "Tabelas",
        "Regra" => "Regras",
        _ => categoria,
    };
}
