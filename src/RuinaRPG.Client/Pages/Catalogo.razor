@page "/catalogo"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Items

<Breadcrumbs Items="@Crumbs" />

<h1>Catálogo de Itens e Equipamentos</h1>

<button @onclick="@(() => Navigation.NavigateTo("/catalogo/novo"))">Novo Item</button>

<div>
    <label>Tipo
        <select @bind="_tipoFiltro" @bind:after="LoadAsync">
            <option value="">Todos os Tipos</option>
            <option value="ItemGeral">Item Geral</option>
            <option value="Arma">Arma</option>
            <option value="Armadura">Armadura</option>
            <option value="Escudo">Escudo</option>
            <option value="Artefato">Artefato</option>
        </select>
    </label>
    <label>Subcategoria <input @bind="_subcategoriaFiltro" @bind:event="oninput" @bind:after="LoadAsync" /></label>
    <label>Tier <input @bind="_tierFiltro" @bind:event="oninput" @bind:after="LoadAsync" /></label>
    <label>Categoria <input @bind="_categoriaFiltro" @bind:event="oninput" @bind:after="LoadAsync" /></label>
    <label>Tipo de Dano <input @bind="_tipoDeDanoFiltro" @bind:event="oninput" @bind:after="LoadAsync" /></label>
</div>

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<table>
    <thead>
        <tr>
            <th>Nome</th>
            <th>Tipo</th>
            <th>Subcategoria</th>
            <th>Peso</th>
            <th>Preço</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in _items)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.Tipo</td>
                <td>@(item.Subcategoria ?? "—")</td>
                <td>@item.Peso</td>
                <td>@item.Preco</td>
                <td>
                    <button @onclick="@(() => Navigation.NavigateTo($"/catalogo/{item.Id}/editar"))">Editar</button>
                    <button @onclick="@(() => DeleteAsync(item.Id))">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Catálogo de Itens"),
    };

    private string _tipoFiltro = "";
    private string _subcategoriaFiltro = "";
    private string _tierFiltro = "";
    private string _categoriaFiltro = "";
    private string _tipoDeDanoFiltro = "";
    private List<ItemResponse> _items = new();
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(_tipoFiltro))
            query.Add($"tipo={_tipoFiltro}");
        if (!string.IsNullOrWhiteSpace(_subcategoriaFiltro))
            query.Add($"subcategoria={Uri.EscapeDataString(_subcategoriaFiltro)}");
        if (!string.IsNullOrWhiteSpace(_tierFiltro))
            query.Add($"tier={Uri.EscapeDataString(_tierFiltro)}");
        if (!string.IsNullOrWhiteSpace(_categoriaFiltro))
            query.Add($"categoria={Uri.EscapeDataString(_categoriaFiltro)}");
        if (!string.IsNullOrWhiteSpace(_tipoDeDanoFiltro))
            query.Add($"tipoDeDano={Uri.EscapeDataString(_tipoDeDanoFiltro)}");

        var queryString = query.Count > 0 ? $"?{string.Join("&", query)}" : "";
        var response = await Http.GetAsync($"items{queryString}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar o catálogo.";
            return;
        }

        _items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        _errorMessage = null;
    }

    private async Task DeleteAsync(string id)
    {
        var response = await Http.DeleteAsync($"items/{id}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir o item.";
            return;
        }

        await LoadAsync();
    }
}
