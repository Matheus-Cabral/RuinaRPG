@page "/catalogo"
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Items
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">Catálogo de Itens e Equipamentos</MudText>

<Section Title="Filtros">
    <MudGrid Class="mt-3">
        <MudItem xs="12" md="4">
            <MudSelect T="string" @bind-Value="_tipoFiltro" @bind-Value:after="LoadAsync" Label="Tipo">
                <MudSelectItem Value="@("")">Todos os Tipos</MudSelectItem>
                <MudSelectItem Value="@("ItemGeral")">Item Geral</MudSelectItem>
                <MudSelectItem Value="@("Arma")">Arma</MudSelectItem>
                <MudSelectItem Value="@("Armadura")">Armadura</MudSelectItem>
                <MudSelectItem Value="@("Escudo")">Escudo</MudSelectItem>
                <MudSelectItem Value="@("Artefato")">Artefato</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_nomeFiltro" Immediate="true" @bind-Value:after="LoadAsync" Label="Nome" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudAutocomplete T="string" @bind-Value="_subcategoriaFiltro" @bind-Value:after="LoadAsync" SearchFunc="SearchSubcategoriasAsync"
                              Label="Subcategoria" Clearable="true" CoerceText="false" ResetValueOnEmptyText="true" MaxItems="null" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_tierFiltro" Immediate="true" @bind-Value:after="LoadAsync" Label="Tier" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_categoriaFiltro" Immediate="true" @bind-Value:after="LoadAsync" Label="Categoria" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_tipoDeDanoFiltro" Immediate="true" @bind-Value:after="LoadAsync" Label="Tipo de Dano" />
        </MudItem>
    </MudGrid>
</Section>

<Section Title="Itens">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="@(() => Navigation.NavigateTo("/catalogo/novo"))">Novo Item</MudButton>

    <DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

    <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Subcategoria</th>
                <th>Peso</th>
                <th>Preço</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in _items)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Tipo</td>
                    <td>@(item.Subcategoria ?? "—")</td>
                    <td>@item.Peso</td>
                    <td>@item.Preco</td>
                    <td>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/catalogo/{item.Id}/editar"))">Editar</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAsync(item.Id))">Excluir</MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</Section>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Catálogo de Itens"),
    };

    private string _nomeFiltro = "";
    private string _tipoFiltro = "";
    private string? _subcategoriaFiltro;
    private string _tierFiltro = "";
    private string _categoriaFiltro = "";
    private string _tipoDeDanoFiltro = "";
    private List<ItemResponse> _items = new();
    private List<string> _subcategoriasDisponiveis = new();
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadSubcategoriasDisponiveisAsync();
        await LoadAsync();
    }

    private async Task LoadSubcategoriasDisponiveisAsync()
    {
        // Fetched once, unfiltered — the source list for the Subcategoria searchable select
        // below. Independent of the table's own filtered LoadAsync so picking a Subcategoria
        // doesn't shrink the list of Subcategorias offered for the *next* pick.
        var response = await Http.GetAsync("items");
        if (!response.IsSuccessStatusCode)
            return;

        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        _subcategoriasDisponiveis = items
            .Select(i => i.Subcategoria)
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!)
            .Distinct()
            .OrderBy(s => s)
            .ToList();
    }

    internal Task<IEnumerable<string>> SearchSubcategoriasAsync(string query, CancellationToken token) =>
        Task.FromResult(FiltrarSubcategorias(_subcategoriasDisponiveis, query));

    internal static IEnumerable<string> FiltrarSubcategorias(IReadOnlyList<string> disponiveis, string query) =>
        string.IsNullOrWhiteSpace(query)
            ? disponiveis
            : disponiveis.Where(s => s.Contains(query, StringComparison.OrdinalIgnoreCase));

    private async Task LoadAsync()
    {
        var queryString = BuildQueryString(_nomeFiltro, _tipoFiltro, _subcategoriaFiltro, _tierFiltro, _categoriaFiltro, _tipoDeDanoFiltro);
        var response = await Http.GetAsync($"items{queryString}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar o catálogo.";
            return;
        }

        _items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        _errorMessage = null;
    }

    internal static string BuildQueryString(string? nome, string? tipo, string? subcategoria, string? tier, string? categoria, string? tipoDeDano)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(nome))
            query.Add($"nome={Uri.EscapeDataString(nome)}");
        if (!string.IsNullOrEmpty(tipo))
            query.Add($"tipo={tipo}");
        if (!string.IsNullOrWhiteSpace(subcategoria))
            query.Add($"subcategoria={Uri.EscapeDataString(subcategoria)}");
        if (!string.IsNullOrWhiteSpace(tier))
            query.Add($"tier={Uri.EscapeDataString(tier)}");
        if (!string.IsNullOrWhiteSpace(categoria))
            query.Add($"categoria={Uri.EscapeDataString(categoria)}");
        if (!string.IsNullOrWhiteSpace(tipoDeDano))
            query.Add($"tipoDeDano={Uri.EscapeDataString(tipoDeDano)}");

        return query.Count > 0 ? $"?{string.Join("&", query)}" : "";
    }

    private async Task DeleteAsync(string id)
    {
        var response = await Http.DeleteAsync($"items/{id}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível excluir o item.";
            return;
        }

        await LoadAsync();
    }
}
