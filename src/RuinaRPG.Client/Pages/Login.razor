@page "/login"
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject TokenAuthenticationStateProvider AuthProvider
@using System.ComponentModel.DataAnnotations
@using RuinaRPG.Contracts.Auth
@using MudBlazor

<div class="rr-auth">
    <div class="rr-auth-card">
        <img src="branding/logo-pequena.png" alt="Ruína RPG" class="rr-auth-logo" />
        <MudText Typo="Typo.h4" Class="rr-auth-title">Entrar</MudText>

        <EditForm Model="_request" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <MudTextField T="string" @bind-Value="_request.Nickname" Label="Nickname" For="@(() => _request.Nickname)" FullWidth="true" />
            <MudTextField T="string" @bind-Value="_request.Senha" Label="Senha" InputType="InputType.Password" For="@(() => _request.Senha)" FullWidth="true" Class="mt-3" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Entrar</MudButton>
        </EditForm>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
        }

        <MudText Typo="Typo.body2" Class="rr-auth-switch">
            Não tem conta? <MudLink Href="/cadastro">Cadastre-se</MudLink>
        </MudText>
    </div>
</div>

@code {
    private readonly LoginFormModel _request = new();
    private string? _errorMessage;

    private async Task SubmitAsync()
    {
        var response = await Http.PostAsJsonAsync("auth/login", new LoginRequest(_request.Nickname, _request.Senha));

        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Nickname ou senha inválidos.";
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<AuthResponse>();
        await AuthState.SetTokensAsync(body!);
        AuthProvider.NotifyUserChanged();
        Navigation.NavigateTo("/painel");
    }

    private class LoginFormModel
    {
        [Required(ErrorMessage = "Informe o Nickname.")]
        public string Nickname { get; set; } = "";

        [Required(ErrorMessage = "Informe a senha.")]
        public string Senha { get; set; } = "";
    }
}
