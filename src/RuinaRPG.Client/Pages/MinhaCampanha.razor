@page "/campanhas/{CampaignId}/jogador"
@inject HttpClient Http
@using RuinaRPG.Contracts.Campaigns
@using MudBlazor

<MudText Typo="Typo.h3">Minha Campanha</MudText>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
}

<MudTabs Class="mt-3">
    <MudTabPanel Text="Minhas Fichas">
        <MudList T="string">
            @foreach (var ficha in _view.MinhasFichas)
            {
                <MudListItem T="string" Text="@($"{(ficha.Nome ?? "(sem nome)")} — Nível {ficha.Nivel}")" Href="@($"fichas/{ficha.Id}")" />
            }
        </MudList>
    </MudTabPanel>

    <MudTabPanel Text="Meus Companheiros">
        <MudList T="string">
            @foreach (var companheiro in _view.MeusCompanheiros)
            {
                <MudListItem T="string" Text="@($"{(companheiro.Nome ?? "(sem nome)")} ({(companheiro.Tipo == "Npc" ? "NPC" : "Criatura")})")" Href="@((companheiro.Tipo == "Npc" ? "npcs/" : "criaturas/") + companheiro.Id)" />
            }
        </MudList>
    </MudTabPanel>

    <MudTabPanel Text="Anexos Públicos">
        <MudSimpleTable Dense="true" Hover="true">
            <tbody>
                @foreach (var anexo in _view.AnexosPublicos)
                {
                    <tr>
                        <td>
                            [@anexo.Tipo] @(anexo.Nome ?? "(sem nome público)")
                            @if (anexo.ImageUrl is not null)
                            {
                                <MudImage Src="@anexo.ImageUrl" Alt="@anexo.Nome" Width="120" Class="ml-2" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public string CampaignId { get; set; } = "";

    private PlayerCampaignViewResponse _view = new(new(), new(), new());
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var response = await Http.GetAsync($"campaigns/{CampaignId}/player-view");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar a campanha.";
            return;
        }

        _view = await response.Content.ReadFromJsonAsync<PlayerCampaignViewResponse>() ?? _view;
        _errorMessage = null;
    }
}
