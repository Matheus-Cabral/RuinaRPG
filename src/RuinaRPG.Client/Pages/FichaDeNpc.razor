    {
        _weapons = await Http.GetFromJsonAsync<List<WeaponResponse>>($"npc-sheets/{SheetId}/weapons") ?? new();
        _armorSlots = await Http.GetFromJsonAsync<List<ArmorSlotResponse>>($"npc-sheets/{SheetId}/armor-slots") ?? new();
        _shields = await Http.GetFromJsonAsync<List<ShieldResponse>>($"npc-sheets/{SheetId}/shields") ?? new();
        _subAttributes = await Http.GetFromJsonAsync<SubAttributesResponse>($"npc-sheets/{SheetId}/sub-attributes");
        _modificadorDeDano = await Http.GetFromJsonAsync<ModificadorDeDanoResponse>($"npc-sheets/{SheetId}/modificador-de-dano");
    }

