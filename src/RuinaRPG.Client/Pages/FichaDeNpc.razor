@page "/npcs/{SheetId}"
@implements IDisposable
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@using RuinaRPG.Contracts.NpcSheets
@using RuinaRPG.Contracts.SpellsAndAbilities
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Contracts.Images
@using RuinaRPG.Contracts.Items
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Client.Shared.Fields
@using MudBlazor
@using System.ComponentModel.DataAnnotations

<Breadcrumbs Items="@Crumbs" />
<h1>Ficha de NPC</h1>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_errorMessage</MudAlert>
}

<MudDialog @bind-Visible="_racialChoiceDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false })">
    <DialogContent>
        <MudText Typo="Typo.h6">Escolha a Característica Racial do NPC</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Toda Variante concede uma Característica Gratuita, a escolher entre as opções abaixo — algumas Variantes também exigem uma Característica Obrigatória.
        </MudText>

        <MudText Typo="Typo.subtitle1">Característica Gratuita</MudText>
        <MudRadioGroup T="string" @bind-Value="_racialGratuitaChoice">
            @foreach (var option in _pendingRacialChoice?.Gratuita ?? new())
            {
                <MudRadio Value="@option.TraitNome">@option.TraitNome</MudRadio>
            }
        </MudRadioGroup>

        @if (_pendingRacialChoice?.Obrigatoria.Count > 1)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">Característica Obrigatória</MudText>
            <MudRadioGroup T="string" @bind-Value="_racialObrigatoriaChoice">
                @foreach (var option in _pendingRacialChoice.Obrigatoria)
                {
                    <MudRadio Value="@option.TraitNome">@option.TraitNome</MudRadio>
                }
            </MudRadioGroup>
        }
        else if (_pendingRacialChoice?.Obrigatoria.Count == 1)
        {
            <MudText Typo="Typo.body2" Class="mt-3">O NPC também recebe automaticamente: <b>@_pendingRacialChoice.Obrigatoria[0].TraitNome</b>.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _racialChoiceDialogOpen = false)">Decidir depois</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_racialGratuitaChoice is null)" OnClick="ConfirmRacialChoiceAsync">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

<MudTabs>
    <MudTabPanel Text="Informações Básicas">
        <EditForm Model="_form">
            <DataAnnotationsValidator />
            <AutoSaveIndicator State="_autoSave.State" LastSavedAt="_autoSave.LastSavedAt" />
            <Section Title="Identidade">
                <div class="mb-4">
                    <MudAvatar Style="width:96px;height:96px;cursor:pointer" @onclick="@(() => _imageExpanded = true)">
                        @if (_form.ImageUrl is not null)
                        {
                            <MudImage Src="@_form.ImageUrl" ObjectFit="ObjectFit.Cover" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        }
                    </MudAvatar>
                </div>

                <MudDialog @bind-Visible="_imageExpanded">
                    <DialogContent>
                        @if (_form.ImageUrl is not null)
                        {
                            <MudImage Src="@_form.ImageUrl" Width="240" Class="mb-2" />
                        }
                        <div>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => _imageEditing = !_imageEditing)" title="Editar imagem" />
                            @if (_form.ImageId is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="RemoveImage" title="Remover imagem" />
                            }
                        </div>

                        @if (_imageEditing)
                        {
                            <MudFileUpload T="IBrowserFile" FilesChanged="UploadImageAsync" Class="mt-2">
                                <CustomContent Context="fileUploadContext">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => fileUploadContext.OpenFilePickerAsync())">Enviar nova imagem</MudButton>
                                </CustomContent>
                            </MudFileUpload>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" OnClick="@(() => _imageGalleryOpen = true)">Escolher imagem já enviada</MudButton>
                            <ImageGalleryDialog @bind-Visible="_imageGalleryOpen" Images="_myImages" AllowClear="true"
                                                 IsSelectedFunc="@(id => id == _form.ImageId)"
                                                 OnPick="@(id => { SelectExistingImage(id); _imageGalleryOpen = false; })" />
                        }
                    </DialogContent>
                    <DialogActions>
                        <MudButton OnClick="@(() => _imageExpanded = false)">Fechar</MudButton>
                    </DialogActions>
                </MudDialog>

                <MudTextField T="string" @bind-Value="_form.Nome" Label="Nome" @bind-Value:after="NotifySavedAsync" />
                <LinhagemVarianteFields @bind-Linhagem="_form.Linhagem" @bind-Variante="_form.Variante" @bind-Linhagem:after="NotifySavedAsync" @bind-Variante:after="NotifySavedAsync" />
                <VocacaoSubVocacaoFields @bind-Vocacao="_form.Vocacao" @bind-SubVocacao="_form.SubVocacao" @bind-Vocacao:after="NotifySavedAsync" @bind-SubVocacao:after="NotifySavedAsync" />
                <AfinidadeSelect @bind-Value="_form.Afinidade" @bind-Value:after="NotifySavedAsync" />
                <MudTextField T="string" @bind-Value="_form.Propriedade" Label="Propriedade" @bind-Value:after="NotifySavedAsync" />
            </Section>

            <Section Title="Nível e Progressão">
                <MudNumericField T="int?" @bind-Value="_form.Nivel" For="@(() => _form.Nivel)" Label="Nível" @bind-Value:after="NotifyNivelChangedAsync" />
                <MudText>@_form.GraduacaoLabel: @_form.Graduacao</MudText>
                <MudCheckBox T="bool" @bind-Value="_form.PossuiCoracaoDeMana" Label="Possui Coração de Mana?" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.ExperienciaAtual" For="@(() => _form.ExperienciaAtual)" Label="Experiência Atual" @bind-Value:after="NotifyExperienciaAtualChangedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.EAPAtual" For="@(() => _form.EAPAtual)" Label="VIS Atual" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.PontosDeIgnicaoAtual" For="@(() => _form.PontosDeIgnicaoAtual)" Label="Pontos de Ignição Atual" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.PontosDeIgnicaoTotal" For="@(() => _form.PontosDeIgnicaoTotal)" Label="Pontos de Ignição Total" @bind-Value:after="NotifySavedAsync" />
            </Section>

            <Section Title="Âmbares Absorvidos">
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankF" For="@(() => _form.NucleosRankF)" Label="Rank F" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankE" For="@(() => _form.NucleosRankE)" Label="Rank E" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankD" For="@(() => _form.NucleosRankD)" Label="Rank D" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankC" For="@(() => _form.NucleosRankC)" Label="Rank C" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankB" For="@(() => _form.NucleosRankB)" Label="Rank B" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankA" For="@(() => _form.NucleosRankA)" Label="Rank A" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.NucleosRankS" For="@(() => _form.NucleosRankS)" Label="Rank S" @bind-Value:after="NotifySavedAsync" />
            </Section>

            <Section Title="Recursos">
                <MudNumericField T="int?" @bind-Value="_form.AdrenalinaAtual" For="@(() => _form.AdrenalinaAtual)" Label="Adrenalina (PA)" Adornment="Adornment.End" AdornmentText="@($"/ {_form.AdrenalinaMaximo}")" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.FocoAtual" For="@(() => _form.FocoAtual)" Label="Foco (PF)" Adornment="Adornment.End" AdornmentText="@($"/ {_form.FocoMaximo}")" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.EstresseAtual" For="@(() => _form.EstresseAtual)" Label="Estresse" Adornment="Adornment.End" AdornmentText="@($"/ {_form.EstresseMaximo}")" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.VitalidadeAtual" For="@(() => _form.VitalidadeAtual)" Label="Vitalidade" Adornment="Adornment.End" AdornmentText="@($"/ {_form.VitalidadeMaximo}")" @bind-Value:after="NotifySavedAsync" />
            </Section>
        </EditForm>
    </MudTabPanel>

    <MudTabPanel Text="Atributos & Perícias">
        <Section Title="Atributos">
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Atributo</th><th>Gasto</th><th>Bônus</th><th>Proeficiência</th><th>Total</th></tr></thead>
                <tbody>
                    @foreach (var attr in _attributes)
                    {
                        <tr>
                            <td>@AtributoDisplay.Label(attr.Atributo)</td>
                            <td><MudNumericField T="int?" Value="@attr.Gasto" ValueChanged="@(v => UpdateAttributeAsync(attr.Atributo, "Gasto", v))" /></td>
                            <td><MudNumericField T="int?" Value="@attr.Bonus" ValueChanged="@(v => UpdateAttributeAsync(attr.Atributo, "Bonus", v))" /></td>
                            <td><MudCheckBox T="bool" Value="@attr.TemMaestria" ValueChanged="@(v => UpdateAttributeAsync(attr.Atributo, "TemMaestria", v))" Dense="true" /></td>
                            <td>@attr.Total</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Perícias">
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Perícia</th><th>Gasto</th><th>Modificador</th><th>Atributo</th><th>Total</th></tr></thead>
                <tbody>
                    @foreach (var skill in _skills)
                    {
                        <tr>
                            <td>@PericiaDisplay.Label(skill.Pericia)</td>
                            <td><MudNumericField T="int?" Value="@skill.Gasto" ValueChanged="@(v => UpdateSkillGastoAsync(skill.Pericia, v))" /></td>
                            <td>@skill.Modificador</td>
                            <td>
                                <MudSelect T="string" Value="@skill.AtributoEscolhido" ValueChanged="@(v => UpdateSkillAtributoAsync(skill.Pericia, v))">
                                    <MudSelectItem Value="@("")">—</MudSelectItem>
                                    @foreach (var attr in _attributes)
                                    {
                                        <MudSelectItem Value="@attr.Atributo">@AtributoDisplay.Label(attr.Atributo)</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>@skill.Total</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Afinidades">
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Essência Básica</th><th>Sub-Elemento</th><th>Caminho</th><th>Experiência</th><th></th></tr></thead>
                <tbody>
                    @foreach (var affinity in _affinities)
                    {
                        <tr>
                            <td>
                                <AfinidadeEssenciaField Label="Elemento" Opcoes="AfinidadeEssenciaField.Elementos"
                                                         Nome="@affinity.Elemento" NomeChanged="@(v => UpdateAffinityAsync(affinity.Id, "Elemento", v))"
                                                         Valor="@affinity.ElementoValor" ValorChanged="@(v => UpdateAffinityAsync(affinity.Id, "ElementoValor", v))" />
                            </td>
                            <td>
                                <AfinidadeEssenciaField Label="Sub-Elemento" Opcoes="AfinidadeEssenciaField.SubElementos"
                                                         Nome="@affinity.SubElemento" NomeChanged="@(v => UpdateAffinityAsync(affinity.Id, "SubElemento", v))"
                                                         Valor="@affinity.SubElementoValor" ValorChanged="@(v => UpdateAffinityAsync(affinity.Id, "SubElementoValor", v))" />
                            </td>
                            <td><MudTextField T="string" Value="@affinity.CaminhoNome" ValueChanged="@(v => UpdateAffinityAsync(affinity.Id, "CaminhoNome", v))" /></td>
                            <td><MudNumericField T="int?" Value="@affinity.Experiencia" ValueChanged="@(v => UpdateAffinityAsync(affinity.Id, "Experiencia", v))" /></td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAffinityAsync(affinity.Id))">Remover</MudButton></td>
                        </tr>
                    }
                    <tr>
                        <td>
                            <AfinidadeEssenciaField Label="Elemento" Opcoes="AfinidadeEssenciaField.Elementos"
                                                     @bind-Nome="_affinityForm.Elemento" @bind-Valor="_affinityForm.ElementoValor" />
                        </td>
                        <td>
                            <AfinidadeEssenciaField Label="Sub-Elemento" Opcoes="AfinidadeEssenciaField.SubElementos"
                                                     @bind-Nome="_affinityForm.SubElemento" @bind-Valor="_affinityForm.SubElementoValor" />
                        </td>
                        <td><MudTextField T="string" @bind-Value="_affinityForm.CaminhoNome" /></td>
                        <td><MudNumericField T="int?" @bind-Value="_affinityForm.Experiencia" /></td>
                        <td><MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddAffinityAsync">Adicionar</MudButton></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Combate">
        <Section Title="Armas">
            <EditForm Model="_weaponForm" OnValidSubmit="AddWeaponAsync">
                <EntityPicker @bind-Value="_weaponForm.ItemId" SearchItems="@(q => SearchItemsByTipoAsync(q, "Arma"))" Placeholder="Buscar arma..." />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Arma</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Tipo de Dano</th>
                        <th>Alcance</th>
                        <th>Dados</th>
                        <th>Dano</th>
                        <th>Crítico</th>
                        <th>Tier</th>
                        <th>Peso</th>
                        <th>Durabilidade</th>
                        <th>Equipada</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var weapon in _weapons)
                    {
                        <tr>
                            <td><ClickableItemName Nome="@weapon.Nome" ImageUrl="@weapon.ImageUrl" Descricao="@weapon.Descricao" /></td>
                            <td>@(weapon.TipoDeDano ?? "—")</td>
                            <td>@(weapon.Alcance?.ToString() ?? "—")</td>
                            <td>@(weapon.Dados ?? "—")</td>
                            <td>@(weapon.Dano?.ToString() ?? "—")</td>
                            <td>@(weapon.Critico ?? "—")</td>
                            <td>@(weapon.Tier ?? "—")</td>
                            <td>@weapon.Peso</td>
                            <td>
                                <MudNumericField T="int?" Value="@weapon.DurabilidadeAtual" ValueChanged="@(v => UpdateWeaponDurabilidadeAsync(weapon.Id, v))" Style="width:5em; display:inline-flex;" />
                                / @weapon.DurabilidadeMaxima
                            </td>
                            <td>@(weapon.IsEquipped ? "Equipada" : "")</td>
                            <td>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EquipWeaponAsync(weapon.Id, !weapon.IsEquipped))">@(weapon.IsEquipped ? "Desequipar" : "Equipar")</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteWeaponAsync(weapon.Id))">Remover</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Armaduras">
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>Slot</th>
                        <th>Armadura</th>
                        <th>Categoria</th>
                        <th>Defesa</th>
                        <th>RF</th>
                        <th>RM</th>
                        <th>Penalidade</th>
                        <th>Requisito de Vigor</th>
                        <th>Peso</th>
                        <th>Durabilidade</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in _armorSlots)
                    {
                        <tr>
                            <td>@slot.Slot</td>
                            <td>
                                @if (slot.Nome is not null)
                                {
                                    <ClickableItemName Nome="@slot.Nome" ImageUrl="@slot.ImageUrl" Descricao="@slot.Descricao" />
                                }
                                else
                                {
                                    @:—
                                }
                            </td>
                            <td>@(slot.Categoria ?? "—")</td>
                            <td>@(slot.Defesa?.ToString() ?? "—")</td>
                            <td>@(slot.RF?.ToString() ?? "—")</td>
                            <td>@(slot.RM?.ToString() ?? "—")</td>
                            <td>@(slot.Penalidade ?? "—")</td>
                            <td>@(slot.RequisitoVigor?.ToString() ?? "—")</td>
                            <td>@(slot.Peso?.ToString() ?? "—")</td>
                            <td>
                                @if (slot.ItemId is not null)
                                {
                                    <MudNumericField T="int?" Value="@slot.DurabilidadeAtual" ValueChanged="@(v => UpdateArmorSlotDurabilidadeAsync(slot.Slot, v))" Style="width:5em; display:inline-flex;" />
                                    <text> / @slot.DurabilidadeMaxima</text>
                                }
                            </td>
                            <td>
                                @if (slot.ItemId is not null)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => AssignArmorSlotAsync(slot.Slot, null))">Remover</MudButton>
                                }
                                else
                                {
                                    <span style="display: inline-block; width: 16em; vertical-align: middle;">
                                        <EntityPicker Value="@_armorSlotForm[slot.Slot]" ValueChanged="@(v => _armorSlotForm[slot.Slot] = v ?? "")" SearchItems="@(q => SearchItemsByTipoAsync(q, "Armadura"))" Placeholder="Buscar armadura..." />
                                    </span>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AssignArmorSlotAsync(slot.Slot, _armorSlotForm.GetValueOrDefault(slot.Slot)))">Atribuir</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Escudos">
            <EditForm Model="_shieldForm" OnValidSubmit="AddShieldAsync">
                <EntityPicker @bind-Value="_shieldForm.ItemId" SearchItems="@(q => SearchItemsByTipoAsync(q, "Escudo"))" Placeholder="Buscar escudo..." />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Escudo</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Categoria</th>
                        <th>Bônus de Defesa</th>
                        <th>Penalidade</th>
                        <th>Requisito de Vigor</th>
                        <th>Peso</th>
                        <th>Durabilidade</th>
                        <th>Equipado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shield in _shields)
                    {
                        <tr>
                            <td><ClickableItemName Nome="@shield.Nome" ImageUrl="@shield.ImageUrl" Descricao="@shield.Descricao" /></td>
                            <td>@(shield.Categoria ?? "—")</td>
                            <td>@(shield.BonusDefesa?.ToString() ?? "—")</td>
                            <td>@(shield.Penalidade ?? "—")</td>
                            <td>@(shield.RequisitoVigor?.ToString() ?? "—")</td>
                            <td>@shield.Peso</td>
                            <td>
                                <MudNumericField T="int?" Value="@shield.DurabilidadeAtual" ValueChanged="@(v => UpdateShieldDurabilidadeAsync(shield.Id, v))" Style="width:5em; display:inline-flex;" />
                                / @shield.DurabilidadeMaxima
                            </td>
                            <td>@(shield.IsEquipped ? "Equipado" : "")</td>
                            <td>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EquipShieldAsync(shield.Id, !shield.IsEquipped))">@(shield.IsEquipped ? "Desequipar" : "Equipar")</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteShieldAsync(shield.Id))">Remover</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        @if (_subAttributes is not null)
        {
            <Section Title="Sub-Atributos">
                <MudText>Iniciativa: @_subAttributes.Iniciativa</MudText>
                <MudText>Movimentação: @_subAttributes.Movimentacao</MudText>
                <MudText>Esquiva Natural: @_subAttributes.EsquivaNatural</MudText>
                <MudText>Defesa Natural: @_subAttributes.DefesaNatural</MudText>
                <MudText>Redução Física: @_subAttributes.ReducaoFisica</MudText>
                <MudText>Redução Mágica: @_subAttributes.ReducaoMagica</MudText>
                <MudSelect T="string" Value="@_form.Cobertura" ValueChanged="@(v => UpdateCoberturaAsync(v))" Label="Cobertura">
                    <MudSelectItem Value="@("Nenhuma")">Nenhuma (+0)</MudSelectItem>
                    <MudSelectItem Value="@("Parcial")">Parcial (+5)</MudSelectItem>
                    <MudSelectItem Value="@("Completa")">Completa (+10)</MudSelectItem>
                </MudSelect>
            </Section>
        }

        @if (_modificadorDeDano is not null)
        {
            <Section Title="Modificador de Dano">
                <MudText>Cortante: @_modificadorDeDano.Cortante</MudText>
                <MudText>Perfurante: @_modificadorDeDano.Perfurante</MudText>
                <MudText>Contundente: @_modificadorDeDano.Contundente</MudText>
                <MudText>Arcano: @_modificadorDeDano.Arcano</MudText>
            </Section>
        }
    </MudTabPanel>

    <MudTabPanel Text="Magias & Habilidades">
        <Section Title="Habilidade Racial">
            <MudText>@(_racialAbility?.Nome ?? "—")</MudText>
            <MudText>@(_racialAbility?.Descricao ?? "—")</MudText>
            @if (_form.Linhagem == "Humano")
            {
                <MudNumericField T="int?" Value="@_form.ArcaRolada" ValueChanged="@(v => UpdateArcaRoladaAsync(v))" Label="Número rolado (1d18)" Min="1" Max="18" Style="width:12em;" Class="mt-2" />
                @if (_racialAbility?.ArcaRolada is not null)
                {
                    <MudText Class="mt-1">@(_racialAbility.ArcaNome ?? "Arca não cadastrada.")</MudText>
                    @if (_racialAbility.ArcaDescricao is not null)
                    {
                        <MudText>@_racialAbility.ArcaDescricao</MudText>
                    }
                }
            }
        </Section>

        <Section Title="Magias e Habilidades">
            <EditForm Model="_spellAbilityForm" OnValidSubmit="AddSpellAbilityAsync">
                <MudSelect T="string" @bind-Value="_spellAbilityForm.Origem" Label="Origem">
                    <MudSelectItem Value="@("Zero")">Montar do zero</MudSelectItem>
                    <MudSelectItem Value="@("Banco")">Escolher do Banco de Magias</MudSelectItem>
                </MudSelect>

                @if (_spellAbilityForm.Origem == "Banco")
                {
                    <MudSelect T="string" @bind-Value="_spellAbilityForm.SourceBankEntryId" Label="Entrada do Banco">
                        <MudSelectItem Value="@("")">Escolha uma entrada</MudSelectItem>
                        @foreach (var entry in _bankEntries)
                        {
                            <MudSelectItem Value="@entry.Id">@entry.Nome (@entry.Tipo, Grau @entry.Grau)</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField T="string" @bind-Value="_spellAbilityForm.Nome" Label="Nome" />
                    <MudSelect T="string" @bind-Value="_spellAbilityForm.Tipo" Label="Tipo">
                        <MudSelectItem Value="@("Magia")">Magia</MudSelectItem>
                        <MudSelectItem Value="@("Habilidade")">Habilidade</MudSelectItem>
                        <MudSelectItem Value="@("Racial")">Racial</MudSelectItem>
                    </MudSelect>
                    <MudNumericField T="int" @bind-Value="_spellAbilityForm.Grau" Label="Grau" />
                    <MudTextField T="string" @bind-Value="_spellAbilityForm.Descricao" Label="Descrição" Lines="3" />

                    <MudText Typo="Typo.h6" Class="mt-3">Efeitos</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="AddSpellAbilityEffect">Adicionar Efeito</MudButton>
                    <MudSimpleTable Dense="true" Hover="true" Class="mt-2">
                        <thead><tr><th>Nome do Efeito</th><th>Quantidade</th><th>Custo em PI</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < _spellAbilityForm.Efeitos.Count; i++)
                            {
                                var index = i; // capture for the closures below
                                <tr>
                                    <td><MudTextField T="string" @bind-Value="_spellAbilityForm.Efeitos[index].EfeitoNome" /></td>
                                    <td><MudNumericField T="int?" @bind-Value="_spellAbilityForm.Efeitos[index].Quantidade" /></td>
                                    <td><MudNumericField T="int" @bind-Value="_spellAbilityForm.Efeitos[index].CustoPI" /></td>
                                    <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => _spellAbilityForm.Efeitos.RemoveAt(index))">Remover</MudButton></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Magia/Habilidade</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <tbody>
                    @foreach (var spellAbility in _spellAbilities)
                    {
                        <tr>
                            <td>@spellAbility.Nome (@spellAbility.Tipo, Grau @spellAbility.Grau) — Gasto em PI @spellAbility.GastoEmPI, Custo @spellAbility.Custo — @spellAbility.Descricao</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteSpellAbilityAsync(spellAbility.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Runas">
            <EditForm Model="_runeForm" OnValidSubmit="AddRuneAsync">
                <MudTextField T="string" @bind-Value="_runeForm.Nome" Label="Nome" />
                <MudTextField T="string" @bind-Value="_runeForm.Descricao" Label="Descrição" Lines="3" />
                <MudNumericField T="int" @bind-Value="_runeForm.Grau" Label="Grau" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Runa</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <tbody>
                    @foreach (var rune in _runes)
                    {
                        <tr>
                            <td>@rune.Nome (Grau @rune.Grau) — @rune.Descricao</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteRuneAsync(rune.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Maestrias">
            <EditForm Model="_masteryForm" OnValidSubmit="AddMasteryAsync">
                <MudTextField T="string" @bind-Value="_masteryForm.Nome" Label="Nome" />
                <MudSelect T="string" @bind-Value="_masteryForm.Pericia" Label="Perícia">
                    <MudSelectItem Value="@("")">Escolha uma Perícia</MudSelectItem>
                    @foreach (var skill in _skills)
                    {
                        <MudSelectItem Value="@skill.Pericia">@PericiaDisplay.Label(skill.Pericia)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_masteryForm.Atributo" Label="Atributo">
                    <MudSelectItem Value="@("")">Escolha um Atributo</MudSelectItem>
                    @foreach (var attr in _attributes)
                    {
                        <MudSelectItem Value="@attr.Atributo">@AtributoDisplay.Label(attr.Atributo)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_masteryForm.GastoMaestria" Label="Gasto Maestria" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Maestria</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <tbody>
                    @foreach (var mastery in _masteries)
                    {
                        <tr>
                            <td>@mastery.Nome — @PericiaDisplay.Label(mastery.Pericia) / @AtributoDisplay.Label(mastery.Atributo) — Gasto @mastery.GastoMaestria — Total @mastery.Total</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteMasteryAsync(mastery.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Posses">
        <Section Title="Inventário">
            @if (_subAttributes?.PesoAtual is not null && _subAttributes.PesoMaximo is not null)
            {
                <MudText>Peso: @_subAttributes.PesoAtual?.ToString("0.##") / @_subAttributes.PesoMaximo?.ToString("0.##")</MudText>
                @if (_subAttributes.PesoAtual > _subAttributes.PesoMaximo)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-1">Sobrecarregado — reduz Movimentação.</MudAlert>
                }
            }
            <MudNumericField T="int?" Value="@_form.Ciclos" ValueChanged="@(v => UpdateCiclosAsync(v))" Label="Ciclos" Style="width:8em;" />
            <EditForm Model="_inventoryForm" OnValidSubmit="AddInventoryItemAsync">
                <EntityPicker @bind-Value="_inventoryForm.ItemId" SearchItems="@(q => SearchItemsByTipoAsync(q, "ItemGeral"))" Placeholder="Buscar item..." />
                <MudNumericField T="int" @bind-Value="_inventoryForm.Qtd" Label="Quantidade" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Item</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Peso</th>
                        <th>Qtd</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _inventory)
                    {
                        <tr>
                            <td><ClickableItemName Nome="@item.Nome" ImageUrl="@item.ImageUrl" Descricao="@item.Descricao" /></td>
                            <td>@item.Peso</td>
                            <td><MudNumericField T="int?" Value="@item.Qtd" ValueChanged="@(v => UpdateInventoryItemQtdAsync(item.Id, v))" Style="width:5em; display:inline-flex;" /></td>
                            <td>@item.Total</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteInventoryItemAsync(item.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Artefatos">
            <EditForm Model="_artifactForm" OnValidSubmit="AddArtifactAsync">
                <EntityPicker @bind-Value="_artifactForm.ArtifactItemId" SearchItems="@(q => SearchItemsByTipoAsync(q, "Artefato"))" Placeholder="Buscar artefato..." />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Artefato</MudButton>
            </EditForm>
            @foreach (var group in _artifacts.GroupBy(a => a.TipoDeAlvo))
            {
                <MudText Typo="Typo.h6" Class="mt-3">@group.Key</MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <tbody>
                        @foreach (var artifact in group)
                        {
                            <tr>
                                <td><ClickableItemName Nome="@artifact.Nome" ImageUrl="@artifact.ImageUrl" Descricao="@artifact.Descricao" /> — Alvo @artifact.Alvo — Valor @artifact.Valor</td>
                                <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteArtifactAsync(artifact.Id))">Remover</MudButton></td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </Section>

        <Section Title="Afeições">
            <EditForm Model="_affectionForm" OnValidSubmit="AddAffectionAsync">
                <MudTextField T="string" @bind-Value="_affectionForm.Nome" Label="Nome" />
                <MudNumericField T="int" @bind-Value="_affectionForm.Favorabilidade" Label="Favorabilidade" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Afeição</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <tbody>
                    @foreach (var affection in _affections)
                    {
                        <tr>
                            <td>@affection.Nome — Favorabilidade @affection.Favorabilidade</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAffectionAsync(affection.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Características">
            <EditForm Model="_traitForm" OnValidSubmit="AddTraitAsync">
                <EntityPicker @bind-Value="_traitForm.TraitId" SearchItems="SearchTraitsAsync" Placeholder="Buscar característica..." />
                <MudTextField @bind-Value="_traitForm.Especificacao" Label="Especificação (se exigida pela característica)" Class="mt-3" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Característica</MudButton>
            </EditForm>
            @{
                var pontosDisponiveis = _traits?.PontosDisponiveis ?? 0;
            }
            <MudText Color="@((_traits?.TotalPositivas ?? 0) > pontosDisponiveis ? Color.Error : Color.Default)" Class="mt-3">
                Positivas: @(_traits?.TotalPositivas ?? 0) / @pontosDisponiveis
            </MudText>
            <MudText Color="@(Math.Abs(_traits?.TotalNegativas ?? 0) > pontosDisponiveis ? Color.Error : Color.Default)">
                Negativas: @Math.Abs(_traits?.TotalNegativas ?? 0) / @pontosDisponiveis
            </MudText>
            <MudText Typo="Typo.h6" Class="mt-3">Positivas (Total: @(_traits?.TotalPositivas ?? 0))</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <tbody>
                    @foreach (var trait in _traits?.Positivas ?? new())
                    {
                        <tr>
                            <td>@trait.Nome (@trait.Custo) — @trait.Descricao@(string.IsNullOrWhiteSpace(trait.Especificacao) ? "" : $" ({trait.Especificacao})")</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTraitAsync(trait.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.h6" Class="mt-3">Negativas (Total: @(_traits?.TotalNegativas ?? 0))</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <tbody>
                    @foreach (var trait in _traits?.Negativas ?? new())
                    {
                        <tr>
                            <td>@trait.Nome (@trait.Custo) — @trait.Descricao@(string.IsNullOrWhiteSpace(trait.Especificacao) ? "" : $" ({trait.Especificacao})")</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTraitAsync(trait.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public string SheetId { get; set; } = "";

    // Value must match the Variante enum member name exactly (server parses it); label is the
    // real Sistema Básico display name (Ruína RPG - Sistema Básico §7).
    private static readonly Dictionary<string, (string Valor, string Rotulo)[]> VariantesPorLinhagem = new()
    {
        ["Humano"] = [("Sinir", "Sinir (Sol)"), ("Laonir", "Laonir (Lua)")],
        ["Phylauc"] = [("PhylacTai", "Phylac'tai (Sol)"), ("EsPhylauc", "Es'Phylauc (Lua)")],
        ["Nephrytes"] = [("Koroanos", "Koroanos (Sol)"), ("Yavos", "Yavos (Lua)")],
        ["Econos"] = [("Alora", "Alóra (Lua)")],
    };

    // Classe (displayed label; SubVocacao is the internal property/DB column name, kept as-is) is
    // free text server-side (no enum), so value == label here — from "Relação de Vocacão e Classes.md".
    private static readonly Dictionary<string, string[]> SubVocacoesPorVocacao = new()
    {
        ["Campeao"] = ["Cavalheiro", "Duelista", "Paladino", "Lamina Holística", "Guardião"],
        ["Cacador"] = ["Arqueiro", "Domador", "Assassino"],
        ["Feiticeiro"] = ["Aeromante", "Biomante", "Fluxomante", "Piromante", "Sábio"],
        ["Adepto"] = ["Paladino", "Arauto", "Trovador", "Eremita"],
        ["Bruxo"] = ["Ecomante", "Hemomante", "Osteomante", "Nexomante", "Cultista"],
    };

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("NPCs do GM", "npcs"),
        new(string.IsNullOrWhiteSpace(_form.Nome) ? "Ficha de NPC" : _form.Nome),
    };

    private readonly SheetFormModel _form = new();
    private readonly RuinaRPG.Client.Services.AutoSaveCoordinator _autoSave = new();
    private string? _errorMessage;
    private List<ImageSummaryResponse> _myImages = new();
    private bool _isGmCaller;
    private string? _campaignId;
    private bool _imageExpanded;
    private bool _imageEditing;
    private bool _imageGalleryOpen;
    private List<NpcAttributeResponse> _attributes = new();
    private List<NpcSkillResponse> _skills = new();
    private List<NpcAffinityResponse> _affinities = new();
    private readonly AffinityFormModel _affinityForm = new();
    private List<NpcWeaponResponse> _weapons = new();
    private List<NpcArmorSlotResponse> _armorSlots = new();
    private List<NpcShieldResponse> _shields = new();
    private readonly WeaponFormModel _weaponForm = new();
    private readonly ShieldFormModel _shieldForm = new();
    // Pre-seeded with the 3 fixed ArmorSlotType values so @bind's getter never sees a missing key.
    private readonly Dictionary<string, string> _armorSlotForm = new() { ["Capacete"] = "", ["Superior"] = "", ["Inferior"] = "" };
    private SubAttributesResponse? _subAttributes;
    private ModificadorDeDanoResponse? _modificadorDeDano;
    private RacialAbilityResponse? _racialAbility;
    private List<NpcSpellAbilityResponse> _spellAbilities = new();
    private List<SpellAbilityEntryResponse> _bankEntries = new();
    private readonly SpellAbilityFormModel _spellAbilityForm = new();
    private List<NpcRuneResponse> _runes = new();
    private readonly RuneFormModel _runeForm = new();
    private List<NpcMasteryResponse> _masteries = new();
    private readonly MasteryFormModel _masteryForm = new();
    private List<NpcInventoryItemResponse> _inventory = new();
    private readonly InventoryFormModel _inventoryForm = new();
    private List<NpcArtifactResponse> _artifacts = new();
    private readonly ArtifactFormModel _artifactForm = new();
    private List<NpcAffectionResponse> _affections = new();
    private readonly AffectionFormModel _affectionForm = new();
    private NpcTraitsListResponse? _traits;
    private PendingRacialTraitChoiceResponse? _pendingRacialChoice;
    private bool _racialChoiceDialogOpen;
    private string? _racialGratuitaChoice;
    private string? _racialObrigatoriaChoice;
    private readonly TraitFormModel _traitForm = new();

    private async Task<List<PickerOption>> SearchItemsByTipoAsync(string query, string tipo)
    {
        var url = _isGmCaller
            ? $"items?nome={Uri.EscapeDataString(query)}&tipo={tipo}"
            : $"campaigns/{_campaignId}/available-items?nome={Uri.EscapeDataString(query)}&tipo={tipo}";
        var response = await Http.GetAsync(url);
        if (!response.IsSuccessStatusCode) return new();
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        return items.Select(i => new PickerOption(i.Id, i.Nome)).ToList();
    }

    private async Task<List<PickerOption>> SearchTraitsAsync(string query)
    {
        var response = await Http.GetAsync($"traits?nome={Uri.EscapeDataString(query)}");
        if (!response.IsSuccessStatusCode) return new();
        var traits = await response.Content.ReadFromJsonAsync<List<TraitResponse>>() ?? new();
        return traits.Select(t => new PickerOption(t.Id, $"{t.Nome} ({t.Custo}, {t.Polaridade})")).ToList();
    }

    protected override void OnInitialized()
    {
        _autoSave.StateChanged += StateHasChangedFromAutoSave;
    }

    private void StateHasChangedFromAutoSave() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _autoSave.StateChanged -= StateHasChangedFromAutoSave;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _isGmCaller = authState.User.IsInRole("GM");

        // LoadSheetAsync sets _campaignId, which LoadImagesAsync now needs — see the identical
        // note in FichaDePersonagem.razor's OnInitializedAsync.
        await LoadSheetAsync();
        await LoadImagesAsync();

        await Task.WhenAll(
            LoadTabs2And3Async(),
            LoadRacialAbilityAsync(), LoadSpellAbilitiesAsync(), LoadRunesAsync(), LoadMasteriesAsync(),
            LoadInventoryAsync(), LoadArtifactsAsync(), LoadAffectionsAsync(), LoadTraitsAsync(),
            LoadPendingRacialChoiceAsync());
    }

    private async Task LoadImagesAsync()
    {
        var url = _isGmCaller ? "images/mine" : $"campaigns/{_campaignId}/available-images";
        var response = await Http.GetAsync(url);
        if (response.IsSuccessStatusCode)
            _myImages = await response.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();
    }

    private async Task UploadImageAsync(IBrowserFile file)
    {
        using var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 20_000_000));
        content.Add(fileContent, "file", file.Name);
        if (!_isGmCaller && _campaignId is not null)
            content.Add(new StringContent(_campaignId), "campaignId");

        var response = await Http.PostAsync("images", content);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível enviar a imagem.";
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<ImageUploadResponse>();
        _form.ImageId = body!.Id;
        _form.ImageUrl = body.Url;
        _myImages.Insert(0, new ImageSummaryResponse(body.Id, body.Url, DateTime.UtcNow));
        _autoSave.NotifyChanged(SaveIfValidAsync);
    }

    private void SelectExistingImage(string? id)
    {
        _form.ImageId = id;
        _form.ImageUrl = id is null ? null : _myImages.FirstOrDefault(i => i.Id == id)?.Url;
        _autoSave.NotifyChanged(SaveIfValidAsync);
    }

    private void RemoveImage()
    {
        _form.ImageId = null;
        _form.ImageUrl = null;
        _autoSave.NotifyChanged(SaveIfValidAsync);
    }

    private async Task LoadSheetAsync()
    {
        var response = await Http.GetAsync($"npc-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar a ficha.";
            return;
        }

        var sheet = await response.Content.ReadFromJsonAsync<NpcSheetResponse>();
        _campaignId = sheet!.CampaignId;
        _form.ImageUrl = sheet!.ImageUrl;
        _form.ImageId = sheet.ImageId;
        _form.Nome = sheet!.Nome;
        _form.Linhagem = sheet.Linhagem;
        _form.Variante = sheet.Variante;
        _form.Vocacao = sheet.Vocacao;
        _form.SubVocacao = sheet.SubVocacao;
        _form.Afinidade = sheet.Afinidade;
        _form.Propriedade = sheet.Propriedade;
        _form.Nivel = sheet.Nivel;
        _form.Graduacao = sheet.Graduacao;
        _form.GraduacaoLabel = sheet.GraduacaoLabel;
        _form.PossuiCoracaoDeMana = sheet.PossuiCoracaoDeMana;
        _form.ExperienciaAtual = sheet.ExperienciaAtual;
        _form.EAPAtual = sheet.EAPAtual;
        _form.NucleosRankF = sheet.NucleosRankF;
        _form.NucleosRankE = sheet.NucleosRankE;
        _form.NucleosRankD = sheet.NucleosRankD;
        _form.NucleosRankC = sheet.NucleosRankC;
        _form.NucleosRankB = sheet.NucleosRankB;
        _form.NucleosRankA = sheet.NucleosRankA;
        _form.NucleosRankS = sheet.NucleosRankS;
        _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicaoAtual;
        _form.PontosDeIgnicaoTotal = sheet.PontosDeIgnicaoTotal;
        _form.VitalidadeAtual = sheet.VitalidadeAtual;
        _form.FocoAtual = sheet.FocoAtual;
        _form.AdrenalinaAtual = sheet.AdrenalinaAtual;
        _form.EstresseAtual = sheet.EstresseAtual;
        _form.Cobertura = sheet.Cobertura;
        _form.Ciclos = sheet.Ciclos;
        _form.ArcaRolada = sheet.ArcaRolada;
        _form.VitalidadeMaximo = sheet.VitalidadeMaximo;
        _form.FocoMaximo = sheet.FocoMaximo;
        _form.AdrenalinaMaximo = sheet.AdrenalinaMaximo;
        _form.EstresseMaximo = sheet.EstresseMaximo;
        _errorMessage = null;
    }

    private async Task<bool> SaveIfValidAsync()
    {
        if (_form.Nivel is null || _form.ExperienciaAtual is null || _form.EAPAtual is null
            || _form.NucleosRankF is null || _form.NucleosRankE is null || _form.NucleosRankD is null
            || _form.NucleosRankC is null || _form.NucleosRankB is null || _form.NucleosRankA is null || _form.NucleosRankS is null
            || _form.PontosDeIgnicaoAtual is null || _form.PontosDeIgnicaoTotal is null
            || _form.VitalidadeAtual is null || _form.FocoAtual is null || _form.AdrenalinaAtual is null || _form.EstresseAtual is null)
        {
            _errorMessage = "Preencha todos os campos obrigatórios da aba Informações Básicas antes de salvar.";
            return false;
        }

        var request = new UpdateNpcSheetRequest(_form.ImageId, _form.Nome, _form.Linhagem, _form.Variante, _form.Vocacao, _form.SubVocacao,
            _form.Afinidade, _form.Propriedade, _form.Nivel!.Value, _form.PossuiCoracaoDeMana, _form.ExperienciaAtual!.Value, _form.EAPAtual!.Value,
            _form.NucleosRankF!.Value, _form.NucleosRankE!.Value, _form.NucleosRankD!.Value, _form.NucleosRankC!.Value, _form.NucleosRankB!.Value, _form.NucleosRankA!.Value, _form.NucleosRankS!.Value,
            _form.PontosDeIgnicaoAtual!.Value, _form.PontosDeIgnicaoTotal!.Value, _form.VitalidadeAtual!.Value, _form.FocoAtual!.Value, _form.AdrenalinaAtual!.Value, _form.EstresseAtual!.Value,
            _form.Cobertura, _form.Ciclos, _form.ArcaRolada);

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}", request);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("Não foi possível salvar a ficha.");

        await LoadSheetAsync();
        // A Variante change may have just cleared stale racial grants server-side (or made a fresh
        // one pending for the first time) — re-check so the dialog reflects that immediately.
        await LoadPendingRacialChoiceAsync();
        return true;
    }

    private Task NotifySavedAsync()
    {
        _autoSave.NotifyChanged(SaveIfValidAsync);
        return Task.CompletedTask;
    }

    // Nível and Experiência Atual go through their own dedicated endpoints, not the generic
    // SaveIfValidAsync PUT above — that one submits every field at once, with no way to tell
    // "the GM just edited Nível" apart from "Nível wasn't touched and still reads its old value".
    // These two calls each say which field they mean, so the server can pull the other one to
    // match via the same XP-threshold rule Ficha de Personagem uses (Requisitos - Ficha de NPCs).
    private Task NotifyNivelChangedAsync()
    {
        _autoSave.NotifyChanged(SaveNivelAsync);
        return Task.CompletedTask;
    }

    private Task NotifyExperienciaAtualChangedAsync()
    {
        _autoSave.NotifyChanged(SaveExperienciaAtualAsync);
        return Task.CompletedTask;
    }

    private async Task<bool> SaveNivelAsync()
    {
        if (_form.Nivel is null)
        {
            _errorMessage = "Informe o Nível.";
            return false;
        }

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/nivel", _form.Nivel.Value);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("Não foi possível salvar a ficha.");

        await LoadSheetAsync();
        return true;
    }

    private async Task<bool> SaveExperienciaAtualAsync()
    {
        if (_form.ExperienciaAtual is null)
        {
            _errorMessage = "Informe a Experiência Atual.";
            return false;
        }

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/experiencia-atual", _form.ExperienciaAtual.Value);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("Não foi possível salvar a ficha.");

        await LoadSheetAsync();
        return true;
    }

    /// <summary>
    /// Runs SaveIfValidAsync outside the autosave flow (i.e. not via _autoSave.NotifyChanged), for
    /// the pre-existing immediate-save handlers below (UpdateCoberturaAsync/UpdateCiclosAsync) that
    /// have no separate sub-resource PUT endpoint of their own. Preserves their original behavior of
    /// surfacing a save failure via _errorMessage instead of letting SaveIfValidAsync's exception go
    /// unhandled.
    /// </summary>
    private async Task SaveIgnoringResultAsync()
    {
        try
        {
            await SaveIfValidAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

