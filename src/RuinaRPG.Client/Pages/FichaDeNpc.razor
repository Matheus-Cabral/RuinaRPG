@page "/npcs/{SheetId}"
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject SecretNoteNotifier Notifier
@inject PericiaCatalogo Pericias
@inject AuthenticationStateProvider AuthProvider
@using RuinaRPG.Contracts.Fichas
@using RuinaRPG.Contracts.NpcSheets
@using RuinaRPG.Contracts.SpellsAndAbilities
@using RuinaRPG.Domain.CharacterSheets
@using RuinaRPG.Domain.SpellsAndAbilities
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Contracts.Images
@using RuinaRPG.Contracts.Items
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Contracts.Runes
@using RuinaRPG.Client.Shared.Fields
@using RuinaRPG.Client.Shared.Ficha
@using MudBlazor
@using RuinaRPG.Contracts.Notifications

<div class="ficha-condicoes-raiz" @onfocusout="@(() => _recarga.FocoSaiu())">
<Breadcrumbs Items="@Crumbs" />
<h1>Ficha de NPC</h1>
@if (_concedida)
{
    <CondicoesAtivasAlert Url="@($"npc-sheets/{SheetId}/condicoes-ativas")" Versao="_condicoesVersao" />
}

<DismissibleAlert @bind-Message="_estado.Erro" Class="mb-3" />

@if (_levelUpBonuses.Count > 0)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-3">
        <MudText Typo="Typo.h6">Novo Nível!</MudText>
        <ul>
            @foreach (var bonus in _levelUpBonuses)
            {
                <li>@bonus</li>
            }
        </ul>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="DismissLevelUpAsync">Fechar</MudButton>
    </MudAlert>
}

<MudDialog @bind-Visible="_racialChoiceDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false })">
    <DialogContent>
        <MudText Typo="Typo.h6">Escolha a Característica Racial do NPC</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Toda Variante concede uma Característica Gratuita, a escolher entre as opções abaixo — algumas Variantes também exigem uma Característica Obrigatória.
        </MudText>

        <MudText Typo="Typo.subtitle1">Característica Gratuita</MudText>
        <MudRadioGroup T="string" @bind-Value="_racialGratuitaChoice">
            @foreach (var option in _pendingRacialChoice?.Gratuita ?? new())
            {
                <MudRadio Value="@option.TraitNome">@option.TraitNome</MudRadio>
            }
        </MudRadioGroup>
        @{ var gratuitaSelected = _pendingRacialChoice?.Gratuita.FirstOrDefault(o => o.TraitNome == _racialGratuitaChoice); }
        @if (gratuitaSelected is { RequerEspecificacao: true, Especificacao: null })
        {
            <MudTextField @bind-Value="_racialGratuitaEspecificacao" Label="Especificação" Class="mt-2" />
        }

        @if (_pendingRacialChoice?.Obrigatoria.Count > 1)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">Característica Obrigatória</MudText>
            <MudRadioGroup T="string" @bind-Value="_racialObrigatoriaChoice">
                @foreach (var option in _pendingRacialChoice.Obrigatoria)
                {
                    <MudRadio Value="@option.TraitNome">@option.TraitNome</MudRadio>
                }
            </MudRadioGroup>
            var obrigatoriaSelected = _pendingRacialChoice.Obrigatoria.FirstOrDefault(o => o.TraitNome == _racialObrigatoriaChoice);
            @if (obrigatoriaSelected is { RequerEspecificacao: true, Especificacao: null })
            {
                <MudTextField @bind-Value="_racialObrigatoriaEspecificacao" Label="Especificação" Class="mt-2" />
            }
        }
        else if (_pendingRacialChoice?.Obrigatoria.Count == 1)
        {
            var fixedOption = _pendingRacialChoice.Obrigatoria[0];
            <MudText Typo="Typo.body2" Class="mt-3">O NPC também recebe automaticamente: <b>@fixedOption.TraitNome</b>.</MudText>
            @if (fixedOption is { RequerEspecificacao: true, Especificacao: null })
            {
                <MudTextField @bind-Value="_racialObrigatoriaEspecificacao" Label="Especificação" Class="mt-2" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _racialChoiceDialogOpen = false)">Decidir depois</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_racialGratuitaChoice is null)" OnClick="ConfirmRacialChoiceAsync">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

<CascadingValue Value="_estado" IsFixed="false">
<MudTabs>
    <MudTabPanel Text="Informações Básicas">
        <AbaInformacoesBasicas Formulario="_form" AutoSave="_autoSave" AoMudar="NotifySavedAsync" AoMudarNivel="NotifyNivelChangedAsync"
                               AoMudarExperiencia="NotifyExperienciaAtualChangedAsync" AoMudarPontosDeIgnicao="NotifyPontosDeIgnicaoChangedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Atributos & Perícias">
        <AbaAtributosEPericias Formulario="_form" AoMudar="NotifySavedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Combate">
        <AbaCombate Formulario="_form" AutoSave="_autoSave" AoMudar="NotifySavedAsync" SalvarAgora="SaveIgnoringResultAsync" SalvarERecarregar="SalvarERecarregarAbasAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Magias & Habilidades">
        <HabilidadeRacialSection Formulario="_form" SalvarAgora="SaveIgnoringResultAsync" />
        <AbaMagiasEHabilidades />
    </MudTabPanel>

    <MudTabPanel Text="Posses">
        <AbaPosses Formulario="_form" SalvarAgora="SaveIgnoringResultAsync" EquipagemEscolhida="OnEquipagemChosenAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Antecedentes">
        <AbaAntecedentes Formulario="_form" AoMudar="NotifySavedAsync" />
    </MudTabPanel>
</MudTabs>
</CascadingValue>

</div>

@code {
    [Parameter] public string SheetId { get; set; } = "";

    // O estado que as abas compartilhadas recebem em cascata (E). Os campos abaixo continuam com os nomes de antes,
    // mas o valor mora no estado: a página e as abas leem e escrevem o mesmo.
    private FichaEstado _estado = null!;
    private string? _errorMessage { get => _estado.Erro; set => _estado.Erro = value; }
    private bool _isGmCaller { get => _estado.IsGmCaller; set => _estado.IsGmCaller = value; }
    private string? _campaignId { get => _estado.CampaignId; set => _estado.CampaignId = value; }
    private List<ImageSummaryResponse> _myImages { get => _estado.MinhasImagens; set => _estado.MinhasImagens = value; }
    private int _penalidadesVersao { get => _estado.PenalidadesVersao; set => _estado.PenalidadesVersao = value; }
    private int _condicoesVersao { get => _estado.CondicoesVersao; set => _estado.CondicoesVersao = value; }
    private bool _historiaLoaded { get => _estado.HistoriaCarregada; set => _estado.HistoriaCarregada = value; }

    // Value must match the Variante enum member name exactly (server parses it); label is the
    // real Sistema Básico display name (Ruína RPG - Sistema Básico §7).
    private static readonly Dictionary<string, (string Valor, string Rotulo)[]> VariantesPorLinhagem = new()
    {
        ["Humano"] = [("Sinir", "Sinir (Sol)"), ("Laonir", "Laonir (Lua)")],
        ["Phylauc"] = [("PhylacTai", "Phylac'tai (Sol)"), ("EsPhylauc", "Es'Phylauc (Lua)")],
        ["Nephrytes"] = [("Koroanos", "Koroanos (Sol)"), ("Yavos", "Yavos (Lua)")],
        ["Econos"] = [("Alora", "Alóra (Lua)")],
    };

    // Classe (displayed label; SubVocacao is the internal property/DB column name, kept as-is) is
    // free text server-side (no enum), so value == label here — from "Relação de Vocacão e Classes.md".
    private static readonly Dictionary<string, string[]> SubVocacoesPorVocacao = new()
    {
        ["Campeao"] = ["Cavalheiro", "Duelista", "Paladino", "Lamina Holística", "Guardião"],
        ["Cacador"] = ["Arqueiro", "Domador", "Assassino"],
        ["Feiticeiro"] = ["Aeromante", "Biomante", "Fluxomante", "Piromante", "Sábio"],
        ["Adepto"] = ["Paladino", "Arauto", "Trovador", "Eremita"],
        ["Bruxo"] = ["Ecomante", "Hemomante", "Osteomante", "Nexomante", "Cultista"],
    };

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("NPCs do GM", "npcs"),
        new(string.IsNullOrWhiteSpace(_form.Nome) ? "Ficha de NPC" : _form.Nome),
    };

    private readonly FormularioDaFicha _form = new(TipoDeFichaCliente.Npc);
    private readonly RuinaRPG.Client.Services.AutoSaveCoordinator _autoSave = new();
    private List<string> _levelUpBonuses = new();
    private PendingRacialTraitChoiceResponse? _pendingRacialChoice;
    private bool _racialChoiceDialogOpen;
    private string? _racialGratuitaChoice;
    private string? _racialObrigatoriaChoice;
    private string? _racialGratuitaEspecificacao;
    private string? _racialObrigatoriaEspecificacao;

    protected override void OnInitialized()
    {
        _estado = new FichaEstado(Http, TipoDeFichaCliente.Npc, SheetId);
        _estado.RecarregarPontosDeIgnicao = RecarregarPontosDeIgnicaoAsync;
        _estado.Alterado += OnEstadoAlterado;
        _autoSave.StateChanged += StateHasChangedFromAutoSave;
        // Condições mudam no servidor (ação do GM no encontro): a ficha se recarrega sem salvar nada e sem
        // trocar o campo que está sendo editado (RecargaAdiada).
        _recarga = new RecargaAdiada(RecarregarPorCondicoesAsync, () => JS.InvokeAsync<bool>("ruinaFoco.campoEmEdicao").AsTask(), () => _autoSave.Ocupado,
            aoFalhar: falha => _ = AvisarFalhaDaRecargaAsync());
        Notifier.CondicoesAlteradas += OnCondicoesAlteradas;
    }

    // Erro de uma recarga adiada (RecargaAdiada nunca chama isto depois do Dispose). Ninguém espera esta tarefa, então
    // ela não pode falhar: se a página sair no meio-tempo, não há onde mostrar o erro.
    private async Task AvisarFalhaDaRecargaAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _errorMessage = "Não foi possível atualizar a ficha com as Condições.";
                StateHasChanged();
            });
        }
        catch (Exception)
        {
        }
    }

    private RecargaAdiada _recarga = null!;
    // Só uma ficha concedida a um jogador tem Condições vivas; a do Mestre mostra o efeito só no Resumo do encontro.
    private bool _concedida;

    private void OnCondicoesAlteradas(CondicoesAlteradasNotification notificacao)
    {
        if (notificacao.Kind != "npc" || notificacao.SheetId != SheetId)
            return;

        _ = InvokeAsync(async () =>
        {
            // O aviso e a lista de Passivas mudam já; a recarga da ficha espera se há um campo em edição.
            _condicoesVersao++;
            StateHasChanged();
            try
            {
                await _recarga.SolicitarAsync();
            }
            catch (Exception)
            {
                _errorMessage = "Não foi possível atualizar a ficha com as Condições.";
            }
            StateHasChanged();
        });
    }

    // Relê os números e as listas que as Condições mexem. Não passa por _autoSave: nada é gravado.
    private Task RecarregarPorCondicoesAsync() => InvokeAsync(async () =>
    {
        await LoadSheetAsync(); await _estado.CarregarAtributosECombateAsync(); await _estado.CarregarMagiasAsync(); await _estado.CarregarRunasAsync(); await _estado.CarregarArtefatosAsync();
        _penalidadesVersao++;
        StateHasChanged();
    });

    private void StateHasChangedFromAutoSave() => InvokeAsync(StateHasChanged);

    // Uma aba filha mudou o estado fora de um evento da página (ex.: Erro depois de um POST recusado).
    private void OnEstadoAlterado() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _estado.Alterado -= OnEstadoAlterado;
        _autoSave.StateChanged -= StateHasChangedFromAutoSave;
        Notifier.CondicoesAlteradas -= OnCondicoesAlteradas;
        _recarga.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await Pericias.CarregarAsync();
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _isGmCaller = authState.User.IsInRole("GM");

        // LoadSheetAsync sets _campaignId, which LoadImagesAsync now needs — see the identical
        // note in FichaDePersonagem.razor's OnInitializedAsync.
        await LoadSheetAsync();
        await LoadImagesAsync();

        await Task.WhenAll(
            LoadLevelUpNoticeAsync(), _estado.CarregarAtributosECombateAsync(),
            _estado.CarregarHabilidadeRacialAsync(), _estado.CarregarVariantesLiberadasAsync(), _estado.CarregarMagiasAsync(), _estado.CarregarRunasAsync(), _estado.CarregarMaestriasAsync(),
            _estado.CarregarInventarioAsync(), _estado.CarregarArtefatosAsync(), _estado.CarregarAfeicoesAsync(), _estado.CarregarCaracteristicasAsync(),
            LoadPendingRacialChoiceAsync());
    }

    private async Task LoadLevelUpNoticeAsync()
    {
        var response = await Http.GetAsync($"npc-sheets/{SheetId}/level-up-notice");
        if (response.IsSuccessStatusCode)
            _levelUpBonuses = (await response.Content.ReadFromJsonAsync<LevelUpNoticeResponse>())!.BonusTexts;
    }

    private async Task DismissLevelUpAsync()
    {
        await Http.PostAsync($"npc-sheets/{SheetId}/dismiss-level-up-notice", null);
        _levelUpBonuses.Clear();
    }

    private async Task LoadImagesAsync()
    {
        var url = _isGmCaller ? "images/mine" : $"campaigns/{_campaignId}/available-images";
        var response = await Http.GetAsync(url);
        if (response.IsSuccessStatusCode)
            _myImages = await response.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();
    }

    private async Task LoadSheetAsync()
    {
        var response = await Http.GetAsync($"npc-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar a ficha.";
            return;
        }

        var sheet = await response.Content.ReadFromJsonAsync<NpcSheetResponse>();
        _campaignId = sheet!.CampaignId;
        _concedida = sheet.OwnerId is not null;
        _form.ImageUrl = sheet!.ImageUrl;
        _form.ImageId = sheet.ImageId;
        _form.Nome = sheet!.Nome;
        _form.Linhagem = sheet.Linhagem;
        _form.Variante = sheet.Variante;
        _form.Vocacao = sheet.Vocacao;
        _form.SubVocacao = sheet.SubVocacao;
        _form.Afinidade = sheet.Afinidade;
        _form.Propriedade = sheet.Propriedade;
        _form.Estrela = sheet.Estrela;
        _form.SinaAtual = sheet.SinaAtual;
        _form.HistoricoId = sheet.HistoricoId;
        if (!_historiaLoaded)
        {
            _form.Historia = sheet.Historia;
            _historiaLoaded = true;
        }
        _form.EquipmentKitId = sheet.EquipmentKitId;
        _form.Nivel = sheet.Nivel;
        _form.Graduacao = sheet.Graduacao;
        _form.GraduacaoLabel = sheet.GraduacaoLabel;
        _form.PossuiCoracaoDeMana = sheet.PossuiCoracaoDeMana;
        _form.AfinidadeAdicional = sheet.AfinidadeAdicional;
        _form.VocacaoArcanaMaxima = sheet.VocacaoArcanaMaxima;
        _form.ExperienciaAtual = sheet.ExperienciaAtual;
        _form.Abate = sheet.Abate;
        _form.Assistencia = sheet.Assistencia;
        _form.EAPAtual = sheet.EAPAtual;
        _form.NucleosRankF = sheet.NucleosRankF;
        _form.NucleosRankE = sheet.NucleosRankE;
        _form.NucleosRankD = sheet.NucleosRankD;
        _form.NucleosRankC = sheet.NucleosRankC;
        _form.NucleosRankB = sheet.NucleosRankB;
        _form.NucleosRankA = sheet.NucleosRankA;
        _form.NucleosRankS = sheet.NucleosRankS;
        _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicaoAtual;
        _form.PontosDeIgnicaoTotal = sheet.PontosDeIgnicaoTotal;
        _form.VitalidadeAtual = sheet.VitalidadeAtual;
        _form.FocoAtual = sheet.FocoAtual;
        _form.AdrenalinaAtual = sheet.AdrenalinaAtual;
        _form.EstresseAtual = sheet.EstresseAtual;
        _form.GuardarAtuaisCarregados();
        _form.Cobertura = sheet.Cobertura;
        _form.Ciclos = sheet.Ciclos;
        _form.ArcaRolada = sheet.ArcaRolada;
        _form.VitalidadeMaximo = sheet.VitalidadeMaximo;
        _form.FocoMaximo = sheet.FocoMaximo;
        _form.AdrenalinaMaximo = sheet.AdrenalinaMaximo;
        _form.EstresseMaximo = sheet.EstresseMaximo;
        _errorMessage = null;
    }

    private async Task<bool> SaveIfValidAsync()
    {
        if (_form.Nivel is null || _form.ExperienciaAtual is null
            || _form.NucleosRankF is null || _form.NucleosRankE is null || _form.NucleosRankD is null
            || _form.NucleosRankC is null || _form.NucleosRankB is null || _form.NucleosRankA is null || _form.NucleosRankS is null
            || _form.PontosDeIgnicaoAtual is null
            || _form.VitalidadeAtual is null || _form.FocoAtual is null || _form.AdrenalinaAtual is null || _form.EstresseAtual is null)
        {
            _errorMessage = "Preencha todos os campos obrigatórios da aba Informações Básicas antes de salvar.";
            return false;
        }

        // EAPAtual vai só por compatibilidade: o servidor ignora e calcula o VIS por Nível + Âmbares.
        var request = new UpdateNpcSheetRequest(_form.ImageId, _form.Nome, _form.Linhagem, _form.Variante, _form.Vocacao, _form.SubVocacao,
            _form.Afinidade, _form.Propriedade, _form.Nivel!.Value, _form.PossuiCoracaoDeMana, _form.ExperienciaAtual!.Value, _form.EAPAtual ?? 0,
            _form.NucleosRankF!.Value, _form.NucleosRankE!.Value, _form.NucleosRankD!.Value, _form.NucleosRankC!.Value, _form.NucleosRankB!.Value, _form.NucleosRankA!.Value, _form.NucleosRankS!.Value,
            _form.PontosDeIgnicaoAtual!.Value, _form.PontosDeIgnicaoTotal, _form.VitalidadeAtual!.Value, _form.FocoAtual!.Value, _form.AdrenalinaAtual!.Value, _form.EstresseAtual!.Value,
            _form.Cobertura, _form.Ciclos, _form.ArcaRolada, _form.Estrela, _form.SinaAtual, _form.HistoricoId, null, _form.AfinidadeAdicional,
            _form.VitalidadeAtualCarregada, _form.FocoAtualCarregado, _form.AdrenalinaAtualCarregada, _form.EstresseAtualCarregado);

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}", request);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await response.Content.ReadErrorMessageAsync() ?? "Não foi possível salvar a ficha.");

        await LoadSheetAsync();
        // A Variante change may have just cleared stale racial grants server-side (or made a fresh
        // one pending for the first time) — re-check so the dialog reflects that immediately.
        await LoadPendingRacialChoiceAsync();
        await LoadLevelUpNoticeAsync();
        await _estado.CarregarAtributosECombateAsync();
        _penalidadesVersao++;
        await _estado.CarregarCaracteristicasAsync();
        // Evoluções de Arca unlocked depend on Nível.
        await _estado.CarregarHabilidadeRacialAsync();
        return true;
    }

    private Task NotifySavedAsync()
    {
        _autoSave.NotifyChanged(SaveIfValidAsync);
        return Task.CompletedTask;
    }

    // Nível and Experiência Atual go through their own dedicated endpoints, not the generic
    // SaveIfValidAsync PUT above — that one submits every field at once, with no way to tell
    // "the GM just edited Nível" apart from "Nível wasn't touched and still reads its old value".
    // These two calls each say which field they mean, so the server can pull the other one to
    // match via the same XP-threshold rule Ficha de Personagem uses (Requisitos - Ficha de NPCs).
    private Task NotifyNivelChangedAsync()
    {
        _autoSave.NotifyChanged(SaveNivelAsync, "nivel");
        return Task.CompletedTask;
    }

    private Task NotifyExperienciaAtualChangedAsync()
    {
        _autoSave.NotifyChanged(SaveExperienciaAtualAsync, "xp");
        return Task.CompletedTask;
    }

    // O saldo de Pontos de Ignição também tem endpoint próprio: o servidor o altera sozinho (nível,
    // Magias/Habilidades), e o PUT genérico o ignora para que um formulário desatualizado nunca escreva
    // por cima disso. Editar o campo à mão salva só ele.
    private Task NotifyPontosDeIgnicaoChangedAsync()
    {
        _autoSave.NotifyChanged(SavePontosDeIgnicaoAsync, "pi");
        return Task.CompletedTask;
    }

    private async Task<bool> SavePontosDeIgnicaoAsync()
    {
        if (_form.PontosDeIgnicaoAtual is null)
        {
            _errorMessage = "Informe os Pontos de Ignição Atual.";
            return false;
        }

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/pontos-de-ignicao", _form.PontosDeIgnicaoAtual.Value);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await response.Content.ReadErrorMessageAsync() ?? "Não foi possível salvar a ficha.");

        _errorMessage = null;
        await RecarregarPontosDeIgnicaoAsync();
        return true;
    }

    private async Task<bool> SaveNivelAsync()
    {
        if (_form.Nivel is null)
        {
            _errorMessage = "Informe o Nível.";
            return false;
        }

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/nivel", _form.Nivel.Value);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await response.Content.ReadErrorMessageAsync() ?? "Não foi possível salvar a ficha.");

        await LoadSheetAsync();
        await LoadLevelUpNoticeAsync();
        await _estado.CarregarAtributosECombateAsync();
        _penalidadesVersao++;
        await _estado.CarregarCaracteristicasAsync();
        // Evoluções de Arca unlocked depend on Nível.
        await _estado.CarregarHabilidadeRacialAsync();
        return true;
    }

    private async Task<bool> SaveExperienciaAtualAsync()
    {
        if (_form.ExperienciaAtual is null)
        {
            _errorMessage = "Informe a Experiência Atual.";
            return false;
        }

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/experiencia-atual", _form.ExperienciaAtual.Value);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException(await response.Content.ReadErrorMessageAsync() ?? "Não foi possível salvar a ficha.");

        await LoadSheetAsync();
        await LoadLevelUpNoticeAsync();
        await _estado.CarregarAtributosECombateAsync();
        _penalidadesVersao++;
        await _estado.CarregarCaracteristicasAsync();
        // Evoluções de Arca unlocked depend on Nível.
        await _estado.CarregarHabilidadeRacialAsync();
        return true;
    }

    /// <summary>
    /// Runs SaveIfValidAsync outside the autosave flow (i.e. not via _autoSave.NotifyChanged), for
    /// the pre-existing immediate-save handlers (through SalvarAgora, the tabs' Sina, Ciclos and Arca
    /// rolada; through SalvarERecarregarAbasAsync, the Cobertura and the Afinidade) that have no
    /// separate sub-resource PUT endpoint of their own. Preserves their original behavior of
    /// surfacing a save failure via _errorMessage instead of letting SaveIfValidAsync's exception go
    /// unhandled.
    /// </summary>
    private async Task SaveIgnoringResultAsync()
    {
        try
        {
            await SaveIfValidAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /// <summary>
    /// A Cobertura e a Afinidade da aba Combate: salva na hora e relê as abas 2 e 3 (a Defesa Natural, a
    /// Eficiência e o Dano Elemental vêm com os Sub-Atributos; o salvamento só relê a ficha), num evento só da
    /// página.
    /// </summary>
    private async Task SalvarERecarregarAbasAsync()
    {
        await SaveIgnoringResultAsync();
        await _estado.CarregarAtributosECombateAsync();
    }

    /// <summary>
    /// A API mexe no saldo de PI ao adicionar, editar e remover uma Magia/Habilidade (4.b), e é ela quem
    /// guarda o valor: o formulário só o exibe. Relê o saldo depois de cada operação que o altera. Se a
    /// releitura falhar, o campo fica como está — a operação em si já deu certo.
    /// </summary>
    private async Task RecarregarPontosDeIgnicaoAsync()
    {
        var response = await Http.GetAsync($"npc-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
            return;

        var sheet = await response.Content.ReadFromJsonAsync<NpcSheetResponse>();
        if (sheet is not null)
            _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicaoAtual;
    }

    private async Task OnEquipagemChosenAsync()
    {
        await LoadSheetAsync();
        await Task.WhenAll(_estado.CarregarAtributosECombateAsync(), _estado.CarregarInventarioAsync(), _estado.CarregarArtefatosAsync());
        _penalidadesVersao++;
    }

    // Ruína RPG - Sistema Básico §7: every Variante grants a Característica Gratuita (a real
    // choice) and, for some, a Característica Obrigatória (0, 1 fixed, or a real choice too) — see
    // RacialTraitLookup/RacialTraitChoiceResolver. Mirrors FichaDePersonagem.razor's dialog.
    private async Task LoadPendingRacialChoiceAsync()
    {
        _pendingRacialChoice = await Http.GetFromJsonAsync<PendingRacialTraitChoiceResponse>($"npc-sheets/{SheetId}/racial-traits/pending");
        _racialChoiceDialogOpen = _pendingRacialChoice?.Pending == true;
        _racialGratuitaChoice = null;
        _racialObrigatoriaChoice = null;
        _racialGratuitaEspecificacao = null;
        _racialObrigatoriaEspecificacao = null;
    }

    private async Task ConfirmRacialChoiceAsync()
    {
        if (_racialGratuitaChoice is null)
            return;

        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/racial-traits/resolve",
            new ResolveRacialTraitChoiceRequest(_racialGratuitaChoice, _racialObrigatoriaChoice, _racialGratuitaEspecificacao, _racialObrigatoriaEspecificacao));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível registrar a Característica Racial escolhida.";
            return;
        }

        _racialChoiceDialogOpen = false;
        await LoadPendingRacialChoiceAsync();
        await _estado.CarregarCaracteristicasAsync();
    }

}
