    /// <summary>
    /// Runs SaveIfValidAsync outside the autosave flow (i.e. not via _autoSave.NotifyChanged), for
    /// the pre-existing immediate-save handlers (UpdateCoberturaAsync below and, through SalvarAgora,
    /// the tabs' Ciclos and Arca rolada) that have no separate sub-resource PUT endpoint of their own. Preserves their original behavior of
    /// surfacing a save failure via _errorMessage instead of letting SaveIfValidAsync's exception go
    /// unhandled.
    /// </summary>
    private async Task SaveIgnoringResultAsync()
    {
        try
        {
            await SaveIfValidAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task UpdateAfinidadeAsync(string? value)
    {
        _form.Afinidade = value;
        await SaveIgnoringResultAsync();
        await _estado.CarregarAtributosECombateAsync(); // A Afinidade define a Eficiência e o Dano Elemental (2.b), carregados aqui.
    }

    private async Task UpdateCoberturaAsync(string? value)
    {
        _form.Cobertura = value ?? "Nenhuma";
        await SaveIgnoringResultAsync();
        await _estado.CarregarAtributosECombateAsync(); // Cobertura feeds Defesa Natural, loaded here, not by LoadSheetAsync.
    }

    private async Task OnSinaChangedAsync(int value)
    {
        _form.SinaAtual = value;
        await SaveIgnoringResultAsync();
    }

    /// <summary>O Combate (ainda desta página): o fim da recarga das abas 2 e 3 (<c>_estado.CarregarAtributosECombateAsync</c>).</summary>
