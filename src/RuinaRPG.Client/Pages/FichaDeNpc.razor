@page "/npcs/{SheetId}"
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject SecretNoteNotifier Notifier
@inject PericiaCatalogo Pericias
@inject AuthenticationStateProvider AuthProvider
@using RuinaRPG.Contracts.Fichas
@using RuinaRPG.Contracts.NpcSheets
@using RuinaRPG.Contracts.SpellsAndAbilities
@using RuinaRPG.Domain.CharacterSheets
@using RuinaRPG.Domain.SpellsAndAbilities
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Contracts.Images
@using RuinaRPG.Contracts.Items
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Contracts.Runes
@using RuinaRPG.Client.Shared.Fields
@using RuinaRPG.Client.Shared.Ficha
@using MudBlazor
@using RuinaRPG.Contracts.Notifications

<div class="ficha-condicoes-raiz" @onfocusout="@(() => _recarga.FocoSaiu())">
<Breadcrumbs Items="@Crumbs" />
<h1>Ficha de NPC</h1>
@if (_concedida)
{
    <CondicoesAtivasAlert Url="@($"npc-sheets/{SheetId}/condicoes-ativas")" Versao="_condicoesVersao" />
}

<DismissibleAlert @bind-Message="_estado.Erro" Class="mb-3" />

@if (_levelUpBonuses.Count > 0)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-3">
        <MudText Typo="Typo.h6">Novo Nível!</MudText>
        <ul>
            @foreach (var bonus in _levelUpBonuses)
            {
                <li>@bonus</li>
            }
        </ul>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="DismissLevelUpAsync">Fechar</MudButton>
    </MudAlert>
}

<MudDialog @bind-Visible="_racialChoiceDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false })">
    <DialogContent>
        <MudText Typo="Typo.h6">Escolha a Característica Racial do NPC</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Toda Variante concede uma Característica Gratuita, a escolher entre as opções abaixo — algumas Variantes também exigem uma Característica Obrigatória.
        </MudText>

        <MudText Typo="Typo.subtitle1">Característica Gratuita</MudText>
        <MudRadioGroup T="string" @bind-Value="_racialGratuitaChoice">
            @foreach (var option in _pendingRacialChoice?.Gratuita ?? new())
            {
                <MudRadio Value="@option.TraitNome">@option.TraitNome</MudRadio>
            }
        </MudRadioGroup>
        @{ var gratuitaSelected = _pendingRacialChoice?.Gratuita.FirstOrDefault(o => o.TraitNome == _racialGratuitaChoice); }
        @if (gratuitaSelected is { RequerEspecificacao: true, Especificacao: null })
        {
            <MudTextField @bind-Value="_racialGratuitaEspecificacao" Label="Especificação" Class="mt-2" />
        }

        @if (_pendingRacialChoice?.Obrigatoria.Count > 1)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">Característica Obrigatória</MudText>
            <MudRadioGroup T="string" @bind-Value="_racialObrigatoriaChoice">
                @foreach (var option in _pendingRacialChoice.Obrigatoria)
                {
                    <MudRadio Value="@option.TraitNome">@option.TraitNome</MudRadio>
                }
            </MudRadioGroup>
            var obrigatoriaSelected = _pendingRacialChoice.Obrigatoria.FirstOrDefault(o => o.TraitNome == _racialObrigatoriaChoice);
            @if (obrigatoriaSelected is { RequerEspecificacao: true, Especificacao: null })
            {
                <MudTextField @bind-Value="_racialObrigatoriaEspecificacao" Label="Especificação" Class="mt-2" />
            }
        }
        else if (_pendingRacialChoice?.Obrigatoria.Count == 1)
        {
            var fixedOption = _pendingRacialChoice.Obrigatoria[0];
            <MudText Typo="Typo.body2" Class="mt-3">O NPC também recebe automaticamente: <b>@fixedOption.TraitNome</b>.</MudText>
            @if (fixedOption is { RequerEspecificacao: true, Especificacao: null })
            {
                <MudTextField @bind-Value="_racialObrigatoriaEspecificacao" Label="Especificação" Class="mt-2" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _racialChoiceDialogOpen = false)">Decidir depois</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_racialGratuitaChoice is null)" OnClick="ConfirmRacialChoiceAsync">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

<CascadingValue Value="_estado" IsFixed="false">
<MudTabs>
    <MudTabPanel Text="Informações Básicas">
        <AbaInformacoesBasicas Formulario="_form" AutoSave="_autoSave" AoMudar="NotifySavedAsync" AoMudarNivel="NotifyNivelChangedAsync"
                               AoMudarExperiencia="NotifyExperienciaAtualChangedAsync" AoMudarPontosDeIgnicao="NotifyPontosDeIgnicaoChangedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Atributos & Perícias">
        <AbaAtributosEPericias Formulario="_form" AoMudar="NotifySavedAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Combate">
        <PenalidadesAtivasAlert Url="@($"npc-sheets/{SheetId}/equipment-penalties")" Versao="_penalidadesVersao" />
        <AutoSaveIndicator State="_autoSave.State" LastSavedAt="_autoSave.LastSavedAt" />
        <Section>
            <div class="mt-2">
                <MudText Typo="Typo.body2">Pontos de Sina</MudText>
                <MudRating SelectedValue="_form.SinaAtual" SelectedValueChanged="OnSinaChangedAsync" MaxValue="3" Size="Size.Large" Class="rr-sina-rating" />
            </div>
            <MudNumericField T="int?" @bind-Value="_form.VitalidadeAtual" For="@(() => _form.VitalidadeAtual)" Label="Vitalidade" Adornment="Adornment.End" AdornmentText="@($"/ {_form.VitalidadeMaximo}")" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.FocoAtual" For="@(() => _form.FocoAtual)" Label="Foco (PF)" Adornment="Adornment.End" AdornmentText="@($"/ {_form.FocoMaximo}")" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.AdrenalinaAtual" For="@(() => _form.AdrenalinaAtual)" Label="Adrenalina (PA)" Adornment="Adornment.End" AdornmentText="@($"/ {_form.AdrenalinaMaximo}")" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.EstresseAtual" For="@(() => _form.EstresseAtual)" Label="Estresse" Adornment="Adornment.End" AdornmentText="@($"/ {_form.EstresseMaximo}")" @bind-Value:after="NotifySavedAsync" />
        </Section>

        @if (_subAttributes is not null)
        {
            <SubAtributosSection SubAtributos="_subAttributes" Cobertura="@_form.Cobertura" CoberturaChanged="@(v => UpdateCoberturaAsync(v))"
                                 ComAfinidade="true" Afinidade="@_form.Afinidade" AfinidadeChanged="@(v => UpdateAfinidadeAsync(v))" />
        }

        @if (_modificadorDeDano is not null)
        {
            <Section Title="Modificador de Dano">
                <MudText>Cortante: @_modificadorDeDano.Cortante</MudText>
                <MudText>Perfurante: @_modificadorDeDano.Perfurante</MudText>
                <MudText>Contundente: @_modificadorDeDano.Contundente</MudText>
                <MudText>Mágico: @_modificadorDeDano.Arcano</MudText>
            @foreach (var linha in CondicaoResumo.LinhasDeDanoElemental(_modificadorDeDano.DanoElemental))
            {
                <MudText>@linha</MudText>
            }
            </Section>
        }

        <Section Title="Armas">
            <EditForm Model="_weaponForm" OnValidSubmit="AddWeaponAsync">
                <CatalogoItemPicker @bind-Value="_weaponForm.ItemId" SearchItems="@(q => _estado.BuscarItensPorTipoAsync(q, "Arma"))" Placeholder="Buscar arma..." Tipo="Arma" PodeCriar="@_isGmCaller" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Arma</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Tipo de Dano</th>
                        <th>Alcance</th>
                        <th>Dados</th>
                        <th>Dano</th>
                        <th>Crítico</th>
                        <th>Rank</th>
                        <th>Peso</th>
                        <th>Durabilidade</th>
                        <th>Equipada</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var weapon in _weapons)
                    {
                        <tr>
                            <td>
                                <ClickableItemName Nome="@weapon.Nome" ImageUrl="@weapon.ImageUrl" Descricao="@weapon.Descricao" Requisitos="@weapon.Requisitos" RequisitosPendentes="@weapon.RequisitosPendentes" Penalidade="@weapon.Penalidade" OutrasPenalidades="@weapon.OutrasPenalidades" EmUso="@weapon.IsEquipped" /> <DesabilitadoChip Condicao="@weapon.DesabilitadoPor" />
                            </td>
                            <td>@(weapon.TipoDeDano ?? "—")</td>
                            <td>@(weapon.Alcance?.ToString() ?? "—")</td>
                            <td>@(weapon.Dados ?? "—")</td>
                            <td>@(weapon.Dano?.ToString() ?? "—")</td>
                            <td>@(weapon.Critico ?? "—")</td>
                            <td>@(weapon.Rank ?? "—")</td>
                            <td>@weapon.Peso</td>
                            <td>
                                @if (weapon.Inquebravel)
                                {
                                    <text>Inquebrável</text>
                                }
                                else
                                {
                                    <MudNumericField T="int?" Value="@weapon.DurabilidadeAtual" ValueChanged="@(v => UpdateWeaponDurabilidadeAsync(weapon.Id, v))" Style="width:5em; display:inline-flex;" />
                                    <text> / @weapon.DurabilidadeMaxima</text>
                                }
                            </td>
                            <td>@(weapon.IsEquipped ? "Equipada" : "")</td>
                            <td>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EquipWeaponAsync(weapon.Id, !weapon.IsEquipped))">@(weapon.IsEquipped ? "Desequipar" : "Equipar")</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteWeaponAsync(weapon.Id))">Remover</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Maestrias">
            <EditForm Model="_masteryForm" OnValidSubmit="AddMasteryAsync">
                <MudTextField T="string" @bind-Value="_masteryForm.Nome" Label="Nome" />
                <MudSelect T="string" @bind-Value="_masteryForm.Pericia" Label="Perícia">
                    <MudSelectItem Value="@("")">Escolha uma Perícia</MudSelectItem>
                    @foreach (var skill in _skills)
                    {
                        <MudSelectItem Value="@skill.Pericia">@PericiaLabel(skill.Pericia)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_masteryForm.Atributo" Label="Atributo">
                    <MudSelectItem Value="@("")">Escolha um Atributo</MudSelectItem>
                    @foreach (var attr in _attributes)
                    {
                        <MudSelectItem Value="@attr.Atributo">@AtributoDisplay.Label(attr.Atributo)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_masteryForm.GastoMaestria" Label="Gasto Maestria" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Adicionar Maestria</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <tbody>
                    @foreach (var mastery in _masteries)
                    {
                        <tr>
                            <td>@mastery.Nome — @PericiaLabel(mastery.Pericia) / @AtributoDisplay.Label(mastery.Atributo) — Gasto @mastery.GastoMaestria — Total @mastery.Total</td>
                            <td><MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteMasteryAsync(mastery.Id))">Remover</MudButton></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Armaduras">
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>Slot</th>
                        <th>Armadura</th>
                        <th>Categoria</th>
                        <th>Defesa</th>
                        <th>RF</th>
                        <th>RM</th>
                        <th>Peso</th>
                        <th>Durabilidade</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in _armorSlots)
                    {
                        <tr>
                            <td>@slot.Slot</td>
                            <td>
                                @if (slot.Nome is not null)
                                {
                                    <ClickableItemName Nome="@slot.Nome" ImageUrl="@slot.ImageUrl" Descricao="@slot.Descricao" Requisitos="@slot.Requisitos" RequisitosPendentes="@slot.RequisitosPendentes" Penalidade="@slot.Penalidade" OutrasPenalidades="@slot.OutrasPenalidades" /> <DesabilitadoChip Condicao="@slot.DesabilitadoPor" />
                                }
                                else
                                {
                                    @:—
                                }
                            </td>
                            <td>@(slot.Categoria ?? "—")</td>
                            <td>@(slot.Defesa?.ToString() ?? "—")</td>
                            <td>@(slot.RF?.ToString() ?? "—")</td>
                            <td>@(slot.RM?.ToString() ?? "—")</td>
                            <td>@(slot.Peso?.ToString() ?? "—")</td>
                            <td>
                                @if (slot.ItemId is not null)
                                {
                                    @if (slot.Inquebravel)
                                    {
                                        <text>Inquebrável</text>
                                    }
                                    else
                                    {
                                        <MudNumericField T="int?" Value="@slot.DurabilidadeAtual" ValueChanged="@(v => UpdateArmorSlotDurabilidadeAsync(slot.Slot, v))" Style="width:5em; display:inline-flex;" />
                                        <text> / @slot.DurabilidadeMaxima</text>
                                    }
                                }
                            </td>
                            <td>
                                @if (slot.ItemId is not null)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => AssignArmorSlotAsync(slot.Slot, null))">Remover</MudButton>
                                }
                                else
                                {
                                    <span style="display: inline-block; width: 16em; vertical-align: middle;">
                                        <CatalogoItemPicker Value="@_armorSlotForm[slot.Slot]" ValueChanged="@(v => _armorSlotForm[slot.Slot] = v ?? "")" SearchItems="@(q => _estado.BuscarItensPorTipoAsync(q, "Armadura"))" Placeholder="Buscar armadura..." Tipo="Armadura" PodeCriar="@_isGmCaller" />
                                    </span>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => AssignArmorSlotAsync(slot.Slot, _armorSlotForm.GetValueOrDefault(slot.Slot)))">Atribuir</MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>

        <Section Title="Escudos">
            <EditForm Model="_shieldForm" OnValidSubmit="AddShieldAsync">
                <CatalogoItemPicker @bind-Value="_shieldForm.ItemId" SearchItems="@(q => _estado.BuscarItensPorTipoAsync(q, "Escudo"))" Placeholder="Buscar escudo..." Tipo="Escudo" PodeCriar="@_isGmCaller" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Escudo</MudButton>
            </EditForm>
            <MudSimpleTable Dense="true" Hover="true" Class="mt-3">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Categoria</th>
                        <th>Bônus de Defesa</th>
                        <th>Peso</th>
                        <th>Durabilidade</th>
                        <th>Equipado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shield in _shields)
                    {
                        <tr>
                            <td>
                                <ClickableItemName Nome="@shield.Nome" ImageUrl="@shield.ImageUrl" Descricao="@shield.Descricao" Requisitos="@shield.Requisitos" RequisitosPendentes="@shield.RequisitosPendentes" Penalidade="@shield.Penalidade" OutrasPenalidades="@shield.OutrasPenalidades" EmUso="@shield.IsEquipped" /> <DesabilitadoChip Condicao="@shield.DesabilitadoPor" />
                            </td>
                            <td>@(shield.Categoria ?? "—")</td>
                            <td>@(shield.BonusDefesa?.ToString() ?? "—")</td>
                            <td>@shield.Peso</td>
                            <td>
                                @if (shield.Inquebravel)
                                {
                                    <text>Inquebrável</text>
                                }
                                else
                                {
                                    <MudNumericField T="int?" Value="@shield.DurabilidadeAtual" ValueChanged="@(v => UpdateShieldDurabilidadeAsync(shield.Id, v))" Style="width:5em; display:inline-flex;" />
                                    <text> / @shield.DurabilidadeMaxima</text>
                                }
                            </td>
                            <td>@(shield.IsEquipped ? "Equipado" : "")</td>
                            <td>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EquipShieldAsync(shield.Id, !shield.IsEquipped))">@(shield.IsEquipped ? "Desequipar" : "Equipar")</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteShieldAsync(shield.Id))">Remover</MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </Section>
    </MudTabPanel>

    <MudTabPanel Text="Magias & Habilidades">
        <HabilidadeRacialSection Formulario="_form" SalvarAgora="SaveIgnoringResultAsync" />
        <AbaMagiasEHabilidades />
    </MudTabPanel>

    <MudTabPanel Text="Posses">
        <AbaPosses Formulario="_form" SalvarAgora="SaveIgnoringResultAsync" EquipagemEscolhida="OnEquipagemChosenAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Antecedentes">
        <AbaAntecedentes Formulario="_form" AoMudar="NotifySavedAsync" />
    </MudTabPanel>
</MudTabs>
</CascadingValue>

</div>

@code {
    [Parameter] public string SheetId { get; set; } = "";

    // O estado que as abas compartilhadas recebem em cascata (E). Os campos abaixo continuam com os nomes de antes,
    // mas o valor mora no estado: a página e as abas leem e escrevem o mesmo.
    private FichaEstado _estado = null!;
    private string? _errorMessage { get => _estado.Erro; set => _estado.Erro = value; }
    private bool _isGmCaller { get => _estado.IsGmCaller; set => _estado.IsGmCaller = value; }
    private string? _campaignId { get => _estado.CampaignId; set => _estado.CampaignId = value; }
    private List<ImageSummaryResponse> _myImages { get => _estado.MinhasImagens; set => _estado.MinhasImagens = value; }
    private int _penalidadesVersao { get => _estado.PenalidadesVersao; set => _estado.PenalidadesVersao = value; }
    private int _condicoesVersao { get => _estado.CondicoesVersao; set => _estado.CondicoesVersao = value; }
    private SubAttributesResponse? _subAttributes { get => _estado.SubAtributos; set => _estado.SubAtributos = value; }
    private bool _historiaLoaded { get => _estado.HistoriaCarregada; set => _estado.HistoriaCarregada = value; }

    // Value must match the Variante enum member name exactly (server parses it); label is the
    // real Sistema Básico display name (Ruína RPG - Sistema Básico §7).
    private static readonly Dictionary<string, (string Valor, string Rotulo)[]> VariantesPorLinhagem = new()
    {
        ["Humano"] = [("Sinir", "Sinir (Sol)"), ("Laonir", "Laonir (Lua)")],
        ["Phylauc"] = [("PhylacTai", "Phylac'tai (Sol)"), ("EsPhylauc", "Es'Phylauc (Lua)")],
        ["Nephrytes"] = [("Koroanos", "Koroanos (Sol)"), ("Yavos", "Yavos (Lua)")],
        ["Econos"] = [("Alora", "Alóra (Lua)")],
    };

    // Classe (displayed label; SubVocacao is the internal property/DB column name, kept as-is) is
    // free text server-side (no enum), so value == label here — from "Relação de Vocacão e Classes.md".
    private static readonly Dictionary<string, string[]> SubVocacoesPorVocacao = new()
    {
        ["Campeao"] = ["Cavalheiro", "Duelista", "Paladino", "Lamina Holística", "Guardião"],
        ["Cacador"] = ["Arqueiro", "Domador", "Assassino"],
        ["Feiticeiro"] = ["Aeromante", "Biomante", "Fluxomante", "Piromante", "Sábio"],
        ["Adepto"] = ["Paladino", "Arauto", "Trovador", "Eremita"],
        ["Bruxo"] = ["Ecomante", "Hemomante", "Osteomante", "Nexomante", "Cultista"],
    };

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("NPCs do GM", "npcs"),
        new(string.IsNullOrWhiteSpace(_form.Nome) ? "Ficha de NPC" : _form.Nome),
    };

    private readonly FormularioDaFicha _form = new(TipoDeFichaCliente.Npc);
    private readonly RuinaRPG.Client.Services.AutoSaveCoordinator _autoSave = new();
    private List<AttributeResponse> _attributes => _estado.Atributos;
    private List<SkillResponse> _skills => _estado.Pericias;

    // O nome vem da própria resposta das perícias da ficha (sempre fresca); o catálogo da sessão pode
    // estar desatualizado se o Auditor adicionou/renomeou uma perícia depois que ele foi carregado.
    private string PericiaLabel(string chave) =>
        _skills.FirstOrDefault(s => s.Pericia == chave)?.Nome ?? Pericias.Label(chave);
    private List<WeaponResponse> _weapons = new();
    private List<ArmorSlotResponse> _armorSlots = new();
    private List<ShieldResponse> _shields = new();
    private readonly WeaponFormModel _weaponForm = new();
    private readonly ShieldFormModel _shieldForm = new();
    // Pre-seeded with the 3 fixed ArmorSlotType values so @bind's getter never sees a missing key.
    private readonly Dictionary<string, string> _armorSlotForm = new() { ["Capacete"] = "", ["Superior"] = "", ["Inferior"] = "" };
    private ModificadorDeDanoResponse? _modificadorDeDano;
    private List<MasteryResponse> _masteries = new();
    private readonly MasteryFormModel _masteryForm = new();
    private List<string> _levelUpBonuses = new();
    private PendingRacialTraitChoiceResponse? _pendingRacialChoice;
    private bool _racialChoiceDialogOpen;
    private string? _racialGratuitaChoice;
    private string? _racialObrigatoriaChoice;
    private string? _racialGratuitaEspecificacao;
    private string? _racialObrigatoriaEspecificacao;

    protected override void OnInitialized()
    {
        _estado = new FichaEstado(Http, TipoDeFichaCliente.Npc, SheetId);
        _estado.RecarregarPontosDeIgnicao = RecarregarPontosDeIgnicaoAsync;
        _estado.CarregarCombate = CarregarCombateAsync;
        _estado.Alterado += OnEstadoAlterado;
        _autoSave.StateChanged += StateHasChangedFromAutoSave;
        // Condições mudam no servidor (ação do GM no encontro): a ficha se recarrega sem salvar nada e sem
        // trocar o campo que está sendo editado (RecargaAdiada).
        _recarga = new RecargaAdiada(RecarregarPorCondicoesAsync, () => JS.InvokeAsync<bool>("ruinaFoco.campoEmEdicao").AsTask(), () => _autoSave.Ocupado,
            aoFalhar: falha => _ = AvisarFalhaDaRecargaAsync());
        Notifier.CondicoesAlteradas += OnCondicoesAlteradas;
    }

    // Erro de uma recarga adiada (RecargaAdiada nunca chama isto depois do Dispose). Ninguém espera esta tarefa, então
    // ela não pode falhar: se a página sair no meio-tempo, não há onde mostrar o erro.
    private async Task AvisarFalhaDaRecargaAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _errorMessage = "Não foi possível atualizar a ficha com as Condições.";
                StateHasChanged();
            });
        }
        catch (Exception)
        {
        }
    }

    private RecargaAdiada _recarga = null!;
    // Só uma ficha concedida a um jogador tem Condições vivas; a do Mestre mostra o efeito só no Resumo do encontro.
    private bool _concedida;

    private void OnCondicoesAlteradas(CondicoesAlteradasNotification notificacao)
    {
        if (notificacao.Kind != "npc" || notificacao.SheetId != SheetId)
            return;

        _ = InvokeAsync(async () =>
        {
            // O aviso e a lista de Passivas mudam já; a recarga da ficha espera se há um campo em edição.
            _condicoesVersao++;
            StateHasChanged();
            try
            {
                await _recarga.SolicitarAsync();
            }
            catch (Exception)
            {
                _errorMessage = "Não foi possível atualizar a ficha com as Condições.";
            }
            StateHasChanged();
        });
    }

    // Relê os números e as listas que as Condições mexem. Não passa por _autoSave: nada é gravado.
    private Task RecarregarPorCondicoesAsync() => InvokeAsync(async () =>
    {
        await LoadSheetAsync(); await _estado.CarregarAtributosECombateAsync(); await _estado.CarregarMagiasAsync(); await _estado.CarregarRunasAsync(); await _estado.CarregarArtefatosAsync();
        _penalidadesVersao++;
        StateHasChanged();
    });

    private void StateHasChangedFromAutoSave() => InvokeAsync(StateHasChanged);

    // Uma aba filha mudou o estado fora de um evento da página (ex.: Erro depois de um POST recusado).
    private void OnEstadoAlterado() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _estado.Alterado -= OnEstadoAlterado;
        _autoSave.StateChanged -= StateHasChangedFromAutoSave;
        Notifier.CondicoesAlteradas -= OnCondicoesAlteradas;
        _recarga.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await Pericias.CarregarAsync();
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        _isGmCaller = authState.User.IsInRole("GM");

        // LoadSheetAsync sets _campaignId, which LoadImagesAsync now needs — see the identical
        // note in FichaDePersonagem.razor's OnInitializedAsync.
        await LoadSheetAsync();
        await LoadImagesAsync();

        await Task.WhenAll(
            LoadLevelUpNoticeAsync(), _estado.CarregarAtributosECombateAsync(),
            _estado.CarregarHabilidadeRacialAsync(), _estado.CarregarVariantesLiberadasAsync(), _estado.CarregarMagiasAsync(), _estado.CarregarRunasAsync(), LoadMasteriesAsync(),
            _estado.CarregarInventarioAsync(), _estado.CarregarArtefatosAsync(), _estado.CarregarAfeicoesAsync(), _estado.CarregarCaracteristicasAsync(),
            LoadPendingRacialChoiceAsync());
    }

