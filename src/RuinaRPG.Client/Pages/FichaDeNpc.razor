    /// <summary>
    /// A API mexe no saldo de PI ao adicionar, editar e remover uma Magia/Habilidade (4.b), e é ela quem
    /// guarda o valor: o formulário só o exibe. Relê o saldo depois de cada operação que o altera. Se a
    /// releitura falhar, o campo fica como está — a operação em si já deu certo.
    /// </summary>
    private async Task RecarregarPontosDeIgnicaoAsync()
    {
        var response = await Http.GetAsync($"npc-sheets/{SheetId}");
        if (!response.IsSuccessStatusCode)
            return;

        var sheet = await response.Content.ReadFromJsonAsync<NpcSheetResponse>();
        if (sheet is not null)
            _form.PontosDeIgnicaoAtual = sheet.PontosDeIgnicaoAtual;
    }

