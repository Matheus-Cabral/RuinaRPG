    /// <summary>
    /// Runs SaveIfValidAsync outside the autosave flow (i.e. not via _autoSave.NotifyChanged), for
    /// the pre-existing immediate-save handlers below (UpdateCoberturaAsync/UpdateCiclosAsync) that
    /// have no separate sub-resource PUT endpoint of their own. Preserves their original behavior of
    /// surfacing a save failure via _errorMessage instead of letting SaveIfValidAsync's exception go
    /// unhandled.
    /// </summary>
    private async Task SaveIgnoringResultAsync()
    {
        try
        {
            await SaveIfValidAsync();
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

