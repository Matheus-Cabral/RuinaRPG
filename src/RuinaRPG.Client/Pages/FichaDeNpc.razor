    private async Task UpdateShieldDurabilidadeAsync(string shieldId, object? value)
    {
        if (int.TryParse(value?.ToString(), out var durabilidade))
            await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/shields/{shieldId}/durabilidade", durabilidade);
        await LoadTabs2And3Async();
    }

    private async Task LoadRacialAbilityAsync()
    {
        _racialAbility = await Http.GetFromJsonAsync<RacialAbilityResponse>($"npc-sheets/{SheetId}/racial-ability");
    }

    private async Task LoadSpellAbilitiesAsync()
    {
        _spellAbilities = await Http.GetFromJsonAsync<List<NpcSpellAbilityResponse>>($"npc-sheets/{SheetId}/spell-abilities") ?? new();
        _bankEntries = await Http.GetFromJsonAsync<List<SpellAbilityEntryResponse>>("spell-ability-bank") ?? new();
    }

    private void AddSpellAbilityEffect() => _spellAbilityForm.Efeitos.Add(new SpellAbilityEffectFormModel());

    private async Task AddSpellAbilityAsync()
    {
        var request = _spellAbilityForm.Origem == "Banco"
            ? new AddNpcSpellAbilityRequest(_spellAbilityForm.SourceBankEntryId, null, null, null, null, null)
            : new AddNpcSpellAbilityRequest(null, _spellAbilityForm.Nome, _spellAbilityForm.Tipo, _spellAbilityForm.Grau, _spellAbilityForm.Descricao,
                _spellAbilityForm.Efeitos.Select(e => new SpellAbilityEffectRequest(e.EfeitoNome, e.Quantidade, e.CustoPI)).ToList());

        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/spell-abilities", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a magia/habilidade.";
            return;
        }

        _spellAbilityForm.SourceBankEntryId = "";
        _spellAbilityForm.Nome = "";
        _spellAbilityForm.Tipo = "Magia";
        _spellAbilityForm.Grau = 0;
        _spellAbilityForm.Descricao = "";
        _spellAbilityForm.Efeitos.Clear();
        await LoadSpellAbilitiesAsync();
    }

    private async Task DeleteSpellAbilityAsync(string id)
    {
        await Http.DeleteAsync($"npc-sheets/{SheetId}/spell-abilities/{id}");
        await LoadSpellAbilitiesAsync();
    }

    private async Task LoadRunesAsync()
    {
        _runes = await Http.GetFromJsonAsync<List<NpcRuneResponse>>($"npc-sheets/{SheetId}/runes") ?? new();
    }

    private async Task AddRuneAsync()
    {
        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/runes", new AddNpcRuneRequest(_runeForm.Nome, _runeForm.Descricao, _runeForm.Grau));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a runa.";
            return;
        }

        _runeForm.Nome = "";
        _runeForm.Descricao = "";
        _runeForm.Grau = 0;
        await LoadRunesAsync();
    }

    private async Task DeleteRuneAsync(string id)
    {
        await Http.DeleteAsync($"npc-sheets/{SheetId}/runes/{id}");
        await LoadRunesAsync();
    }

    private async Task LoadMasteriesAsync()
    {
        _masteries = await Http.GetFromJsonAsync<List<NpcMasteryResponse>>($"npc-sheets/{SheetId}/masteries") ?? new();
    }

    private async Task AddMasteryAsync()
    {
        var request = new AddNpcMasteryRequest(_masteryForm.Nome, _masteryForm.Pericia, _masteryForm.Atributo, _masteryForm.GastoMaestria);
        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/masteries", request);
