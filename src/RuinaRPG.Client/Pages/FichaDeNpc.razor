    private async Task UpdateAffinityAsync(string id, string field, object? value)
    {
        var current = _affinities.Single(a => a.Id == id);
        var elemento = field == "Elemento" ? value?.ToString() : current.Elemento;
        var elementoValor = field == "ElementoValor" ? value as int? : current.ElementoValor;
        var subElemento = field == "SubElemento" ? value?.ToString() : current.SubElemento;
        var subElementoValor = field == "SubElementoValor" ? value as int? : current.SubElementoValor;
        var caminhoNome = field == "CaminhoNome" ? value?.ToString() : current.CaminhoNome;
        var experiencia = field == "Experiencia" ? value as int? : current.Experiencia;

        var response = await Http.PutAsJsonAsync($"npc-sheets/{SheetId}/affinities/{id}",
            new UpdateNpcAffinityRequest(elemento, elementoValor, subElemento, subElementoValor, caminhoNome, experiencia));
        _errorMessage = response.IsSuccessStatusCode ? null : await response.Content.ReadErrorMessageAsync();
        await LoadTabs2And3Async();
    }

