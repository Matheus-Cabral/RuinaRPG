    private async Task DeleteMasteryAsync(string id)
    {
        await Http.DeleteAsync($"npc-sheets/{SheetId}/masteries/{id}");
        await LoadMasteriesAsync();
    }

    private async Task LoadInventoryAsync()
    {
        _inventory = await Http.GetFromJsonAsync<List<NpcInventoryItemResponse>>($"npc-sheets/{SheetId}/inventory") ?? new();
    }

    private async Task AddInventoryItemAsync()
    {
        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/inventory", new AddNpcInventoryItemRequest(_inventoryForm.ItemId, _inventoryForm.Qtd));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar o item.";
            return;
        }

        _inventoryForm.ItemId = "";
        _inventoryForm.Qtd = 1;
