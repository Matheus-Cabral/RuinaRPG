        await LoadInventoryAsync();
    }

    private async Task LoadArtifactsAsync()
    {
        _artifacts = await Http.GetFromJsonAsync<List<NpcArtifactResponse>>($"npc-sheets/{SheetId}/artifacts") ?? new();
    }

    private async Task AddArtifactAsync()
    {
        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/artifacts", new AddNpcArtifactRequest(_artifactForm.ArtifactItemId));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar o artefato.";
            return;
        }

        _artifactForm.ArtifactItemId = "";
        await LoadArtifactsAsync();
    }

    private async Task DeleteArtifactAsync(string id)
    {
        await Http.DeleteAsync($"npc-sheets/{SheetId}/artifacts/{id}");
        await LoadArtifactsAsync();
    }

    private async Task LoadAffectionsAsync()
    {
        _affections = await Http.GetFromJsonAsync<List<NpcAffectionResponse>>($"npc-sheets/{SheetId}/affections") ?? new();
    }

    private async Task AddAffectionAsync()
    {
        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/affections", new AddNpcAffectionRequest(_affectionForm.Nome, _affectionForm.Favorabilidade));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a afeição.";
            return;
        }

        _affectionForm.Nome = "";
        _affectionForm.Favorabilidade = 0;
        await LoadAffectionsAsync();
    }

    private async Task DeleteAffectionAsync(string id)
    {
        await Http.DeleteAsync($"npc-sheets/{SheetId}/affections/{id}");
        await LoadAffectionsAsync();
    }

    private async Task LoadTraitsAsync()
    {
        _traits = await Http.GetFromJsonAsync<NpcTraitsListResponse>($"npc-sheets/{SheetId}/traits");
    }

    private async Task AddTraitAsync()
    {
        var response = await Http.PostAsJsonAsync($"npc-sheets/{SheetId}/traits", new AddNpcTraitRequest(_traitForm.TraitId));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar a característica.";
            return;
        }

        _traitForm.TraitId = "";
        await LoadTraitsAsync();
    }

    private async Task DeleteTraitAsync(string id)
    {
        await Http.DeleteAsync($"npc-sheets/{SheetId}/traits/{id}");
        await LoadTraitsAsync();
    }

