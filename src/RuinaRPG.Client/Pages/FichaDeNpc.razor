        ["Nephrytes"] = [("Koroanos", "Koroanos (Sol)"), ("Yavos", "Yavos (Lua)")],
        ["Econos"] = [("Alora", "Alóra (Lua)")],
    };

    // Sub-Vocação is free text server-side (no enum), so value == label here — from "Relação de
    // Vocacão e Classes.md".
