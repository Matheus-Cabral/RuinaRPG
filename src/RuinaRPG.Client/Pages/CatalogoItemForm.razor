@page "/catalogo/novo"
@page "/catalogo/{ItemId}/editar"
@implements IDisposable
@inject HttpClient Http
@inject PericiaCatalogo Pericias
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Items
@using RuinaRPG.Contracts.Images
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using RuinaRPG.Domain.CharacterSheets
@using RuinaRPG.Domain.Items
@using RuinaRPG.Contracts.Rules
@using RuinaRPG.Client.Shared.Fields

@if (!OnCreated.HasDelegate)
{
    <Breadcrumbs Items="@Crumbs" />
}

<MudText Typo="Typo.h3">@(ItemId is null ? "Novo Item" : "Editar Item")</MudText>

<DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

<EditForm EditContext="_editContext">
    <DataAnnotationsValidator />
    @if (ItemId is not null)
    {
        <AutoSaveIndicator State="_autoSave.State" LastSavedAt="_autoSave.LastSavedAt" />
    }
    <ItemFieldsEditor Model="_form" TipoBloqueado="@(ItemId is not null || FixedTipo is not null)"
                      OcultarTipo="@(ItemId is not null || FixedTipo is not null)" MostrarImagem="true"
                      ImagensDisponiveis="_myImages" ImagemIds="_imageIds" ImagemIdsChanged="OnImagesChanged"
                      OnImageError="@(e => _errorMessage = e)" DurabilidadeHint="@_durabilidadeHint"
                      OnRankChanged="RecomputeDurabilidadeHint" OnChanged="NotifySavedAsync"
                      SubcategoriasExistentes="LoadSubcategoriasExistentesAsync" />

    @if (ItemId is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="CreateAsync">Salvar</MudButton>
    }
</EditForm>

@code {
    [Parameter] public string? ItemId { get; set; }
    [Parameter] public string? FixedTipo { get; set; }
    [Parameter] public EventCallback<ItemResponse> OnCreated { get; set; }

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Catálogo de Itens", "catalogo"),
        new(ItemId is null ? "Novo Item" : (string.IsNullOrWhiteSpace(_form.Nome) ? "Editar Item" : _form.Nome)),
    };

    private readonly ItemFormModel _form = new();
    // Constructed synchronously (not inside OnInitializedAsync, and not after any await there) so
    // it is never null on first render — EditContext only holds a reference to _form and reads its
    // properties lazily at validation time, so it doesn't need _form to already be populated from
    // the server first.
    private readonly EditContext _editContext;
    private readonly AutoSaveCoordinator _autoSave = new();
    private List<ImageSummaryResponse> _myImages = new();
    private List<string> _imageIds = new();
    private string? _errorMessage;
    private Dictionary<RankDeItem, DurabilidadeDeRank> _durabilidadesPorRank = new();
    private string _durabilidadeHint = "Sem durabilidade";
    private bool _durabilidadesPorRankIndisponivel;

    // Kept as forwards: the lists and Alvo options now live in ItemFieldsEditor (shared with the
    // fixed items of the Equipagem kits), and the existing tests still reach them through the page.
    internal static string[] RankOptions => ItemFieldsEditor.RankOptions;
    internal static (string Value, string Label)[] TipoDeAlvoOptions => ItemFieldsEditor.TipoDeAlvoOptions;
    internal static IEnumerable<string> AlvoOptionsFor(string? tipoDeAlvo, IEnumerable<string> pericias) =>
        ItemFieldsEditor.AlvoOptionsFor(tipoDeAlvo, pericias);

    public CatalogoItemForm()
    {
        _editContext = new EditContext(_form);
    }

    protected override void OnInitialized()
    {
        _autoSave.StateChanged += StateHasChangedFromAutoSave;
        if (FixedTipo is not null)
            _form.Tipo = FixedTipo;
    }

    private void StateHasChangedFromAutoSave() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _autoSave.StateChanged -= StateHasChangedFromAutoSave;
    }

    protected override async Task OnInitializedAsync()
    {
        await Pericias.RecarregarAsync();
        var imagesResponse = await Http.GetAsync("images/mine");
        if (imagesResponse.IsSuccessStatusCode)
            _myImages = await imagesResponse.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();

        await LoadDurabilidadesPorRankAsync();

        if (ItemId is null)
            return;

        var response = await Http.GetAsync($"items?tipo="); // full list; find the one being edited
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        var existing = items.SingleOrDefault(i => i.Id == ItemId);
        if (existing is null)
        {
            _errorMessage = "Item não encontrado.";
            return;
        }

        _form.Apply(existing);
        _form.ImageId = _myImages.FirstOrDefault(i => i.Url == existing.ImageUrl)?.Id;
        _imageIds = _form.ImageId is null ? new() : new() { _form.ImageId };
        RecomputeDurabilidadeHint();
    }

    // Catálogo R0003/R0004: a Subcategoria sugere as que o GM já usa em itens do mesmo Tipo. Não há
    // cadastro próprio de subcategorias — elas são as dos itens do catálogo, como no filtro da lista.
    private async Task<List<string>> LoadSubcategoriasExistentesAsync(string tipo)
    {
        var response = await Http.GetAsync($"items?tipo={Uri.EscapeDataString(tipo)}");
        if (!response.IsSuccessStatusCode)
            return new();
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        return items.Select(i => i.Subcategoria).OfType<string>().ToList();
    }

    private async Task LoadDurabilidadesPorRankAsync()
    {
        var response = await Http.GetAsync("durabilidades-por-rank");
        if (!response.IsSuccessStatusCode)
        {
            // Sem a tabela não dá pra saber a durabilidade de um Rank — o hint não pode afirmar "Sem durabilidade".
            _durabilidadesPorRankIndisponivel = true;
            return;
        }

        var linhas = await response.Content.ReadFromJsonAsync<List<DurabilidadePorRankResponse>>() ?? new();
        _durabilidadesPorRank = linhas
            .Where(l => Enum.TryParse<RankDeItem>(l.Rank, out _))
            .ToDictionary(l => Enum.Parse<RankDeItem>(l.Rank), l => new DurabilidadeDeRank(Enum.Parse<RankDeItem>(l.Rank), l.Durabilidade, l.Inquebravel));
    }

    private void RecomputeDurabilidadeHint()
    {
        RankDeItem? rank = Enum.TryParse<RankDeItem>(_form.Rank, out var parsed) ? parsed : null;
        if (rank is not null && _durabilidadesPorRankIndisponivel)
        {
            _durabilidadeHint = "Durabilidade: —";
            return;
        }
        var (maxima, inquebravel) = DurabilidadeDeItem.Resolver(rank, _durabilidadesPorRank);
        _durabilidadeHint = inquebravel ? "Inquebrável" : maxima is null ? "Sem durabilidade" : $"Durabilidade: {maxima}";
    }

    private async Task CreateAsync()
    {
        if (!_editContext.Validate())
            return;

        var request = _form.ToCreateRequest();
        var response = await Http.PostAsJsonAsync("items", request);

        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar o item.";
            return;
        }

        if (OnCreated.HasDelegate)
        {
            var created = await response.Content.ReadFromJsonAsync<ItemResponse>();
            if (created is null)
            {
                _errorMessage = "Não foi possível salvar o item.";
                return;
            }
            await OnCreated.InvokeAsync(created);
            return;
        }

        Navigation.NavigateTo("/catalogo");
    }

    private async Task<bool> SaveIfValidAsync()
    {
        if (!_editContext.Validate())
            return false;

        var request = _form.ToUpdateRequest();
        var response = await Http.PutAsJsonAsync($"items/{ItemId}", request);

        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("Não foi possível salvar o item.");

        return true;
    }

    private Task OnImagesChanged(List<string> ids)
    {
        _imageIds = ids;
        _form.ImageId = ids.FirstOrDefault();
        return ItemId is not null ? NotifySavedAsync() : Task.CompletedTask;
    }

    internal Task CreateForTestsAsync() => CreateAsync();

    private Task NotifySavedAsync()
    {
        // Guard, not the brief's literal sketch: the plain-field @bind-Value:after callbacks have
        // no per-field ItemId check (unlike the ImageAttachmentField callback above), so without
        // this guard every field blur during create mode would fire a PUT to "items/" (empty id)
        // and flip _autoSave to Error — silently, since AutoSaveIndicator isn't rendered there.
        // Create mode keeps its explicit "Salvar" -> CreateAsync path untouched.
        if (ItemId is not null)
            _autoSave.NotifyChanged(SaveIfValidAsync);
        return Task.CompletedTask;
    }
}
