@page "/catalogo/novo"
@page "/catalogo/{ItemId}/editar"
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@using RuinaRPG.Contracts.Items
@using RuinaRPG.Contracts.Images
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using RuinaRPG.Domain.CharacterSheets
@using RuinaRPG.Domain.Items

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">@(ItemId is null ? "Novo Item" : "Editar Item")</MudText>

@if (_errorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_errorMessage</MudAlert>
}

<EditForm EditContext="_editContext">
    <DataAnnotationsValidator />
    @if (ItemId is not null)
    {
        <AutoSaveIndicator State="_autoSave.State" LastSavedAt="_autoSave.LastSavedAt" />
    }
    <Section Title="Geral">
        @if (ItemId is null)
        {
            <MudSelect T="string" @bind-Value="_form.Tipo" Label="Tipo">
                <MudSelectItem Value="@("ItemGeral")">Item Geral</MudSelectItem>
                <MudSelectItem Value="@("Arma")">Arma</MudSelectItem>
                <MudSelectItem Value="@("Armadura")">Armadura</MudSelectItem>
                <MudSelectItem Value="@("Escudo")">Escudo</MudSelectItem>
                <MudSelectItem Value="@("Artefato")">Artefato</MudSelectItem>
            </MudSelect>
        }

        <MudTextField T="string" @bind-Value="_form.Nome" Label="Nome" @bind-Value:after="NotifySavedAsync" />
        <MudNumericField T="decimal" @bind-Value="_form.Peso" For="@(() => _form.Peso)" Label="Peso" @bind-Value:after="NotifySavedAsync" />
        <MudNumericField T="int" @bind-Value="_form.Preco" For="@(() => _form.Preco)" Label="Preço (Ciclos)" @bind-Value:after="NotifySavedAsync" />
        <MudTextField T="string" @bind-Value="_form.Descricao" Label="Descrição" Lines="3" @bind-Value:after="NotifySavedAsync" />

        <ImageAttachmentField AvailableImages="_myImages" SelectedIds="_imageIds"
                              SelectedIdsChanged="@(v => { _imageIds = v; _form.ImageId = v.FirstOrDefault(); if (ItemId is not null) NotifySavedAsync(); })"
                              OnError="@(e => _errorMessage = e)" Multiple="false" />
    </Section>

    @if (_form.Tipo == "ItemGeral")
    {
        <Section Title="Item Geral">
            <MudTextField T="string" @bind-Value="_form.Subcategoria" Label="Subcategoria" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="decimal?" @bind-Value="_form.CapacidadeExtra" For="@(() => _form.CapacidadeExtra)" Label="Capacidade Extra" @bind-Value:after="NotifySavedAsync" />
        </Section>
    }
    else if (_form.Tipo == "Arma")
    {
        <Section Title="Arma">
            <MudTextField T="string" @bind-Value="_form.Subcategoria" Label="Subcategoria" @bind-Value:after="NotifySavedAsync" />
            <MudTextField T="string" @bind-Value="_form.Tier" Label="Tier" @bind-Value:after="NotifySavedAsync" />
            <MudTextField T="string" @bind-Value="_form.Empunhadura" Label="Empunhadura" @bind-Value:after="NotifySavedAsync" />
            <MudTextField T="string" @bind-Value="_form.Dados" Label="Dados" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.Dano" Label="Dano" @bind-Value:after="NotifySavedAsync" />
            <MudTextField T="string" @bind-Value="_form.Critico" Label="Crítico" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.Alcance" Label="Alcance" @bind-Value:after="NotifySavedAsync" />
            <MudTextField T="string" @bind-Value="_form.TipoDeDano" Label="Tipo de Dano" @bind-Value:after="NotifySavedAsync" />
            <MudTextField T="string" @bind-Value="_form.RequisitoAtributo" Label="Requisito de Atributo" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.DurabilidadeMaxima" For="@(() => _form.DurabilidadeMaxima)" Label="Durabilidade" @bind-Value:after="NotifySavedAsync" />
        </Section>
    }
    else if (_form.Tipo is "Armadura" or "Escudo")
    {
        <Section Title="@(_form.Tipo == "Armadura" ? "Armadura" : "Escudo")">
            <MudTextField T="string" @bind-Value="_form.Categoria" Label="Categoria" @bind-Value:after="NotifySavedAsync" />
            @if (_form.Tipo == "Armadura")
            {
                <MudNumericField T="int?" @bind-Value="_form.Defesa" Label="Defesa" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.RF" Label="RF" @bind-Value:after="NotifySavedAsync" />
                <MudNumericField T="int?" @bind-Value="_form.RM" Label="RM" @bind-Value:after="NotifySavedAsync" />
            }
            else
            {
                <MudNumericField T="int?" @bind-Value="_form.BonusDefesa" Label="Bônus de Defesa" @bind-Value:after="NotifySavedAsync" />
            }
            <MudTextField T="string" @bind-Value="_form.Penalidade" Label="Penalidade" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.RequisitoVigor" Label="Requisito de Vigor" @bind-Value:after="NotifySavedAsync" />
            <MudNumericField T="int?" @bind-Value="_form.DurabilidadeMaxima" For="@(() => _form.DurabilidadeMaxima)" Label="Durabilidade" @bind-Value:after="NotifySavedAsync" />
        </Section>
    }
    else if (_form.Tipo == "Artefato")
    {
        <Section Title="Artefato">
            <MudAutocomplete T="string" @bind-Value="_form.TipoDeAlvo" @bind-Value:after="OnTipoDeAlvoChangedAsync"
                              SearchFunc="SearchTipoDeAlvoAsync" ToStringFunc="@TipoDeAlvoLabel"
                              Label="Tipo de Alvo" CoerceText="false" ResetValueOnEmptyText="true" MaxItems="null" />
            <MudAutocomplete T="string" @bind-Value="_form.Alvo" @bind-Value:after="NotifySavedAsync"
                              SearchFunc="SearchAlvoAsync" Label="Alvo" CoerceText="false" ResetValueOnEmptyText="true" MaxItems="null"
                              Disabled="@string.IsNullOrEmpty(_form.TipoDeAlvo)" />
            <MudNumericField T="int?" @bind-Value="_form.Valor" Label="Valor" @bind-Value:after="NotifySavedAsync" />
        </Section>
    }

    @if (ItemId is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="CreateAsync">Salvar</MudButton>
    }
</EditForm>

@code {
    [Parameter] public string? ItemId { get; set; }

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Catálogo de Itens", "catalogo"),
        new(ItemId is null ? "Novo Item" : (string.IsNullOrWhiteSpace(_form.Nome) ? "Editar Item" : _form.Nome)),
    };

    private readonly ItemFormModel _form = new();
    // Constructed synchronously (not inside OnInitializedAsync, and not after any await there) so
    // it is never null on first render — EditContext only holds a reference to _form and reads its
    // properties lazily at validation time, so it doesn't need _form to already be populated from
    // the server first.
    private readonly EditContext _editContext;
    private readonly AutoSaveCoordinator _autoSave = new();
    private List<ImageSummaryResponse> _myImages = new();
    private List<string> _imageIds = new();
    private string? _errorMessage;

    public CatalogoItemForm()
    {
        _editContext = new EditContext(_form);
    }

    protected override void OnInitialized()
    {
        _autoSave.StateChanged += StateHasChangedFromAutoSave;
    }

    private void StateHasChangedFromAutoSave() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _autoSave.StateChanged -= StateHasChangedFromAutoSave;
    }

    protected override async Task OnInitializedAsync()
    {
        var imagesResponse = await Http.GetAsync("images/mine");
        if (imagesResponse.IsSuccessStatusCode)
            _myImages = await imagesResponse.Content.ReadFromJsonAsync<List<ImageSummaryResponse>>() ?? new();

        if (ItemId is null)
            return;

        var response = await Http.GetAsync($"items?tipo="); // full list; find the one being edited
        var items = await response.Content.ReadFromJsonAsync<List<ItemResponse>>() ?? new();
        var existing = items.SingleOrDefault(i => i.Id == ItemId);
        if (existing is null)
        {
            _errorMessage = "Item não encontrado.";
            return;
        }

        _form.Tipo = existing.Tipo;
        _form.Nome = existing.Nome;
        _form.ImageId = _myImages.FirstOrDefault(i => i.Url == existing.ImageUrl)?.Id;
        _imageIds = _form.ImageId is null ? new() : new() { _form.ImageId };
        _form.Peso = existing.Peso;
        _form.Preco = existing.Preco;
        _form.Subcategoria = existing.Subcategoria;
        _form.Descricao = existing.Descricao;
        _form.CapacidadeExtra = existing.CapacidadeExtra;
        _form.Tier = existing.Tier;
        _form.Empunhadura = existing.Empunhadura;
        _form.Dados = existing.Dados;
        _form.Dano = existing.Dano;
        _form.Critico = existing.Critico;
        _form.Alcance = existing.Alcance;
        _form.TipoDeDano = existing.TipoDeDano;
        _form.RequisitoAtributo = existing.RequisitoAtributo;
        _form.DurabilidadeMaxima = existing.DurabilidadeMaxima;
        _form.Categoria = existing.Categoria;
        _form.Defesa = existing.Defesa;
        _form.RF = existing.RF;
        _form.RM = existing.RM;
        _form.Penalidade = existing.Penalidade;
        _form.RequisitoVigor = existing.RequisitoVigor;
        _form.BonusDefesa = existing.BonusDefesa;
        _form.TipoDeAlvo = existing.TipoDeAlvo;
        _form.Alvo = existing.Alvo;
        _form.Valor = existing.Valor;
    }

    private async Task CreateAsync()
    {
        if (!_editContext.Validate())
            return;

        var request = new CreateItemRequest(_form.Tipo, _form.Nome, _form.Peso, _form.Preco, _form.ImageId,
            _form.Subcategoria, _form.Descricao, _form.Tier, _form.Empunhadura, _form.Dados, _form.Dano,
            _form.Critico, _form.Alcance, _form.TipoDeDano, _form.RequisitoAtributo, _form.DurabilidadeMaxima,
            _form.Categoria, _form.Defesa, _form.RF, _form.RM, _form.Penalidade, _form.RequisitoVigor,
            _form.BonusDefesa, _form.TipoDeAlvo, _form.Alvo, _form.Valor, _form.CapacidadeExtra);
        var response = await Http.PostAsJsonAsync("items", request);

        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar o item.";
            return;
        }

        Navigation.NavigateTo("/catalogo");
    }

    private async Task<bool> SaveIfValidAsync()
    {
        if (!_editContext.Validate())
            return false;

        var request = new UpdateItemRequest(_form.Nome, _form.Peso, _form.Preco, _form.ImageId,
            _form.Subcategoria, _form.Descricao, _form.Tier, _form.Empunhadura, _form.Dados, _form.Dano,
            _form.Critico, _form.Alcance, _form.TipoDeDano, _form.RequisitoAtributo, _form.DurabilidadeMaxima,
            _form.Categoria, _form.Defesa, _form.RF, _form.RM, _form.Penalidade, _form.RequisitoVigor,
            _form.BonusDefesa, _form.TipoDeAlvo, _form.Alvo, _form.Valor, _form.CapacidadeExtra);
        var response = await Http.PutAsJsonAsync($"items/{ItemId}", request);

        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("Não foi possível salvar o item.");

        return true;
    }

    // The 4 fixed Tipo de Alvo values, keyed by the raw enum member name the server expects
    // (ItemsController parses this with Enum.TryParse<TipoDeAlvo>) — the label is only for display.
    private static readonly (string Value, string Label)[] TipoDeAlvoOptions =
    [
        (RuinaRPG.Domain.Items.TipoDeAlvo.Atributo.ToString(), "Atributo"),
        (RuinaRPG.Domain.Items.TipoDeAlvo.Pericia.ToString(), "Perícia"),
        (RuinaRPG.Domain.Items.TipoDeAlvo.SubAtributo.ToString(), "Sub-Atributo"),
        (RuinaRPG.Domain.Items.TipoDeAlvo.Dano.ToString(), "Dano"),
    ];

    // Canonical Alvo strings for Tipo de Alvo = Sub-Atributo (ver SubAtributoAlvo) — the only one
    // of the 4 groups with no backing enum of its own.
    private static readonly string[] SubAtributoAlvoOptions =
    [
        SubAtributoAlvo.Iniciativa, SubAtributoAlvo.Movimentacao, SubAtributoAlvo.EsquivaNatural,
        SubAtributoAlvo.DefesaNatural, SubAtributoAlvo.ReducaoFisica, SubAtributoAlvo.ReducaoMagica,
        SubAtributoAlvo.Adrenalina,
    ];

    private static string TipoDeAlvoLabel(string? value) =>
        TipoDeAlvoOptions.FirstOrDefault(o => o.Value == value).Label ?? value ?? "";

    private Task<IEnumerable<string>> SearchTipoDeAlvoAsync(string value, CancellationToken token) =>
        Task.FromResult(TipoDeAlvoOptions
            .Where(o => string.IsNullOrEmpty(value) || o.Label.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(o => o.Value));

    // Alvo's own options depend on whichever Tipo de Alvo is currently chosen — same "Atributo",
    // "Pericia" and "Dano" enum-member spelling every other Alvo dropdown in the app already shows
    // raw (no accented relabeling), so a value picked here round-trips identically through
    // ArtifactBonusCalculator's string comparison elsewhere.
    private Task<IEnumerable<string>> SearchAlvoAsync(string value, CancellationToken token)
    {
        IEnumerable<string> options = _form.TipoDeAlvo switch
        {
            "Atributo" => Enum.GetValues<Atributo>().Select(a => a.ToString()),
            "Pericia" => Enum.GetValues<Pericia>().Select(p => p.ToString()),
            "SubAtributo" => SubAtributoAlvoOptions,
            "Dano" => Enum.GetValues<TipoDeDano>().Select(t => t.ToString()),
            _ => Enumerable.Empty<string>(),
        };

        return Task.FromResult(options.Where(o => string.IsNullOrEmpty(value) || o.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private Task OnTipoDeAlvoChangedAsync()
    {
        // Alvo's options are tied to Tipo de Alvo — a value from the old group makes no sense
        // under the new one (and might not even be a valid Alvo for it), so it's cleared rather
        // than left stale.
        _form.Alvo = null;
        return NotifySavedAsync();
    }

    // Test-only seams (see EntityPicker's identical rationale): MudAutocomplete owns its own
    // debounce/open-state internally, which bUnit's synchronous TestContext can't drive through
    // real elapsed time — these let CatalogoItemFormTests exercise the search/reset logic
    // deterministically, without needing _form.TipoDeAlvo set through the rendered component.
    internal Task<IEnumerable<string>> SearchTipoDeAlvoForTestsAsync(string value) => SearchTipoDeAlvoAsync(value, CancellationToken.None);
    internal Task<IEnumerable<string>> SearchAlvoForTestsAsync(string tipoDeAlvo, string value)
    {
        _form.TipoDeAlvo = tipoDeAlvo;
        return SearchAlvoAsync(value, CancellationToken.None);
    }
    internal Task OnTipoDeAlvoChangedForTestsAsync(string? previousAlvo)
    {
        _form.Alvo = previousAlvo;
        return OnTipoDeAlvoChangedAsync();
    }
    internal string? AlvoForTests => _form.Alvo;

    private Task NotifySavedAsync()
    {
        // Guard, not the brief's literal sketch: the plain-field @bind-Value:after callbacks have
        // no per-field ItemId check (unlike the ImageAttachmentField callback above), so without
        // this guard every field blur during create mode would fire a PUT to "items/" (empty id)
        // and flip _autoSave to Error — silently, since AutoSaveIndicator isn't rendered there.
        // Create mode keeps its explicit "Salvar" -> CreateAsync path untouched.
        if (ItemId is not null)
            _autoSave.NotifyChanged(SaveIfValidAsync);
        return Task.CompletedTask;
    }

    private class ItemFormModel
    {
        public string Tipo { get; set; } = "ItemGeral";
        public string Nome { get; set; } = "";
        [Range(typeof(decimal), "0", "79228162514264337593543950335")]
        public decimal Peso { get; set; }
        [Range(0, int.MaxValue)]
        public int Preco { get; set; }
        public string? ImageId { get; set; }
        public string? Subcategoria { get; set; }
        public string? Descricao { get; set; }
        [Range(typeof(decimal), "0", "79228162514264337593543950335")]
        public decimal? CapacidadeExtra { get; set; }
        public string? Tier { get; set; }
        public string? Empunhadura { get; set; }
        public string? Dados { get; set; }
        public int? Dano { get; set; }
        public string? Critico { get; set; }
        public int? Alcance { get; set; }
        public string? TipoDeDano { get; set; }
        public string? RequisitoAtributo { get; set; }
        [Range(0, int.MaxValue)]
        public int? DurabilidadeMaxima { get; set; }
        public string? Categoria { get; set; }
        public int? Defesa { get; set; }
        public int? RF { get; set; }
        public int? RM { get; set; }
        public string? Penalidade { get; set; }
        public int? RequisitoVigor { get; set; }
        public int? BonusDefesa { get; set; }
        public string? TipoDeAlvo { get; set; }
        public string? Alvo { get; set; }
        public int? Valor { get; set; }
    }
}
