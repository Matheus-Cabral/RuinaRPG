@page "/minhas-campanhas"
@implements IDisposable
@inject HttpClient Http
@inject SecretNoteNotifier Notifier
@using RuinaRPG.Client.Services
@using RuinaRPG.Contracts.Campaigns
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />

<MudText Typo="Typo.h3">Minhas Campanhas</MudText>

<DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />
@if (_errorMessage is null && _campaigns.Count == 0)
{
    <MudText Color="Color.Secondary" Class="mt-3">Você ainda não faz parte de nenhuma campanha.</MudText>
}

<MudGrid Class="mt-3">
    @foreach (var campaign in _campaigns)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard>
                <MudCardMedia Image="@(campaign.ImageUrl ?? "")" Height="160" Style="@(campaign.ImageUrl is null ? "display:none" : null)" />
                <MudCardContent>
                    <MudText Typo="Typo.h6">@campaign.Nome</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@campaign.Descricao</MudText>
                    @if (Notifier.UnreadFor(campaign.Id) is > 0 and var unread)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.MarkEmailUnread" Class="rr-unread-chip mt-2">
                            @(unread == 1 ? "1 nota secreta não lida" : $"{unread} notas secretas não lidas")
                        </MudChip>
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"campanhas/{campaign.Id}/jogador")">Abrir</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs => new()
    {
        new("Painel", "painel"),
        new("Minhas Campanhas"),
    };

    private List<CampaignResponse> _campaigns = new();
    private string? _errorMessage;

    protected override Task OnInitializedAsync()
    {
        Notifier.Changed += OnNotifierChanged;
        return LoadAsync();
    }

    private void OnNotifierChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Notifier.Changed -= OnNotifierChanged;

    private async Task LoadAsync()
    {
        var response = await Http.GetAsync("campaigns/mine");
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível carregar suas campanhas.";
            return;
        }

        _campaigns = await response.Content.ReadFromJsonAsync<List<CampaignResponse>>() ?? new();
        _errorMessage = null;
    }
}
