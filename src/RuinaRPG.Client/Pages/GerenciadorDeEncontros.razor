@page "/campanhas/{CampaignId}/encontros/{EncounterId}"
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthStateService AuthState
@using Microsoft.AspNetCore.SignalR.Client
@using RuinaRPG.Client.Services
@using RuinaRPG.Contracts.Campaigns
@using RuinaRPG.Contracts.Encounters

<Breadcrumbs Items="@Crumbs" />
@if (_editingNome)
{
    <div class="input-group" style="max-width: 24rem">
        <input class="form-control" @bind="_nomeEdit" />
        <button type="button" class="btn btn-primary" @onclick="SaveNomeAsync">Salvar</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _editingNome = false)">Cancelar</button>
    </div>
}
else
{
    <h1>
        @(_encounter?.Nome ?? "Encontro") — Rodada @_encounter?.CurrentRound
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="StartEditNome">Renomear</button>
    </h1>
}

@if (_errorMessage is not null)
{
    <p class="error">@_errorMessage</p>
}

<Section Title="Adicionar Participante">
    <EditForm Model="_addForm" OnValidSubmit="AddParticipantAsync">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Origem</label>
                <select class="form-select" @bind="_addForm.SourceKind">
                    <option value="CharacterSheet">Ficha de Personagem</option>
                    <option value="NpcSheet">Ficha de NPC</option>
                    <option value="CreatureSheet">Ficha de Criatura</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Ficha de origem (id)</label>
                <InputText class="form-control" @bind-Value="_addForm.SourceSheetId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Iniciativa</label>
                <InputNumber class="form-control" @bind-Value="_addForm.Iniciativa" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary">Adicionar Participante</button>
            </div>
        </div>
    </EditForm>
</Section>

<button type="button" class="btn btn-primary my-3" @onclick="AdvanceTurnAsync">Próximo Turno</button>

<table class="table">
    <thead><tr><th>Nome</th><th>Iniciativa</th><th>PV</th><th>PF</th><th>PA</th><th>Ações</th><th>Condições</th><th></th></tr></thead>
    <tbody>
        @for (var i = 0; i < _participants.Count; i++)
        {
            var participant = _participants[i];
            var isCurrentTurn = i == _encounter?.CurrentParticipantIndex;
            <tr style="@(isCurrentTurn ? "font-weight: bold" : "")">
                <td>@participant.Nome</td>
                <td>@participant.Iniciativa</td>
                <td>@participant.PV @(participant.IsLiveSourced ? "(somente leitura)" : "")</td>
                <td>@participant.PF @(participant.IsLiveSourced ? "(somente leitura)" : "")</td>
                <td>@participant.PA @(participant.IsLiveSourced ? "(somente leitura)" : "")</td>
                <td>@participant.AcoesRestantes</td>
                <td>@string.Join(", ", participant.Condicoes)</td>
                <td>
                    @if (_editingParticipantId == participant.Id)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEditParticipant">Cancelar</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="@(() => StartEditParticipant(participant))">Editar</button>
                    }
                </td>
            </tr>
            @if (_editingParticipantId == participant.Id)
            {
                <tr>
                    <td colspan="8">
                        <EditForm Model="_editParticipantForm" OnValidSubmit="@(() => SaveParticipantAsync(participant))">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label">Iniciativa</label>
                                    <InputNumber class="form-control" @bind-Value="_editParticipantForm.Iniciativa" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Ações Restantes (0-3)</label>
                                    <InputNumber class="form-control" @bind-Value="_editParticipantForm.AcoesRestantes" min="0" max="3" />
                                </div>
                                @if (participant.IsLiveSourced)
                                {
                                    <div class="col-md-8">
                                        <p class="text-muted mb-0">PV/PF/PA somente leitura aqui — este participante vem de uma ficha vinculada; edite a ficha diretamente.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-2">
                                        <label class="form-label">PV</label>
                                        <InputNumber class="form-control" @bind-Value="_editParticipantForm.PV" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">PF</label>
                                        <InputNumber class="form-control" @bind-Value="_editParticipantForm.PF" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">PA</label>
                                        <InputNumber class="form-control" @bind-Value="_editParticipantForm.PA" />
                                    </div>
                                }
                                <div class="col-md-6">
                                    <label class="form-label">Condições (substitui a lista atual)</label>
                                    <InputText class="form-control" @bind-Value="_editParticipantForm.CondicoesText" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary">Salvar</button>
                                </div>
                            </div>
                        </EditForm>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter] public string CampaignId { get; set; } = "";
    [Parameter] public string EncounterId { get; set; } = "";

    private string? _campaignName;

    private List<BreadcrumbItem> Crumbs
    {
        get
        {
            var crumbs = new List<BreadcrumbItem> { new("Painel", "painel") };
            if (_campaignName is not null)
            {
                crumbs.Add(new("Campanhas", "campanhas"));
                crumbs.Add(new(_campaignName, $"campanhas/{CampaignId}"));
            }
            crumbs.Add(new(_encounter?.Nome ?? "Encontro"));
            return crumbs;
        }
    }

    private EncounterResponse? _encounter;
    private List<EncounterParticipantResponse> _participants = new();
    private HubConnection? _hubConnection;
    private readonly AddParticipantFormModel _addForm = new();
    private string? _errorMessage;
    private string? _editingParticipantId;
    private readonly EditParticipantFormModel _editParticipantForm = new();
    private bool _editingNome;
    private string _nomeEdit = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadCampaignNameAsync());

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(new Uri(new Uri(Http.BaseAddress!, "/"), "hubs/encounters"), options =>
            {
                options.AccessTokenProvider = async () => await AuthState.GetAccessTokenAsync();
            })
            .WithAutomaticReconnect()
            .Build();
        _hubConnection.On("ParticipantsChanged", async () => { await LoadAsync(); StateHasChanged(); });
        // A reconnect gets a brand-new connection id server-side, so group membership (JoinEncounter)
        // doesn't survive it — without re-joining here, live sync would silently stop after any
        // network hiccup until the whole page was manually reloaded (item 5 of the gap audit).
        // Also re-fetch state in case anything changed while disconnected.
        _hubConnection.Reconnected += async _ =>
        {
            await _hubConnection.SendAsync("JoinEncounter", EncounterId);
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        };
        await _hubConnection.StartAsync();
        await _hubConnection.SendAsync("JoinEncounter", EncounterId);
    }

    private async Task LoadCampaignNameAsync()
    {
        var response = await Http.GetAsync("campaigns");
        if (!response.IsSuccessStatusCode) return;
        var campaigns = await response.Content.ReadFromJsonAsync<List<CampaignResponse>>() ?? new();
        _campaignName = campaigns.FirstOrDefault(c => c.Id == CampaignId)?.Nome;
    }

    private async Task LoadAsync()
    {
        var encountersResponse = await Http.GetAsync($"campaigns/{CampaignId}/encounters");
        var encounters = await encountersResponse.Content.ReadFromJsonAsync<List<EncounterResponse>>() ?? new();
        _encounter = encounters.SingleOrDefault(e => e.Id == EncounterId);

        _participants = await Http.GetFromJsonAsync<List<EncounterParticipantResponse>>($"encounters/{EncounterId}/participants") ?? new();
    }

    private async Task AddParticipantAsync()
    {
        if (string.IsNullOrWhiteSpace(_addForm.SourceSheetId))
        {
            _errorMessage = "Informe o id da ficha de origem.";
            return;
        }

        var request = new AddParticipantRequest(
            _addForm.SourceKind == "CharacterSheet" ? _addForm.SourceSheetId : null,
            _addForm.SourceKind == "NpcSheet" ? _addForm.SourceSheetId : null,
            _addForm.SourceKind == "CreatureSheet" ? _addForm.SourceSheetId : null,
            _addForm.Iniciativa);

        var response = await Http.PostAsJsonAsync($"encounters/{EncounterId}/participants", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível adicionar o participante.";
            return;
        }

        _addForm.SourceSheetId = "";
        _addForm.Iniciativa = 0;
        await LoadAsync();
    }

    private void StartEditNome()
    {
        _nomeEdit = _encounter?.Nome ?? "";
        _editingNome = true;
    }

    private async Task SaveNomeAsync()
    {
        var nome = string.IsNullOrWhiteSpace(_nomeEdit) ? null : _nomeEdit;
        var response = await Http.PutAsJsonAsync($"encounters/{EncounterId}", new UpdateEncounterRequest(nome));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível renomear o encontro.";
            return;
        }

        _editingNome = false;
        await LoadAsync();
    }

    private async Task AdvanceTurnAsync()
    {
        var response = await Http.PostAsync($"encounters/{EncounterId}/advance-turn", null);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível avançar o turno.";
            return;
        }

        await LoadAsync();
    }

    private void StartEditParticipant(EncounterParticipantResponse participant)
    {
        _editingParticipantId = participant.Id;
        _editParticipantForm.Iniciativa = participant.Iniciativa;
        _editParticipantForm.AcoesRestantes = participant.AcoesRestantes;
        _editParticipantForm.PV = participant.PV;
        _editParticipantForm.PF = participant.PF;
        _editParticipantForm.PA = participant.PA;
        // The label makes clear that submitting replaces the whole list, matching the server's
        // actual (replace, not append) semantics — pre-filling here just saves retyping unchanged tags.
        _editParticipantForm.CondicoesText = string.Join(", ", participant.Condicoes);
    }

    private void CancelEditParticipant()
    {
        _editingParticipantId = null;
    }

    private async Task SaveParticipantAsync(EncounterParticipantResponse participant)
    {
        var condicoes = _editParticipantForm.CondicoesText
            .Split(new[] { ',', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(c => c.Trim())
            .Where(c => c.Length > 0)
            .ToList();

        var request = new UpdateParticipantRequest(
            _editParticipantForm.Iniciativa,
            participant.IsLiveSourced ? null : _editParticipantForm.PV,
            participant.IsLiveSourced ? null : _editParticipantForm.PF,
            participant.IsLiveSourced ? null : _editParticipantForm.PA,
            _editParticipantForm.AcoesRestantes,
            condicoes);

        var response = await Http.PutAsJsonAsync($"encounters/{EncounterId}/participants/{participant.Id}", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = "Não foi possível salvar o participante.";
            return;
        }

        _editingParticipantId = null;
        await LoadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }

    private class AddParticipantFormModel
    {
        public string SourceKind { get; set; } = "CharacterSheet";
        public string SourceSheetId { get; set; } = "";
        public int Iniciativa { get; set; }
    }

    private class EditParticipantFormModel
    {
        public int Iniciativa { get; set; }
        public int AcoesRestantes { get; set; }
        public int? PV { get; set; }
        public int? PF { get; set; }
        public int? PA { get; set; }
        public string CondicoesText { get; set; } = "";
    }
}
