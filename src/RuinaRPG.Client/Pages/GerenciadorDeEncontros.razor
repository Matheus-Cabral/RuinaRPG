@page "/campanhas/{CampaignId}/encontros/{EncounterId}"
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IEncounterConnection Connection
@using RuinaRPG.Client.Services
@using RuinaRPG.Contracts.Campaigns
@using RuinaRPG.Contracts.CharacterSheets
@using RuinaRPG.Contracts.CreatureSheets
@using RuinaRPG.Contracts.Encounters
@using RuinaRPG.Contracts.NpcSheets
@using MudBlazor

<Breadcrumbs Items="@Crumbs" />
@if (_editingNome)
{
    <MudTextField T="string" @bind-Value="_nomeEdit" Style="max-width:24rem" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="SaveNomeAsync">Salvar</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-2" OnClick="@(() => _editingNome = false)">Cancelar</MudButton>
}
else
{
    <MudText Typo="Typo.h3">
        @(_encounter?.Nome ?? "Encontro") — Turno @_encounter?.CurrentRound
        @if (_encounter is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="@CorDaFase" Class="ml-2">@NomeDaFase</MudChip>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="StartEditNome" Class="ml-2">Renomear</MudButton>
    </MudText>
}

<DismissibleAlert @bind-Message="_errorMessage" Class="mt-3" />

@if (_encounter?.Status == "EmAndamento")
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.PlayArrow" Class="mt-3">
        @(_encounter.CurrentParticipantId is null
            ? $"Turno {_encounter.CurrentRound}, ninguém com a vez"
            : $"Turno {_encounter.CurrentRound}, vez de {NomeDaVez}")
    </MudAlert>
}

@if (!Finalizado)
{
<Section Title="Adicionar Participante">
    <EditForm Model="_addForm" OnValidSubmit="AddParticipantAsync">
        <MudGrid Class="mt-3">
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_addForm.SourceKind" @bind-Value:after="@(() => _addForm.SourceSheetId = "")" Label="Origem">
                    <MudSelectItem Value="@("CharacterSheet")">Ficha de Personagem</MudSelectItem>
                    <MudSelectItem Value="@("NpcSheet")">Ficha de NPC</MudSelectItem>
                    <MudSelectItem Value="@("CreatureSheet")">Ficha de Criatura</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="5">
                <EntityPicker @bind-Value="_addForm.SourceSheetId" SearchItems="SearchSourceSheetsAsync" Placeholder="Buscar ficha..." />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="int" @bind-Value="_addForm.Iniciativa" Label="Iniciativa" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Adicionar Participante</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</Section>
}

@if (_encounter is not null)
{
    <MudStack Row="true" Class="my-3">
        @switch (_encounter.Status)
        {
            case "Preparacao":
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_enviando" OnClick="@(() => PostAsync("start", "Não foi possível iniciar o encontro."))">Iniciar encontro</MudButton>
                break;
            case "EmAndamento":
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SkipPrevious" Disabled="_enviando" OnClick="@(() => PostAsync("previous-turn", "Não foi possível voltar a vez."))">Vez anterior</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SkipNext" Disabled="_enviando" OnClick="@(() => PostAsync("advance-turn", "Não foi possível passar a vez."))">Próxima vez</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Flag" Disabled="_enviando" OnClick="FinishAsync">Finalizar encontro</MudButton>
                break;
            default:
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Replay" Disabled="_enviando" OnClick="@(() => PostAsync("reopen", "Não foi possível reabrir o encontro."))">Reabrir</MudButton>
                break;
        }
    </MudStack>
}

<MudSimpleTable Dense="true" Hover="true">
    <thead><tr><th>Nome</th><th>Iniciativa</th><th>PV</th><th>PF</th><th>PA</th><th>Ações</th><th>Condições</th><th></th></tr></thead>
    <tbody>
        @for (var i = 0; i < _participants.Count; i++)
        {
            var participant = _participants[i];
            var isCurrentTurn = _encounter?.CurrentParticipantId == participant.Id;
            <tr class="@(isCurrentTurn ? "encontro-vez" : "")">
                <td>
                    @if (isCurrentTurn)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Class="mr-1" />
                    }
                    @participant.Nome
                </td>
                <td>@participant.Iniciativa</td>
                <td>@participant.PV @(participant.IsLiveSourced ? "(somente leitura)" : "")</td>
                <td>@participant.PF @(participant.IsLiveSourced ? "(somente leitura)" : "")</td>
                <td>@participant.PA @(participant.IsLiveSourced ? "(somente leitura)" : "")</td>
                <td>@participant.AcoesRestantes</td>
                <td>@string.Join(", ", participant.Condicoes)</td>
                <td>
                    @if (Finalizado)
                    {
                    }
                    else if (_editingParticipantId == participant.Id)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="CancelEditParticipant">Cancelar</MudButton>
                    }
                    else
                    {
                        @if (_encounter?.Status == "EmAndamento" && !isCurrentTurn)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Redo" Size="Size.Small" aria-label="Passar a vez para este" title="Passar a vez para este" Disabled="_enviando"
                                           OnClick="@(() => PostAsync($"turn/{participant.Id}", "Não foi possível passar a vez."))" />
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => StartEditParticipant(participant))">Editar</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small" aria-label="Remover do encontro" title="Remover do encontro" Disabled="_enviando"
                                       OnClick="@(() => RemoveParticipantAsync(participant))" />
                    }
                </td>
            </tr>
            @if (_editingParticipantId == participant.Id && !Finalizado)
            {
                <tr>
                    <td colspan="8">
                        <EditForm Model="_editParticipantForm" OnValidSubmit="@(() => SaveParticipantAsync(participant))">
                            <MudGrid Class="mt-3">
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="int" @bind-Value="_editParticipantForm.Iniciativa" Label="Iniciativa" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="int" @bind-Value="_editParticipantForm.AcoesRestantes" Label="Ações Restantes (0-3)" Min="0" Max="3" />
                                </MudItem>
                                @if (participant.IsLiveSourced)
                                {
                                    <MudItem xs="12" md="8">
                                        <MudText Color="Color.Secondary">PV/PF/PA somente leitura aqui — este participante vem de uma ficha vinculada; edite a ficha diretamente.</MudText>
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="int?" @bind-Value="_editParticipantForm.PV" Label="PV" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="int?" @bind-Value="_editParticipantForm.PF" Label="PF" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="int?" @bind-Value="_editParticipantForm.PA" Label="PA" />
                                    </MudItem>
                                }
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string" @bind-Value="_editParticipantForm.CondicoesText" Label="Condições (substitui a lista atual)" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Salvar</MudButton>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

@if (_encounter is { Status: not "Preparacao" })
{
    <Section Title="Log do encontro">
        @if (_log.Count == 0)
        {
            <MudText Color="Color.Secondary">Nenhum evento registrado ainda.</MudText>
        }
        @foreach (var turno in LogDoEncontroAgrupador.PorTurno(_log))
        {
            <MudText Typo="Typo.h6" Class="mt-3">Turno @turno.Turno</MudText>
            @foreach (var vez in turno.Vezes)
            {
                @if (vez.VezNome is not null)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-1">Vez de @vez.VezNome</MudText>
                }
                @foreach (var linha in vez.Linhas)
                {
                    <div class="encontro-log-linha">
                        <MudText Typo="Typo.body2" Inline="true" Class="mr-2">@LocalDe(linha).ToString("HH:mm")</MudText>
                        <MudText Typo="Typo.body2" Inline="true">@LogDoEncontroAgrupador.Texto(linha)</MudText>
                    </div>
                }
            }
        }
    </Section>
}

@code {
    [Parameter] public string CampaignId { get; set; } = "";
    [Parameter] public string EncounterId { get; set; } = "";

    private string? _campaignName;

    private List<RuinaRPG.Client.Shared.BreadcrumbItem> Crumbs
    {
        get
        {
            var crumbs = new List<RuinaRPG.Client.Shared.BreadcrumbItem> { new("Painel", "painel") };
            if (_campaignName is not null)
            {
                crumbs.Add(new("Campanhas", "campanhas"));
                crumbs.Add(new(_campaignName, $"campanhas/{CampaignId}"));
            }
            crumbs.Add(new(_encounter?.Nome ?? "Encontro"));
            return crumbs;
        }
    }

    private EncounterResponse? _encounter;
    private List<EncounterParticipantResponse> _participants = new();
    private List<EncounterLogEntryResponse> _log = new();
    private bool _enviando;
    private readonly AddParticipantFormModel _addForm = new();
    private string? _errorMessage;
    private string? _editingParticipantId;
    private readonly EditParticipantFormModel _editParticipantForm = new();
    private bool _editingNome;
    private string _nomeEdit = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadCampaignNameAsync());

        await Connection.StartAsync(EncounterId, async () => { await LoadAsync(); await InvokeAsync(StateHasChanged); });
    }

    private async Task LoadCampaignNameAsync()
    {
        var response = await Http.GetAsync("campaigns");
        if (!response.IsSuccessStatusCode) return;
        var campaigns = await response.Content.ReadFromJsonAsync<List<CampaignResponse>>() ?? new();
        _campaignName = campaigns.FirstOrDefault(c => c.Id == CampaignId)?.Nome;
    }

    private async Task LoadAsync()
    {
        var encountersResponse = await Http.GetAsync($"campaigns/{CampaignId}/encounters");
        var encounters = await encountersResponse.Content.ReadFromJsonAsync<List<EncounterResponse>>() ?? new();
        _encounter = encounters.SingleOrDefault(e => e.Id == EncounterId);
        if (Finalizado)
            _editingParticipantId = null; // a finished encounter is read-only: drop any inline edit left open

        _participants = await Http.GetFromJsonAsync<List<EncounterParticipantResponse>>($"encounters/{EncounterId}/participants") ?? new();

        // The log only exists once the encounter has started; "Preparacao" has nothing to show or fetch.
        _log = _encounter is { Status: not "Preparacao" }
            ? await Http.GetFromJsonAsync<List<EncounterLogEntryResponse>>($"encounters/{EncounterId}/log") ?? new()
            : new();
    }

    private bool Finalizado => _encounter?.Status == "Finalizado";

    private string NomeDaFase => _encounter?.Status switch
    {
        "EmAndamento" => "Em andamento",
        "Finalizado" => "Finalizado",
        _ => "Preparação",
    };

    private Color CorDaFase => _encounter?.Status switch
    {
        "EmAndamento" => Color.Success,
        "Finalizado" => Color.Dark,
        _ => Color.Default,
    };

    private string? NomeDaVez => _participants.FirstOrDefault(p => p.Id == _encounter?.CurrentParticipantId)?.Nome;

    private static DateTime LocalDe(EncounterLogEntryResponse linha) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(linha.OccurredAt, DateTimeKind.Utc), TimeZoneInfo.Local);

    /// <summary>One request of the phase/turn controls: every button stays disabled until it answers.</summary>
    private async Task PostAsync(string path, string fallbackMessage)
    {
        _enviando = true;
        try
        {
            var response = await Http.PostAsync($"encounters/{EncounterId}/{path}", null);
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await response.Content.ReadErrorMessageAsync() ?? fallbackMessage;
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _enviando = false;
        }
    }

    private async Task FinishAsync()
    {
        if (_enviando)
            return;

        // The flag stays up while the confirmation is open, so a second click cannot open another one.
        _enviando = true;
        bool? confirmou;
        try
        {
            confirmou = await DialogService.ShowMessageBoxAsync(
                "Finalizar encontro",
                "Finalizar o encontro? Ele passa a ser somente leitura; é possível reabrir depois.",
                yesText: "Finalizar", cancelText: "Cancelar");
        }
        finally
        {
            _enviando = false;
        }
        if (confirmou == true)
            await PostAsync("finish", "Não foi possível finalizar o encontro.");
    }

    private async Task RemoveParticipantAsync(EncounterParticipantResponse participant)
    {
        if (_enviando)
            return;

        // The flag stays up from the confirmation through the request, so a second click cannot open another dialog.
        _enviando = true;
        try
        {
            var confirmou = await DialogService.ShowMessageBoxAsync(
                "Remover participante",
                $"Remover {participant.Nome} do encontro?",
                yesText: "Remover", cancelText: "Cancelar");
            if (confirmou != true)
                return;

            var response = await Http.DeleteAsync($"encounters/{EncounterId}/participants/{participant.Id}");
            if (!response.IsSuccessStatusCode)
            {
                _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível remover o participante.";
                return;
            }

            await LoadAsync();
        }
        finally
        {
            _enviando = false;
        }
    }

    private async Task<List<PickerOption>> SearchSourceSheetsAsync(string query)
    {
        switch (_addForm.SourceKind)
        {
            case "NpcSheet":
            {
                var response = await Http.GetAsync($"npc-sheets?nome={Uri.EscapeDataString(query)}");
                if (!response.IsSuccessStatusCode) return new();
                var sheets = await response.Content.ReadFromJsonAsync<List<NpcSheetSummaryResponse>>() ?? new();
                return sheets.Select(s => new PickerOption(s.Id, s.Nome)).ToList();
            }
            case "CreatureSheet":
            {
                var response = await Http.GetAsync($"creature-sheets?nome={Uri.EscapeDataString(query)}");
                if (!response.IsSuccessStatusCode) return new();
                var sheets = await response.Content.ReadFromJsonAsync<List<CreatureSheetSummaryResponse>>() ?? new();
                return sheets.Select(s => new PickerOption(s.Id, s.Nome)).ToList();
            }
            default:
            {
                // No dedicated search-by-name endpoint for CharacterSheets — the campaign's own
                // roster (already scoped, typically small) is fetched and filtered client-side.
                var response = await Http.GetAsync($"campaigns/{CampaignId}/character-sheets");
                if (!response.IsSuccessStatusCode) return new();
                var sheets = await response.Content.ReadFromJsonAsync<List<CharacterSheetResponse>>() ?? new();
                return sheets
                    .Where(s => (s.Nome ?? "").Contains(query, StringComparison.OrdinalIgnoreCase))
                    .Select(s => new PickerOption(s.Id, s.Nome ?? "(sem nome)"))
                    .ToList();
            }
        }
    }

    private async Task AddParticipantAsync()
    {
        if (string.IsNullOrWhiteSpace(_addForm.SourceSheetId))
        {
            _errorMessage = "Informe o id da ficha de origem.";
            return;
        }

        var request = new AddParticipantRequest(
            _addForm.SourceKind == "CharacterSheet" ? _addForm.SourceSheetId : null,
            _addForm.SourceKind == "NpcSheet" ? _addForm.SourceSheetId : null,
            _addForm.SourceKind == "CreatureSheet" ? _addForm.SourceSheetId : null,
            _addForm.Iniciativa);

        var response = await Http.PostAsJsonAsync($"encounters/{EncounterId}/participants", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível adicionar o participante.";
            return;
        }

        _addForm.SourceSheetId = "";
        _addForm.Iniciativa = 0;
        await LoadAsync();
    }

    private void StartEditNome()
    {
        _nomeEdit = _encounter?.Nome ?? "";
        _editingNome = true;
    }

    private async Task SaveNomeAsync()
    {
        var nome = string.IsNullOrWhiteSpace(_nomeEdit) ? null : _nomeEdit;
        var response = await Http.PutAsJsonAsync($"encounters/{EncounterId}", new UpdateEncounterRequest(nome));
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível renomear o encontro.";
            return;
        }

        _editingNome = false;
        await LoadAsync();
    }

    private void StartEditParticipant(EncounterParticipantResponse participant)
    {
        _editingParticipantId = participant.Id;
        _editParticipantForm.Iniciativa = participant.Iniciativa;
        _editParticipantForm.AcoesRestantes = participant.AcoesRestantes;
        _editParticipantForm.PV = participant.PV;
        _editParticipantForm.PF = participant.PF;
        _editParticipantForm.PA = participant.PA;
        // The label makes clear that submitting replaces the whole list, matching the server's
        // actual (replace, not append) semantics — pre-filling here just saves retyping unchanged tags.
        _editParticipantForm.CondicoesText = string.Join(", ", participant.Condicoes);
    }

    private void CancelEditParticipant()
    {
        _editingParticipantId = null;
    }

    private async Task SaveParticipantAsync(EncounterParticipantResponse participant)
    {
        var condicoes = _editParticipantForm.CondicoesText
            .Split(new[] { ',', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(c => c.Trim())
            .Where(c => c.Length > 0)
            .ToList();

        var request = new UpdateParticipantRequest(
            _editParticipantForm.Iniciativa,
            participant.IsLiveSourced ? null : _editParticipantForm.PV,
            participant.IsLiveSourced ? null : _editParticipantForm.PF,
            participant.IsLiveSourced ? null : _editParticipantForm.PA,
            _editParticipantForm.AcoesRestantes,
            condicoes);

        var response = await Http.PutAsJsonAsync($"encounters/{EncounterId}/participants/{participant.Id}", request);
        if (!response.IsSuccessStatusCode)
        {
            _errorMessage = await response.Content.ReadErrorMessageAsync() ?? "Não foi possível salvar o participante.";
            return;
        }

        _editingParticipantId = null;
        await LoadAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await Connection.DisposeAsync();
    }

    private class AddParticipantFormModel
    {
        public string SourceKind { get; set; } = "CharacterSheet";
        public string SourceSheetId { get; set; } = "";
        public int Iniciativa { get; set; }
    }

    private class EditParticipantFormModel
    {
        public int Iniciativa { get; set; }
        public int AcoesRestantes { get; set; }
        public int? PV { get; set; }
        public int? PF { get; set; }
        public int? PA { get; set; }
        public string CondicoesText { get; set; } = "";
    }
}
